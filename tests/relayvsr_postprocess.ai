// Focused no-model gate for the RelayVSR adapter: request mapping, the Generate
// handoff (retained .pre-relayvsr.mp4) and the durable sidecar.
module app.mm_air.tests.relayvsr_postprocess

import "h3_presets_fixture.ai" as fixture
import std.inference.h3.policy as h3_policy
import "../generate.ai" as generation
import "../relayvsr_post.ai" as relayvsr
import "../.air/deps/relayvsr/config.ai" as config
import "../.air/deps/relayvsr/session.ai" as relay_session
import "../.air/deps/relayvsr/media.ai" as relay_media
import "../character_sheet.ai" as sheet
import std.inference.h3.media as media
import std.inference.h3.session as session
import std.channel as channel
import std.text as text

fn require(value:bool,message:str)->unit effects {io.write} {
  if not value{io.ewrite("MM-Air RelayVSR post-process FAIL: ")
    io.ewrite(message)
    io.ewrite("\n")
    panic "MM-Air RelayVSR post-process regression failed"}
}

fn make_job(receiver:ref<channel.Receiver>,mode:u32,output:str,
            transformer:session.Projection)
    ->generation.Job effects {alloc,env,fs.read,io.write} {
  var configuration=generation.Configuration {checkpoint_root:string.copy("/h3"),
    reference_checkpoint_root:string.copy("/h3-ref"),donor_root:string.copy("/donor"),
    manifest_root:string.copy("/manifests"),
    deployment_file:string.copy("/h3_deployment.json"),presets:fixture.presets(),
    scratch_root:string.copy("/tmp")}
  var references:array<string> = []
  var audio:array<string> = []
  var geometry=match media.geometry(22,256,256){ok(value)=>value,err(_)=>{
    panic "fixed H3 geometry rejected"},}
  generation.job(configuration,"restore this",session.Model.Base,session.Task.T2VA,
    geometry,references,audio,output,mode,"/tmp/sheet.png",42,7,
    session.Projection.ExactBF16,transformer,
    session.Attention.Exact,channel.ticket(receiver),session.Schedule.Simple,h3_policy.Sampler.ResMultistep)
}

pub fn main(args:view<str>)->i32 effects {alloc,env,fs.read,io.write,net,time} {
  // Request mapping: native scale vs same size, per variant.
  let native2=relayvsr.settings(0,0,true,11)
  let same4=relayvsr.settings(1,1,false,12)
  let native4=relayvsr.settings(1,0,true,13)
  require(relayvsr.request(native2).sr_ratio_milli==2000,"2x native is 2000 milli")
  require(relayvsr.request(native4).sr_ratio_milli==4000,"4x native is 4000 milli")
  require(relayvsr.request(same4).sr_ratio_milli==1000,"same size is 1000 milli")
  require(relayvsr.request(same4).seed==12 and not relayvsr.request(same4).preserve_audio,
    "seed and audio reach the request")
  require(relayvsr.request(same4).variant==config.Variant.X4 and
    relayvsr.request(native2).variant==config.Variant.X2,"variant maps")
  require(relayvsr.settings(7,9,true,1).variant==0 and relayvsr.settings(7,9,true,1).size_mode==0,
    "unknown values fall back to 2x native")

  // Folder defaults and file names.
  var found=relay_session.sources_in("/m/RelayVSR_X4",config.Variant.X4)
  require(found.wan_checkpoint=="/m/RelayVSR_X4/wan.safetensors" and
    found.flash_checkpoint=="/m/RelayVSR_X4/flash.safetensors","4x file names")

  // Generate handoff.
  var receiver=match channel.open(4,64){ok(value)=>value,err(_)=>{return 1},}
  var job=make_job(receiver,0,"/tmp/final.mp4",session.Projection.ExactBF16)
  match generation.enable_relayvsr(job,same4){ok(_)=>{},err(_)=>{return 1},}
  require(job.relayvsr_enabled and not job.seedvr2_enabled,"only RelayVSR enabled")
  require(job.output=="/tmp/final.mp4.pre-relayvsr.mp4","retained pre-upscale MP4")
  require(job.relayvsr_final_output=="/tmp/final.mp4","final output kept")
  require(job.relayvsr_settings.variant==1 and job.relayvsr_settings.seed==12,
    "settings reach the job")
  let _=channel.close(receiver)
  var sheet_receiver=match channel.open(4,64){ok(value)=>value,err(_)=>{return 1},}
  var sheet_job=make_job(sheet_receiver,sheet.six_panel(),"/tmp/final.mp4",
    session.Projection.ExactBF16)
  match generation.enable_relayvsr(sheet_job,same4){ok(_)=>{
    require(false,"character-sheet PNG must be rejected")},err(_)=>{},}
  require(not sheet_job.relayvsr_enabled and sheet_job.output=="/tmp/final.mp4",
    "rejected request remains unchanged")
  let _=channel.close(sheet_receiver)

  // Sidecar.
  var report=relay_media.Report {source:string.copy("/tmp/final.mp4.pre-relayvsr.mp4"),
    output:string.copy("/tmp/final.mp4"),width:1024,height:576,frames:49,
    fps_numerator:24,fps_denominator:1,seed:13,preserve_audio:true,runtime_ms:1234,
    peak_vram_bytes:5678}
  let encoded=match relayvsr.metadata(report,found,native4){ok(value)=>value,
    err(_)=>{return 1},}
  let view_text=str.view(encoded)
  require(text.contains(view_text,"\"schema\":\"mm-air.relayvsr.postprocess\""),"schema")
  require(text.contains(view_text,"\"model_variant\":\"RelayVSR 4x\""),"variant name")
  require(text.contains(view_text,"/m/RelayVSR_X4/wan.safetensors"),"model file")
  require(text.contains(view_text,"\"target_width\":1024"),"width")
  require(text.contains(view_text,"\"frames\":49"),"frames")
  require(text.contains(view_text,"\"fps_numerator\":24"),"fps")
  require(text.contains(view_text,"\"seed\":13"),"seed")
  require(text.contains(view_text,"\"preserve_audio\":true"),"audio")
  require(text.contains(view_text,"\"runtime_ms\":1234"),"runtime")
  require(text.contains(view_text,"\"peak_vram_bytes\":5678"),"peak vram")
  require(relayvsr.sidecar_path("/a/b.mp4")=="/a/b.mp4.relayvsr.json","sidecar name")
  io.write("MM-Air RelayVSR adapter mapping, handoff and sidecar: PASS\n")
  0
}
