module app.mm_air.tests.h3image_generate
import "../h3image.ai" as h3image
import "../parameters.ai" as parameters
import std.channel as channel
import std.text as text

// One real MM-Air MiniMax H3-Image job through the application's own worker (h3image.run, the code the
// Generate and Image Edit buttons start): OUTPUT.png PROMPT SEED SIZE(WxH or keep) EXPANDER(off|low|xhigh|qwen) [IMAGE.png | lora=FILE.safetensors ...]
pub fn main(args:view<str>)->i32
    effects {alloc,env,ffi,fs.meta,fs.read,fs.write,gpu,io.write,net,process,thread,time} {
  if view.len(args)<6 {
    io.ewrite("usage: h3image-generate OUTPUT.png PROMPT SEED WxH|keep off|low|xhigh|qwen [IMAGE.png | lora=FILE.safetensors ...]\n")
    return 1
  }
  let seed=match text.parse_u64(view.get(args,3)){some(value)=>value,none=>{return 2},}
  var request=parameters.h3image_defaults()
  let _a=ref.swap(struct.borrow(request,field=output),string.copy(view.get(args,1)))
  let _b=ref.swap(struct.borrow(request,field=prompt),string.copy(view.get(args,2)))
  let _c=ref.swap(struct.borrow(request,field=expander),string.copy(view.get(args,5)))
  struct.set(request,seed,field=seed)
  let size=view.get(args,4)
  if size=="keep" {
    struct.set(request,0,field=width)
    struct.set(request,0,field=height)
  } else {
    var parts=text.split(size,"x")
    if array.len(parts)!=2 {return 3}
    struct.set(request,match text.parse_u64(str.view(array.borrow(parts,0))){some(v)=>v,none=>0},field=width)
    struct.set(request,match text.parse_u64(str.view(array.borrow(parts,1))){some(v)=>v,none=>0},field=height)
  }
  var index:u64=6
  loop{
    if index>=view.len(args){break}
    let argument=view.get(args,index)
    if str.starts_with(argument,"lora=") {
      array.push(struct.borrow(request,field=loras),parameters.LoraEntry{path:string.copy(str.slice(argument,5,str.len(argument))),
        strength:1.0,enabled:true})
    } else {
      array.push(struct.borrow(request,field=images),string.copy(argument))
    }
    index=index+1
  }
  var receiver=match channel.open(128,1024){ok(value)=>value,err(_)=>{return 5},}
  var work=h3image.H3ImageJob{request:request,progress:channel.ticket(receiver)}
  var outcome=h3image.run(work)
  let _=channel.close(receiver)
  io.write(text.concat("MM-Air MiniMax H3-Image: ",outcome.message))
  io.write("\n")
  if outcome.succeeded{0}else{6}
}
