// Real imported-mask character replacement runner used by MM-Air acceptance
// work. The source is both edit authority and Video 1; Picture 1 supplies the
// replacement identity.
module app.mm_air.tests.masked_video_generate

import "../generate.ai" as generation
import "../masked_runtime.ai" as masked
import "../.air/deps/h3/media.ai" as media
import "../.air/deps/h3/session.ai" as session
import std.channel as channel
import std.text as text

fn failure(message:str)->i32 effects {io.write} {
  io.ewrite(message)
  io.ewrite("\n")
  1
}

pub fn main(args:view<str>)->i32
    effects {alloc,env,fs.meta,fs.read,fs.write,gpu,io.write,net,process,thread,time} {
  if view.len(args)!=7{
    io.ewrite("usage: masked-video-generate SOURCE MASK CHARACTER_IMAGE OUTPUT_MP4 SAM3_PLUGIN SAM3_MODEL\n")
    return 2
  }
  var configuration=match generation.configuration(){ok(value)=>value,
    err(problem)=>{return failure(str.view(problem))},}
  let geometry=match media.geometry(48,256,448){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(media.error_message(held)))},}
  var receiver=match channel.open(128,1024){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(channel.message(held)))},}
  let prompt="subject_definitions:\n<Video 1>: the two-second source performance, motion, framing, camera, environment, lighting, timing, and synchronized soundtrack authority.\n<Picture 1>: the replacement claymation dancer identity: one handcrafted warm terracotta-clay dancer with an expressive sculpted face, fitted clay dance costume, tactile fingerprints, clean full-body silhouette, and stop-motion film character construction.\n\nsummary:\n[masked video editing + reference generation] Replace only the masked performer in <Video 1> with the claymation dancer from <Picture 1>.\n\nretention_analysis:\n<Video 1>: partially_preserved; preserve every unmasked pixel, action trajectory, pose progression, screen position, scale, camera, room, lighting, timing, and original audio.\n<Picture 1>: fully_preserved; preserve the terracotta clay material, sculpted facial identity, costume, body proportions, handcrafted surface detail, and stop-motion character style.\n\ndetailed_description:\n[Shot 1] One coherent claymation dancer replaces the source performer inside the authored tracked mask and follows the exact source dance motion and pose timing. The dancer remains the same character in every frame. Do not add another person, duplicate body, text, props, or change the background. Preserve the complete source outside the mask.\n\noverall_soundscape:\nReuse the synchronized soundtrack from <Video 1> unchanged.\n\nnon_diegetic_music:\nPreserve source music without adding music."
  var references:array<string> = [string.copy(view.get(args,1)),
    string.copy(view.get(args,3))]
  var audio:array<string> = []
  var job=generation.job(configuration,prompt,session.Model.Reference,
    session.Task.Ref2VA,geometry,references,audio,view.get(args,4),0,"",424242,19,
    session.Projection.ExactBF16,session.Projection.RowScaledI8,
    session.Attention.DenseInt8,channel.ticket(receiver),session.Schedule.Exponential)
  generation.enable_masked_composite(job,masked.settings(view.get(args,2),false,0.0,0.0,
    0.0,0.0,2,8,4,0,96,true))
  match generation.enable_two_matte(job,view.get(args,5),view.get(args,6)) {
    ok(_)=>{},err(problem)=>{return failure(str.view(problem))},}
  var completed=generation.Outcome {succeeded:false,output:string.new(),
    message:string.copy("masked video worker did not complete"),runtime_ms:0,
    peak_vram_bytes:0}
  task.scope {
    var jobs:array<task<generation.Outcome>> = [task.spawn(job,fn=generation.run)]
    loop {
      match channel.recv_now(receiver,time.monotonic_ns()) {
        ok(value)=>match value {some(item)=>{var update=item
          match channel.text_of(update) {some(message)=>{io.write(str.view(message))
            io.write("\n")},none=>{}}},none=>{}},err(_)=>{},
      }
      match task.wait_any(jobs,0) {some(_)=>{
        completed=task.join(option.unwrap(array.pop(jobs)))
        break},none=>{time.sleep_ms(50)},}
    }
  }
  let _=channel.close(receiver)
  io.write(text.concat("result=",text.concat(if completed.succeeded{"success"}
    else{"failure"},"\n")))
  io.write(text.concat("output=",text.concat(struct.borrow(completed,field=output),"\n")))
  io.write(text.concat("message=",text.concat(struct.borrow(completed,field=message),"\n")))
  if completed.succeeded{0}else{1}
}
