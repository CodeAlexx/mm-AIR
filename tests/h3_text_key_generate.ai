// Bounded real-model receipt for the H3 text encoder choice "Plato's Key": the same Job the Generate panel builds for
// MiniMax H3 Base text to video (ConvRot INT8, dense INT8 attention, the exponential 20-evaluation profile), with
// generation.enable_text_key, through the app's own worker. The donor folder and the key file come from the Settings.
//   h3-text-key-generate OUTPUT.mp4 [FRAMES WIDTH HEIGHT EVALUATIONS STRENGTH_PERCENT PROMPT_FILE]
module app.mm_air.tests.h3_text_key_generate
import std.inference.h3.policy as h3_policy
import "../generate.ai" as generation
import std.inference.h3.media as media
import std.inference.h3.session as session
import std.channel as channel
import std.text as text
import std.files as files
import "../parameters.ai" as parameters

fn failure(message:str)->i32 effects{io.write}{
  io.ewrite(message)
  io.ewrite("\n")
  1
}

fn num(value:str,fallback:u64)->u64 effects{}{
  match text.parse_u64(value){some(found)=>found,none=>fallback}
}

pub fn main(args:view<str>)->i32
    effects{alloc,env,fs.meta,fs.read,fs.write,gpu,io.write,net,process,thread,time}{
  if view.len(args)<2{
    io.ewrite("usage: h3-text-key-generate OUTPUT.mp4 [FRAMES WIDTH HEIGHT EVALUATIONS STRENGTH_PERCENT PROMPT_FILE]\n")
    return 2
  }
  var configuration=match generation.configuration(){ok(value)=>value,
    err(message)=>{return failure(str.view(message))}}
  let frames:u64=if view.len(args)>2{num(view.get(args,2),49)}else{49}
  let width:u64=if view.len(args)>3{num(view.get(args,3),832)}else{832}
  let height:u64=if view.len(args)>4{num(view.get(args,4),480)}else{480}
  let evaluations:u64=if view.len(args)>5{num(view.get(args,5),20)}else{20}
  let percent:u64=if view.len(args)>6{num(view.get(args,6),100)}else{100}
  let geometry=match media.geometry(frames,width,height){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(media.error_message(held)))}}
  var prompt:string=if view.len(args)>7{match files.read_text(view.get(args,7)){ok(value)=>value,
    err(_)=>{return failure("cannot read the prompt file")}}}
    else{string.copy("A calm sea at sunrise. Small waves roll toward a sandy beach while the camera slowly pans right across the shoreline.")}
  var receiver=match channel.open(128,1024){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(channel.message(held)))}}
  var loras:array<parameters.LoraEntry> = []
  var job=generation.job_loras(configuration,str.view(prompt),session.Model.Base,
    session.Task.T2VA,geometry,[],[],view.get(args,1),loras,0,"",0,evaluations,
    session.Projection.ConvRotI8,session.Projection.ConvRotI8,
    session.Attention.DenseInt8,channel.ticket(receiver),session.Schedule.Exponential,
    h3_policy.Sampler.Euler)
  let strength:f64=cast.float(percent)/100.0
  match generation.enable_text_key(job,strength){ok(_)=>{},err(message)=>{return failure(str.view(message))}}
  var completed=generation.Outcome{succeeded:false,output:string.new(),
    message:string.copy("The worker did not complete"),runtime_ms:0,
    peak_vram_bytes:0}
  task.scope{
    var jobs:array<task<generation.Outcome>> = [task.spawn(job,fn=generation.run)]
    loop{
      match channel.recv_now(receiver,time.monotonic_ns()){
        ok(value)=>match value{some(item)=>{var update=item
          match channel.text_of(update){some(message)=>{io.write(str.view(message))
            io.write("\n")},none=>{}}},none=>{}},err(_)=>{}}
      match task.wait_any(jobs,0){some(_)=>{completed=task.join(option.unwrap(
        array.pop(jobs)))
        break},none=>{time.sleep_ms(50)}}
    }
  }
  let _=channel.close(receiver)
  io.write(text.concat("result=",text.concat(if completed.succeeded{"success"}
    else{"failure"},"\n")))
  io.write(text.concat("output=",text.concat(struct.borrow(completed,field=output),"\n")))
  io.write(text.concat("message=",text.concat(struct.borrow(completed,field=message),"\n")))
  if completed.succeeded{0}else{1}
}
