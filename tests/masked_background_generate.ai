// Native Ref2VA background-removal proposal used by masked replacement
// acceptance. The final compositor, not this full-frame proposal, owns source
// preservation outside the authored subject region.
module app.mm_air.tests.masked_background_generate

import "../generate.ai" as generation
import std.inference.h3.media as media
import std.inference.h3.session as session
import std.channel as channel
import std.text as text

fn failure(message:str)->i32 effects {io.write} {
  io.ewrite(message)
  io.ewrite("\n")
  1
}

pub fn main(args:view<str>)->i32
    effects {alloc,env,fs.meta,fs.read,fs.write,gpu,io.write,net,process,thread,time} {
  if view.len(args)!=3{
    io.ewrite("usage: masked-background-generate SOURCE OUTPUT_MP4\n")
    return 2
  }
  var configuration=match generation.configuration(){ok(value)=>value,
    err(problem)=>{return failure(str.view(problem))},}
  let geometry=match media.geometry(48,256,448){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(media.error_message(held)))},}
  var receiver=match channel.open(128,1024){ok(value)=>value,
    err(problem)=>{var held=problem
      return failure(str.view(channel.message(held)))},}
  let prompt="subject_definitions:\n<Video 1>: the exact two-second source scene, framing, camera, architecture, lighting, timing, and synchronized soundtrack authority.\n\nsummary:\n[video editing] Remove the entire main performer from <Video 1> and reconstruct the empty room behind them.\n\nretention_analysis:\n<Video 1>: partially_preserved; preserve the camera, framing, ceiling, wall, floor, lighting, timing, and original audio, but fully erase the performer and every part of their silhouette.\n\ndetailed_description:\n[Shot 1] The room is empty for the complete shot. Reconstruct clean uninterrupted ceiling slats, wall rails, panels, and floor across every area formerly covered by the performer. No person, character, robot, dancer, bow, ears, limbs, shadow, ghost, halo, double contour, or translucent remnant appears. The camera and environment remain stationary and unchanged.\n\noverall_soundscape:\nReuse the synchronized soundtrack from <Video 1> unchanged.\n\nnon_diegetic_music:\nPreserve source music without adding music."
  var references:array<string> = [string.copy(view.get(args,1))]
  var audio:array<string> = []
  var job=generation.job(configuration,prompt,session.Model.Reference,
    session.Task.Ref2VA,geometry,references,audio,view.get(args,2),0,"",424242,19,
    session.Projection.ExactBF16,session.Projection.RowScaledI8,
    session.Attention.DenseInt8,channel.ticket(receiver),session.Schedule.Exponential)
  var completed=generation.Outcome {succeeded:false,output:string.new(),
    message:string.copy("background worker did not complete"),runtime_ms:0,
    peak_vram_bytes:0}
  task.scope {
    var jobs:array<task<generation.Outcome>> = [task.spawn(job,fn=generation.run)]
    loop {
      match channel.recv_now(receiver,time.monotonic_ns()) {
        ok(value)=>match value {some(item)=>{var update=item
          match channel.text_of(update) {some(message)=>{io.write(str.view(message))
            io.write("\n")},none=>{}}},none=>{}},err(_)=>{},
      }
      match task.wait_any(jobs,0) {some(_)=>{
        completed=task.join(option.unwrap(array.pop(jobs)))
        break},none=>{time.sleep_ms(50)},}
    }
  }
  let _=channel.close(receiver)
  io.write(text.concat("result=",text.concat(if completed.succeeded{"success"}
    else{"failure"},"\n")))
  io.write(text.concat("output=",text.concat(struct.borrow(completed,field=output),"\n")))
  io.write(text.concat("message=",text.concat(struct.borrow(completed,field=message),"\n")))
  if completed.succeeded{0}else{1}
}
