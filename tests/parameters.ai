// Generate parameter persistence contract. Requires the refreshed H3 package.
module app.mm_air.tests.parameters
import "h3_presets_fixture.ai" as fixture
import "../parameters.ai" as parameters
import std.inference.h3.request as h3
import std.text as text
import std.json as json

fn qwen_mode(request:ref<parameters.QwenImageRequest>)->string effects {alloc} {
  let encoded=match parameters.encode_qwen_image(request){ok(value)=>value,err(_)=>{return "error"},}
  var document=match json.parse(encoded){ok(value)=>value,err(_)=>{return "error"},}
  let node=option.unwrap(json.get(document,json.root(),"mode"))
  option.unwrap(json.as_string(document,node))
}

fn expect_error(source: str) -> bool effects {alloc} {
  match parameters.decode(source) { ok(_) => false, err(_) => true }
}

fn lora_round_trip() -> bool effects {alloc} {
  var entries: array<parameters.LoraEntry> = [
    parameters.LoraEntry {path:"/tmp/robot.safetensors",strength:0.75,enabled:true},
    parameters.LoraEntry {path:"/tmp/style.SAFETENSORS",strength:-0.25,enabled:false},
    parameters.LoraEntry {path:"/tmp/detail.safetensors",strength:1.5,enabled:false}]
  var request = parameters.KreaRequest {prompt:"robot",seed:42,width:1024,height:1024,
    output:"/tmp/robot.png",loras:parameters.clone_loras(entries)}
  var encoded = match parameters.encode_krea(request) { ok(v) => v,err(_) => { return false }, }
  var restored = match parameters.decode_krea(encoded) { ok(v) => v,err(_) => { return false }, }
  let copies = struct.borrow(restored,field=loras)
  if array.len(copies) != 3 { return false }
  var index: u64 = 0
  loop {
    if index >= 3 { break }
    let expected = array.borrow(entries,index)
    let actual = array.borrow(copies,index)
    if str.view(struct.borrow(actual,field=path)) != str.view(struct.borrow(expected,field=path)) or actual.strength != expected.strength or
       actual.enabled != expected.enabled { return false }
    index = index + 1
  }
  // Clone owns independent rows, including disabled entries for saved UI state.
  struct.set(array.borrow(entries,0),9.0,field=strength)
  if array.borrow(copies,0).strength != 0.75 { return false }
  // Several enabled LoRAs are valid; each runs at its own strength.
  struct.set(array.borrow(entries,1),true,field=enabled)
  match parameters.validate_loras(entries) { ok(_) => {},err(_) => { return false }, }
  struct.set(array.borrow(entries,1),false,field=enabled)
  let legacy: str = "{\"schema\":\"mm-air.krea2.parameters\",\"version\":1,\"model\":\"krea2-turbo\",\"prompt\":\"robot\",\"seed\":42,\"width\":1024,\"height\":1024,\"steps\":8,\"precision\":\"bf16\",\"output\":\"/tmp/robot.png\"}"
  var old = match parameters.decode_krea(legacy) { ok(v) => v,err(_) => { return false }, }
  if array.len(struct.borrow(old,field=loras)) != 0 { return false }
  let invalid_path = text.replace(encoded,"robot.safetensors","robot.ckpt")
  match parameters.decode_krea(invalid_path) { ok(_) => { return false },err(_) => {}, }
  let invalid_scale = text.replace(encoded,"0.75","1e100")
  match parameters.decode_krea(invalid_scale) { ok(_) => { return false },err(_) => {}, }
  let outside_ui = text.replace(encoded,"0.75","25")
  match parameters.decode_krea(outside_ui) { ok(_) => { return false },err(_) => {}, }
  let below_ui = text.replace(encoded,"0.75","-10.01")
  match parameters.decode_krea(below_ui) { ok(_) => { return false },err(_) => {}, }
  let minimum_ui = text.replace(encoded,"0.75","-10")
  match parameters.decode_krea(minimum_ui) { ok(_) => {},err(_) => { return false }, }
  let maximum_ui = text.replace(encoded,"0.75","10")
  match parameters.decode_krea(maximum_ui) { ok(_) => {},err(_) => { return false }, }
  let invalid_toggle = text.replace(encoded,"\"enabled\":true","\"enabled\":1")
  match parameters.decode_krea(invalid_toggle) { ok(_) => { return false },err(_) => {}, }
  let malformed = text.replace(legacy,"\"output\":","\"loras\":{},\"output\":")
  match parameters.decode_krea(malformed) { ok(_) => { return false },err(_) => {}, }
  let null_loras = text.replace(legacy,"\"output\":","\"loras\":null,\"output\":")
  match parameters.decode_krea(null_loras) { ok(_) => { return false },err(_) => {}, }
  let missing_strength = text.replace(encoded,"\"strength\":0.75,","")
  match parameters.decode_krea(missing_strength) { ok(_) => { return false },err(_) => {}, }
  let infinity_bits: u64 = 9218868437227405312
  let infinity: f64 = cast.bits(infinity_bits)
  struct.set(array.borrow(entries,0),infinity,field=strength)
  match parameters.validate_loras(entries) { ok(_) => { return false },err(_) => {}, }
  true
}

fn h3_lora_round_trip() -> bool effects {alloc} {
  var refs: array<string> = []
  var request = h3.request("eri_with_trigger walking through a garden",0,0,2,
    h3.projection_exact_bf16(),h3.projection_row_scaled_int8(),2,42,6,refs,
    "/tmp/mm-air-h3-lora.mp4")
  match h3.set_geometry(request,512,512,124.0/24.0) {
    ok(_) => {},err(_) => { return false },
  }
  var loras: array<parameters.LoraEntry> = [parameters.LoraEntry {
    path:"/tmp/eri_with_trigger.safetensors",strength:1.0,enabled:true}]
  let encoded = match parameters.encode_h3(request,loras) {
    ok(value) => value,err(_) => { return false },
  }
  var restored = match parameters.decode_h3(encoded) {
    ok(value) => value,err(_) => { return false },
  }
  let restored_loras = struct.borrow(restored,field=loras)
  if array.len(restored_loras) != 1 { return false }
  let restored_lora = array.borrow(restored_loras,0)
  if str.view(struct.borrow(restored_lora,field=path)) !=
      "/tmp/eri_with_trigger.safetensors" or restored_lora.strength != 1.0 or
      not restored_lora.enabled { return false }
  let restored_request = struct.borrow(restored,field=request)
  if restored_request.geometry.frames != 124 or
      restored_request.transformer_projection != h3.projection_row_scaled_int8() {
    return false
  }
  // Older H3 snapshots remain loadable and produce an empty LoRA list.
  let legacy = match parameters.encode(request) {
    ok(value) => value,err(_) => { return false },
  }
  var old = match parameters.decode_h3(legacy) {
    ok(value) => value,err(_) => { return false },
  }
  if array.len(struct.borrow(old,field=loras)) != 0 { return false }
  let invalid = text.replace(encoded,"eri_with_trigger.safetensors","eri_with_trigger.ckpt")
  match parameters.decode_h3(invalid) {
    ok(_) => { return false },err(_) => {},
  }
  true
}

fn geometry_round_trip(width: u64, height: u64, seconds: f64,
                       frames: u64) -> bool effects {alloc} {
  var refs: array<string> = []
  var request = h3.request("fractional duration", 0, 0, 2, 2, 2, 2,
    42, 6, refs, "/tmp/mm-air-fractional-parameters.mp4")
  match h3.set_geometry(request, width, height, seconds) {
    ok(_) => {}, err(_) => { return false },
  }
  let encoded = match parameters.encode(request) {
    ok(value) => value, err(_) => { return false },
  }
  var decoded: h3.Request = match parameters.decode(encoded) {
    ok(value) => value, err(_) => { return false },
  }
  decoded.geometry.width == width and decoded.geometry.height == height and
    decoded.geometry.frames == frames and decoded.seconds == seconds
}

pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.read,io.write} {
  if not lora_round_trip() { return 1 }
  if not h3_lora_round_trip() { return 1 }
  var krea = parameters.KreaRequest {prompt:"mechanical robot reference",seed:9007199254740993,
    width:1024,height:1024,output:"/tmp/mm-air-krea.png",loras:[]}
  let krea_json = match parameters.encode_krea(krea) { ok(value) => value,err(_) => { return 1 }, }
  if not parameters.is_krea(krea_json) or parameters.is_krea("{}") { return 1 }
  var krea_restored = match parameters.decode_krea(krea_json) { ok(value) => value,err(_) => { return 1 }, }
  if krea_restored.seed != 9007199254740993 or krea_restored.width != 1024 or
     krea_restored.height != 1024 or krea_restored.prompt != "mechanical robot reference" or
     krea_restored.output != "/tmp/mm-air-krea.png" { return 1 }
  match parameters.validate_krea(krea_restored) { ok(_) => {},err(_) => { return 1 }, }
  struct.set(krea_restored,832,field=width)
  struct.set(krea_restored,560,field=height)
  match parameters.validate_krea(krea_restored) { ok(_) => {},err(_) => { return 1 }, }
  let custom_krea=match parameters.encode_krea(krea_restored){ok(value)=>value,err(_)=>{return 1}}
  var custom_restored=match parameters.decode_krea(custom_krea){ok(value)=>value,err(_)=>{return 1}}
  if custom_restored.width!=832 or custom_restored.height!=560{return 1}
  struct.set(krea_restored,833,field=width)
  match parameters.validate_krea(krea_restored) { ok(_) => { return 1 },err(_) => {}, }
  let unsupported = match parameters.encode_krea(krea_restored) { ok(value) => value,err(_) => { return 1 }, }
  match parameters.decode_krea(unsupported) { ok(_) => { return 1 },err(_) => {}, }
  var qwen=parameters.QwenImageRequest{prompt:"make the dancer a copper robot",
    output:"/tmp/qwen-edit.png",source:"/tmp/source.png",
    references:["/tmp/style.png","/tmp/identity.png"],width:2048,height:2048,
    steps:24,seed:42,scheduler:1,sampler:1,enhance:false,loras:[]}
  let qwen_json=match parameters.encode_qwen_image(qwen){
    ok(value)=>value,err(_)=>{return 1},}
  if not parameters.is_qwen_image(qwen_json) or parameters.is_qwen_image("{}"){return 1}
  if not text.contains(qwen_json,"\"noise_schedule\":\"Linear Flow\"") or
     not text.contains(qwen_json,"\"solver\":\"DPM++ 2M\""){return 1}
  var qwen_restored=match parameters.decode_qwen_image(qwen_json){
    ok(value)=>value,err(_)=>{return 1},}
  if qwen_restored.prompt!="make the dancer a copper robot" or
     qwen_restored.output!="/tmp/qwen-edit.png" or
     qwen_restored.source!="/tmp/source.png" or qwen_restored.width!=2048 or
     array.len(struct.borrow(qwen_restored,field=references))!=2 or
     str.view(array.borrow(struct.borrow(qwen_restored,field=references),0))!="/tmp/style.png" or
     str.view(array.borrow(struct.borrow(qwen_restored,field=references),1))!="/tmp/identity.png" or
     qwen_restored.height!=2048 or qwen_restored.steps!=24 or
     qwen_restored.seed!=42 or qwen_restored.scheduler!=1 or
     qwen_restored.sampler!=1{return 1}
  var qwen_jpeg=parameters.QwenImageRequest{prompt:"make the dancer a copper robot",
    output:"/tmp/qwen-edit.png",source:"/tmp/source.jpg",
    references:["/tmp/style.jpeg","/tmp/identity.webp"],
    width:2048,height:2048,
    steps:40,seed:42,scheduler:0,sampler:0,enhance:false,loras:[]}
  match parameters.validate_qwen_image(qwen_jpeg){
    ok(_)=>{},err(_)=>{return 1},}
  if qwen_mode(qwen_jpeg)!="edit" or parameters.qwen_condition_count(qwen_jpeg)!=3{return 1}
  let _=ref.swap(struct.borrow(qwen_jpeg,field=source),string.new())
  if qwen_mode(qwen_jpeg)!="edit" or parameters.qwen_condition_count(qwen_jpeg)!=2{return 1}
  let _=ref.swap(struct.borrow(qwen_jpeg,field=references),array.new())
  if qwen_mode(qwen_jpeg)!="t2i" or parameters.qwen_condition_count(qwen_jpeg)!=0{return 1}
  struct.set(qwen_jpeg,896,field=width)
  struct.set(qwen_jpeg,640,field=height)
  let custom_qwen=match parameters.encode_qwen_image(qwen_jpeg){ok(value)=>value,err(_)=>{return 1}}
  var custom_qwen_restored=match parameters.decode_qwen_image(custom_qwen){ok(value)=>value,err(_)=>{return 1}}
  if custom_qwen_restored.width!=896 or custom_qwen_restored.height!=640{return 1}
  var qwen_invalid=parameters.QwenImageRequest{prompt:"make the dancer a copper robot",
    output:"/tmp/qwen-edit.png",source:"/tmp/source.gif",references:array.new(),
    width:2048,height:2048,steps:40,seed:42,scheduler:0,sampler:0,enhance:false,loras:[]}
  match parameters.validate_qwen_image(qwen_invalid){ok(_)=>{return 1},err(_)=>{},}
  var too_many: array<string> = array.new()
  var source_index:u64=0
  loop{
    if source_index==10{break}
    array.push(too_many,"/tmp/extra.png")
    source_index=source_index+1
  }
  var qwen_too_many=parameters.QwenImageRequest{prompt:"edit",
    output:"/tmp/qwen-edit.png",source:"/tmp/source.png",references:too_many,
    width:2048,height:2048,steps:40,seed:42,scheduler:0,sampler:0,enhance:false,loras:[]}
  match parameters.validate_qwen_image(qwen_too_many){
    ok(_)=>{return 1},err(_)=>{},}
  if not expect_error(krea_json) { return 1 }
  var dc_request = h3.request("explicit DC recipe", 1, 3,
    h3.profile_dc_euler_19(), h3.projection_exact_bf16(),
    h3.projection_row_scaled_int8(), h3.attention_dense_int8(),
    7311, 3, ["robot.png"], "/tmp/mm-air-dc.mp4")
  var presets: h3.Presets = fixture.presets()
  fixture.with_preset_geometry(presets, dc_request)
  let dc_json = match parameters.encode(dc_request) { ok(value) => value,err(_) => { return 1 }, }
  var dc_restored = match parameters.decode(dc_json) { ok(value) => value,err(_) => { return 1 }, }
  if dc_restored.profile != 3 or dc_restored.conditioner_projection != 1 or
     dc_restored.transformer_projection != 3 or dc_restored.attention != 3 or
     h3.evaluations(presets, dc_restored.profile) != 19 { return 1 }
  match h3.validate(dc_restored) { ok(_) => {},err(_) => { return 1 }, }
  var refs: array<string> = []
  var i: u64 = 0
  loop {
    if i == 9 { break }
    array.push(refs, text.concat("visual-", string.from_int(i)))
    i = i + 1
  }
  var request = h3.request("robot speaking to an injured ally", 1, 3, 1, 2, 2, 1,
    9007199254740993, 6, refs, "/tmp/mm-air-parameters.mp4")
  match h3.set_geometry(request, 960, 544, 10.0) { ok(_) => {}, err(_) => { return 1 } }
  var audio: array<string> = ["audio-0.wav", "audio-1.wav", "audio-2.wav"]
  let _ = ref.swap(struct.borrow(request, field=audio_references), audio)
  let encoded = match parameters.encode(request) { ok(v) => v, err(_) => { return 1 } }
  var decoded: h3.Request = match parameters.decode(encoded) { ok(v) => v, err(_) => { return 1 } }
  if decoded.geometry.width != 960 or decoded.geometry.height != 544 or
      decoded.seconds != 10.0 or array.len(struct.borrow(decoded, field=references)) != 9 or
      array.len(struct.borrow(decoded, field=audio_references)) != 3 or
      decoded.seed != 9007199254740993 or decoded.model != 1 or decoded.task != 3 or
      decoded.profile != 1 or decoded.conditioner_projection != 2 or
      decoded.transformer_projection != 2 or decoded.attention != 1 or decoded.resolution != 6 or
      str.view(struct.borrow(decoded, field=prompt)) != "robot speaking to an injured ally" or
      str.view(struct.borrow(decoded, field=output)) != "/tmp/mm-air-parameters.mp4" { return 1 }
  i = 0
  loop {
    if i == 9 { break }
    if str.view(array.borrow(struct.borrow(decoded, field=references), i)) !=
       str.view(array.borrow(struct.borrow(request, field=references), i)) { return 1 }
    i = i + 1
  }
  i = 0
  loop {
    if i == 3 { break }
    if str.view(array.borrow(struct.borrow(decoded, field=audio_references), i)) !=
       str.view(array.borrow(struct.borrow(request, field=audio_references), i)) { return 1 }
    i = i + 1
  }
  array.push(struct.borrow(request, field=audio_references), "fourth.wav")
  let excessive_audio = match parameters.encode(request) { ok(v) => v, err(_) => { return 1 } }
  if not expect_error(excessive_audio) { return 1 }
  array.push(struct.borrow(decoded, field=references), "tenth.png")
  let excessive_visual = match parameters.encode(decoded) { ok(v) => v, err(_) => { return 1 } }
  if not expect_error(excessive_visual) { return 1 }
  if not expect_error("{}") { return 1 }
  // A saved FLUX 3 Image Klein file (model removed 2026-11-05) is recognized by its schema and
  // read by no current model's decoder.
  let flux3_saved="{\"schema\":\"mm-air.flux3-klein.parameters\",\"prompt\":\"a red fox\",\"references\":[],\"width\":1024,\"height\":1024,\"steps\":16,\"seed\":7,\"upsample\":false}"
  if not parameters.is_retired_flux3(flux3_saved) { return 1 }
  if parameters.is_qwen_image(flux3_saved) or parameters.is_krea(flux3_saved) or parameters.is_flux1(flux3_saved) { return 1 }
  if not expect_error(flux3_saved) { return 1 }
  if parameters.is_retired_flux3("{\"schema\":\"mm-air.krea2.parameters\"}") { return 1 }
  // MOSS-Image: dropdown positions, defaults, save/restore with a LoRA, refusals.
  if parameters.moss_base_model_index()!=4 or parameters.moss_sft_model_index()!=5 { return 1 }
  if not parameters.image_model(4) or not parameters.image_model(5) or parameters.image_model(1) { return 1 }
  if parameters.flux1_model_index()<=5 { return 1 }
  var moss=parameters.moss_defaults(parameters.moss_sft_model_index())
  if moss.steps!=50 or moss.cfg!=3.0 or moss.shift!=5.0 or moss.fast { return 1 }
  let _=ref.swap(struct.borrow(moss,field=prompt),string.copy("a lighthouse at dusk"))
  let _=ref.swap(struct.borrow(moss,field=output),string.copy("/tmp/moss.png"))
  let _=ref.swap(struct.borrow(moss,field=negative),string.copy("blurry"))
  let _=ref.swap(struct.borrow(moss,field=loras),[parameters.LoraEntry{path:"/tmp/style.safetensors",strength:0.8,enabled:true}])
  struct.set(moss,true,field=fast)
  struct.set(moss,1344,field=width)
  struct.set(moss,768,field=height)
  let moss_json=match parameters.encode_moss(moss){ok(value)=>value,err(_)=>{return 1},}
  if not parameters.is_moss(moss_json) or parameters.is_qwen_image(moss_json) or parameters.is_krea(moss_json) or
     parameters.is_retired_flux3(moss_json) { return 1 }
  var moss_back=match parameters.decode_moss(moss_json){ok(value)=>value,err(_)=>{return 1},}
  if moss_back.model!="moss-image-sft" or moss_back.negative!="blurry" or not moss_back.fast or
     moss_back.width!=1344 or moss_back.height!=768 or array.len(struct.borrow(moss_back,field=loras))!=1 { return 1 }
  match parameters.moss_model_index_of(str.view(struct.borrow(moss_back,field=model))){
    some(value)=>{if value!=parameters.moss_sft_model_index(){return 1}},none=>{return 1},}
  struct.set(moss,1000,field=width)
  match parameters.validate_moss(moss){ok(_)=>{return 1},err(_)=>{},}
  struct.set(moss,1344,field=width)
  let _=ref.swap(struct.borrow(moss,field=model),string.copy("moss-image-edit"))
  match parameters.validate_moss(moss){ok(_)=>{return 1},err(_)=>{},}
  // MOSS image prompt: add / remove pictures, strengths in hundredths, round trip, refusals, old files.
  var prompted=parameters.copy_moss(moss_back)
  if array.len(struct.borrow(prompted,field=prompt_images))!=0 or prompted.text_strength!=1.0 or prompted.vision_size!=384 { return 1 }
  match parameters.moss_add_picture(prompted,"/tmp/a.png"){ok(_)=>{},err(_)=>{return 1},}
  match parameters.moss_add_picture(prompted,"/tmp/b.JPG"){ok(_)=>{},err(_)=>{return 1},}
  match parameters.moss_add_picture(prompted,"/tmp/c.gif"){ok(_)=>{return 1},err(_)=>{},}
  match parameters.moss_add_picture(prompted,"rel.png"){ok(_)=>{return 1},err(_)=>{},}
  if array.get(struct.borrow(prompted,field=prompt_strength_percent),0)!=5 { return 1 }
  array.set(struct.borrow(prompted,field=prompt_strength_percent),1,20)
  struct.set(prompted,0.5,field=text_strength)
  struct.set(prompted,512,field=vision_size)
  let prompted_json=match parameters.encode_moss(prompted){ok(value)=>value,err(_)=>{return 1},}
  var prompted_back=match parameters.decode_moss(prompted_json){ok(value)=>value,err(_)=>{return 1},}
  if array.len(struct.borrow(prompted_back,field=prompt_images))!=2 or
     array.borrow(struct.borrow(prompted_back,field=prompt_images),1)!="/tmp/b.JPG" or
     array.get(struct.borrow(prompted_back,field=prompt_strength_percent),1)!=20 or
     prompted_back.text_strength!=0.5 or prompted_back.vision_size!=512 { return 1 }
  parameters.moss_remove_picture(prompted_back,0)
  if array.len(struct.borrow(prompted_back,field=prompt_images))!=1 or
     array.borrow(struct.borrow(prompted_back,field=prompt_images),0)!="/tmp/b.JPG" or
     array.get(struct.borrow(prompted_back,field=prompt_strength_percent),0)!=20 { return 1 }
  var five=parameters.copy_moss(prompted)
  array.push(struct.borrow(five,field=prompt_images),string.copy("/tmp/c.png"))
  array.push(struct.borrow(five,field=prompt_strength_percent),5)
  array.push(struct.borrow(five,field=prompt_images),string.copy("/tmp/d.png"))
  array.push(struct.borrow(five,field=prompt_strength_percent),5)
  array.push(struct.borrow(five,field=prompt_images),string.copy("/tmp/e.png"))
  array.push(struct.borrow(five,field=prompt_strength_percent),5)
  match parameters.validate_moss(five){ok(_)=>{return 1},err(_)=>{},}
  struct.set(prompted,2048,field=vision_size)
  match parameters.validate_moss(prompted){ok(_)=>{return 1},err(_)=>{},}
  // a file saved before the image prompt existed still decodes, with no pictures
  let old_json="{\"schema\":\"mm-air.moss-image.parameters.v1\",\"request\":{\"model\":\"moss-image-sft\",\"prompt\":\"a lighthouse\",\"negative\":\"\",\"output\":\"/tmp/moss.png\",\"width\":1024,\"height\":1024,\"steps\":50,\"cfg\":3.0,\"shift\":5.0,\"seed\":42,\"fast\":false,\"loras\":[]}}"
  var old_back=match parameters.decode_moss(old_json){ok(value)=>value,err(_)=>{return 1},}
  if array.len(struct.borrow(old_back,field=prompt_images))!=0 or old_back.text_strength!=1.0 or
     old_back.vision_size!=384 or old_back.prompt!="a lighthouse" { return 1 }
  // Fibo 2.0: Dev on Generate (index 6), Edit Turbo on Image Edit; defaults, round trip, refusals.
  if parameters.fibo_dev_model_index()!=6 or not parameters.image_model(6) or parameters.image_model(9) { return 1 }
  if parameters.h3image_model_index()!=7 or not parameters.image_model(7) or not parameters.uses_image_geometry(7) { return 1 }
  var fibo=parameters.fibo_defaults_for(false)
  if fibo.steps!=50 or fibo.guidance!=5.0 or fibo.width!=1024 { return 1 }
  let _=ref.swap(struct.borrow(fibo,field=prompt),string.copy("a red fox in snow"))
  let _=ref.swap(struct.borrow(fibo,field=output),string.copy("/tmp/fibo.png"))
  let fibo_json=match parameters.encode_fibo(fibo){ok(value)=>value,err(_)=>{return 1},}
  if not parameters.is_fibo(fibo_json) or parameters.is_moss(fibo_json) or parameters.is_qwen_image(fibo_json) { return 1 }
  array.push(struct.borrow(fibo,field=images),"/tmp/source.png")
  match parameters.validate_fibo(fibo){ok(_)=>{return 1},err(_)=>{},}
  var fibo_edit=parameters.fibo_defaults_for(true)
  if fibo_edit.steps!=4 or fibo_edit.guidance!=1.0 or fibo_edit.width!=0 { return 1 }
  let _=ref.swap(struct.borrow(fibo_edit,field=prompt),string.copy("make the sky orange"))
  let _=ref.swap(struct.borrow(fibo_edit,field=output),string.copy("/tmp/fibo-edit.png"))
  match parameters.validate_fibo(fibo_edit){ok(_)=>{return 1},err(_)=>{},}
  array.push(struct.borrow(fibo_edit,field=images),"/tmp/source.png")
  array.push(struct.borrow(fibo_edit,field=images),"/tmp/reference.jpg")
  let edit_json=match parameters.encode_fibo(fibo_edit){ok(value)=>value,err(_)=>{return 1},}
  var edit_back=match parameters.decode_fibo(edit_json){ok(value)=>value,err(_)=>{return 1},}
  if not parameters.fibo_is_edit(edit_back) or array.len(struct.borrow(edit_back,field=images))!=2 or edit_back.width!=0 { return 1 }
  array.push(struct.borrow(fibo_edit,field=images),"/tmp/c.webp")
  match parameters.validate_fibo(fibo_edit){ok(_)=>{return 1},err(_)=>{},}
  // MiniMax H3-Image: one request for text to image and edit; codes 61+ name the failing check.
  // The H3-Image size list: every entry inside the model's 4-20 MP range, sides in 32-pixel steps,
  // each found again by its size, and the default is 2048x2048.
  var size_index:u64=0
  loop{if size_index>=parameters.h3image_size_count(){break}
    let size=parameters.h3image_size(size_index)
    if size.width%32!=0 or size.height%32!=0 { return 1 }
    if size.width*size.height<3900000 or size.width*size.height>parameters.h3image_max_pixels() { return 1 }
    if parameters.h3image_size_index(size.width,size.height)!=size_index { return 1 }
    size_index=size_index+1}
  if parameters.h3image_size_index(1024,1024)!=parameters.h3image_size_count() { return 1 }
  let default_size=parameters.h3image_size(parameters.h3image_default_size_index())
  if default_size.width!=2048 or default_size.height!=2048 { return 1 }
  if parameters.h3image_defaults().width!=2048 or parameters.h3image_defaults().height!=2048 { return 1 }
  var wide=parameters.h3image_defaults()
  let _=ref.swap(struct.borrow(wide,field=prompt),string.copy("a lighthouse at dusk"))
  let _=ref.swap(struct.borrow(wide,field=output),string.copy("/tmp/h3image.png"))
  let wide_json=match parameters.encode_h3image(wide){ok(value)=>value,err(_)=>{return 61},}
  if not parameters.is_h3image(wide_json) or parameters.is_fibo(wide_json) or parameters.is_moss(wide_json) or
     parameters.is_qwen_image(wide_json) { return 62 }
  var wide_back=match parameters.decode_h3image(wide_json){ok(value)=>value,err(_)=>{return 63},}
  if parameters.h3image_is_edit(wide_back) or wide_back.width!=2048 or wide_back.seed!=42 or wide_back.expander!="off" { return 64 }
  // the Qwen3-VL expander is for edits only; an unknown name is refused
  let _=ref.swap(struct.borrow(wide,field=expander),string.copy("qwen"))
  match parameters.validate_h3image(wide){ok(_)=>{return 65},err(_)=>{},}
  let _=ref.swap(struct.borrow(wide,field=expander),string.copy("xhigh"))
  match parameters.validate_h3image(wide){ok(_)=>{},err(_)=>{return 66},}
  // an edit takes 1 to 16 pictures; width and height 0 keep the first picture's size
  var wide_edit=parameters.h3image_defaults()
  let _=ref.swap(struct.borrow(wide_edit,field=prompt),string.copy("Make it rain in Picture 1"))
  let _=ref.swap(struct.borrow(wide_edit,field=output),string.copy("/tmp/h3image-edit.png"))
  let _=ref.swap(struct.borrow(wide_edit,field=expander),string.copy("qwen"))
  struct.set(wide_edit,0,field=width)
  struct.set(wide_edit,0,field=height)
  match parameters.validate_h3image(wide_edit){ok(_)=>{return 67},err(_)=>{},}
  var picture:u64=0
  loop{
    if picture>=16{break}
    array.push(struct.borrow(wide_edit,field=images),text.concat("/tmp/p",str.view(text.concat(str.view(string.from_int(cast.sat(picture))),".png"))))
    picture=picture+1
  }
  let wide_edit_json=match parameters.encode_h3image(wide_edit){ok(value)=>value,err(_)=>{return 68},}
  var wide_edit_back=match parameters.decode_h3image(wide_edit_json){ok(value)=>value,err(_)=>{return 69},}
  if not parameters.h3image_is_edit(wide_edit_back) or array.len(struct.borrow(wide_edit_back,field=images))!=16 or
     wide_edit_back.width!=0 or wide_edit_back.expander!="qwen" { return 70 }
  array.push(struct.borrow(wide_edit,field=images),"/tmp/p16.png")
  match parameters.validate_h3image(wide_edit){ok(_)=>{return 71},err(_)=>{},}
  // size limits: 20 megapixels at most
  struct.set(wide,5000,field=width)
  struct.set(wide,5000,field=height)
  match parameters.validate_h3image(wide){ok(_)=>{return 72},err(_)=>{},}
  struct.set(wide,4096,field=width)
  struct.set(wide,4096,field=height)
  match parameters.validate_h3image(wide){ok(_)=>{},err(_)=>{return 73},}
  // P-H3-Image: a new place on the model list (8); the places before it are unchanged. Codes 81+ name the failing check.
  if parameters.ph3image_model_index()!=8 or not parameters.image_model(8) or parameters.uses_image_geometry(8) { return 81 }
  if parameters.h3image_model_index()!=7 or parameters.fibo_dev_model_index()!=6 or parameters.moss_sft_model_index()!=5 or
     parameters.moss_base_model_index()!=4 or parameters.qwen_image_model_index()!=3 or parameters.krea_model_index()!=2 { return 82 }
  // the two size lists: sides in 32-pixel steps, each found again by its size; the default is 2912x2912
  var tall_index:u64=0
  loop{if tall_index>=parameters.ph3image_size_count(){break}
    let size=parameters.ph3image_size(tall_index)
    if size.width%32!=0 or size.height%32!=0 or size.width*size.height>parameters.ph3image_max_pixels() { return 83 }
    if parameters.ph3image_size_index(size.width,size.height)!=tall_index { return 83 }
    let edit_size=parameters.ph3image_edit_size(tall_index)
    if edit_size.width%32!=0 or edit_size.height%32!=0 { return 84 }
    if parameters.ph3image_edit_size_index(edit_size.width,edit_size.height)!=tall_index { return 84 }
    tall_index=tall_index+1}
  if parameters.ph3image_size_count()!=7 or parameters.ph3image_edit_size_count()!=7 { return 85 }
  if parameters.ph3image_size_index(1024,1024)!=7 or parameters.ph3image_edit_size_index(2912,2912)!=7 { return 85 }
  if parameters.ph3image_size(6).width!=2176 or parameters.ph3image_size(6).height!=3872 or
     parameters.ph3image_edit_size(0).width!=2048 or parameters.ph3image_edit_size(6).height!=2720 { return 85 }
  var tall=parameters.ph3image_defaults()
  if tall.width!=2912 or tall.height!=2912 or not tall.upsample { return 86 }
  let _=ref.swap(struct.borrow(tall,field=prompt),string.copy("a lighthouse at dusk"))
  let _=ref.swap(struct.borrow(tall,field=output),string.copy("/out/ph3image.png"))
  let tall_json=match parameters.encode_ph3image(tall){ok(value)=>value,err(_)=>{return 87},}
  if not parameters.is_ph3image(tall_json) or parameters.is_h3image(tall_json) or parameters.is_fibo(tall_json) or
     parameters.is_moss(tall_json) or parameters.is_qwen_image(tall_json) or parameters.is_ph3image(wide_json) { return 88 }
  var tall_back=match parameters.decode_ph3image(tall_json){ok(value)=>value,err(_)=>{return 89},}
  if parameters.ph3image_is_edit(tall_back) or tall_back.width!=2912 or tall_back.seed!=42 or not tall_back.upsample { return 90 }
  struct.set(tall,false,field=upsample)
  let tall_off=match parameters.encode_ph3image(tall){ok(value)=>value,err(_)=>{return 91},}
  var tall_off_back=match parameters.decode_ph3image(tall_off){ok(value)=>value,err(_)=>{return 91},}
  if tall_off_back.upsample { return 91 }
  // Custom: multiples of 32, up to the largest listed area
  struct.set(tall,1024,field=width)
  struct.set(tall,1024,field=height)
  match parameters.validate_ph3image(tall){ok(_)=>{},err(_)=>{return 92},}
  struct.set(tall,1000,field=width)
  match parameters.validate_ph3image(tall){ok(_)=>{return 93},err(_)=>{},}
  struct.set(tall,4096,field=width)
  struct.set(tall,4096,field=height)
  match parameters.validate_ph3image(tall){ok(_)=>{return 94},err(_)=>{},}
  // an edit takes 1 to 8 pictures; width and height 0 keep Picture 1's size, else a listed edit size
  var tall_edit=parameters.ph3image_defaults()
  let _=ref.swap(struct.borrow(tall_edit,field=prompt),string.copy("Make it rain in Picture 1"))
  let _=ref.swap(struct.borrow(tall_edit,field=output),string.copy("/out/ph3image-edit.png"))
  struct.set(tall_edit,0,field=width)
  struct.set(tall_edit,0,field=height)
  match parameters.validate_ph3image(tall_edit){ok(_)=>{return 95},err(_)=>{},}
  var tall_picture:u64=0
  loop{
    if tall_picture>=8{break}
    array.push(struct.borrow(tall_edit,field=images),text.concat("/in/p",str.view(text.concat(str.view(string.from_int(cast.sat(tall_picture))),".png"))))
    tall_picture=tall_picture+1
  }
  let tall_edit_json=match parameters.encode_ph3image(tall_edit){ok(value)=>value,err(_)=>{return 96},}
  var tall_edit_back=match parameters.decode_ph3image(tall_edit_json){ok(value)=>value,err(_)=>{return 97},}
  if not parameters.ph3image_is_edit(tall_edit_back) or array.len(struct.borrow(tall_edit_back,field=images))!=8 or
     tall_edit_back.width!=0 or tall_edit_back.height!=0 { return 98 }
  struct.set(tall_edit,2048,field=width)
  struct.set(tall_edit,2048,field=height)
  match parameters.validate_ph3image(tall_edit){ok(_)=>{},err(_)=>{return 99},}
  struct.set(tall_edit,2912,field=width)
  struct.set(tall_edit,2912,field=height)
  match parameters.validate_ph3image(tall_edit){ok(_)=>{return 100},err(_)=>{},}
  struct.set(tall_edit,0,field=width)
  struct.set(tall_edit,0,field=height)
  array.push(struct.borrow(tall_edit,field=images),"/in/p8.png")
  match parameters.validate_ph3image(tall_edit){ok(_)=>{return 111},err(_)=>{},}
  // an H3-Image file is not read as P-H3-Image and the other way round
  match parameters.decode_ph3image(wide_json){ok(_)=>{return 102},err(_)=>{},}
  match parameters.decode_h3image(tall_json){ok(_)=>{return 103},err(_)=>{},}
  // Sampler controls (Sampler / Schedule / Noise / Bong math). Codes 41+ name the failing check.
  // A MOSS file saved before the fields reads as Default (ER-SDE) with the field defaults.
  let moss_old="{\"schema\":\"mm-air.moss-image.parameters.v1\",\"request\":{\"model\":\"moss-image-base\",\"prompt\":\"a cat\",\"negative\":\"\",\"output\":\"/tmp/m.png\",\"width\":1024,\"height\":1024,\"steps\":50,\"cfg\":3.0,\"shift\":5.0,\"seed\":42,\"fast\":false,\"loras\":[],\"prompt_images\":[],\"prompt_strength_percent\":[],\"text_strength\":1.0,\"vision_size\":384}}"
  var moss_old_back=match parameters.decode_moss(moss_old){ok(value)=>value,err(_)=>{return 41},}
  if moss_old_back.sampler!="default" or moss_old_back.schedule!="default" or moss_old_back.eta!=0.5 or not moss_old_back.bongmath { return 42 }
  var moss_cs=parameters.copy_moss(moss_back)
  let _=ref.swap(struct.borrow(moss_cs,field=sampler),string.copy("res_2m"))
  let _=ref.swap(struct.borrow(moss_cs,field=schedule),string.copy("beta57"))
  struct.set(moss_cs,0.25,field=eta)
  struct.set(moss_cs,false,field=bongmath)
  let moss_cs_json=match parameters.encode_moss(moss_cs){ok(value)=>value,err(_)=>{return 43},}
  var moss_cs_back=match parameters.decode_moss(moss_cs_json){ok(value)=>value,err(_)=>{return 44},}
  if moss_cs_back.sampler!="res_2m" or moss_cs_back.schedule!="beta57" or moss_cs_back.eta!=0.25 or moss_cs_back.bongmath { return 45 }
  if not parameters.moss_uses_stepper("res_2m") or parameters.moss_uses_stepper("euler") or parameters.moss_uses_stepper("default") { return 46 }
  struct.set(moss_cs,1.5,field=eta)
  match parameters.validate_moss(moss_cs){ok(_)=>{return 47},err(_)=>{},}
  struct.set(moss_cs,0.5,field=eta)
  let _=ref.swap(struct.borrow(moss_cs,field=sampler),string.copy("nope"))
  match parameters.validate_moss(moss_cs){ok(_)=>{return 48},err(_)=>{},}
  // Fibo: a file without the fields reads as Default; Edit Turbo keeps its own sampler.
  let fibo_old="{\"schema\":\"mm-air.fibo2.parameters.v1\",\"request\":{\"model\":\"fibo-2.0-dev\",\"prompt\":\"a fox\",\"negative\":\"\",\"output\":\"/tmp/f.png\",\"images\":[],\"width\":1024,\"height\":1024,\"steps\":50,\"guidance\":5.0,\"seed\":42,\"loras\":[]}}"
  var fibo_old_back=match parameters.decode_fibo(fibo_old){ok(value)=>value,err(_)=>{return 49},}
  if fibo_old_back.sampler!="default" or not parameters.fibo_uses_stepper("euler") or parameters.fibo_uses_stepper("default") { return 50 }
  var fibo_turbo_cs=parameters.copy_fibo(edit_back)
  let _=ref.swap(struct.borrow(fibo_turbo_cs,field=sampler),string.copy("res_2m"))
  match parameters.validate_fibo(fibo_turbo_cs){ok(_)=>{return 51},err(_)=>{},}
  // Qwen: a version-2 file without the fields (the shape History saved) reads with their defaults.
  let qwen_old="{\"schema\":\"mm-air.qwen-image-2.1.parameters\",\"version\":2,\"model\":\"qwen-image-2.1\",\"mode\":\"edit\",\"prompt\":\"swap\",\"source\":\"/tmp/source.jpg\",\"references\":[\"/tmp/ref.jpg\"],\"output\":\"qwen-image-2.1/edit/qwen-edit-1.png\",\"width\":608,\"height\":896,\"steps\":40,\"scheduler\":0,\"sampler\":0,\"noise_schedule\":\"Dynamic shifted Flow\",\"solver\":\"Euler\",\"seed\":44462283733756777,\"enhance\":false,\"loras\":[{\"path\":\"/tmp/head.safetensors\",\"strength\":1,\"enabled\":true}]}"
  var qwen_old_back=match parameters.decode_qwen_image(qwen_old){ok(value)=>value,err(_)=>{return 52},}
  if qwen_old_back.sampler!=0 or qwen_old_back.schedule!=0 or qwen_old_back.eta!=0.5 or not qwen_old_back.bongmath { return 53 }
  struct.set(qwen_old_back,3,field=sampler)
  struct.set(qwen_old_back,1,field=schedule)
  struct.set(qwen_old_back,0.75,field=eta)
  struct.set(qwen_old_back,false,field=bongmath)
  let _=ref.swap(struct.borrow(qwen_old_back,field=output),string.copy("/tmp/q.png"))
  let qwen_cs_json=match parameters.encode_qwen_image(qwen_old_back){ok(value)=>value,err(_)=>{return 54},}
  if not text.contains(qwen_cs_json,"\"solver\":\"res_2m\"") or not text.contains(qwen_cs_json,"\"schedule_name\":\"beta57\"") { return 55 }
  var qwen_cs_back=match parameters.decode_qwen_image(qwen_cs_json){ok(value)=>value,err(_)=>{return 56},}
  if qwen_cs_back.sampler!=3 or qwen_cs_back.schedule!=1 or qwen_cs_back.eta!=0.75 or qwen_cs_back.bongmath { return 57 }
  struct.set(qwen_cs_back,2,field=scheduler)  // Turbo
  struct.set(qwen_cs_back,8,field=steps)
  match parameters.validate_qwen_image(qwen_cs_back){ok(_)=>{return 58},err(_)=>{},}
  // The Sampler list order maps to the contract codes and back (Euler 0, DPM++ 2M 1, shared 3..11).
  var code:u32=0
  loop{
    if code>11{break}
    if code!=2 and parameters.qwen_sampler_code(parameters.qwen_sampler_index(code))!=code { return 59 }
    code=code+1
  }
  if parameters.qwen_sampler_index(0)!=0 or parameters.qwen_sampler_index(1)!=8 or parameters.qwen_sampler_index(3)!=1 { return 60 }
  if parameters.image_sampler_name(0)!="default" or parameters.image_sampler_name(11)!="euler" or
     parameters.image_sampler_index("dpmpp_2s")!=9 or parameters.sampler_schedule_name(2)!="bong_tangent" { return 61 }
  if not expect_error("{\"schema\":\"mm-air.generate.parameters\",\"version\":99}") { return 1 }
  // Persist the requested fractional seconds, recomputing delivery frames on
  // the native 24 FPS clock when parameters are loaded or reused.
  if not geometry_round_trip(832, 480, 10.25, 246) or
     not geometry_round_trip(960, 544, 7.5, 180) or
     not geometry_round_trip(1344, 768, 5.125, 123) or
     not geometry_round_trip(512, 896, 12.75, 306) or
     not geometry_round_trip(832, 480, 2.3125, 56) {
    return 1
  }
  0
}
