// Face / head / body swap presets for Image Edit (Qwen-Image-2.1 plus a community swap LoRA).
//
// Each entry is one released LoRA file with the instruction it was trained on and the strength
// it was released at. The files are read from MM_AIR_FACE_SWAP_LORA_DIR (deployment setting) and
// applied unmerged beside the resident transformer. Order matches the `qwen_edit_swap_list`
// dropdown in desktop.ui (entry 0 there is "Off"; the tests lock the two together).
// Source: Alissonerdx/BFS-Best-Face-Swap docs/qwen-image-2.1.md and docs/qwen-image-2.1-body.md.
module app.mm_air.face_swap

pub type Preset = struct {label:string,stem:string,prompt:string,strength:f64}

fn head_prompt() -> string effects {alloc} {
  string.copy("head_swap: start with <image1> as the base image, keeping its lighting, environment, and background. remove the head from <image1> completely and replace it with the head from <image2>, strictly preserving the hair, eye color, nose structure from <image2>. copy the direction of the eye, head rotation, micro expressions from <image1>, high quality, sharp details, 4k")
}

fn body_prompt() -> string effects {alloc} {
  string.copy("body_swap: start with <image1> as the base image, keeping its lighting, environment, and background. replace the body from <image1> with the body from <image2>, strictly preserving the clothing, body shape and proportions from <image2>. copy the pose, direction of the eye, head rotation, micro expressions from <image1>")
}

// Number of presets (the dropdown has one more item, "Off", in front).
pub fn count() -> u64 effects {} { 4 }

pub fn preset(index: u64) -> option<Preset> effects {alloc} {
  if index == 0 { return option.some(Preset {label:string.copy("Head swap v1.1"),stem:string.copy("bfs_head_v1.1_qwen_2.1"),prompt:head_prompt(),strength:1.0}) }
  if index == 1 { return option.some(Preset {label:string.copy("Head swap v1.1 alternative"),stem:string.copy("bfs_head_v1.1_alternative_qwen_2.1"),prompt:head_prompt(),strength:1.0}) }
  if index == 2 { return option.some(Preset {label:string.copy("Head swap v1"),stem:string.copy("bfs_head_v1_qwen_2.1"),prompt:head_prompt(),strength:1.0}) }
  if index == 3 { return option.some(Preset {label:string.copy("Body swap v1.0"),stem:string.copy("bfs_body_swap_v1.0_qwen_2.1"),prompt:body_prompt(),strength:1.0}) }
  option.none()
}
