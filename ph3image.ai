// P-H3-Image for MM-Air: text to image (Generate) and edit of 1 to 8 pictures (Image Edit).
// The model runs in this process through AIR's std.inference.ph3image.session; this module only
// resolves the folders, builds the request and reports the result. The prompt upsampler (when on)
// runs inside the session, before the text encoder.
//
// Folders come from the runtime configuration (environment or runtime.json) and fall back to
// ~/models: MM_AIR_PH3IMAGE_ROOT (P-H3-Image), MM_AIR_PH3IMAGE_AIR_ROOT (P-H3-Image-air).
module app.mm_air.ph3image
import std.channel as channel
import std.files as files
import std.path as path
import std.system as system
import std.text as text
import std.inference.ph3image.session as psession
import "generate.ai" as generation
import "parameters.ai" as parameters
import "runtime_config.ai" as runtime_config

pub type PH3ImageJob = struct {request:parameters.PH3ImageRequest,progress:channel.Ticket}

fn present(file:str)->bool effects{fs.meta}{
  match files.exists(file){ok(found)=>found,err(_)=>false,}
}

fn number(value:u64)->string effects{alloc}{string.from_int(cast.sat(value))}

pub fn model_root()->result<string,string> effects{alloc,env,fs.read,fs.meta}{
  match try runtime_config.value("MM_AIR_PH3IMAGE_ROOT"){
    some(value)=>{if text.trim(str.view(value))!=""{return result.ok(value)}},
    none=>{},
  }
  result.ok(match env.get("HOME"){some(home)=>path.join(home,"models/P-H3-Image"),none=>string.new(),})
}
// The prepared files follow the model folder unless the runtime configuration names them.
pub fn air_root()->result<string,string> effects{alloc,env,fs.read,fs.meta}{
  match try runtime_config.value("MM_AIR_PH3IMAGE_AIR_ROOT"){
    some(value)=>{if text.trim(str.view(value))!=""{return result.ok(value)}},
    none=>{},
  }
  let model=try model_root()
  result.ok(psession.default_air_root(str.view(model)))
}

fn all_present(folder:str,names:view<str>)->bool effects{alloc,fs.meta}{
  var index:u64=0
  loop{
    if index>=view.len(names){break}
    if not present(str.view(path.join(folder,view.get(names,index)))){return false}
    index=index+1
  }
  true
}

// Empty when every file the model needs is on this computer; else one short sentence.
pub fn missing(upsample:bool)->string effects{alloc,env,fs.read,fs.meta}{
  let root=match model_root(){ok(value)=>value,err(message)=>{return message},}
  let air=match air_root(){ok(value)=>value,err(message)=>{return message},}
  var model_files:array<str> = ["modular_model_index.json","transformer/config.json","text_encoder/config.json",
    "text_encoder/model.safetensors.index.json","tokenizer/tokenizer.json",
    "text_connector/diffusion_pytorch_model.safetensors","vae/diffusion_pytorch_model.safetensors"]
  if not all_present(str.view(root),array.view(model_files)){
    return string.copy("P-H3-Image is not installed on this computer")
  }
  var prepared:array<str> = ["ph3-convrot-h256-blocks.safetensors","ph3-blocks-convrot.json",
    "ph3-transformer-static.safetensors","ph3-static.json","ph3-token-refiner-bf16.json",
    "ph3-modulation-t2i.safetensors","ph3-modulation-edit.safetensors","ph3-modulation-cache.json"]
  if not all_present(str.view(air),array.view(prepared)){
    return string.copy("P-H3-Image files are not prepared on this computer")
  }
  var text_files:array<str> = ["ph3-text-static.json","ph3-text-layers.json","ph3-text-connector.json",
    "ph3-vision-static.json","ph3-vision-layers.json"]
  if not all_present(str.view(air),array.view(text_files)){
    return string.copy("P-H3-Image text files are missing")
  }
  var picture_files:array<str> = ["ph3-vae-decoder.json","ph3-vae-encoder.json"]
  if not all_present(str.view(air),array.view(picture_files)){
    return string.copy("P-H3-Image picture files are missing")
  }
  if upsample{
    if not present(str.view(path.join(str.view(air),"upsampler-int8/model.safetensors"))) or
        not present(str.view(path.join(str.view(root),"prompt_upsampler_processor/tokenizer.json"))){
      return string.copy("The P-H3-Image prompt upsampler is not installed on this computer")
    }
  }
  string.new()
}

fn failure(output:str,message:str)->generation.Outcome effects{alloc}{
  generation.outcome(false,output,message)
}

pub fn run(job:PH3ImageJob own)->generation.Outcome
    effects{alloc,env,ffi,fs.meta,fs.read,fs.write,gpu,io.write,net,process,time}{
  var owned=job
  var ticket=ref.swap(struct.borrow(owned,field=progress),generation.no_progress())
  var connection=match channel.connect(ticket,time.monotonic_ns()+30000000000){
    ok(value)=>value,
    err(_)=>{return failure(str.view(struct.borrow(struct.borrow(owned,field=request),field=output)),
      "Cannot connect the MM-Air P-H3-Image progress channel")},
  }
  var sender:option<channel.Sender> = option.some(connection)
  var finished=run_inner(struct.borrow(owned,field=request),sender)
  generation.finish_progress(sender,finished)
  finished
}

fn run_inner(request:ref<parameters.PH3ImageRequest>,sender:ref<option<channel.Sender>>)->generation.Outcome
    effects{alloc,env,ffi,fs.meta,fs.read,fs.write,gpu,io.write,net,process,time}{
  let started=time.monotonic_ns()
  let output=string.copy(struct.borrow(request,field=output))
  match parameters.validate_ph3image(request){
    err(message)=>{return failure(str.view(output),message)},ok(_)=>{},
  }
  let edit=parameters.ph3image_is_edit(request)
  let absent=missing(request.upsample)
  if str.len(str.view(absent))>0{return failure(str.view(output),str.view(absent))}
  let root=match model_root(){ok(value)=>value,err(message)=>{return failure(str.view(output),message)},}
  let air=match air_root(){ok(value)=>value,err(message)=>{return failure(str.view(output),message)},}
  let scratch=path.join(system.temp_directory(),"mm-air-ph3image")
  let _made=files.mkdirs(str.view(scratch))

  var images:array<string>=[]
  var image_index:u64=0
  loop{
    if image_index>=array.len(struct.borrow(request,field=images)){break}
    array.push(images,string.copy(str.view(array.borrow(struct.borrow(request,field=images),image_index))))
    image_index=image_index+1
  }

  // The model's own request: 8 steps, no guidance, no negative prompt. width and height 0 (edit) keep
  // Picture 1's size; the session works that out.
  var deployment=psession.Deployment{model_root:root,air_root:air}
  var form=psession.Request{prompt:string.copy(struct.borrow(request,field=prompt)),width:request.width,
    height:request.height,seed:request.seed,output:string.copy(str.view(output)),dump:string.new(),images:images,
    scratch:string.copy(str.view(scratch)),fast:false,upsample:request.upsample,embeds:string.new()}
  match psession.check(form){
    ok(_)=>{},
    err(message)=>{return failure(str.view(output),message)},
  }
  // Memory: 1 GiB of the card kept free, host memory minus 2 GiB for the system (as MiniMax H3-Image).
  let host=match system.memory(){
    ok(value)=>if value.available_bytes>2147483648{value.available_bytes-2147483648}else{0},
    err(_)=>0,
  }
  var budget=psession.Budget{device_reserve_bytes:1073741824,host_available_bytes:host}

  generation.report(sender,if edit{"Generating the edit"}else{"Generating the picture"})
  match psession.generate(deployment,form,budget){
    ok(measured)=>{
      var timings=measured
      var note=string.new()
      if request.upsample{
        // The prompt that was rendered, written beside the picture.
        let sidecar=text.concat(str.view(output),".prompt.txt")
        let _saved=files.write_text(str.view(sidecar),str.view(struct.borrow(timings,field=prompt)))
        note=text.concat(" · prompt rewritten in ",text.concat(str.view(number(timings.upsample_ms/1000))," s"))
      }
      let seconds=number((time.monotonic_ns()-started)/1000000000)
      let done=text.concat("P-H3-Image ",text.concat(if edit{"edit"}else{"picture"},
        text.concat(" completed in ",text.concat(str.view(seconds)," s"))))
      generation.outcome_metrics(true,str.view(output),str.view(text.concat(str.view(done),str.view(note))),
        (time.monotonic_ns()-started)/1000000,timings.peak_vram_bytes)
    },
    err(message)=>failure(str.view(output),message),
  }
}
