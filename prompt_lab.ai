// Tab-specific worker around the reusable AIR Prompt Engine. It owns no UI
// state and returns only after Qwen's context, stream and weights are closed.
module app.mm_air.prompt_lab
import ".air/deps/prompt/engine.ai" as engine
import ".air/deps/prompt/runtime.ai" as runtime
import ".air/deps/prompt/types.ai" as prompt
import ".air/deps/prompt/director.ai" as director
import std.files as files
import std.path as path
import std.system as system
import std.tasks as tasks
import std.text as text
import "runtime_config.ai" as config

pub type Job = struct { request: prompt.Request, manifest_directory: string }
pub type Outcome = struct {
  succeeded: bool,
  response: string,
  message: string,
  input_tokens: u64,
  output_tokens: u64,
  peak_device_bytes: u64,
  fully_unloaded: bool
}

fn failure(message: str) -> Outcome effects {alloc} {
  Outcome {succeeded:false,response:string.new(),message:string.copy(message),
    input_tokens:0,output_tokens:0,peak_device_bytes:0,fully_unloaded:true}
}

pub fn model(index: u32) -> prompt.ModelChoice effects {} {
  if index == 1 { return prompt.ModelChoice.Qwen3VL8B }
  if index == 2 { return prompt.ModelChoice.Qwen3VL32B }
  prompt.ModelChoice.Qwen3VL4B
}

pub fn discover(model:prompt.ModelChoice) -> prompt.Availability
    effects {alloc,env,fs.meta,fs.read} {
  match config.value(runtime.directory_key(model)) {
    ok(value)=>match value {
      some(directory)=>{
        if directory!="" { return runtime.discover_at(model,directory) }
      },
      none=>{},
    },
    err(message)=>{return prompt.Availability {model:model,available:false,
      checkpoint_index:string.new(),tokenizer_directory:string.new(),
      reason:message,strategy:string.copy("Unavailable; configuration needs correction")}},
  }
  runtime.discover(model)
}

pub fn manifest_directory(bindir:str) -> result<string,string>
    effects {alloc,env,fs.meta,fs.read} {
  match try config.value("MM_AIR_PROMPT_MANIFEST_ROOT") {
    some(directory)=>{if directory!="" {return result.ok(directory)}},
    none=>{},
  }
  let installed=path.join(bindir,"share/mm-air/prompt-manifests")
  match fs.meta(installed) {ok(value)=>{
    if value.is_dir {return result.ok(installed)}},err(_)=>{},}
  result.ok(path.join(path.dirname(bindir),"prompt-manifests"))
}

pub fn cancellation_path() -> string effects {alloc,env,time} {
  path.join(system.temp_directory(),text.concat("mm-air-prompt-cancel-",
    text.concat(string.from_int(time.monotonic_ns()),".signal")))
}

pub fn task(index: u32) -> prompt.Task effects {} {
  if index == 1 { return prompt.Task.Variations }
  if index == 2 { return prompt.Task.ImageCaption }
  if index == 3 { return prompt.Task.VideoCaption }
  if index == 4 { return prompt.Task.ShotList }
  if index == 5 { return prompt.Task.ContinuityNotes }
  if index == 6 { return prompt.Task.ScenePlan }
  if index == 7 { return prompt.Task.DirectorNotes }
  prompt.Task.Prompt
}

// Pure routing helpers keep Generate/Movie integration testable without GTK.
pub fn route_generate(current: str, produced: str, append: bool) -> string effects {alloc} {
  if not append or str.len(current) == 0 { return string.copy(produced) }
  var output = string.copy(current)
  string.append(output,"\n\n")
  string.append(output,produced)
  output
}

pub fn route_movie(produced: str) -> string effects {alloc} {
  string.copy(produced)
}

pub fn window_plan(total_seconds:f64,window_seconds:f64,overlap_seconds:f64)
    -> result<director.State,string> effects {alloc} {
  director.create(total_seconds,window_seconds,overlap_seconds)
}

pub fn window_report(total_seconds:f64,window_seconds:f64,overlap_seconds:f64)
    -> result<string,string> effects {alloc} {
  var state=try window_plan(total_seconds,window_seconds,overlap_seconds)
  result.ok(director.report(state))
}

pub fn scene_instruction(total_seconds:f64,window_seconds:f64,
                         overlap_seconds:f64,idea:str)
    -> result<string,string> effects {alloc} {
  var state=try window_plan(total_seconds,window_seconds,overlap_seconds)
  result.ok(director.scene_plan_instruction(state,idea))
}

pub fn cancel(path:str) -> bool effects {alloc,fs.write} {
  result.is_ok(files.write_text(path,"cancelled\n"))
}

pub fn run(job: Job own) -> Outcome
    effects {alloc,env,fs.meta,fs.read,fs.write,gpu,process,time} {
  var owned = job
  let manifest_directory = string.copy(struct.borrow(owned,field=manifest_directory))
  let request = struct.borrow(owned,field=request)
  if request.cancel_path!="" and tasks.requested_at(request.cancel_path) {
    return failure("Qwen request cancelled before load")
  }
  var availability = discover(request.model)
  if not availability.available {
    return failure(struct.borrow(availability,field=reason))
  }
  var sources = engine.sources(availability,
    str.view(manifest_directory))
  match engine.generate(sources,request) {
    err(message) => failure(str.view(message)),
    ok(value) => {
      var response = value
      if not response.fully_unloaded {
        return failure("Qwen response was rejected because GPU teardown did not complete; H3 was not started")
      }
      Outcome {succeeded:true,
        response:string.copy(struct.borrow(response,field=content)),
        message:string.copy("Qwen response complete; model synchronized and unloaded"),
        input_tokens:response.input_tokens,output_tokens:response.output_tokens,
        peak_device_bytes:response.peak_device_bytes,
        fully_unloaded:response.fully_unloaded}
    },
  }
}
