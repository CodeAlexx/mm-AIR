// Native Movie project editing over the shared Linux project/shot contract.
module app.mm_air.native_movie
import std.widgets as w
import std.text as text
import std.math as math
import std.path as path
import "movie_project.ai" as movie
import ".air/deps/h3/request.ai" as h3

// Match Movie Maker's routing: continuation, cast/reference, then keyframes.
pub fn request(project:ref<movie.Project>,index:u64,output:str)->result<h3.Request,string> effects{alloc}{
  if index>=array.len(struct.borrow(project,field=shots)){return result.err("Select a shot to generate")}
  var shot=movie.snapshot_shot(project,index)
  try movie.validate(shot)
  if shot.locked{return result.err("Unlock the approved shot before generating another take")}
  var references=movie.effective_references(project,index)
  var model=h3.model_base()
  var task=h3.task_t2va()
  if struct.borrow(shot,field=continue_from)!=""{references=[]}
  else{if array.len(references)!=0{model=h3.model_reference()
    task=h3.task_ref2va()}
  else{
    let first=struct.borrow(shot,field=first_frame)!=""
    let last=struct.borrow(shot,field=last_frame)!=""
    if first{array.push(references,string.copy(struct.borrow(shot,field=first_frame)))}
    if last{array.push(references,string.copy(struct.borrow(shot,field=last_frame)))}
    task=if first and last{h3.task_fl2va()}else{if first{h3.task_i2va()}else{if last{h3.task_l2va()}else{h3.task_t2va()}}}
  }}
  var value=h3.request(movie.compile_project_prompt(project,index),model,task,
    h3.profile_dc_euler_19(),h3.projection_convrot_int8(),h3.projection_convrot_int8(),
    h3.attention_ck_int8(),shot.seed,h3.resolution_custom(),references,output)
  match h3.set_geometry(value,shot.width,shot.height,shot.duration){ok(_)=>{},err(problem)=>{var held=problem
    return result.err(h3.describe(held))},}
  match h3.validate(value){ok(_)=>result.ok(value),err(problem)=>{var held=problem
    result.err(h3.describe(held))},}
}

pub fn generating(ui:ref<w.Ui>,busy:bool)->unit effects{}{
  var key:u64=9002
  loop{if key>9059{break}
    let node=w.find(ui,key)
    if key!=9034 and node!=0{w.enable(ui,node,not busy)}
    key=key+1}
  ()
}

pub type ExportJob=struct{project:string,output:string,scratch:string}
pub type ExportOutcome=struct{succeeded:bool,message:string,output:string}
pub fn export_movie(job:ExportJob own)->ExportOutcome
    effects{alloc,env,fs.meta,fs.write,process,time}{
  var work=job
  var project=match movie.decode(string.copy(struct.borrow(work,field=project))){
    ok(value)=>value,err(problem)=>{return ExportOutcome{succeeded:false,message:problem,
      output:string.copy(struct.borrow(work,field=output))}},}
  match movie.stitch(project,struct.borrow(work,field=output),struct.borrow(work,field=scratch)){
    ok(_)=>ExportOutcome{succeeded:true,message:text.concat("Movie exported: ",struct.borrow(work,field=output)),
      output:string.copy(struct.borrow(work,field=output))},
    err(problem)=>ExportOutcome{succeeded:false,message:problem,
      output:string.copy(struct.borrow(work,field=output))},
  }
}

