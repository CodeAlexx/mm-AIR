// Edit "Auto Mask" on the native AIR SAM 3.1 tracker: one text prompt, every matching
// track merged into one 8-bit mask per frame, written as raw gray + the lossless preview.
// Same Job -> Outcome contract as the SAM 3 runner; that runner stays the fallback when
// the SAM 3.1 weights file is absent.
module app.mm_air.sam31_mask

import ".air/deps/sam3/mask.ai" as auto_mask
import ".air/deps/sam3/tracks.ai" as sam_tracks
import ".air/deps/sam31/video.ai" as sam31
import "pick.ai" as pick
import std.files as files
import std.media as media
import std.path as path
import std.process as proc
import std.text as text

pub type Job = struct {
  plugin:string,
  model:string,
  sam31_model:string,
  source:string,
  prompt:string,
  raw_output:string,
  preview_output:string,
  frames:u64,
  still:bool
}

fn failed(message:str)->auto_mask.Outcome effects{alloc}{
  auto_mask.Outcome{succeeded:false,mask_path:string.new(),message:string.copy(message),
    width:0,height:0,frames:0}
}

fn check(arguments:array<string> own,message:str)->result<unit,string>
    effects{alloc,fs.meta,fs.read,fs.write,process}{
  match proc.check(arguments){
    ok(_)=>result.ok(()),
    err(problem)=>{var held=problem
      let detail=match held{Launch(error)=>string.copy(error.message),
        Exit(status)=>text.concat("exit status ",str.view(string.from_int(
          proc.exit_code(status))))}
      result.err(text.concat(message,text.concat(": ",str.view(detail))))},
  }
}

fn still_frames()->u64 effects{}{6}

fn clean(directory:str)->unit effects{alloc,fs.meta,fs.read,fs.write,process}{
  let _=proc.check(["rm","-rf",string.copy(directory)])
  ()
}

fn read_plane(file:ref<File>,frame:u64,plane:u64)->result<bytes,string>
    effects{alloc,fs.read}{
  match fs.seek(file,cast.sat(frame*plane),whence=start){ok(_)=>{},
    err(_)=>{return result.err("SAM 3.1 mask track seek failed")}}
  var raw:bytes=bytes.copy(b"")
  loop{
    let have:u64=view.len(bytes.view(raw))
    if have==plane{break}
    let part:bytes=match fs.read(file,plane-have){ok(value)=>value,
      err(_)=>{return result.err("SAM 3.1 mask track read failed")}}
    if view.len(bytes.view(part))==0{return result.err("SAM 3.1 mask track is short")}
    bytes.append(raw,bytes.view(part))
  }
  result.ok(raw)
}

fn none_present(frames:u64)->array<bool> effects{alloc}{
  var out:array<bool> = array.new()
  var frame:u64=0
  loop{if frame>=frames{break}
    array.push(out,false)
    frame=frame+1}
  out
}

fn present_frames(track:ref<sam_tracks.Track>,frames:u64)->array<bool> effects{alloc}{
  var present:array<bool> = array.new()
  var frame:u64=0
  loop{if frame>=frames{break}
    array.push(present,false)
    frame=frame+1}
  var at:u64=0
  loop{if at>=array.len(track.appearances){break}
    let seen=array.borrow(track.appearances,at).frame
    if seen<frames{array.set(present,seen,true)}
    at=at+1}
  present
}

// Union of every track on every tracked frame, streamed to `sink` one plane per frame.
// A still is tracked on a few repeated frames; only the last tracked plane is kept and
// written `repeat` times.
fn merge_tracks(tracks:ref<array<sam_tracks.Track>>,allow:ref<array<bool>>,first:u64,frames:u64,plane:u64,
    repeat:u64,raw_output:str)->result<unit,string> effects{alloc,fs.meta,fs.read,fs.write}{
  var files_open:array<File> = array.new()
  var present:array<array<bool>> = array.new()
  var at:u64=0
  loop{if at>=array.len(tracks){break}
    let track=array.borrow(tracks,at)
    var file:File=match fs.open(str.view(track.raw),mode=read){ok(value)=>value,
      err(_)=>{return result.err("SAM 3.1 mask track could not be opened")}}
    array.push(files_open,file)
    array.push(present,if array.len(allow)==0 or array.get(allow,at){present_frames(track,frames)}
      else{none_present(frames)})
    at=at+1}
  var zero_cells:array<byte> = array.new()
  var cell:u64=0
  loop{if cell>=plane{break}
    let nothing:u8=0
    array.push(zero_cells,cast.bits(nothing))
    cell=cell+1}
  let zero:bytes=bytes.from_array(zero_cells)
  var sink:files.Sink=match files.sink_create(raw_output,
      str.view(text.concat(raw_output,".partial"))){ok(value)=>value,
    err(_)=>{return result.err("Cannot write the SAM 3.1 mask")}}
  var frame:u64=first
  loop{if frame>=frames{break}
    var active:array<u64> = array.new()
    var t:u64=0
    loop{if t>=array.len(files_open){break}
      if array.get(array.borrow(present,t),frame){array.push(active,t)}
      t=t+1}
    var out:bytes=bytes.copy(bytes.view(zero))
    if array.len(active)==1{
      out=match read_plane(array.borrow(files_open,array.get(active,0)),frame,plane){
        ok(value)=>value,err(message)=>{let _=files.sink_discard(sink)
          return result.err(message)}}
    }
    if array.len(active)>1{
      var merged:array<byte> = array.new()
      var first:bool=true
      var k:u64=0
      loop{if k>=array.len(active){break}
        let item=match read_plane(array.borrow(files_open,array.get(active,k)),frame,plane){
          ok(value)=>value,err(message)=>{let _=files.sink_discard(sink)
            return result.err(message)}}
        let view_item=bytes.view(item)
        var pixel:u64=0
        if first{
          loop{if pixel>=plane{break}
            array.push(merged,view.get(view_item,pixel))
            pixel=pixel+1}
          first=false
        }else{
          loop{if pixel>=plane{break}
            let value:u8=cast.bits(view.get(view_item,pixel))
            if value!=0{array.set(merged,pixel,view.get(view_item,pixel))}
            pixel=pixel+1}
        }
        k=k+1}
      out=bytes.from_array(merged)
    }
    var again:u64=0
    loop{if again>=repeat{break}
      match files.sink_write(sink,bytes.view(out)){ok(_)=>{},
        err(_)=>{let _=files.sink_discard(sink)
          return result.err("Cannot write the SAM 3.1 mask")}}
      again=again+1}
    frame=frame+1}
  match files.sink_publish(sink,true){ok(_)=>{},
    err(_)=>{return result.err("Cannot write the SAM 3.1 mask")}}
  result.ok(())
}

fn fallback(job:Job own)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  var owned=job
  var old=auto_mask.Job{plugin:string.copy(struct.borrow(owned,field=plugin)),
    model:string.copy(struct.borrow(owned,field=model)),
    source:string.copy(struct.borrow(owned,field=source)),
    prompt:string.copy(struct.borrow(owned,field=prompt)),
    raw_output:string.copy(struct.borrow(owned,field=raw_output)),
    preview_output:string.copy(struct.borrow(owned,field=preview_output)),
    frames:owned.frames}
  var outcome=auto_mask.run(old)
  if outcome.succeeded{
    struct.set(outcome,text.concat("SAM 3 mask ready · ",text.concat(
      str.view(string.from_int(owned.frames))," frames")),field=message)}
  outcome
}

// The SAM 3 runner for each prompt in turn while one finds nothing.
fn fallback_prompts(job:Job own,prompts:ref<array<string>>)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  var owned=job
  var outcome=failed("SAM 3 found no match")
  var p:u64=0
  loop{if p>=array.len(prompts){break}
    var attempt=Job{plugin:string.copy(struct.borrow(owned,field=plugin)),
      model:string.copy(struct.borrow(owned,field=model)),
      sam31_model:string.copy(struct.borrow(owned,field=sam31_model)),
      source:string.copy(struct.borrow(owned,field=source)),
      prompt:string.copy(array.borrow(prompts,p)),
      raw_output:string.copy(struct.borrow(owned,field=raw_output)),
      preview_output:string.copy(struct.borrow(owned,field=preview_output)),
      frames:owned.frames,still:owned.still}
    outcome=fallback(attempt)
    if outcome.succeeded{break}
    p=p+1}
  outcome
}

pub fn run(job:Job own)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  var none:array<string> = array.new()
  run_prompts(job,none)
}

// run, then each of `fallbacks` in turn on the same decoded frames while a prompt finds nothing (a generated
// replacement need not be a person); fails only when every prompt finds nothing.
pub fn run_prompts(job:Job own,fallbacks:array<string> own)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  let nobody=pick.none()
  run_prompts_pick(job,fallbacks,nobody)
}

// A job and the person chosen by face (an empty pick masks every match, as run does).
pub type PickedJob = struct { job:Job, person:pick.Pick }

pub fn run_picked(work:PickedJob own)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  var held=work
  let person=ref.swap(struct.borrow(held,field=person),pick.none())
  let job=ref.swap(struct.borrow(held,field=job),Job{plugin:string.new(),model:string.new(),
    sam31_model:string.new(),source:string.new(),prompt:string.new(),raw_output:string.new(),
    preview_output:string.new(),frames:0,still:false})
  var none:array<string> = array.new()
  run_prompts_pick(job,none,person)
}

// run_prompts, masking only the tracks that cover the chosen person's face when `person` is set.
pub fn run_prompts_pick(job:Job own,fallbacks:array<string> own,person:ref<pick.Pick>)->auto_mask.Outcome
    effects{alloc,fs.meta,fs.read,fs.write,gpu,process,time}{
  var owned=job
  var prompts:array<string> = [string.copy(struct.borrow(owned,field=prompt))]
  var more=fallbacks
  var m:u64=0
  loop{if m>=array.len(more){break}
    array.push(prompts,string.copy(array.borrow(more,m)))
    m=m+1}
  if owned.frames==0{return failed("Automatic masking needs at least one frame")}
  match files.exists(struct.borrow(owned,field=sam31_model)){
    ok(present)=>{if not present{return fallback_prompts(owned,prompts)}},
    err(_)=>{return fallback_prompts(owned,prompts)}}
  let started=time.monotonic_ns()

  let token=str.view(string.from_int(time.monotonic_ns()))
  let probe_root=path.join("/tmp",text.concat("air-sam31-mask-probe-",token))
  var info=match media.probe("/nonexistent/air-image-provider",
      struct.borrow(owned,field=source),str.view(probe_root)){
    ok(value)=>value,err(message)=>{return failed(str.view(message))}}
  clean(str.view(probe_root))
  let width:u64=cast.sat(info.width)
  let height:u64=cast.sat(info.height)
  if width==0 or height==0{return failed("SAM 3.1 source has invalid geometry")}
  let plane:u64=width*height

  // A still is tracked on a few repeated frames (the tracker confirms an object after
  // several), its last mask repeated for every output frame.
  let still=owned.still
  let tracked:u64=if still{still_frames()}else{owned.frames}
  let rgb=text.concat(struct.borrow(owned,field=raw_output),".rgb")
  let work=text.concat(struct.borrow(owned,field=raw_output),".sam31")
  var decode:array<string> = ["ffmpeg","-nostdin","-v","error","-y"]
  if still{array.push(decode,"-loop")
    array.push(decode,"1")}
  array.push(decode,"-i")
  array.push(decode,string.copy(struct.borrow(owned,field=source)))
  if not still{array.push(decode,"-vf")
    array.push(decode,"fps=24")}
  array.push(decode,"-frames:v")
  array.push(decode,string.from_int(tracked))
  array.push(decode,"-f")
  array.push(decode,"rawvideo")
  array.push(decode,"-pix_fmt")
  array.push(decode,"rgb24")
  array.push(decode,string.copy(str.view(rgb)))
  match check(decode,"Could not decode source for SAM 3.1"){
    ok(_)=>{},err(message)=>{return failed(str.view(message))}}

  var found:array<sam_tracks.Track> = array.new()
  var p:u64=0
  loop{if p>=array.len(prompts){break}
    let _=clean(str.view(work))
    var request=sam31.Job{model:string.copy(struct.borrow(owned,field=sam31_model)),
      source_rgb:string.copy(str.view(rgb)),prompt:string.copy(array.borrow(prompts,p)),
      output_dir:string.copy(str.view(work)),frames:tracked,width:width,height:height}
    let tracking=sam31.track(request)
    match tracking{ok(_)=>{},err(message)=>{let _=files.remove(str.view(rgb))
      let _=clean(str.view(work))
      return failed(str.view(message))}}
    let index=match files.read_text(str.view(path.join(str.view(work),"tracks.tsv"))){
      ok(value)=>value,err(_)=>{let _=files.remove(str.view(rgb))
        let _=clean(str.view(work))
        return failed("SAM 3.1 wrote no track index")}}
    found=match sam_tracks.parse_index(str.view(index),str.view(work),tracked){
      ok(value)=>value,err(message)=>{let _=files.remove(str.view(rgb))
        let _=clean(str.view(work))
        return failed(str.view(message))}}
    if array.len(found)!=0{break}
    p=p+1}
  let _=files.remove(str.view(rgb))
  if array.len(found)==0{
    let _=clean(str.view(work))
    return failed("SAM 3.1 found no match")}
  var allow:array<bool> = array.new()
  if pick.chosen(person) and not still{
    let covering=match pick.tracks_for(found,person,24.0,tracked,width,height){ok(value)=>value,
      err(message)=>{let _=clean(str.view(work))
        return failed(str.view(message))}}
    if array.len(covering)==0{
      let _=clean(str.view(work))
      return failed("SAM 3.1 did not find the chosen person")}
    var t:u64=0
    loop{if t>=array.len(found){break}
      array.push(allow,false)
      t=t+1}
    var c:u64=0
    loop{if c>=array.len(covering){break}
      array.set(allow,array.get(covering,c),true)
      c=c+1}
  }
  let merged=merge_tracks(found,allow,if still{tracked-1}else{0},tracked,plane,if still{owned.frames}else{1},
    str.view(struct.borrow(owned,field=raw_output)))
  let _=clean(str.view(work))
  match merged{ok(_)=>{},err(message)=>{return failed(str.view(message))}}

  let size=text.concat(str.view(string.from_int(width)),text.concat("x",
    str.view(string.from_int(height))))
  match check(["ffmpeg","-nostdin","-v","error","-y","-f","rawvideo",
      "-pixel_format","gray","-video_size",size,"-framerate","24","-i",
      string.copy(struct.borrow(owned,field=raw_output)),"-frames:v",
      string.from_int(owned.frames),"-vf","pad=ceil(iw/2)*2:ceil(ih/2)*2:0:0","-an","-c:v","libx264","-preset","fast",
      "-crf","0","-pix_fmt","yuv420p",
      string.copy(struct.borrow(owned,field=preview_output))],
      "Could not encode the automatic-mask preview"){
    err(message)=>{return failed(str.view(message))},ok(_)=>{}}
  let seconds=(time.monotonic_ns()-started)/1000000000
  var matched:string=string.new()
  if p>0{matched=text.concat(str.view(array.borrow(prompts,p))," · ")}
  auto_mask.Outcome{succeeded:true,
    mask_path:string.copy(struct.borrow(owned,field=preview_output)),
    message:text.concat("SAM 3.1 mask ready · ",text.concat(
      str.view(string.from_int(owned.frames)),text.concat(" frames · ",
      text.concat(str.view(matched),
      text.concat(str.view(string.from_int(seconds))," s"))))),
    width:width,height:height,frames:owned.frames}
}
