  var edit_timing_block_lo:u64=30
  var edit_timing_block_hi:u64=49
  var edit_timing_fade:f32=0.7
  var edit_timing_step_lo:u64=0
  var edit_timing_step_hi:u64=18
  var edit_generation_active:bool=false
  var qwen_edit_active:bool=false
  var qwen_edit_source:string=string.new()
  var qwen_edit_references: array<string> = array.new()
  var qwen_edit_selected:u64=0
  var qwen_edit_seed:u64=cast.wrap(random_seed())
  var qwen_edit_seed_locked:bool=false
  // Image Edit model: false = Qwen-Image-2.1, true = Fibo 2.0 Edit Turbo.
  var qwen_edit_fibo:bool=false
  // true: Image Edit runs MiniMax H3-Image (model list entry 3); fibo and this are never both true.
  var qwen_edit_h3image:bool=false
  // true: Image Edit runs P-H3-Image (model list entry 4); never true together with the two above.
  var qwen_edit_ph3image:bool=false
  // P-H3-Image edit size: 0 keeps Picture 1's size, 1.. are parameters.ph3image_edit_size(n-1).
  var qwen_edit_ph3_size:u64=0
  var qwen_edit_ph3_upsample:bool=true
  var generate_ph3_upsample:bool=true
  var qwen_edit_expander:string=string.copy("off")
  var qwen_edit_lora:array<parameters.LoraEntry>=[]
  var generate_expander:string=string.copy("off")
  var qwen_edit_match_source:bool=true
  var qwen_edit_enhance:bool=true
