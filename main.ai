            if id=="edit_repair_dilation"{
              edit_repair_dilation=desk.number(event,"value")}
            if id=="edit_repair_cuts"{edit_repair_cuts=desk.field(event,"value")}
            if id=="edit_repair_memory"{edit_repair_memory=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_v2v_window" or id=="gen_v2v_window"{
              let choice:u64=cast.sat(desk.number(event,"value"))
              v2v_window_frames=if choice==0{90}else if choice==2{175}else{124}
              let _=desk.set_number(session,if id=="edit_v2v_window"{"gen_v2v_window"}else{"edit_v2v_window"},"selected",
                cast.float(choice))}
            if id=="edit_v2v_overlap" or id=="gen_v2v_overlap"{
              let choice:u64=cast.sat(desk.number(event,"value"))
              v2v_overlap_frames=if choice==0{5}else if choice==2{39}else{22}
              let _=desk.set_number(session,if id=="edit_v2v_overlap"{"gen_v2v_overlap"}else{"edit_v2v_overlap"},"selected",
                cast.float(choice))}
