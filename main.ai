fn repair_cuts(value:str)->result<array<u64>,string> effects{alloc}{
  var out:array<u64> = []
  if str.len(text.trim(value))==0{return result.ok(out)}
  var pieces=text.split(value,",")
  var index:u64=0
  loop{if index>=array.len(pieces){break}
    let part=text.trim(array.borrow(pieces,index))
    match text.parse_u64(part){
      some(frame)=>array.push(out,frame),
      none=>{return result.err("Shot cuts must be comma-separated frame numbers")},
    }
    index=index+1
  }
  result.ok(out)
}

fn prompt_role(role: prompt_types.Role) -> string effects {alloc} {
  string.copy(match role { System => "System", User => "You", Assistant => "Qwen" })
}

fn show_prompt_session(session: ref<desk.Session>, state: ref<prompt_session.Session>)
    -> unit effects {alloc,net,time} {
  var transcript = string.new()
  let turns = struct.borrow(state,field=conversation)
  var index: u64 = 0
  loop {
    if index >= array.len(turns) { break }
    let turn = array.borrow(turns,index)
    if index != 0 { string.append(transcript,"\n\n") }
    var role_name = prompt_role(turn.role)
    string.append(transcript,str.view(role_name))
    string.append(transcript,"  ·  ")
    string.append(transcript,struct.borrow(turn,field=content))
    index = index + 1
  }
  if array.len(turns) == 0 {
    string.append(transcript,"Start with a rough idea, then ask Qwen to refine it. Conversation context stays in this session.")
  }
  let _ = desk.set_text(session,"prompt_chat_buffer",str.view(transcript))
  let attachments = struct.borrow(state,field=attachments)
  var summary = string.new()
  index = 0
  loop {
    if index >= array.len(attachments) { break }
    let item = array.borrow(attachments,index)
    if index != 0 { string.append(summary,"  ·  ") }
    string.append(summary,"#")
    string.append(summary,str.view(string.from_int(item.ordinal)))
    string.append(summary,if item.kind == prompt_types.AttachmentKind.Image {" image · "} else {" video · "})
    string.append(summary,str.view(path.basename(struct.borrow(item,field=path))))
    index = index + 1
  }
  if array.len(attachments) == 0 { string.append(summary,"No references") }
  let _ = desk.set_text(session,"prompt_attachment_summary",str.view(summary))
  let _ = desk.set_bool(session,"prompt_clear_attachments","sensitive",array.len(attachments) != 0)
  ()
}

fn show_prompt_model(session: ref<desk.Session>, index: u32)
    -> unit effects {alloc,env,fs.meta,fs.read,net,time} {
  let selected = prompt_lab.model(index)
  var availability = prompt_lab.discover(selected)
  let _ = desk.set_text(session,"prompt_model_badge",
    if index == 0 {"Qwen3-VL 4B"} else if index == 1 {"Qwen3-VL 8B"} else {"Qwen3-VL 32B"})
  var status = if availability.available {
    string.copy(struct.borrow(availability,field=strategy))
  } else { string.copy(struct.borrow(availability,field=reason)) }
  let _ = desk.set_text(session,"prompt_availability",str.view(status))
  let _ = desk.set_bool(session,"prompt_run","sensitive",availability.available)
  ()
}

fn save_prompt_state(state: ref<prompt_session.Session>, directory: str, unique: bool)
    -> result<string,string> effects {alloc,fs.meta,fs.write,time} {
  let folder = path.join(directory,"prompt-history")
  match files.mkdirs(str.view(folder)) {
    ok(_) => {}, err(problem) => { return result.err(string.copy(fs.error.message(problem))) },
  }
  var filename = path.join(str.view(folder),"latest.json")
  if unique {
    filename = path.join(str.view(folder),text.concat("prompt-",text.concat(
      str.view(string.from_int(time.monotonic_ns())),".json")))
  }
  let encoded = try prompt_persistence.encode(state)
  match files.write_atomic(str.view(filename),text.concat(str.view(filename),".tmp"),str.view(encoded)) {
    ok(_) => result.ok(filename),
    err(problem) => result.err(string.copy(fs.error.message(problem))),
  }
}

fn copy_result(source: string own) -> result<string, string>
    effects {alloc,env,fs.read,fs.write,fs.meta} {
  let owned: string = source
  desktop.copy_to_downloads(owned)
}

// The source video a generated video was made from: Video 1 in its parameter
// sidecar, when that is a video file that still exists.
fn side_by_side_source(output: str) -> option<string> effects {alloc,fs.meta,fs.read} {
  let sidecar = text.concat(output, ".json")
  let encoded = match files.read_text(str.view(sidecar)) { ok(value) => value, err(_) => { return option.none() } }
  var document = match json.parse(str.view(encoded)) { ok(value) => value, err(_) => { return option.none() } }
  let node: u64 = match json.get(document, json.root(), "references") { some(value) => value, none => { return option.none() } }
  let first: u64 = match json.at(document, node, 0) { some(value) => value, none => { return option.none() } }
  let source: string = match json.as_string(document, first) { some(value) => value, none => { return option.none() } }
  match media.inspect(str.view(source), 68719476736) {
    ok(info) => if info.kind == media.Kind.Video { option.some(source) } else { option.none() },
    err(_) => option.none(),
  }
}

// Source on the left, result on the right, one MP4 that plays both in sync. The
// source is resampled to 24 FPS (the H3 output clock) and scaled to the result's
// height; the result's soundtrack is kept.
fn make_side_by_side(output: string own) -> result<string, string>
    effects {alloc,env,fs.meta,fs.read,fs.write,process} {
  let owned: string = output
  let source: string = match side_by_side_source(str.view(owned)) {
    some(value) => value,
    none => { return result.err("Side by Side needs a video result whose source video still exists") },
  }
  let stem: string = text.concat(str.view(path.stem(str.view(owned))), "-side-by-side")
  let destination: string = try library.unused_output(str.view(path.dirname(str.view(owned))),
    str.view(stem), ".mp4")
  match proc.check(["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", string.copy(str.view(source)),
      "-i", string.copy(str.view(owned)), "-filter_complex",
      "[0:v]fps=24,setsar=1[s];[s][1:v]scale2ref=w='trunc(oh*mdar/2)*2':h=ih[l][r];[r]setsar=1[r2];[l][r2]hstack=inputs=2[v]",
      "-map", "[v]", "-map", "1:a?", "-shortest", "-c:v", "libx264", "-crf", "16",
      "-preset", "veryfast", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "192k",
      "-movflags", "+faststart", string.copy(str.view(destination))]) {
    ok(_) => result.ok(destination),
    err(_) => result.err("FFmpeg could not build the side-by-side movie"),
  }
}

fn item_paths(source: ref<array<library.Item>>) -> array<string> effects {alloc} {
  var out: array<string> = []
  var i: u64 = 0
  loop {
    if i == array.len(source) { break }
    array.push(out, string.copy(struct.borrow(array.borrow(source, i), field=path)))
    i = i + 1
  }
  out
}

fn save_parameter_snapshot(session: ref<desk.Session>, directory: str, encoded: str)
    -> unit effects {alloc,fs.meta,fs.write,net,time,io.write} {
  let filename = match library.unused_output(path.join(directory,"parameters"),
      text.concat("settings-",string.from_int(time.monotonic_ns())),".json") {
    ok(value) => value, err(message) => {
      let _ = desk.set_text(session,"status",message)
      return ()
    },
  }
  match files.write_atomic(filename,text.concat(filename,".tmp"),encoded) {
    ok(_) => {
      let _ = desk.set_text(session,"status",text.concat("Parameters saved: ",filename))
      io.write(text.concat("mm-air parameters saved=",text.concat(filename,"\n")))
    },
    err(error) => { let _ = desk.set_text(session,"status",fs.error.message(error)) },
  }
}

fn show_items(session: ref<desk.Session>, id: str, items: ref<array<library.Item>>)
    -> unit effects {alloc,net,time} {
  var command = desk.command("items", id)
  codec.field_u64(command, "thumbnail_width", 136)
  codec.field_u64(command, "thumbnail_height", 136)
  codec.key(command, "items")
  codec.begin_array(command)
  var i: u64 = 0
  loop {
    if i == array.len(items) { break }
    let item = array.borrow(items, i)
    codec.begin_object(command)
    codec.field_text(command, "key", string.from_int(i))
    codec.field_text(command, "label", "")
    codec.field_text(command, "path", struct.borrow(item, field=thumbnail))
    codec.field_text(command, "icon", "video-x-generic-symbolic")
    codec.end_object(command)
    i = i + 1
  }
  codec.end_array(command)
  let _ = desk.submit(session, command)
}

// Generated-output galleries are visual selectors. Paths and filenames remain
// in the item records for actions, but do not consume presentation space.
fn show_gallery_items(session:ref<desk.Session>,id:str,
    items:ref<array<library.Item>>) -> unit effects {alloc,net,time} {
  var command=desk.command("items",id)
  codec.field_u64(command,"thumbnail_width",136)
  codec.field_u64(command,"thumbnail_height",136)
  codec.key(command,"items")
  codec.begin_array(command)
  var i:u64=0
  loop {
    if i == array.len(items){break}
    let item=array.borrow(items,i)
    codec.begin_object(command)
    codec.field_text(command,"key",string.from_int(i))
    codec.field_text(command,"label","")
    // Not shown; names the tile for screen readers and UI tests.
    codec.field_text(command,"name",str.view(path.basename(str.view(struct.borrow(item,field=path)))))
    codec.field_text(command,"path",struct.borrow(item,field=thumbnail))
    codec.field_text(command,"icon","image-x-generic-symbolic")
    codec.end_object(command)
    i=i+1
  }
  codec.end_array(command)
  let _=desk.submit(session,command)
}

fn show_path_gallery(session:ref<desk.Session>,id:str,paths:ref<array<string>>)
    ->unit effects{alloc,net,time}{
  var command=desk.command("items",id)
  codec.field_u64(command,"thumbnail_width",112)
  codec.field_u64(command,"thumbnail_height",112)
  codec.key(command,"items")
  codec.begin_array(command)
  var index:u64=0
  loop{
    if index>=array.len(paths){break}
    codec.begin_object(command)
    codec.field_text(command,"key",string.from_int(index))
    codec.field_text(command,"label","")
    codec.field_text(command,"name",str.view(path.basename(str.view(array.borrow(paths,index)))))
    codec.field_text(command,"path",str.view(array.borrow(paths,index)))
    codec.field_text(command,"icon","image-x-generic-symbolic")
    codec.end_object(command)
    index=index+1
  }
  codec.end_array(command)
  let _=desk.submit(session,command)
}

fn update_qwen_edit_sources(session:ref<desk.Session>,paths:ref<array<string>>)
    ->unit effects{alloc,net,time}{
  show_path_gallery(session,"qwen_edit_references",paths)
  let count:u64=array.len(paths)
  let count_i64:i64=cast.sat(count)
  let _=desk.set_text(session,"qwen_edit_source_count",text.concat(
    str.view(string.from_int(count_i64))," / 10"))
  let any:bool=count!=0
  let _=desk.set_bool(session,"qwen_edit_remove_source","sensitive",any)
  let _=desk.set_bool(session,"qwen_edit_clear_sources","sensitive",any)
  let _=desk.set_bool(session,"qwen_edit_run","sensitive",any)
  let _=desk.set_bool(session,"qwen_edit_source_empty","visible",not any)
  if any{let _=desk.picture(session,"qwen_edit_source_picture",
    str.view(array.borrow(paths,0)))}else{
    let _=desk.picture(session,"qwen_edit_source_picture","")
  }
}

fn remove_path_at(paths:ref<array<string>>,selected:u64)->unit effects{alloc}{
  var kept: array<string> = array.new()
  var index:u64=0
  loop{
    if index>=array.len(paths){break}
    if index!=selected{array.push(kept,string.copy(str.view(array.borrow(paths,index))))}
    index=index+1
  }
  let _=ref.swap(paths,kept)
}

fn lora_editor(session: ref<desk.Session>, entries: ref<array<parameters.LoraEntry>>, selected: u64)
    -> unit effects {alloc,net,time} {
  let valid = selected < array.len(entries)
  let _ = desk.set_bool(session,"gen_lora_editor","sensitive",valid)
  let _ = desk.set_bool(session,"gen_remove_lora","sensitive",valid)
  let _ = desk.set_bool(session,"gen_clear_loras","sensitive",array.len(entries) > 0)
  if valid {
    let entry = array.borrow(entries,selected)
    let _ = desk.set_text(session,"gen_lora_selected",path.basename(struct.borrow(entry,field=path)))
    let _ = desk.set_number(session,"gen_lora_strength","value",entry.strength)
    let _ = desk.set_bool(session,"gen_lora_strength","sensitive",entry.enabled)
    let _ = desk.set_bool(session,"gen_lora_enabled","active",entry.enabled)
  } else {
    let _ = desk.set_text(session,"gen_lora_selected","Select a LoRA to adjust")
  }
}

fn show_loras(session: ref<desk.Session>, entries: ref<array<parameters.LoraEntry>>, selected: u64)
    -> unit effects {alloc,net,time} {
  var command = desk.command("items","gen_loras")
  codec.field_u64(command,"thumbnail_width",32)
  codec.field_u64(command,"thumbnail_height",24)
  codec.key(command,"items")
  codec.begin_array(command)
  var i: u64 = 0
  loop {
    if i == array.len(entries) { break }
    let entry = array.borrow(entries,i)
    codec.begin_object(command)
    codec.field_text(command,"key",string.from_int(i))
    codec.field_text(command,"label",path.basename(struct.borrow(entry,field=path)))
    codec.field_text(command,"icon","applications-engineering-symbolic")
    codec.end_object(command)
    i = i + 1
  }
  codec.end_array(command)
  let _ = desk.submit(session,command)
  let _ = desk.select(session,"gen_loras",if selected < array.len(entries) {string.from_int(selected)} else {string.new()})
  lora_editor(session,entries,selected)
}

fn remove_item(items: ref<array<library.Item>>, selected: str) -> unit effects {alloc} {
  var kept: array<library.Item> = []
  var i: u64 = 0
  loop {
    if i == array.len(items) { break }
    let old = array.borrow(items, i)
    if string.from_int(i) != selected {
      array.push(kept, library.item_with_postprocess(struct.borrow(old, field=path),
        struct.borrow(old, field=thumbnail), struct.borrow(old, field=parameters),
        struct.borrow(old,field=postprocess)))
    }
    i = i + 1
  }
  let _ = ref.swap(items, kept)
}

fn remove_output(items:ref<array<library.Item>>,filename:str) -> unit effects {alloc} {
  var kept:array<library.Item> = []
  var i:u64=0
  loop {
    if i==array.len(items){break}
    let old=array.borrow(items,i)
    if struct.borrow(old,field=path)!=filename {
      array.push(kept,library.item_with_postprocess(struct.borrow(old,field=path),
        struct.borrow(old,field=thumbnail),struct.borrow(old,field=parameters),
        struct.borrow(old,field=postprocess)))
    }
    i=i+1
  }
  let _=ref.swap(items,kept)
}

fn reference_actions(session: ref<desk.Session>, audio: bool, key: str, count: u64)
    -> unit effects {alloc,net,time} {
  let index: u64 = match text.parse_u64(key) {
    some(value) => value, none => count,
  }
  let valid: bool = index < count
  let _ = desk.set_bool(session, if audio { "gen_remove_audio" } else { "gen_remove_visual" },
    "sensitive", valid)
  let _ = desk.set_bool(session, if audio { "gen_audio_earlier" } else { "gen_visual_earlier" },
    "sensitive", valid and index > 0)
  let _ = desk.set_bool(session, if audio { "gen_audio_later" } else { "gen_visual_later" },
    "sensitive", valid and index + 1 < count)
}

fn move_reference(session: ref<desk.Session>, items: ref<array<library.Item>>,
    selected: ref<string>, audio: bool, earlier: bool) -> unit effects {alloc,net,time} {
  let index: u64 = match text.parse_u64(str.view(selected)) {
    some(value) => value, none => { return () },
  }
  match library.move_item(items, index, earlier) {
    some(target) => {
      var key: string = string.from_int(target)
      let _ = ref.swap(selected, key)
      let id: str = if audio { "gen_audio_refs" } else { "gen_visual_refs" }
      show_items(session, id, items)
      let _ = desk.select(session, id, str.view(selected))
      reference_actions(session, audio, str.view(selected), array.len(items))
    },
    none => {},
  }
  ()
}

fn selected_parameters(items: ref<array<library.Item>>, key: str) -> option<string> effects {alloc} {
  var i: u64 = 0
  loop {
    if i == array.len(items) { break }
    let item = array.borrow(items, i)
    if string.from_int(i) == key {
      return option.some(string.copy(struct.borrow(item, field=parameters)))
    }
    i = i + 1
  }
  option.none()
}

fn selected_postprocess(items:ref<array<library.Item>>,key:str)->string effects {alloc} {
  var index:u64=0
  loop {if index>=array.len(items){break}
    if string.from_int(index)==key{
      return string.copy(struct.borrow(array.borrow(items,index),field=postprocess))}
    index=index+1}
  string.new()
}

fn selected_path(items: ref<array<library.Item>>, key: str) -> string effects {alloc} {
  var i: u64 = 0
  loop {
    if i == array.len(items) { break }
    if string.from_int(i) == key {
      return string.copy(struct.borrow(array.borrow(items, i), field=path))
    }
    i = i + 1
  }
  string.new()
}

fn geometry_preset(selected: u32, width: u64, height: u64) -> u32 effects {} {
  let size = h3.resolution(selected)
  if size.width == width and size.height == height { selected }
  else { h3.resolution_custom() }
}

// Turbo runs its fixed 8 steps; show that in both Steps fields, and return to
// the creator default when another schedule is chosen again.
fn qwen_turbo_steps(session:ref<desk.Session>,scheduler:u32,steps:u64)->u64 effects{alloc,net,time}{
  let turbo:bool=scheduler==qwen_image_contract.scheduler_turbo()
  let next:u64=if turbo{qwen_image_contract.turbo_steps()}
    else if steps==qwen_image_contract.turbo_steps(){qwen_image_contract.default_steps()}else{steps}
  let _=desk.set_number(session,"qwen_image_steps","value",cast.float(next))
  let _=desk.set_number(session,"qwen_edit_steps","value",cast.float(next))
  next
}

// Turbo is a checkbox rather than a schedule: it picks the Turbo checkpoint and its
// fixed 8 steps. The schedule dropdowns keep the base model's choice underneath.
fn qwen_effective_scheduler(turbo:bool,scheduler:u32)->u32{
  if turbo{qwen_image_contract.scheduler_turbo()}else{scheduler}
}

fn show_qwen_turbo(session:ref<desk.Session>,turbo:bool)->unit effects{alloc,net,time}{
  let _=desk.set_bool(session,"qwen_image_turbo","active",turbo)
  let _=desk.set_bool(session,"qwen_edit_turbo","active",turbo)
  let _=desk.set_bool(session,"qwen_image_scheduler","sensitive",not turbo)
  let _=desk.set_bool(session,"qwen_edit_scheduler","sensitive",not turbo)
  let _=desk.set_bool(session,"qwen_image_steps","sensitive",not turbo)
  let _=desk.set_bool(session,"qwen_edit_steps","sensitive",not turbo)
  ()
}

fn show_qwen_recipe(session:ref<desk.Session>,scheduler:u32,sampler:u32)
    ->unit effects{alloc,net,time}{
  // Scheduler and sampler are already visible in their controls.
  ()
}

fn filter_parameters(session:ref<desk.Session>,query:str,model:u32,swap_mode:u32)
    ->unit effects{alloc,net,time}{
  let wanted = text.lower_ascii(query)
  let krea:bool=model==parameters.krea_model_index()
  let qwen_image:bool=model==parameters.qwen_image_model_index()
  let flux:bool=model==parameters.flux3_model_index()
  let image_model:bool=krea or qwen_image or flux
  let swap:bool=not image_model and character_swap.is_swap(swap_mode)
  let _ = desk.set_bool(session, "gen_model_group", "visible", wanted == "" or
    text.contains("model checkpoint base reference", wanted))
  let _ = desk.set_bool(session,"gen_character_group","visible",not image_model and
    not swap and (wanted == "" or
    text.contains("character sheet orbit panel portrait anime photoreal",wanted)))
  let _ = desk.set_bool(session,"gen_swap_group","visible",not image_model and
    (wanted == "" or text.contains(
      "h3 mode character swap source video replacement target identity qwen prompt",wanted)))
  // LoRAs apply to Krea 2 and to H3 runs; Character Swap adds its Settings LoRA files.
  let _ = desk.set_bool(session,"gen_lora_group","visible",(krea or not image_model) and
    (wanted == "" or text.contains("krea h3 lora overlay strength",wanted)))
  let _=desk.set_bool(session,"gen_enhance_group","visible",(flux or qwen_image) and
    (wanted=="" or text.contains("prompt enhance enhancer upsample upsampler rewrite",wanted)))
  let _=desk.set_bool(session,"gen_krea_sampling","visible",krea and
    (wanted=="" or text.contains("krea resolution schedule scheduler solver sampler steps",wanted)))
  let _ = desk.set_bool(session,"gen_seed_group","visible",wanted == "" or
    text.contains("seed random deterministic",wanted))
  let _ = desk.set_bool(session,"gen_h3_core_group","visible",not image_model and
    (wanted == "" or text.contains("h3 task profile schedule evaluations",wanted)))
  let _ = desk.set_bool(session,"gen_qwen_sampling","visible",qwen_image and
    (wanted == "" or text.contains(
      "qwen resolution schedule scheduler solver sampler steps cfg",wanted)))
  let _ = desk.set_bool(session,"gen_h3_geometry_group","visible",
    (wanted == "" or
    text.contains("resolution width height duration seconds frames fps size geometry custom",wanted)))
  let _=desk.set_bool(session,"gen_resolution","visible",not image_model)
  let _=desk.set_bool(session,"gen_duration_row","visible",not image_model)
  let sixteen:bool=krea or flux
  let _=desk.set_number(session,"gen_width_adjustment","lower",if sixteen{16.0}else{32.0})
  let _=desk.set_number(session,"gen_height_adjustment","lower",if sixteen{16.0}else{32.0})
  let _=desk.set_number(session,"gen_width_adjustment","step-increment",if sixteen{16.0}else{32.0})
  let _=desk.set_number(session,"gen_height_adjustment","step-increment",if sixteen{16.0}else{32.0})
  let _ = desk.set_bool(session,"gen_output_summary_group","visible",wanted == "" or
    text.contains("current output resolution image video fps",wanted))
  let _ = desk.set_bool(session,"gen_sources_group","visible",not image_model and
    not swap and (wanted == "" or
      text.contains("source references image video audio first last frame",wanted)))
  let _ = desk.set_bool(session,"gen_h3_runtime_group","visible",not image_model and
    (wanted == "" or text.contains(
      "h3 runtime projection conditioner transformer attention convrot int8 bf16",wanted)))
  let _ = desk.set_bool(session,"gen_output_group","visible",wanted == "" or
    text.contains("output save load parameters recipe",wanted))
}

fn apply_parameter_widgets(session: ref<desk.Session>, request: ref<h3.Request>) -> unit
    effects {alloc,net,time} {
  let _ = desk.set_text(session, "gen_parameter_filter", "")
  filter_parameters(session,"",request.model,character_swap.standard())
  let _ = desk.set_text(session, "gen_prompt_buffer", struct.borrow(request, field=prompt))
  let _ = desk.set_number(session, "gen_model", "selected", cast.float(request.model))
  let _ = desk.set_number(session, "gen_task", "selected", cast.float(request.task))
  let _ = desk.set_number(session, "gen_profile", "selected", cast.float(request.profile))
  let _ = desk.set_number(session, "gen_conditioner_projection", "selected", cast.float(request.conditioner_projection))
  let _ = desk.set_number(session, "gen_transformer_projection", "selected", cast.float(request.transformer_projection))
  let _ = desk.set_number(session, "gen_attention", "selected", cast.float(request.attention))
  let _ = desk.set_number(session, "gen_resolution", "selected", cast.float(request.resolution))
  let _ = desk.set_text(session, "gen_seed", string.from_int(request.seed))
  let geometry = request.geometry
  let _ = desk.set_number(session, "gen_width", "value", cast.float(geometry.width))
  let _ = desk.set_number(session, "gen_height", "value", cast.float(geometry.height))
  let _ = desk.set_number(session, "gen_duration", "value", request.seconds)
  geometry_summary(session, geometry.width, geometry.height, request.seconds)
  source_widgets(session, request.task)
  model_widgets(session, h3.model_base(), character_sheet.off(), character_swap.standard())
}

fn model_widgets(session: ref<desk.Session>, model:u32, sheet_mode: u32,
                 swap_mode: u32) -> unit effects {alloc,net,time} {
  let krea:bool=model==parameters.krea_model_index()
  let qwen_image:bool=model==parameters.qwen_image_model_index()
  let flux:bool=model==parameters.flux3_model_index()
  let image_model:bool=krea or qwen_image or flux
  let swap: bool = not image_model and character_swap.is_swap(swap_mode)
  let masked: bool = not image_model and character_swap.is_masked(swap_mode)
  filter_parameters(session,"",model,swap_mode)
  let _ = desk.set_bool(session,"gen_swap_fields","visible",swap)
  let _ = desk.set_bool(session,"gen_masked_fields","visible",masked)
  // Only Masked Swap asks Qwen for a prompt; unmasked Build Prompt writes
  // the direct swap instruction without it.
  let _ = desk.set_bool(session,"gen_swap_qwen_fields","visible",masked)
  let _ = desk.set_bool(session,"gen_swap_qwen_note","visible",masked)
  let _ = desk.set_bool(session,"gen_sources_group","sensitive",not image_model and not swap)
  let sheet: bool = character_sheet.valid(sheet_mode)
  let _ = desk.set_text(session,"generate_action",if flux {"Generate FLUX 3 PNG"} else if qwen_image {"Generate Qwen PNG"} else if krea {"Generate Krea PNG"} else if sheet {"Generate H3 Character Sheet"} else if masked {"Generate Masked H3 Swap"} else if swap {"Generate H3 Character Swap"} else {"Generate H3 MP4"})
  let _ = desk.set_text(session,"gen_media_badge",if image_model {"Image"} else if sheet {"Sheet"} else if masked {"Masked"} else if swap {"Swap"} else {"Video"})
  let _ = desk.set_text(session,"gen_stage_badge",if flux {"F3"} else if qwen_image {"Q21"} else if krea {"K2"} else {"H3"})
  let _ = desk.set_text(session,"gen_stage_model",if flux {"FLUX 3 Image Klein · native AIR session"} else if qwen_image {"Qwen-Image-2.1 · native AIR session"} else if krea {"Krea 2 Turbo · native AIR session"} else {"MiniMax H3 · native AIR session"})
  let _ = desk.set_text(session,"gen_fps_badge",if image_model {"PNG"} else {"24 FPS"})
  let _ = desk.set_text(session,"gen_prompt_label",if swap {"Built Prompt · editable before Generate"} else {"Prompt"})
}

fn clear_swap_source_ui(session: ref<desk.Session>) -> unit effects {alloc,net,time} {
  let _ = desk.picture(session,"gen_swap_source_preview","")
  let _ = desk.set_bool(session,"gen_swap_source_preview","visible",false)
  let _ = desk.set_text(session,"gen_swap_source_name","＋ Choose source video")
  let _ = desk.set_text(session,"gen_swap_source_metadata","Required")
  let _ = desk.set_bool(session,"gen_swap_clear_source","sensitive",false)
}

fn show_swap_source(session: ref<desk.Session>, item: ref<library.Item>,
                    filename: str) -> unit
    effects {alloc,env,fs.meta,fs.read,fs.write,net,process,time} {
  let _ = desk.picture(session,"gen_swap_source_preview",
    struct.borrow(item,field=thumbnail))
  let _ = desk.set_bool(session,"gen_swap_source_preview","visible",true)
  let _ = desk.set_text(session,"gen_swap_source_name",path.basename(filename))
  let _ = desk.set_bool(session,"gen_swap_clear_source","sensitive",true)
  let work = path.join(system.temp_directory(),text.concat(
    "mm-air-character-swap-probe-",string.from_int(time.monotonic_ns())))
  var detail = string.copy("Video selected")
  match media_io.probe("/nonexistent/air-image-provider",filename,str.view(work)) {
    ok(info) => {
      let info_width: u64 = cast.sat(info.width)
      let info_height: u64 = cast.sat(info.height)
      string.append(detail," · ")
      string.append(detail,str.view(string.from_int(info_width)))
      string.append(detail,"×")
      string.append(detail,str.view(string.from_int(info_height)))
      match info.duration_ms {
        some(duration) => {
          string.append(detail," · ")
          string.append(detail,str.view(string.from_int(duration)))
          string.append(detail," ms")
        },
        none => {},
      }
    },
    err(problem) => { string.append(detail,text.concat(" · metadata: ",str.view(problem))) },
  }
  let _ = files.remove(str.view(work))
  let _ = desk.set_text(session,"gen_swap_source_metadata",str.view(detail))
}

fn source_widgets(session: ref<desk.Session>, task: u32) -> unit effects {alloc,net,time} {
  let first = task == h3.task_i2va() or task == h3.task_fl2va()
  let last = task == h3.task_fl2va() or task == h3.task_l2va()
  let reference = task == h3.task_ref2va()
  let _ = desk.set_bool(session, "choose_reference", "visible", first)
  let _ = desk.set_bool(session, "clear_reference", "visible", first)
  let _ = desk.set_bool(session, "choose_last_reference", "visible", last)
  let _ = desk.set_bool(session, "clear_last_reference", "visible", last)
  let _ = desk.set_bool(session, "gen_visual_refs", "visible", reference)
  let _ = desk.set_bool(session, "gen_audio_refs", "visible", reference)
  let _ = desk.set_bool(session, "gen_visual_actions", "visible", reference)
  let _ = desk.set_bool(session, "gen_audio_actions", "visible", reference)
  let _ = desk.set_bool(session, "gen_reference_note", "visible", reference)
  let _ = desk.set_bool(session, "gen_sources_hint", "visible", not first and not last and not reference)
  let _ = desk.set_bool(session, "gen_clear_references", "visible", first or last or reference)
}

fn copy_paths(source: ref<array<string>>) -> array<string> effects {alloc} {
  var out: array<string> = []
  var i: u64 = 0
  loop {
    if i == array.len(source) { break }
    array.push(out, string.copy(array.borrow(source, i)))
    i = i + 1
  }
  out
}

fn geometry_summary(session: ref<desk.Session>, width: u64, height: u64, seconds: f64)
    -> unit effects {alloc,net,time} {
  let frames: u64 = cast.sat(math.round(seconds * cast.float(h3_media.fps())))
  let shown_width: i64 = cast.sat(width)
  let shown_height: i64 = cast.sat(height)
  let shown_frames: i64 = cast.sat(frames)
  var label = text.concat(string.from_int(shown_width), "×")
  string.append(label, string.from_int(shown_height))
  string.append(label, " · ")
  string.append(label, string.from_int(shown_frames))
  string.append(label, " frames · 24 FPS")
  let _ = desk.set_text(session, "gen_dimension_readout",
    text.concat(string.from_int(shown_width), text.concat(" × ", string.from_int(shown_height))))
}

fn show_prompt_window_plan(session:ref<desk.Session>,total_seconds:f64,
                           window_seconds:f64,overlap_seconds:f64)
    -> bool effects{alloc,net,time}{
  match prompt_lab.window_report(total_seconds,window_seconds,overlap_seconds){
    ok(report)=>{
      let _=desk.set_text(session,"prompt_window_report",str.view(report))
      true
    },
    err(message)=>{
      let _=desk.set_text(session,"prompt_window_report",message)
      false
    },
  }
}
fn geometry_widgets(session: ref<desk.Session>, width: u64, height: u64, seconds: f64, krea: bool, qwen_image:bool)
    -> unit effects {alloc,net,time} {
  if krea {
    let preset=krea_config.preset(0)
    let _=desk.set_number(session,"krea_resolution","selected",
      if width==preset.width and height==preset.height{0.0}else{1.0})
  }
  if qwen_image or krea {
    let _ = desk.set_text(session,"gen_dimension_readout",text.concat(
      str.view(string.from_int(width)),text.concat(" × ",str.view(string.from_int(height)))))

  } else { geometry_summary(session,width,height,seconds) }
  ()
}

fn two_digits(value:u64)->string effects {alloc} {
  if value<10 {return text.concat("0",str.view(string.from_int(value)))}
  string.from_int(value)
}

fn edit_timecode(position:f64,duration:f64)->string effects {alloc} {
  var safe_position:f64=position
  var safe_duration:f64=duration
  if safe_position<0.0{safe_position=0.0}
  if safe_duration<0.0{safe_duration=0.0}
  let here:u64=cast.sat(safe_position)
  let total:u64=cast.sat(safe_duration)
  var out=two_digits(here/60)
  string.append(out,":")
  string.append(out,str.view(two_digits(rem(here,60))))
  string.append(out," / ")
  string.append(out,str.view(two_digits(total/60)))
  string.append(out,":")
  string.append(out,str.view(two_digits(rem(total,60))))
  out
}

fn clear_reference(session: ref<desk.Session>, last: bool) -> unit effects {alloc,net,time} {
  let _ = desk.picture(session, if last { "last_reference_preview" } else { "reference_preview" }, "")
  let _ = desk.set_bool(session, if last { "last_reference_preview" } else { "reference_preview" }, "visible", false)
  let _ = desk.set_text(session, if last { "last_reference_name" } else { "reference_name" },
    if last { "＋ Choose last frame" } else { "＋ Choose first frame" })
  let _ = desk.set_text(session, if last { "last_reference_detail" } else { "reference_detail" }, "No media selected")
  let _ = desk.set_bool(session, if last { "clear_last_reference" } else { "clear_reference" }, "sensitive", false)
}

fn show_result(session: ref<desk.Session>, filename: str) -> unit effects {alloc,fs.meta,fs.read,net,time,io.write} {
  let is_image: bool = match media.inspect(filename, 68719476736) {
    ok(info) => info.kind == media.Kind.Image,
    err(_) => false,
  }
  let _ = desk.set_bool(session, "result_placeholder", "visible", false)
  let _ = desk.set_bool(session, "result_empty_title", "visible", false)
  let _ = desk.set_bool(session, "result_picture", "visible", is_image)
  let _ = desk.set_bool(session, "result_video", "visible", not is_image)
  // GTK gives the preview video no accessible name, so the shown file is logged for tests.
  io.write(text.concat("mm-air preview=", text.concat(filename, "\n")))
  if is_image {
    let _ = desk.pause(session, "result_video", false)
    let _ = desk.picture(session, "result_picture", filename)
  } else { let _ = desk.play(session, "result_video", filename) }
  let _ = desk.set_bool(session, "gen_reuse_parameters", "sensitive", true)
  let _ = desk.set_bool(session, "gen_copy_downloads", "sensitive", true)
  let _ = desk.set_bool(session, "gen_use_image_reference", "sensitive", is_image)
  let _ = desk.set_bool(session, "gen_use_swap_character", "sensitive", is_image)
  let _ = desk.set_bool(session,"gen_delete_result","sensitive",true)
  let paired: bool = not is_image and option.is_some(side_by_side_source(filename))
  let _ = desk.set_bool(session, "gen_side_by_side", "visible", paired)
}

fn show_source(session: ref<desk.Session>, filename: str) -> unit
    effects {alloc,fs.meta,fs.read,net,time,io.write} {
  match media.inspect(filename, 8589934592) {
    err(error) => { var held: media.Error = error
      let _ = desk.set_text(session, "status", media_error(held)) },
    ok(info) => {
      if info.kind == media.Kind.Image {
        let _ = desk.pause(session, "result_video", false)
        let _ = desk.set_bool(session, "result_video", "visible", false)
        let _ = desk.set_bool(session, "result_picture", "visible", true)
        let _ = desk.picture(session, "result_picture", filename)
        let _ = desk.set_bool(session, "result_placeholder", "visible", false)
        let _ = desk.set_bool(session, "result_empty_title", "visible", false)
      } else { show_result(session, filename) }
      let _ = desk.set_bool(session, "gen_reuse_parameters", "sensitive", false)
      let _ = desk.set_bool(session, "gen_copy_downloads", "sensitive", false)
      let _ = desk.set_bool(session, "gen_use_image_reference", "sensitive", false)
      let _ = desk.set_bool(session, "gen_use_swap_character", "sensitive", false)
      let _ = desk.set_bool(session, "gen_side_by_side", "visible", false)
    },
  }
}

fn open_image_view(session: ref<desk.Session>, filename: str) -> unit
    effects {alloc,fs.meta,net,time} {
  match media.inspect(filename, 68719476736) {
    ok(info) => { if info.kind == media.Kind.Image {
      let _ = desk.picture(session,"result_fullscreen_picture",filename)
      let _ = desk.set_text(session,"image_view_name",path.basename(filename))
      let _ = desk.set_string(session,"app_surface","visible-child-name","image")
      let _ = desk.focus(session,"result_fullscreen_close")
    } },
    err(_) => {},
  }
}

fn close_image_view(session: ref<desk.Session>) -> unit effects {alloc,net,time} {
  let _ = desk.set_string(session,"app_surface","visible-child-name","workspace")
  let _ = desk.picture(session,"result_fullscreen_picture","")
  let _ = desk.focus(session,"window")
}

fn session_projection(value: u32) -> h3_session.Projection effects {} {
  if value == h3.projection_exact_bf16() {
    return h3_session.Projection.ExactBF16
  }
  if value == h3.projection_convrot_int8() {
    return h3_session.Projection.ConvRotI8
  }
  if value == h3.projection_row_scaled_int8() { return h3_session.Projection.RowScaledI8 }
  panic "MM-Air reached an unselected H3 projection"
}

fn session_attention(value: u32) -> h3_session.Attention effects {} {
  if value == h3.attention_exact() { return h3_session.Attention.Exact }
  if value == h3.attention_donor_hybrid() {
    return h3_session.Attention.HybridExact3DenseInt8
  }
  if value == h3.attention_dense_int8() { return h3_session.Attention.DenseInt8 }
  if value == h3.attention_ck_int8() { return h3_session.Attention.CkInt8 }
  panic "MM-Air reached unselected H3 attention"
}

fn fail(message: str) -> i32 effects {alloc,io.write} {
  io.ewrite(text.concat(message, "\n"))
  1
}

fn generation_status(session:ref<desk.Session>,message:str) -> unit
    effects {alloc,net,time,io.write} {
  let _ = desk.set_text(session,"status",message)
  let _ = desk.set_text(session,"gen_progress_detail",message)
  io.write(text.concat("mm-air status: ",text.concat(message,"\n")))
}

// Completion remains visible in the app and is also surfaced through the
// desktop notification service when available. Notification failure never
// changes the generation result.
fn generation_notification(title:str,message:str) -> unit effects {alloc,process} {
  let _=proc.check(["notify-send","--app-name","MM-Air",string.copy(title),
    string.copy(message)])
  ()
}

fn movie_items(session:ref<desk.Session>,id:str,labels:ref<array<string>>)
    ->unit effects{alloc,net,time}{
  var command=desk.command("items",id)
  codec.key(command,"items")
  codec.begin_array(command)
  var i:u64=0
  loop{if i >= array.len(labels){break}
    codec.begin_object(command)
    codec.field_text(command,"key",str.view(string.from_int(i)))
    codec.field_text(command,"label",array.borrow(labels,i))
    codec.field_text(command,"icon",if id=="movie_take_list"{
      "media-playback-start-symbolic"}else{"video-x-generic-symbolic"})
    codec.end_object(command)
    i=i+1
  }
  codec.end_array(command)
  let _=desk.submit(session,command)
  ()
}

fn show_project_library(session:ref<desk.Session>,paths:ref<array<string>>,
                        current:str)->unit effects{alloc,net,time}{
  var labels: array<string> = array.new()
  var i:u64=0
  loop{if i>=array.len(paths){break}
    let entry=array.borrow(paths,i)
    array.push(labels,text.concat(if entry==current{"● "}else{"  "},
      path.basename(entry)))
    i=i+1}
  movie_items(session,"movie_project_list",labels)
}

fn movie_time(seconds:f64)->string effects{alloc}{
  let frames:u64=cast.sat(math.round(seconds*24.0))
  let whole=frames/24
  let ff=frames%24
  let mm=whole/60
  let ss=whole%60
  text.concat("00:",text.concat(if mm<10{text.concat("0",string.from_int(mm))}
    else{string.from_int(mm)},text.concat(":",text.concat(
    if ss<10{text.concat("0",string.from_int(ss))}else{string.from_int(ss)},
    text.concat(":",if ff<10{text.concat("0",string.from_int(ff))}
      else{string.from_int(ff)})))))
}

fn save_movie(project:ref<movie.Project>,filename:str)->result<unit,string>
    effects{alloc,fs.meta,fs.write}{movie.save(project,filename)}

fn save_movie_selection(root:str,filename:str)->unit
    effects{alloc,fs.meta,fs.write,io.write}{
  match movie.save_library_selection(root,filename){
    ok(_)=>{},err(message)=>{io.ewrite(text.concat("Movie selection: ",
      text.concat(message,"\n")))}}
  ()
}

// Movie and Generate share the selected H3 runtime policy. Shot geometry and
// sources remain project-owned; queueing a take must not silently change precision.
fn movie_projection_label(value:u32)->str effects{}{
  if value==h3.projection_exact_bf16(){"Exact BF16"}
  else if value==h3.projection_convrot_int8(){"ConvRot INT8"}
  else if value==h3.projection_row_scaled_int8(){"Row-scaled INT8"}
  else{"Select in Generate"}
}
fn show_movie_runtime_policy(session:ref<desk.Session>,profile:u32,
    conditioner:u32,transformer:u32,attention:u32)->unit effects{alloc,net,time}{
  let _=desk.set_text(session,"movie_conditioner_precision",movie_projection_label(conditioner))
  let _=desk.set_text(session,"movie_transformer_precision",movie_projection_label(transformer))
  let _=desk.set_text(session,"movie_profile_policy",if profile==h3.profile_dc_euler_19(){"DC Euler · 19"}
    else if profile==h3.profile_quality_19(){"Euler · 19"}
    else if profile==h3.profile_donor_7(){"Donor · 7"}else{"Select in Generate"})
  let _=desk.set_text(session,"movie_attention_policy",if attention==h3.attention_ck_int8(){"CK INT8"}
    else if attention==h3.attention_dense_int8(){"Dense INT8"}
    else if attention==h3.attention_exact(){"Exact"}
    else if attention==h3.attention_donor_hybrid(){"Donor hybrid"}else{"Select in Generate"})
  ()
}

fn show_movie(session:ref<desk.Session>,project:ref<movie.Project>)
    ->unit effects{alloc,net,time}{
  let count=array.len(struct.borrow(project,field=shots))
  if count==0{return ()}
  if project.selected_shot >= count{struct.set(project,0,field=selected_shot)}
  var shot=movie.snapshot_shot(project,project.selected_shot)
  let prompt=movie.compile_project_prompt(project,project.selected_shot)
  let _=desk.set_text(session,"project_title",struct.borrow(project,field=title))
  let format_index:u32=if project.format==1{0}else if project.format==0{1}else{2}
  let _=desk.set_number(session,"movie_format","selected",cast.float(format_index))
  let _=desk.set_number(session,"movie_target","value",project.target_duration)
  let _=desk.set_number(session,"movie_takes","value",cast.float(project.takes_per_shot))
  let _=desk.set_text(session,"director_bible_buffer",struct.borrow(project,field=director_bible))
  let _=desk.set_text(session,"continuity_bible_buffer",struct.borrow(project,field=continuity_bible))
  let _=desk.set_text(session,"brand_bible_buffer",struct.borrow(project,field=brand_bible))
  let _=desk.set_number(session,"movie_endless_target","value",project.endless_target)
  let _=desk.set_number(session,"movie_endless_segment","value",project.endless_segment)
  let _=desk.set_text(session,"movie_endless_status",if project.endless_active{
    "Running · each segment continues from the preceding native latent tail."}
    else{"Stopped · project can resume from its final selected take."})
  let _=desk.set_text(session,"movie_shot_count",text.concat(str.view(string.from_int(count)),if count==1{" shot"}else{" shots"}))
  let _=desk.set_text(session,"movie_deck_count",str.view(string.from_int(count)))
  let total=movie.total_seconds(project)
  let _=desk.set_text(session,"movie_cut_duration",text.concat(str.view(string.from_float(total)),"s cut"))
  let _=desk.set_text(session,"movie_timecode",text.concat(str.view(movie_time(total)),
    text.concat(" · DELIVERY ",text.concat(str.view(string.from_int(project.delivery_fps))," FPS"))))
  let _=desk.set_text(session,"movie_shot_title",struct.borrow(shot,field=title))
  let _=desk.set_number(session,"movie_duration","value",shot.duration)
  let _=desk.set_number(session,"movie_width","value",cast.float(shot.width))
  let _=desk.set_number(session,"movie_height","value",cast.float(shot.height))
  let resolution:u32=if shot.width==1344 and shot.height==768{0}
    else if shot.width==1536 and shot.height==672{1}
    else if shot.width==1024 and shot.height==768{2}
    else if shot.width==768 and shot.height==768{3}
    else if shot.width==768 and shot.height==1024{4}
    else if shot.width==768 and shot.height==1344{5}
    else if shot.width==832 and shot.height==480{6}else{7}
  let _=desk.set_number(session,"movie_resolution","selected",cast.float(resolution))
  let _=desk.set_bool(session,"movie_locked","active",shot.locked)
  let opening_name=if str.len(struct.borrow(shot,field=first_frame))==0{
    string.copy("No opening frame")}else{path.basename(struct.borrow(shot,field=first_frame))}
  let ending_name=if str.len(struct.borrow(shot,field=last_frame))==0{
    string.copy("No ending frame")}else{path.basename(struct.borrow(shot,field=last_frame))}
  let _=desk.set_text(session,"movie_opening_name",str.view(opening_name))
  let _=desk.set_text(session,"movie_ending_name",str.view(ending_name))
  let _=desk.set_text(session,"movie_brief_buffer",struct.borrow(shot,field=brief))
  let _=desk.set_text(session,"movie_plan_buffer",struct.borrow(shot,field=plan))
  let _=desk.set_text(session,"movie_prompt_buffer",str.view(prompt))
  let _=desk.set_text(session,"movie_soundscape_buffer",struct.borrow(shot,field=soundscape))
  let _=desk.set_text(session,"movie_music_buffer",struct.borrow(shot,field=music))
  let mode=movie.mode_label(shot)
  let _=desk.set_text(session,"movie_monitor_mode",text.concat("Shot ",text.concat(
    str.view(string.from_int(project.selected_shot+1)),text.concat(" · ",str.view(mode)))))
  let _=desk.set_text(session,"movie_monitor_title",struct.borrow(shot,field=title))
  let take_count=array.len(struct.borrow(shot,field=takes))
  let monitor_status=if take_count==0{
    string.copy("Write the beat, stage references, then render this shot.")}else{
    text.concat(str.view(string.from_int(take_count))," take(s) in this shot")}
  let _=desk.set_text(session,"movie_monitor_status",str.view(monitor_status))
  let _=desk.set_text(session,"movie_monitor_contract",text.concat(str.view(string.from_int(shot.width)),
    text.concat("×",text.concat(str.view(string.from_int(shot.height)),text.concat(" · ",
    text.concat(str.view(string.from_float(shot.duration)),"s · H3 NATIVE 24 FPS · SYNC AUDIO"))))))
  var shot_labels:array<string> = []
  var timeline=string.new()
  var cursor:f64=0.0
  var i:u64=0
  loop{if i >= count{break}
    var item=movie.snapshot_shot(project,i)
    let item_mode=movie.mode(item)
    let item_takes=array.len(struct.borrow(item,field=takes))
    var label=string.copy(if i==project.selected_shot{"● "}else{"  "})
    string.append(label,str.view(string.from_int(i+1)))
    string.append(label,"  ")
    string.append(label,struct.borrow(item,field=title))
    string.append(label," · ")
    string.append(label,str.view(item_mode))
    string.append(label," · ")
    string.append(label,str.view(string.from_float(item.duration)))
    string.append(label,"s · ")
    if item_takes==0{string.append(label,"Unrendered")}else{
      string.append(label,str.view(string.from_int(item_takes)))
      string.append(label," take(s)")
    }
    array.push(shot_labels,label)
    if i!=0{string.append(timeline,"    →    ")}
    string.append(timeline,str.view(string.from_int(i+1)))
    string.append(timeline,"  ")
    string.append(timeline,struct.borrow(item,field=title))
    string.append(timeline,"  ")
    string.append(timeline,str.view(movie_time(cursor)))
    string.append(timeline," → ")
    cursor=cursor+item.duration
    string.append(timeline,str.view(movie_time(cursor)))
    i=i+1
  }
  movie_items(session,"movie_shot_list",shot_labels)
  let _=desk.select(session,"movie_shot_list",str.view(string.from_int(project.selected_shot)))
  let _=desk.set_text(session,"movie_timeline",str.view(timeline))
  var ref_labels:array<string> = []
  i=0
  loop{if i >= array.len(struct.borrow(shot,field=references)){break}
    var reference_label=text.concat("Picture ",str.view(string.from_int(i+1)))
    string.append(reference_label," · ")
    string.append(reference_label,path.basename(array.borrow(
      struct.borrow(shot,field=references),i)))
    array.push(ref_labels,reference_label)
    i=i+1}
  movie_items(session,"movie_reference_list",ref_labels)
  let _=desk.set_bool(session,"movie_remove_reference","sensitive",array.len(ref_labels)!=0)
  var cast_labels: array<string> = array.new()
  i=0
  loop {if i>=array.len(struct.borrow(project,field=characters)){break}
    let character=array.borrow(struct.borrow(project,field=characters),i)
    array.push(cast_labels,text.concat(struct.borrow(character,field=name),
      text.concat(" · ",text.concat(struct.borrow(character,field=role),
      text.concat(" · ",path.basename(struct.borrow(character,field=image)))))))
    i=i+1}
  movie_items(session,"movie_cast_list",cast_labels)
  if array.len(cast_labels)!=0 {
    if project.selected_character>=array.len(cast_labels){struct.set(project,0,field=selected_character)}
    let selected_character=project.selected_character
    let character=array.borrow(struct.borrow(project,field=characters),selected_character)
    let _=desk.select(session,"movie_cast_list",str.view(string.from_int(selected_character)))
    let _=desk.set_text(session,"movie_character_name",struct.borrow(character,field=name))
    let _=desk.set_text(session,"movie_character_role",struct.borrow(character,field=role))
    let _=desk.set_text(session,"movie_character_identity_buffer",struct.borrow(character,field=identity))
  } else {
    let _=desk.set_text(session,"movie_character_name","")
    let _=desk.set_text(session,"movie_character_role","")
    let _=desk.set_text(session,"movie_character_identity_buffer","")
  }
  var take_labels:array<string> = []
  i=0
  loop{if i >= take_count{break}
    let take=array.borrow(struct.borrow(shot,field=takes),i)
    let selected_take:u64=cast.wrap(shot.selected_take)
    var take_label=string.copy(if selected_take==i{"✓ "}else{"  "})
    string.append(take_label,"Take ")
    string.append(take_label,str.view(string.from_int(i+1)))
    string.append(take_label," · ")
    string.append(take_label,struct.borrow(take,field=state))
    string.append(take_label," · ")
    string.append(take_label,path.basename(struct.borrow(take,field=output)))
    array.push(take_labels,take_label)
    i=i+1}
  movie_items(session,"movie_take_list",take_labels)
  let selected_take:u64=cast.wrap(shot.selected_take)
  if shot.selected_take >= 0 and selected_take < take_count{
    let take=array.borrow(struct.borrow(shot,field=takes),selected_take)
    if take.state=="done" and str.len(struct.borrow(take,field=output))!=0{
      let _=desk.set_bool(session,"movie_monitor_empty","visible",false)
      let _=desk.set_bool(session,"movie_monitor_video","visible",true)
      let _=desk.play(session,"movie_monitor_video",struct.borrow(take,field=output))
    }
  }else{
    let _=desk.set_bool(session,"movie_monitor_empty","visible",true)
    let _=desk.set_bool(session,"movie_monitor_video","visible",false)
  }
  let _=desk.set_bool(session,"continue_take","sensitive",shot.selected_take>=0)
  var completed:u64=0
  i=0
  loop{if i >= count{break}
    var candidate=movie.snapshot_shot(project,i)
    if candidate.selected_take>=0{completed=completed+1}
    i=i+1}
  let _=desk.set_bool(session,"assemble_movie","sensitive",completed!=0)
  ()
}

fn absolute(value: str) -> result<string,string> effects {alloc,fs.read} {
  if path.is_absolute(value) { return result.ok(path.normalize(value)) }
  let cwd: string = match files.cwd() {
    ok(found) => found,
    err(problem) => { return result.err(text.copy(problem.message)) },
  }
  result.ok(path.join(cwd, value))
}

fn select_mode(session: ref<desk.Session>, mode: str) -> unit effects {alloc,net,time} {
  let _ = desk.set_string(session,"app_surface","visible-child-name","workspace")
  let _ = desk.set_string(session, "main_stack", "visible-child-name", mode)
  let _ = desk.set_bool(session, "nav_generate", "active", mode == "generate")
  let _ = desk.set_bool(session, "nav_edit", "active", mode == "edit")
  let _ = desk.set_bool(session,"nav_image_edit","active",mode=="image_edit")
  let _ = desk.set_bool(session, "nav_movie", "active", mode == "movie")
  let _ = desk.set_bool(session, "nav_control", "active", mode == "control")
  let _ = desk.set_bool(session, "nav_prompt", "active", mode == "prompt")
  let _ = desk.set_bool(session, "nav_settings", "active", mode == "settings")
  let title: str = if mode == "edit" { "Edit" }
    else if mode=="image_edit"{"Image Edit"}
    else if mode == "movie" { "Movie Maker" }
    else if mode == "control" { "H3 ControlNet" }
    else if mode == "prompt" { "Prompt Lab / Director" }
    else if mode == "settings" { "Settings" }
    else { "Generate" }
  let _ = desk.set_text(session, "active_mode", title)
  let _ = desk.set_text(session, "status", text.concat(title, " ready"))
  ()
}

fn action_status(session: ref<desk.Session>, id: str) -> unit effects {alloc,net,time} {
  let message: str = if id == "queue_take" { "H3 take staged · runtime wiring comes next" }
    else if id == "control_action" { "ControlNet controls staged · runtime wiring comes next" }
    else if id == "new_project" { "New movie project wiring comes next" }
    else { "Editor control staged for the next functionality pass" }
  let _ = desk.set_text(session, "status", message)
  ()
}

fn show_media(session: ref<desk.Session>, id: str, filename: str,
              media_kind: media.Kind) -> unit
  effects {alloc,io.write,net,time} {
  let first: bool = id == "choose_reference"
  let last: bool = id == "choose_last_reference"
  let title_id: str = if first { "reference_name" }
    else if last { "last_reference_name" } else { "control_name" }
  let detail_id: str = if first { "reference_detail" }
    else if last { "last_reference_detail" } else { "control_detail" }
  let picture_id: str = if first { "reference_preview" }
    else if last { "last_reference_preview" } else { "control_preview" }
  let name: string = path.basename(filename)
  let _ = desk.set_text(session, title_id, str.view(name))
  let _ = desk.set_text(session, detail_id, filename)
  if first or last {
    let _ = desk.set_bool(session, if last { "clear_last_reference" } else { "clear_reference" }, "sensitive", true)
  }
  if media_kind == media.Kind.Image {
    let _ = desk.picture(session, picture_id, filename)
    let _ = desk.set_bool(session, picture_id, "visible", true)
  } else {
    let _ = desk.picture(session, picture_id, "")
    let _ = desk.set_bool(session, picture_id, "visible", false)
  }
  let slot: str = if first { "first-reference" }
    else if last { "last-reference" } else { "control" }
  let label: string = media.kind_name(media_kind)
  let _ = desk.set_text(session, "status", text.concat("Selected H3 ",
    text.concat(slot, text.concat(" ", text.concat(str.view(label), text.concat(": ", str.view(name)))))))
  io.write(text.concat("mm-air media selected ", text.concat(slot, text.concat("=", text.concat(filename, "\n")))))
  ()
}

fn media_error(problem: ref<media.Error>) -> string effects {alloc} {
  let filename: str = str.view(struct.borrow(problem, field=path))
  if problem.code == media.ErrorCode.NotRegularFile {
    return text.concat("Cannot add media: not a regular file: ", filename)
  }
  if problem.code == media.ErrorCode.TooLarge {
    return text.concat("Cannot add media: file exceeds the 8 GiB selection limit: ", filename)
  }
  text.concat("Cannot read media: ", filename)
}

fn accept_media(session: ref<desk.Session>, id: str, filename: str) -> bool
  effects {alloc,fs.meta,io.write,net,time} {
  match media.inspect(filename, 8589934592) {
    err(found) => {
      var problem: media.Error = found
      let message: string = media_error(problem)
      let _ = desk.set_text(session, "status", str.view(message))
      io.write(text.concat("mm-air media rejected=", text.concat(filename, "\n")))
      false
    },
    ok(found) => {
      var info: media.Info = found
      let control: bool = id == "choose_control"
      if info.kind == media.Kind.Unknown or (control and info.kind == media.Kind.Audio) or
         (not control and info.kind != media.Kind.Image) {
        let _ = desk.set_text(session, "status",
          text.concat("Cannot add H3 reference/control media type: ", filename))
        io.write(text.concat("mm-air media rejected=", text.concat(filename, "\n")))
        return false
      }
      show_media(session, id, filename, info.kind)
      true
    },
  }
}

fn selected_references(first: str, last: str) -> array<string> effects {alloc} {
  var out: array<string> = array.new()
  if str.len(first) != 0 { array.push(out, text.copy(first)) }
  if str.len(last) != 0 { array.push(out, text.copy(last)) }
  out
}

fn random_seed() -> i64 effects {alloc,random,time} {
  var data=match system.secure_random(7) {
    ok(value)=>value,
    err(_)=>{return cast.sat(time.monotonic_ns())},
  }
  var value:u64=0
  var index:u64=0
  loop {
    if index >= 7{break}
    let byte_value:u8=cast.bits(view.get(bytes.view(data),index))
    value=value*256+cast.wrap(byte_value)
    index=index+1
  }
  cast.sat(value)
}

pub fn main(args: view<str>) -> i32
  effects {alloc,env,ffi,fs.read,fs.meta,fs.write,gpu,io.write,net,time,thread,process,random} {
  let program: string = match system.executable_path() {
    ok(found) => found,
    err(problem) => { return fail(text.concat("Cannot locate MM-Air executable: ",problem.message)) },
  }
  let bindir: string = path.dirname(program)
  let configured_output=match runtime_config.value("MM_AIR_OUTPUT_ROOT"){
    ok(value)=>value,err(problem)=>{return fail(problem)},}
  var output_directory:string=match configured_output{
    some(value)=>path.normalize(value),none=>path.join(
      match library.data_directory(){ok(value)=>value,err(problem)=>{return fail(problem)}},"Output")}
  var local_settings=match settings.load(output_directory){ok(value)=>value,
    err(problem)=>{return fail(problem)},}
  let bundled_shared = path.join(bindir, "share/mm-air")
  let shared: string = if match files.exists(path.join(bundled_shared,"desktop.ui")) {
    ok(found) => found, err(_) => false,
  } { string.copy(bundled_shared) } else { path.join(path.dirname(bindir), "share/mm-air") }
  let open_parameters: bool = view.len(args) > 1 and view.get(args, 1) == "--parameters"
  if open_parameters and view.len(args) != 3 { return fail("Usage: mm-air --parameters FILE.json") }
  let layout: string = if view.len(args) > 1 and not open_parameters { text.copy(view.get(args, 1)) }
    else { path.join(shared, "desktop.ui") }
  let css: string = if view.len(args) > 2 and not open_parameters { text.copy(view.get(args, 2)) }
    else { path.join(shared, "desktop.css") }
  let helper: string = if view.len(args) > 3 { text.copy(view.get(args, 3)) }
    else {match runtime_config.value("MM_AIR_UI_HOST"){
      ok(value)=>match value{some(host)=>host,none=>path.join(bindir,"air-ui")},
      err(problem)=>{return fail(problem)},}}

  var reference_media: string = string.new()
  // The Generate LoRA control is shared by Krea and H3. Saved parameter files
  // retain the active model's entry, and model-specific loaders validate it.
  var generate_loras: array<parameters.LoraEntry> = []
  var selected_lora: u64 = 18446744073709551615
  var last_reference_media: string = string.new()
  var control_media: string = string.new()
  var output_media: string = string.new()
  var prompt: string = text.copy("A cinematic wide shot with natural motion, detailed atmosphere, and synchronized environmental audio.")
  var model_index: u32 = 0
  var task_index: u32 = h3.task_t2va()
  var profile_index: u32 = h3.profile_quality_19()
  var conditioner_projection_index: u32 = h3.projection_exact_bf16()
  var transformer_projection_index: u32 = h3.projection_convrot_int8()
  var attention_index: u32 = h3.attention_ck_int8()
  var generation_mode: u32 = character_swap.standard()
  var character_sheet_mode: u32 = character_sheet.off()
  var character_sheet_style: u32 = character_sheet.keep_picture_style()
  var resolution_index: u32 = 6
  var qwen_image_resolution_index:u32=0
  var qwen_turbo:bool=layout_memory.turbo()
  var qwen_image_steps:u64=if qwen_turbo{qwen_image_contract.turbo_steps()}
    else{qwen_image_contract.default_steps()}
  var qwen_image_scheduler:u32=qwen_image_contract.scheduler_creator_dynamic()
  var qwen_image_sampler:u32=qwen_image_contract.sampler_euler()
  var width: u64 = 832
  var height: u64 = 480
  var seconds: f64 = 5.0
  var saved_h3_width: u64 = width
  var saved_h3_height: u64 = height
  var saved_h3_seconds: f64 = seconds
  var saved_h3_resolution: u32 = resolution_index
  var saved_h3_output: string = string.new()
  var saved_krea_width:u64=1024
  var saved_krea_height:u64=1024
  var saved_qwen_width:u64=qwen_image_contract.default_width()
  var saved_qwen_height:u64=qwen_image_contract.default_height()
  var saved_krea_output: string = string.new()
  var saved_qwen_output:string=string.new()
  var visual_references: array<library.Item> = []
  var audio_references: array<library.Item> = []
  var swap_source_video: string = string.new()
  var swap_character_references: array<library.Item> = []
  var selected_swap_character: string = string.new()
  var swap_target_mode: u32 = character_swap.replace_main()
  var swap_target_notes: string = string.new()
  var swap_notes: string = string.new()
  var swap_preserve_environment: bool = true
  var swap_preserve_camera: bool = true
  var swap_strong_identity: bool = true
  var swap_prompt_built: bool = false
  var swap_built_prompt: string = string.new()
  var swap_mask_path: string = string.new()
  var swap_manual_mask: bool = false
  var swap_mask_x: f64 = 0.0
  var swap_mask_y: f64 = 0.0
  var swap_mask_width: f64 = 0.0
  var swap_mask_height: f64 = 0.0
  var swap_painted_mask:bool=false
  var swap_brush_points:array<masked_edit.BrushPoint> = []
  var swap_mask_preserve: bool = true
  var swap_mask_feather: u64 = 8
  var swap_mask_cleanup: u64 = 2
  var swap_mask_expand: i64 = 4
  var swap_mask_strategy: u32 = 0
  var swap_mask_padding: u64 = 96
  var edit_source: string = string.new()
  var edit_mask_path: string = string.new()
  var edit_auto_mask_prompt:string=string.copy("person")
  var edit_auto_mask_started:u64=0
  var edit_manual_mask: bool = false
  var edit_mask_x: f64 = 0.0
  var edit_mask_y: f64 = 0.0
  var edit_mask_width: f64 = 0.0
  var edit_mask_height: f64 = 0.0
  var edit_brush_points:array<masked_edit.BrushPoint> = []
  var edit_brush_radius:f64=0.06
  var edit_erase_mask:bool=false
  var edit_source_video:bool=false
  var edit_source_width:u64=0
  var edit_source_height:u64=0
  var edit_source_frames:u64=0
  var edit_mask_video_source:bool=false
  var edit_duration:f64=0.0
  var edit_position:f64=0.0
  var edit_playing:bool=false
  var edit_painting:bool=false
  var edit_showing_result:bool=false
  let edit_frame_preview=path.join(system.temp_directory(),text.concat("mm-air-edit-frame-",
    text.concat(str.view(string.from_int(time.monotonic_ns())),".png")))
  var edit_references: array<library.Item> = []
  var edit_prompt: string = string.copy("Replace the main character with the character shown in the reference image. Preserve the source action, camera, lighting, environment, timing, and audio.")
  var edit_mode: u32 = 2
  var edit_preserve: bool = true
  var edit_feather: u64 = 8
  var edit_cleanup: u64 = 2
  var edit_expand: i64 = 4
  var edit_strategy: u32 = 0
  var edit_padding: u64 = 96
  var edit_result: string = string.new()
  var edit_outpaint_width:u64=1344
  var edit_outpaint_height:u64=768
  var edit_outpaint_direction:u32=outpaint.right()
  var edit_outpaint_anchor:u32=outpaint.anchor_center()
  var edit_outpaint_composite:u32=outpaint.exact()
  var edit_outpaint_seam:u64=8
  var edit_outpaint_window_seconds:f64=5.1666667
  var edit_outpaint_overlap_seconds:f64=0.9166667
  var edit_outpaint_preview:bool=false
  var edit_repair_first:u64=0
  var edit_repair_end:u64=24
  var edit_repair_handle_before:u64=5
  var edit_repair_handle_after:u64=5
  var edit_repair_dilation:f64=2.0
  var edit_repair_cuts=string.new()
  var edit_repair_memory:u32=0
  var edit_repair_window:u64=124
  var edit_repair_overlap:u64=22
  var edit_motion_plan=repair_motion.create(1)
  var edit_motion_plan_ready:bool=false
  var edit_timing_mode:u32=0
  var edit_timing_block_lo:u64=30
  var edit_timing_block_hi:u64=49
  var edit_timing_fade:f32=0.7
  var edit_timing_step_lo:u64=0
  var edit_timing_step_hi:u64=18
  var edit_generation_active:bool=false
  var qwen_edit_active:bool=false
  var qwen_edit_source:string=string.new()
  var qwen_edit_references: array<string> = array.new()
  var qwen_edit_selected:u64=0
  var qwen_edit_seed:u64=cast.wrap(random_seed())
  var qwen_edit_seed_locked:bool=false
  // Image Edit model: false = Qwen-Image-2.1, true = FLUX 3 Image Klein.
  var qwen_edit_flux:bool=false
  var qwen_edit_match_source:bool=true
  var qwen_edit_enhance:bool=true
  // "Enhance prompt" on Generate: FLUX 3's upsampler or Qwen-Image's enhancer.
  var enhance_prompt:bool=true
  var qwen_edit_prompt:string=text.copy(
    "Describe the requested change while preserving the source composition and identity.")
  var qwen_edit_width:u64=qwen_image_contract.default_width()
  var qwen_edit_height:u64=qwen_image_contract.default_height()
  var qwen_edit_resolution_index:u32=0
  var qwen_edit_result:string=string.new()
  var history: array<library.Item> = match library.load_history() {
    ok(value) => value,
    err(message) => { io.ewrite(text.concat(message, "\n"))
      [] },
  }
  var current: array<library.Item> = []
  var selected_visual: string = string.new()
  var selected_audio: string = string.new()
  var saved_parameters: string = string.new()
  var selected_result: string = string.new()
  var pending_parameters: string = string.new()
  var startup_warning:string=string.new()
  let initial_parameters=if open_parameters{option.some(text.copy(view.get(args,2)))}else if view.len(args)==1{
    match runtime_config.value("MM_AIR_PARAMETERS_FILE"){
      ok(value)=>value,err(problem)=>{return fail(problem)},}}else{option.none()}
  match initial_parameters { some(filename)=>{
    pending_parameters = match files.read_text(filename) {
      ok(value) => value,
      err(error) => {
        let message=text.concat("Cannot restore startup parameters from ",
          text.concat(filename,text.concat(": ",fs.error.message(error))))
        if open_parameters{return fail(message)}
        startup_warning=message
        string.new()
      },
    }
  },none=>{},}
  var running_parameters: string = string.new()
  var generation_started: u64 = 0
  var seed:i64=random_seed()
  var seed_valid: bool = true
  var seed_locked:bool=false
  var seedvr2_enabled:bool=false
  var seedvr2_run_after:bool=true
  var seedvr2_variant:u32=0
  var seedvr2_size:u32=0
  var seedvr2_width:u64=1664
  var seedvr2_height:u64=960
  var seedvr2_audio:bool=true
  var seedvr2_seed:u64=42
  var seedvr2_seed_valid:bool=true
  var seedvr2_quality:u32=0
  var seedvr2_memory:u32=0
  var prompt_state = prompt_session.create(prompt_types.ModelChoice.Qwen3VL4B)
  var prompt_instruction: string = string.copy("Expand this into a cinematic H3 prompt.")
  var prompt_model_index: u32 = 0
  var prompt_task_index: u32 = 0
  var prompt_transform: prompt_types.Transform = prompt_types.Transform.ExpandH3
  var prompt_total_seconds:f64=60.0
  var prompt_window_seconds:f64=20.0
  var prompt_overlap_seconds:f64=3.0
  var prompt_started: u64 = 0
  var prompt_cancel_path: string = string.new()
  var prompt_target: u32 = 0
  var swap_prompt_state = prompt_session.create(prompt_types.ModelChoice.Qwen3VL4B)
  var movie_library_root=path.join(output_directory,"movies")
  let movie_project_fallback=path.join(str.view(movie_library_root),
    "current.serenitymovie.json")
  var movie_project_path=movie.selected_library_path(str.view(movie_library_root),
    str.view(movie_project_fallback))
  var movie_library_paths=match movie.library_paths(str.view(movie_library_root)){
    ok(value)=>value,err(message)=>{io.ewrite(text.concat(message,"\n"))
      array.new()}}
  var movie_state=match movie.load(str.view(movie_project_path)){
    ok(value)=>value,err(message)=>{io.ewrite(text.concat("Movie load: ",text.concat(message,"\n")))
      movie.create()}}
  var movie_generation_active:bool=false
  var movie_generation_shot:u64=0
  var movie_render_all:bool=false
  var movie_motion_context:string=string.new()
  var movie_motion_context_frames:u64=22
  var movie_motion_output_frames:u64=0
  var movie_drift_enabled:bool=false
  var movie_drift_matched:u64=5
  var movie_drift_taper:u64=2
  var movie_drift_amount:f32=0.35
  var movie_director_input=string.copy("Build a short film from this idea, preserving subject identity and screen direction across every shot.")
  var prompt_manifest_directory: string = match prompt_lab.manifest_directory(bindir) {
    ok(value) => value,
    err(message) => {return fail(message)},
  }
  let sam3_plugin:string=match env.get("MM_AIR_SAM3_PLUGIN"){
    some(value)=>string.copy(value),none=>path.join(bindir,"libair_sam3.so")}
  let sam3_home:string=match env.get("HOME"){
    some(value)=>string.copy(value),none=>string.copy("/home/alex")}
  let sam3_model:string=match env.get("MM_AIR_SAM3_MODEL"){
    some(value)=>string.copy(value),none=>path.join(str.view(sam3_home),
      ".serenity/models/sam3/sam3-q4_0.ggml")}

  var session: desk.Session = match desk.prepare(helper, layout, css) {
    ok(found) => found,
    err(problem) => { return fail(problem) },
  }
  var result_code: i32 = 0
  task.scope {
    var hosts: array<task<proc.Exit>> = [task.spawn(desk.plan(session), fn=proc.start)]
    var generations: array<task<generation.Outcome>> = array.new()
    var copies: array<task<result<string, string>>> = array.new()
    var side_jobs: array<task<result<string, string>>> = array.new()
    var prompt_jobs: array<task<prompt_lab.Outcome>> = array.new()
    var auto_mask_jobs:array<task<auto_mask.Outcome>> = array.new()
    var progress_receivers: array<channel.Receiver> = array.new()
    match desk.connect(session) {
      err(problem) => { result_code = fail(problem) },
      ok(_) => {
        if startup_warning!=""{io.ewrite(text.concat(startup_warning,"\n"))}
        let _ = desk.shortcut(session, "<Control>1", "show_generate")
        let _ = desk.shortcut(session, "<Control>2", "show_edit")
        let _ = desk.shortcut(session,"<Control>3","show_image_edit")
        let _ = desk.shortcut(session, "<Control>4", "show_movie")
        let _ = desk.shortcut(session, "<Control>5", "show_control")
        let _ = desk.shortcut(session, "<Control>6", "show_prompt")
        let _ = desk.shortcut(session, "<Control>comma", "show_settings")
        let _ = desk.shortcut(session, "<Control>o", "choose_reference")
        let _ = desk.shortcut(session, "<Control>l", "choose_last_reference")
        let _ = desk.shortcut(session, "<Control><Shift>o", "choose_control")
        let _ = desk.shortcut(session, "<Control>s", "choose_output")
        let _ = desk.shortcut(session, "<Control><Shift>s", "gen_save_parameters")
        let _ = desk.shortcut(session, "<Control><Shift>l", "gen_load_parameters")
        let _ = desk.shortcut(session, "<Control>r", "gen_reuse_parameters")
        let _ = desk.shortcut(session, "<Control><Shift>r", "reset_generate")
        let _ = desk.shortcut(session, "F5", "generate_action")
        let _ = desk.shortcut(session, "<Control>q", "quit")
        let _ = desk.shortcut(session, "Escape", "result_fullscreen_close")
        settings.show(session,local_settings)
        match settings.apply(session,local_settings){ok(_)=>{},
          err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
        let _=desk.set_text(session,"gen_seed",str.view(string.from_int(seed)))
        let _=desk.set_bool(session,"gen_seed_lock","active",seed_locked)
        let initial_qwen_edit_seed:i64=cast.sat(qwen_edit_seed)
        let _=desk.set_text(session,"qwen_edit_seed",str.view(string.from_int(
          initial_qwen_edit_seed)))
        let _=desk.set_bool(session,"qwen_edit_seed_lock","active",qwen_edit_seed_locked)
        show_qwen_turbo(session,qwen_turbo)
        let _=desk.set_number(session,"qwen_image_steps","value",cast.float(qwen_image_steps))
        let _=desk.set_number(session,"qwen_edit_steps","value",cast.float(qwen_image_steps))
        layout_memory.restore(session)
        update_qwen_edit_sources(session,qwen_edit_references)
        select_mode(session, "generate")
        source_widgets(session, task_index)
        model_widgets(session,model_index,character_sheet_mode,generation_mode)
        show_gallery_items(session,"gen_history",history)
        show_prompt_session(session,prompt_state)
        show_prompt_model(session,prompt_model_index)
        show_movie(session,movie_state)
        show_movie_runtime_policy(session,profile_index,conditioner_projection_index,
          transformer_projection_index,attention_index)
        // Snapshot restored fields, so layout defaults cannot overwrite a saved Movie.
        if pending_parameters == "" { let _ = desk.snapshot(session) }
        show_project_library(session,movie_library_paths,str.view(movie_project_path))
        match save_movie(movie_state,str.view(movie_project_path)){
          ok(_)=>{},err(message)=>{io.ewrite(text.concat("Movie autosave: ",text.concat(message,"\n")))}}
        save_movie_selection(str.view(movie_library_root),str.view(movie_project_path))
        movie_library_paths=match movie.library_paths(str.view(movie_library_root)){
          ok(paths)=>paths,err(_)=>copy_paths(movie_library_paths)}
        show_project_library(session,movie_library_paths,str.view(movie_project_path))
        let _=show_prompt_window_plan(session,prompt_total_seconds,
          prompt_window_seconds,prompt_overlap_seconds)
        let _ = desk.set_bool(session, "gen_history_empty", "visible", array.len(history) == 0)
        loop {
          if pending_parameters != "" {
            if parameters.is_qwen_image(pending_parameters){
              match parameters.decode_qwen_image(pending_parameters){
                ok(restored)=>{var request=restored
                  if struct.borrow(request,field=source)!="" or
                     array.len(struct.borrow(request,field=references))!=0{
                    qwen_edit_prompt=string.copy(struct.borrow(request,field=prompt))
                    qwen_edit_references=array.new()
                    if struct.borrow(request,field=source)!=""{
                      array.push(qwen_edit_references,string.copy(
                        struct.borrow(request,field=source)))
                    }
                    var restored_reference:u64=0
                    loop{
                      if restored_reference>=array.len(struct.borrow(
                          request,field=references)){break}
                      array.push(qwen_edit_references,string.copy(str.view(array.borrow(
                        struct.borrow(request,field=references),restored_reference))))
                      restored_reference=restored_reference+1
                    }
                    qwen_edit_source=string.copy(str.view(array.borrow(qwen_edit_references,0)))
                    qwen_edit_result=string.copy(struct.borrow(request,field=output))
                    let _=desk.set_text(session,"qwen_edit_prompt_buffer",str.view(qwen_edit_prompt))
                    qwen_edit_width=request.width
                    qwen_edit_height=request.height
                    qwen_edit_resolution_index=match qwen_image_contract.resolution_index(
                      request.width,request.height){some(index)=>index,none=>qwen_image_contract.resolution_custom()}
                    let _=desk.set_number(session,"qwen_edit_width","value",cast.float(qwen_edit_width))
                    let _=desk.set_number(session,"qwen_edit_height","value",cast.float(qwen_edit_height))
                    qwen_image_steps=request.steps
                    qwen_turbo=request.scheduler==qwen_image_contract.scheduler_turbo()
                    qwen_image_scheduler=if qwen_turbo{qwen_image_contract.scheduler_creator_dynamic()}
                      else{request.scheduler}
                    qwen_image_sampler=request.sampler
                    qwen_edit_seed=request.seed
                    let _=desk.set_number(session,"qwen_edit_resolution","selected",
                      cast.float(qwen_edit_resolution_index))
                    let _=desk.set_number(session,"qwen_edit_steps","value",cast.float(request.steps))
                    let _=desk.set_number(session,"qwen_edit_scheduler","selected",cast.float(qwen_image_scheduler))
                    show_qwen_turbo(session,qwen_turbo)
                    let _=desk.set_number(session,"qwen_edit_sampler","selected",cast.float(request.sampler))
                    let restored_seed:i64=cast.sat(request.seed)
                    let _=desk.set_text(session,"qwen_edit_seed",str.view(string.from_int(restored_seed)))
                    update_qwen_edit_sources(session,qwen_edit_references)
                    select_mode(session,"image_edit")
                    let _=desk.set_text(session,"status","Qwen Image Edit parameters restored")
                  }else{
                    if model_index!=parameters.krea_model_index() and
                       model_index!=parameters.qwen_image_model_index(){
                      saved_h3_width=width
                      saved_h3_height=height
                      saved_h3_seconds=seconds
                      saved_h3_resolution=resolution_index
                      saved_h3_output=string.copy(output_media)
                    }
                    prompt=string.copy(struct.borrow(request,field=prompt))
                    output_media=string.copy(struct.borrow(request,field=output))
                    saved_qwen_output=string.copy(output_media)
                    model_index=parameters.qwen_image_model_index()
                    width=request.width
                    height=request.height
                    saved_qwen_width=width
                    saved_qwen_height=height
                    let _=desk.set_number(session,"gen_width","value",cast.float(width))
                    let _=desk.set_number(session,"gen_height","value",cast.float(height))
                    qwen_image_steps=request.steps
                    qwen_turbo=request.scheduler==qwen_image_contract.scheduler_turbo()
                    qwen_image_scheduler=if qwen_turbo{qwen_image_contract.scheduler_creator_dynamic()}
                      else{request.scheduler}
                    qwen_image_sampler=request.sampler
                    qwen_image_resolution_index=match qwen_image_contract.resolution_index(
                        request.width,request.height){
                      some(index)=>index,
                      none=>qwen_image_contract.resolution_custom(),
                    }
                    seed=cast.sat(request.seed)
                    seed_valid=true
                    resolution_index=h3.resolution_custom()
                    let _=desk.set_number(session,"gen_model","selected",cast.float(model_index))
                    let _=desk.set_number(session,"qwen_image_resolution","selected",
                      cast.float(qwen_image_resolution_index))
                    let _=desk.set_number(session,"qwen_image_steps","value",
                      cast.float(qwen_image_steps))
                    let _=desk.set_number(session,"qwen_image_scheduler","selected",
                      cast.float(qwen_image_scheduler))
                    let _=desk.set_number(session,"qwen_image_sampler","selected",
                      cast.float(qwen_image_sampler))
                    show_qwen_turbo(session,qwen_turbo)
                    let _=desk.set_text(session,"gen_seed",string.from_int(seed))
                    show_qwen_recipe(session,qwen_image_scheduler,qwen_image_sampler)
                    let _=desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
                    model_widgets(session,parameters.qwen_image_model_index(),character_sheet_mode,generation_mode)
                    geometry_widgets(session,width,height,seconds,false,true)
                    select_mode(session,"generate")
                    let _=desk.set_text(session,"status","Qwen Generate parameters restored")
                  }
                },
                err(message)=>{let _=desk.set_text(session,"status",message)},
              }
              pending_parameters=string.new()
              continue
            }
            if parameters.is_krea(pending_parameters) {
              match parameters.decode_krea(pending_parameters) {
                ok(restored) => {
                  var request = restored
                  generate_loras = parameters.clone_loras(struct.borrow(request,field=loras))
                  selected_lora = 18446744073709551615
                  show_loras(session,generate_loras,selected_lora)
                  if model_index != parameters.krea_model_index() and
                     model_index != parameters.qwen_image_model_index() {
                    saved_h3_width = width
                    saved_h3_height = height
                    saved_h3_seconds = seconds
                    saved_h3_resolution = resolution_index
                    saved_h3_output = string.copy(output_media)
                  }
                  prompt = string.copy(struct.borrow(request,field=prompt))
                  seed = request.seed
                  seed_valid = true
                  width = request.width
                  height = request.height
                  saved_krea_width=width
                  saved_krea_height=height
                  output_media = string.copy(struct.borrow(request,field=output))
                  saved_krea_output = string.copy(output_media)
                  model_index = parameters.krea_model_index()
                  resolution_index = h3.resolution_custom()
                  let _ = desk.set_number(session,"gen_model","selected",cast.float(model_index))
                  let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
                  let _ = desk.set_number(session,"gen_width","value",cast.float(width))
                  let _ = desk.set_number(session,"gen_height","value",cast.float(height))
                  let _ = desk.set_text(session,"gen_seed",string.from_int(seed))
                  let _ = desk.set_text(session,"gen_prompt_buffer",prompt)
                  character_sheet_mode = character_sheet.off()
                  let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
                  generation_mode = character_swap.standard()
                  let _ = desk.set_number(session,"gen_mode","selected",0.0)
                  model_widgets(session,parameters.krea_model_index(),character_sheet_mode,generation_mode)
                  geometry_widgets(session,width,height,seconds,true,false)
                  let _ = desk.set_text(session,"status","Krea Generate parameters restored")
                },
                err(message) => { let _ = desk.set_text(session,"status",message) },
              }
              pending_parameters = string.new()
              continue
            }
            match parameters.decode_h3(pending_parameters) {
              err(message) => { let _ = desk.set_text(session, "status", message) },
              ok(value) => {
                var restored_parameters: parameters.H3Parameters = value
                generate_loras = parameters.clone_loras(
                  struct.borrow(restored_parameters,field=loras))
                selected_lora = 18446744073709551615
                show_loras(session,generate_loras,selected_lora)
                var empty_restored_references: array<string> = []
                var restored: h3.Request = ref.swap(
                  struct.borrow(restored_parameters,field=request),
                  h3.request("",0,0,0,0,0,0,0,0,empty_restored_references,""))
                prompt = string.copy(struct.borrow(restored, field=prompt))
                model_index = restored.model
                task_index = restored.task
                profile_index = restored.profile
                conditioner_projection_index = restored.conditioner_projection
                transformer_projection_index = restored.transformer_projection
                attention_index = restored.attention
                show_movie_runtime_policy(session,profile_index,conditioner_projection_index,
                  transformer_projection_index,attention_index)
                resolution_index = restored.resolution
                seed = restored.seed
                seed_valid = true
                let geometry = restored.geometry
                width = geometry.width
                height = geometry.height
                resolution_index = geometry_preset(resolution_index, width, height)
                struct.set(restored, resolution_index, field=resolution)
                seconds = restored.seconds
                output_media = string.copy(struct.borrow(restored, field=output))
                reference_media = string.new()
                last_reference_media = string.new()
                visual_references = []
                audio_references = []
                selected_visual = string.new()
                selected_audio = string.new()
                clear_reference(session, false)
                clear_reference(session, true)
                let references = struct.borrow(restored, field=references)
                var i: u64 = 0
                loop {
                  if i == array.len(references) { break }
                  let filename = array.borrow(references, i)
                  if task_index == h3.task_ref2va() {
                    match library.prep_reference(filename, "") {
                      ok(item) => { array.push(visual_references, item) },
                      err(message) => {
                        array.push(visual_references, library.item(filename, "", ""))
                        io.ewrite(text.concat(message, "\n"))
                      },
                    }
                  } else if i == 0 {
                    reference_media = string.copy(filename)
                    let _ = accept_media(session, "choose_reference", filename)
                  } else if i == 1 {
                    last_reference_media = string.copy(filename)
                    let _ = accept_media(session, "choose_last_reference", filename)
                  }
                  i = i + 1
                }
                let audio = struct.borrow(restored, field=audio_references)
                i = 0
                loop {
                  if i == array.len(audio) { break }
                  match library.prep_reference(array.borrow(audio, i), "") {
                    ok(item) => { array.push(audio_references, item) },
                    err(message) => {
                      array.push(audio_references, library.item(array.borrow(audio, i), "", ""))
                      io.ewrite(text.concat(message, "\n"))
                    },
                  }
                  i = i + 1
                }
                show_items(session, "gen_visual_refs", visual_references)
                show_items(session, "gen_audio_refs", audio_references)
                reference_actions(session, false, "", array.len(visual_references))
                reference_actions(session, true, "", array.len(audio_references))
                character_sheet_mode = character_sheet.off()
                let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
                generation_mode = character_swap.standard()
                let _ = desk.set_number(session,"gen_mode","selected",0.0)
                apply_parameter_widgets(session, restored)
                let _ = desk.set_text(session, "status", "Generate parameters restored")
              },
            }
            pending_parameters = string.new()
          }
          if array.len(copies) != 0 {
            match task.wait_any(copies, 0) {
              some(_) => {
                match task.join(option.unwrap(array.pop(copies))) {
                  ok(destination) => {
                    let _ = desk.set_text(session, "status", text.concat("Copied to: ", destination))
                    io.write(text.concat("mm-air copied=", text.concat(destination, "\n")))
                  },
                  err(message) => { let _ = desk.set_text(session, "status", message)
                    io.ewrite(text.concat(message, "\n")) },
                }
              },
              none => {},
            }
          }
          if array.len(side_jobs) != 0 {
            match task.wait_any(side_jobs, 0) {
              some(_) => {
                let _ = desk.set_bool(session, "gen_side_by_side", "sensitive", true)
                match task.join(option.unwrap(array.pop(side_jobs))) {
                  ok(made) => {
                    match library.prep_output(str.view(made), "") {
                      ok(item) => {
                        var held: library.Item = item
                        array.push(current, library.item_with_postprocess(
                          struct.borrow(held, field=path), struct.borrow(held, field=thumbnail),
                          struct.borrow(held, field=parameters), struct.borrow(held, field=postprocess)))
                        array.push(history, held)
                        show_gallery_items(session,"gen_current",current)
                        show_gallery_items(session,"gen_history",history)
                        let _ = desk.set_bool(session, "gen_current_empty", "visible", false)
                        let _ = desk.set_bool(session, "gen_history_empty", "visible", false)
                        match library.save_history(history) { ok(_) => {}, err(message) => { io.ewrite(text.concat(message, "\n")) } }
                      },
                      err(message) => { io.ewrite(text.concat(message, "\n")) },
                    }
                    selected_result = string.copy(str.view(made))
                    show_result(session, str.view(made))
                    let _ = desk.set_text(session, "status", text.concat("Side-by-side movie saved: ", str.view(made)))
                    io.write(text.concat("mm-air side-by-side=", text.concat(str.view(made), "\n")))
                  },
                  err(message) => { let _ = desk.set_text(session, "status", message)
                    io.ewrite(text.concat(message, "\n")) },
                }
              },
              none => {},
            }
          }
          if array.len(auto_mask_jobs)!=0{
            let elapsed=(time.monotonic_ns()-edit_auto_mask_started)/1000000000
            let _=desk.set_text(session,"edit_status",text.concat(
              "SAM 3 tracking mask · ",text.concat(str.view(string.from_int(elapsed))," s")))
            match task.wait_any(auto_mask_jobs,0){
              some(_)=>{
                var completed=task.join(option.unwrap(array.pop(auto_mask_jobs)))
                let _=desk.set_bool(session,"edit_auto_mask","sensitive",true)
                let _=desk.set_text(session,"edit_status",
                  struct.borrow(completed,field=message))
                if completed.succeeded{
                  edit_mask_path=string.copy(struct.borrow(completed,field=mask_path))
                  edit_mask_video_source=true
                  edit_manual_mask=false
                  edit_brush_points=[]
                  let _=desk.set_bool(session,"edit_mask_overlay","visible",false)
                  let _=desk.set_bool(session,"edit_mask_video","visible",true)
                  let _=desk.play_muted(session,"edit_mask_video",str.view(edit_mask_path))
                  let _=desk.seek(session,"edit_mask_video",edit_position)
                  let _=desk.set_text(session,"edit_mask_name",text.concat(
                    "SAM 3 · ",text.concat(str.view(edit_auto_mask_prompt)," · tracked mask")))
                  generation_notification("MM-Air automatic mask ready",
                    str.view(edit_mask_path))
                }else{generation_notification("MM-Air automatic mask failed",
                  struct.borrow(completed,field=message))}
              },none=>{},
            }
          }
          if array.len(progress_receivers) != 0 {
            var drained: u64 = 0
            loop {
            if drained >= 128 { break }
            drained = drained + 1
            match channel.recv_now(array.borrow(progress_receivers, 0),
                time.monotonic_ns()) {
              ok(value) => match value {
                some(item) => { var update: channel.Message = item
                  match channel.text_of(update) {
                    some(message) => {
                      generation_status(session,str.view(message))
                      if qwen_edit_active{
                        let _=desk.set_text(session,"qwen_edit_status",str.view(message))}
                      if movie_generation_active{
                        let _=desk.set_text(session,"movie_runtime",str.view(message))}
                    },
                    none => {},
                  }
                },
                none => { break },
              },
              err(_) => { break },
            }
            }
          }
          if array.len(generations) != 0 {
            let elapsed: u64 = (time.monotonic_ns() - generation_started) / 1000000000
            let _ = desk.set_text(session, "gen_run_state",
              text.concat("Generating · ", text.concat(string.from_int(elapsed), " s")))
            let _ = desk.set_text(session,"gen_progress_elapsed",
              text.concat("Elapsed: ",text.concat(string.from_int(elapsed)," s")))
            if movie_generation_active{
              let _=desk.set_text(session,"movie_runtime",text.concat("H3 take · ",
                text.concat(str.view(string.from_int(elapsed))," s")))}
            match task.wait_any(generations, 0) {
              some(_) => {
                var completed: generation.Outcome = task.join(
                  option.unwrap(array.pop(generations)))
                match array.pop(progress_receivers) {
                  some(receiver) => { let _ = channel.close(receiver) },
                  none => {},
                }
                let _ = desk.set_bool(session, "generate_action", "sensitive", true)
                if qwen_edit_active{
                  let _=desk.set_bool(session,"qwen_edit_run","sensitive",true)
                  let _=desk.set_text(session,"qwen_edit_status",
                    struct.borrow(completed,field=message))
                }
                generation_status(session,str.view(struct.borrow(completed,field=message)))
                if completed.succeeded {
                  let seedvr2_sidecar=text.concat(
                    struct.borrow(completed,field=output),".seedvr2.json")
                  var completed_postprocess=match files.read_text(
                      str.view(seedvr2_sidecar)){
                    ok(value)=>value,err(_)=>string.new(),}
                  let sidecar = text.concat(struct.borrow(completed,field=output),".json")
                  match files.write_atomic(sidecar,text.concat(sidecar,text.concat(".tmp-",
                      string.from_int(time.monotonic_ns()))),running_parameters) {
                    ok(_) => {},
                    err(error) => { io.ewrite(text.concat("Parameter sidecar: ",text.concat(fs.error.message(error),"\n"))) },
                  }
                  match library.prep_output(struct.borrow(completed, field=output), running_parameters) {
                    ok(item) => {
                      var held: library.Item = item
                      let _=ref.swap(struct.borrow(held,field=postprocess),
                        string.copy(str.view(completed_postprocess)))
                      array.push(current, library.item_with_postprocess(
                        struct.borrow(held, field=path),
                        struct.borrow(held, field=thumbnail),
                        struct.borrow(held, field=parameters),
                        struct.borrow(held,field=postprocess)))
                      array.push(history, held)
                      show_gallery_items(session,"gen_current",current)
                      show_gallery_items(session,"gen_history",history)
                      let _ = desk.set_bool(session, "gen_current_empty", "visible", false)
                      let _ = desk.set_bool(session, "gen_history_empty", "visible", false)
                      match library.save_history(history) {
                        ok(_) => {},
                        err(message) => { io.ewrite(text.concat(message, "\n")) },
                      }
                    },
                    err(message) => { io.ewrite(text.concat(message, "\n")) },
                  }
                  saved_parameters = string.copy(running_parameters)
                  selected_result = string.copy(struct.borrow(completed, field=output))
                  show_result(session, str.view(struct.borrow(completed, field=output)))
                  if qwen_edit_active{
                    qwen_edit_result=string.copy(struct.borrow(completed,field=output))
                    let _=desk.picture(session,"qwen_edit_result_picture",
                      struct.borrow(completed,field=output))
                    let _=desk.set_bool(session,"qwen_edit_result_empty","visible",false)
                    let _=desk.set_text(session,"qwen_edit_status",
                      if qwen_edit_flux{"FLUX 3 Klein edit completed · PNG saved and displayed"}else{"Qwen Image Edit completed · PNG saved and displayed"})
                  }
                  let _ = desk.set_text(session, "gen_batch_status", "Completed")
                  let _ = desk.set_text(session, "gen_run_state", "Ready")
                  generation_notification("MM-Air generation completed",
                    str.view(struct.borrow(completed,field=output)))
                  if movie_generation_active{
                    movie.record_take_at(movie_state,movie_generation_shot,
                      struct.borrow(completed,field=output),cast.sat(seed),true)
                    struct.set(movie_state,movie_generation_shot,field=selected_shot)
                    match save_movie(movie_state,str.view(movie_project_path)){
                      ok(_)=>{},err(message)=>{io.ewrite(text.concat("Movie autosave: ",text.concat(message,"\n")))}}
                    show_movie(session,movie_state)
                    let _=desk.set_text(session,"movie_runtime","H3 ready")
                    let _=desk.set_text(session,"status",text.concat("Movie take completed: ",
                      struct.borrow(completed,field=output)))
                    movie_generation_active=false
                    if movie_state.endless_active{
                      let completed_seconds=movie.completed_seconds(movie_state)
                      if completed_seconds>=movie_state.endless_target{
                        struct.set(movie_state,false,field=endless_active)
                        match save_movie(movie_state,str.view(movie_project_path)){
                          ok(_)=>{},err(message)=>{io.ewrite(text.concat(message,"\n"))}}
                        show_movie(session,movie_state)
                        let _=desk.set_text(session,"status",text.concat(
                          "Endless chain completed · ",text.concat(
                          str.view(string.from_float(completed_seconds))," seconds")))
                        generation_notification("MM-Air endless movie completed",
                          struct.borrow(movie_state,field=title))
                      }else{
                        let next_duration=movie.endless_segment_duration(
                          completed_seconds,movie_state.endless_target,
                          movie_state.endless_segment)
                        match movie.create_continuation(movie_state,movie_generation_shot){
                          ok(_)=>{movie.set_duration(movie_state,movie_state.selected_shot,
                            next_duration)
                            match save_movie(movie_state,str.view(movie_project_path)){
                              ok(_)=>{},err(message)=>{io.ewrite(text.concat(message,"\n"))}}
                            show_movie(session,movie_state)
                            let _=desk.set_text(session,"status","Endless chain · starting next native continuation")
                            let _=desk.activate(session,"queue_take")},
                          err(message)=>{struct.set(movie_state,false,field=endless_active)
                            let _=desk.set_text(session,"status",message)},
                        }
                      }
                    }else if movie_render_all{
                      var next:u64=movie_generation_shot+1
                      var found:bool=false
                      loop{if next>=array.len(struct.borrow(movie_state,field=shots)){break}
                        var candidate=movie.snapshot_shot(movie_state,next)
                        if candidate.selected_take<0{
                          found=true
                          break
                        }
                        next=next+1}
                      if found{
                        struct.set(movie_state,next,field=selected_shot)
                        show_movie(session,movie_state)
                        let _=desk.set_text(session,"status",text.concat("Render all · starting shot ",
                          str.view(string.from_int(next+1))))
                        let _=desk.activate(session,"queue_take")
                      }else{
                        movie_render_all=false
                        let _=desk.set_text(session,"status","Render all completed · every shot has a selected take")
                        generation_notification("MM-Air render all completed",struct.borrow(movie_state,field=title))
                      }
                    }
                  }
                  if character_swap.is_masked(generation_mode) or edit_generation_active {
                    edit_result=string.copy(struct.borrow(completed,field=output))
                    if str.len(str.view(edit_source))!=0 and edit_source==swap_source_video {
                      edit_showing_result=true
                      if edit_source_video {
                        let _=desk.set_string(session,"edit_media_stack","visible-child-name","video")
                        let _=desk.play(session,"edit_source_video",str.view(edit_result))
                      } else {
                        let _=desk.set_string(session,"edit_media_stack","visible-child-name","picture")
                        let _=desk.picture(session,"edit_source_picture",str.view(edit_result))
                      }
                    }
                    let _=desk.set_bool(session,"edit_save_as","sensitive",true)
                    let _=desk.set_text(session,"edit_status",if edit_mode==5{
                      "Video Outpaint completed · source rectangle and source audio preserved"}
                      else if character_swap.edit_character_replace(edit_mode){
                        "Character Replace completed from source + reference image + prompt"}
                      else{"Localized H3 edit completed and composited under the authored mask"})
                  }
                  edit_generation_active=false
                  qwen_edit_active=false
                  io.write(text.concat("mm-air generated media saved=",
                    text.concat(str.view(struct.borrow(completed, field=output)), "\n")))
                  io.write(text.concat("mm-air Generate-to-displayed-result ms=",
                    text.concat(string.from_int((time.monotonic_ns() - generation_started) / 1000000), "\n")))
                } else {
                  edit_generation_active=false
                  if qwen_edit_active{
                    let _=desk.set_text(session,"qwen_edit_status",
                      struct.borrow(completed,field=message))
                    let _=desk.set_bool(session,"qwen_edit_run","sensitive",true)
                  }
                  qwen_edit_active=false
                  if movie_generation_active{
                    movie.record_take_at(movie_state,movie_generation_shot,"",cast.sat(seed),false)
                    match save_movie(movie_state,str.view(movie_project_path)){
                      ok(_)=>{},err(message)=>{io.ewrite(text.concat("Movie autosave: ",text.concat(message,"\n")))}}
                    struct.set(movie_state,movie_generation_shot,field=selected_shot)
                    movie_generation_active=false
                    movie_render_all=false
                    struct.set(movie_state,false,field=endless_active)
                    show_movie(session,movie_state)
                    let _=desk.set_text(session,"movie_runtime","H3 take failed")
                  }
                  let _ = desk.set_text(session, "gen_batch_status", "Failed")
                  let _ = desk.set_text(session, "gen_run_state", "Failed")
                  generation_notification("MM-Air generation failed",
                    str.view(struct.borrow(completed,field=message)))
                  io.ewrite(text.concat("mm-air generation failed: ",
                    text.concat(str.view(struct.borrow(completed, field=message)), "\n")))
                }
              },
              none => {},
            }
          }
          if array.len(prompt_jobs) != 0 {
            let elapsed = (time.monotonic_ns() - prompt_started) / 1000000000
            let _ = desk.set_text(session,"prompt_metrics",text.concat(
              "Qwen running · ",text.concat(str.view(string.from_int(elapsed))," s")))
            match task.wait_any(prompt_jobs,0) {
              some(_) => {
                var completed = task.join(option.unwrap(array.pop(prompt_jobs)))
                let _ = desk.set_bool(session,"prompt_cancel","sensitive",false)
                if str.len(str.view(prompt_cancel_path)) != 0 {
                  let removed=result.is_ok(files.remove(str.view(prompt_cancel_path)))
                  prompt_cancel_path=string.new()
                }
                show_prompt_model(session,prompt_model_index)
                if completed.succeeded and completed.fully_unloaded {
                  let mebibytes: u64 = completed.peak_device_bytes / 1048576
                  let _ = desk.set_text(session,"prompt_metrics",text.concat(
                    str.view(string.from_int(completed.input_tokens)),text.concat(
                    " in · ",text.concat(str.view(string.from_int(completed.output_tokens)),
                    text.concat(" out · peak ",text.concat(str.view(string.from_int(mebibytes))," MiB"))))))
                  let _ = desk.set_text(session,"prompt_residency","Unloaded")
                  if prompt_target==3{
                    movie.apply_director_plan(movie_state,movie_state.selected_shot,
                      struct.borrow(completed,field=response))
                    match save_movie(movie_state,str.view(movie_project_path)){
                      ok(_)=>{},err(message)=>{io.ewrite(text.concat("Movie autosave: ",text.concat(message,"\n")))}}
                    show_movie(session,movie_state)
                    let _=desk.set_text(session,"movie_runtime","H3 ready · Qwen unloaded")
                    let _=desk.set_text(session,"status","Movie Director plan applied to the selected shot; compiled H3 prompt is ready")
                  } else if prompt_target == 1 {
                    var normalized = character_swap.normalize_prompt(
                      struct.borrow(completed,field=response))
                    match character_swap.validate_prompt(str.view(normalized)) {
                      err(message) => {
                        swap_prompt_built = false
                        let _ = desk.set_text(session,"prompt_residency",
                          "Unloaded · prompt needs rebuild")
                        let _ = desk.set_text(session,"gen_swap_status",message)
                        let _ = desk.set_text(session,"status",message)
                      },
                      ok(_) => {
                        swap_built_prompt = string.copy(str.view(normalized))
                        prompt = string.copy(str.view(normalized))
                        swap_prompt_built = true
                        let _ = ref.swap(struct.borrow(swap_prompt_state,field=current_result),
                          string.copy(str.view(normalized)))
                        prompt_session.add_turn(swap_prompt_state,prompt_types.Role.Assistant,
                          str.view(normalized))
                        let _ = desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
                        let _ = desk.set_text(session,"gen_swap_status",text.concat(
                          "Built Prompt ready and editable · Qwen unloaded · peak ",
                          text.concat(str.view(string.from_int(mebibytes))," MiB")))
                        let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",true)
                        let _ = desk.set_text(session,"status",
                          "Character Swap prompt built; edit it before Generate if needed")
                        match save_prompt_state(swap_prompt_state,str.view(output_directory),true) {
                          ok(_) => {}, err(message) => { io.ewrite(text.concat(message,"\n")) },
                        }
                      },
                    }
                  } else if prompt_target == 2 {
                    var normalized=character_swap.normalize_prompt(
                      struct.borrow(completed,field=response))
                    match if edit_mode==5 {
                      outpaint.validate_prompt(str.view(normalized))
                    } else if edit_source_video {
                      character_swap.validate_prompt(str.view(normalized))
                    } else {character_swap.validate_local_image_prompt(str.view(normalized))} {
                      err(message)=>{
                        let _=desk.set_text(session,"prompt_residency",
                          "Unloaded · edit prompt needs rebuild")
                        let _=desk.set_text(session,"edit_status",message)
                      },
                      ok(_)=>{
                        edit_prompt=string.copy(str.view(normalized))
                        let _=desk.set_text(session,"edit_prompt_buffer",str.view(edit_prompt))
                        let _=desk.set_text(session,"edit_status",text.concat(
                          if edit_mode==5{"Video Outpaint prompt ready · Qwen unloaded · peak "}
                          else{"Masked edit prompt ready · Qwen unloaded · peak "},
                          text.concat(str.view(string.from_int(mebibytes))," MiB")))
                      },
                    }
                  } else {
                    let _ = ref.swap(struct.borrow(prompt_state,field=current_result),
                      string.copy(struct.borrow(completed,field=response)))
                    prompt_session.add_turn(prompt_state,prompt_types.Role.Assistant,
                      struct.borrow(completed,field=response))
                    let _ = desk.set_text(session,"prompt_output_buffer",
                      struct.borrow(completed,field=response))
                    show_prompt_session(session,prompt_state)
                    let _ = desk.set_text(session,"status",struct.borrow(completed,field=message))
                    match save_prompt_state(prompt_state,str.view(output_directory),false) {
                      ok(_) => {}, err(message) => { io.ewrite(text.concat(message,"\n")) },
                    }
                  }
                } else {
                  let _ = desk.set_text(session,"prompt_residency","Unloaded · request failed")
                  let _ = desk.set_text(session,"prompt_metrics","No result admitted")
                  let _ = desk.set_text(session,"status",struct.borrow(completed,field=message))
                  if prompt_target == 1 {
                    swap_prompt_built = false
                    let _ = desk.set_text(session,"gen_swap_status",
                      struct.borrow(completed,field=message))
                  } else if prompt_target == 2 {
                    let _=desk.set_text(session,"edit_status",
                      struct.borrow(completed,field=message))
                  }
                  if prompt_target==3{
                    let _=desk.set_text(session,"movie_runtime","Qwen director failed")
                  }
                }
                let _ = desk.set_bool(session,"gen_swap_build_prompt","sensitive",true)
                prompt_target = 0
              },
              none => {},
            }
          }
          // Unmasked swap needs no model to write its prompt, so keep the
          // direct instruction current instead of waiting for Build Prompt.
          if character_swap.is_swap(generation_mode) and
             not character_swap.is_masked(generation_mode) and
             not swap_prompt_built and str.len(str.view(swap_source_video)) != 0 and
             array.len(swap_character_references) != 0 {
            var auto_options = character_swap.settings(swap_target_mode,
              str.view(swap_target_notes),str.view(swap_notes),
              swap_preserve_environment,swap_preserve_camera,swap_strong_identity)
            match character_swap.direct_prompt(auto_options,
                array.len(swap_character_references)) {
              err(message) => {
                let _ = desk.set_text(session,"gen_swap_status",message)
              },
              ok(built) => {
                swap_built_prompt = string.copy(str.view(built))
                prompt = built
                let _ = desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
                let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",true)
                let _ = desk.set_text(session,"gen_swap_status",
                  "Swap prompt filled in automatically · edit it before Generate if needed")
                swap_prompt_built = true
              },
            }
          }
          var event: json.Document = match desk.next(session, 1000) {
            ok(item) => match item {
              some(value) => value,
              none => { continue },
            },
            err(problem) => { result_code = fail(problem)
              break },
          }
          let kind: string = desk.field(event, "event")
          let id: string = desk.field(event, "id")
          if kind=="dialog" or kind=="drop" {
            if not desk.boolean(event, "cancelled") {
              let selected: string = desk.field(event, "value")
              match settings.index(id,true){
                some(index)=>{
                  array.set(struct.borrow(local_settings,field=paths),index,string.copy(selected))
                  let _=desk.set_text(session,text.concat("settings_path_",string.from_int(index)),selected)
                  let _=desk.set_text(session,"settings_status","Unsaved changes · choose Save and Apply")
                  continue},none=>{},}
              if id=="choose_opening" or id=="choose_ending"{
                var chosen=desk.dialog_paths(event)
                if array.len(chosen)!=0{
                  movie.set_frame(movie_state,movie_state.selected_shot,
                    array.borrow(chosen,0),id=="choose_opening")
                  if id=="choose_opening"{
                    let work=path.join(system.temp_directory(),text.concat(
                      "mm-air-opening-probe-",string.from_int(time.monotonic_ns())))
                    match media_io.probe("/nonexistent/air-image-provider",
                        array.borrow(chosen,0),work){
                      ok(info)=>{movie.set_resolution(movie_state,movie_state.selected_shot,
                        movie.resolution_for_aspect(cast.sat(info.width),cast.sat(info.height)))},
                      err(problem)=>{let _=desk.set_text(session,"status",problem)},}
                  }
                  match save_movie(movie_state,str.view(movie_project_path)){ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                  show_movie(session,movie_state)
                }
                continue
              }
              if id=="edit_motion_export"{
                if not edit_motion_plan_ready{
                  let _=desk.set_text(session,"edit_status",
                    "Load a source video before exporting MotionPlan")
                }else{
                  let payload=repair_motion.encode(edit_motion_plan)
                  match files.write_atomic(str.view(selected),text.concat(
                      str.view(selected),".tmp"),str.view(payload)){
                    ok(_)=>{let _=desk.set_text(session,"edit_status",
                      text.concat("MotionPlan saved: ",str.view(selected)))},
                    err(problem)=>{let _=desk.set_text(session,"edit_status",
                      problem.message)}}
                }
                continue
              }
              if id=="edit_motion_import"{
                match files.read_text(str.view(selected)){
                  ok(payload)=>match repair_motion.decode(str.view(payload)){
                    ok(value)=>{var made=value
                      if made.frame_count!=edit_source_frames{
                        let _=desk.set_text(session,"edit_status",
                          "MotionPlan frame count does not match the loaded source")
                      }else{
                        let heat=repair_motion.heatmap(made,32)
                        edit_motion_plan=made
                        edit_motion_plan_ready=true
                        let _=desk.set_text(session,"edit_motion_heatmap",
                          str.view(heat))
                        let _=desk.set_text(session,"edit_status",
                          "MotionPlan imported and ready")}},
                    err(message)=>{let _=desk.set_text(session,"edit_status",message)}},
                  err(problem)=>{let _=desk.set_text(session,"edit_status",
                    problem.message)},
                }
                continue
              }
              if id=="movie_add_reference"{
                var chosen=desk.dialog_paths(event)
                movie.add_references(movie_state,movie_state.selected_shot,chosen)
                match save_movie(movie_state,str.view(movie_project_path)){ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                show_movie(session,movie_state)
                continue
              }
              if id=="movie_add_character"{
                var chosen=desk.dialog_paths(event)
                if array.len(chosen)!=0{
                  movie.add_character(movie_state,array.borrow(chosen,0))
                  let new_character_index=array.len(struct.borrow(movie_state,field=characters))-1
                  struct.set(movie_state,new_character_index,field=selected_character)
                  match save_movie(movie_state,str.view(movie_project_path)){
                    ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                  show_movie(session,movie_state)}
                continue
              }
              if id=="export_project" or id=="export_edit"{
                let payload=if id=="export_project"{movie.encode(movie_state)}else{movie.edit_manifest(movie_state)}
                match payload{
                  ok(value)=>match files.write_atomic(str.view(selected),text.concat(str.view(selected),".tmp"),str.view(value)){
                    ok(_)=>{let _=desk.set_text(session,"status",text.concat("Movie export saved: ",str.view(selected)))},
                    err(problem)=>{let _=desk.set_text(session,"status",problem.message)},
                  },
                  err(message)=>{let _=desk.set_text(session,"status",message)},
                }
                continue
              }
              if id=="import_project"{
                match movie.load(str.view(selected)){
                  ok(value)=>{
                    movie_state=value
                    movie_project_path=movie.new_library_path(str.view(movie_library_root))
                    match save_movie(movie_state,str.view(movie_project_path)){
                      ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                    save_movie_selection(str.view(movie_library_root),
                      str.view(movie_project_path))
                    movie_library_paths=match movie.library_paths(str.view(movie_library_root)){
                      ok(paths)=>paths,err(_)=>copy_paths(movie_library_paths)}
                    show_movie(session,movie_state)
                    show_project_library(session,movie_library_paths,str.view(movie_project_path))
                    let _=desk.set_text(session,"status",text.concat("Imported movie project: ",str.view(selected)))
                  },err(message)=>{let _=desk.set_text(session,"status",message)}
                }
                continue
              }
              if id == "gen_add_lora" {
                var chosen = desk.dialog_paths(event)
                var choice: u64 = 0
                loop {
                  if choice == array.len(chosen) { break }
                  let filename = array.borrow(chosen,choice)
                  choice = choice + 1
                  if not text.ends_with(text.lower_ascii(filename),".safetensors") {
                    let _ = desk.set_text(session,"status","Choose a LoRA .safetensors file")
                    continue
                  }
                  var accepted_filename: string = string.copy(str.view(filename))
                  if model_index != parameters.krea_model_index() {
                    match h3_lora.resolve_path(str.view(filename)) {
                      ok(value) => {
                        accepted_filename = value
                      },
                      err(message) => {
                        let _ = desk.set_text(session,"status",str.view(message))
                        continue
                      },
                    }
                  }
                  var duplicate: bool = false
                  var i: u64 = 0
                  loop {
                    if i == array.len(generate_loras) { break }
                    if str.view(struct.borrow(array.borrow(generate_loras,i),field=path)) == str.view(accepted_filename) {
                      duplicate = true
                    }
                    i = i + 1
                  }
                  if not duplicate {
                    if array.len(generate_loras) > 0 {
                      let _ = desk.set_text(session,"status","Generate admits one LoRA; remove the current LoRA before adding another")
                      continue
                    }
                    array.push(generate_loras,parameters.LoraEntry {path:accepted_filename,strength:1.0,enabled:true})
                    selected_lora = array.len(generate_loras) - 1
                    if model_index != parameters.krea_model_index() {
                      transformer_projection_index = h3.projection_row_scaled_int8()
                      let _ = desk.set_number(session,"gen_transformer_projection","selected",
                        cast.float(transformer_projection_index))
                      let _ = desk.set_text(session,"status",
                        "H3 LoRA selected from its original path · transformer projection set to Row-scaled INT8")
                    }
                  }
                }
                show_loras(session,generate_loras,selected_lora)
              }
              if id == "gen_load_parameters" {
                match files.read_text(selected) {
                  ok(value) => { pending_parameters = value },
                  err(error) => { let _ = desk.set_text(session, "status", fs.error.message(error)) },
                }
              }
              // Drops anywhere on Source / References follow the current H3 task:
              // keyframe tasks fill the first/last frame, Ref2VA adds each file to
              // the visual or audio references by its media kind.
              if id == "gen_sources_group" and task_index != h3.task_ref2va() {
                var dropped: array<string> = desk.dialog_paths(event)
                let keyframes: bool = task_index == h3.task_i2va() or
                  task_index == h3.task_fl2va() or task_index == h3.task_l2va()
                if not keyframes {
                  let _ = desk.set_text(session, "status",
                    "This task takes no pictures. Pick Reference (Ref2VA) or a first/last-frame task, then drop again")
                  continue
                }
                var slot: u64 = 0
                loop {
                  if slot == array.len(dropped) { break }
                  if slot > 1 or (task_index != h3.task_fl2va() and slot > 0) { break }
                  let dropped_path: str = str.view(array.borrow(dropped, slot))
                  let to_last: bool = task_index == h3.task_l2va() or
                    (task_index == h3.task_fl2va() and slot == 1)
                  if to_last {
                    if accept_media(session, "choose_last_reference", dropped_path) {
                      last_reference_media = text.copy(dropped_path)
                    }
                  } else {
                    if accept_media(session, "choose_reference", dropped_path) {
                      reference_media = text.copy(dropped_path)
                    }
                  }
                  slot = slot + 1
                }
                continue
              }
              if id == "gen_add_visual" or id == "gen_add_audio" or id == "gen_sources_group" {
                let by_kind: bool = id == "gen_sources_group"
                var chosen: array<string> = desk.dialog_paths(event)
                var choice: u64 = 0
                loop {
                  if choice == array.len(chosen) { break }
                  let chosen_path: str = str.view(array.borrow(chosen, choice))
                  choice = choice + 1
                  match media.inspect(chosen_path, 8589934592) {
                  err(error) => { var held: media.Error = error
                    let _ = desk.set_text(session, "status", media_error(held)) },
                  ok(info) => {
                    let audio: bool = if by_kind { info.kind == media.Kind.Audio }
                                      else { id == "gen_add_audio" }
                    if (audio and array.len(audio_references) >= 3) or
                       (not audio and array.len(visual_references) >= 9) {
                      let _ = desk.set_text(session, "status", "Reference limit reached: nine visuals and three audio clips")
                      break
                    }
                    if (audio and info.kind != media.Kind.Audio) or
                       (not audio and info.kind != media.Kind.Image and info.kind != media.Kind.Video) {
                      let _ = desk.set_text(session, "status", "Choose media matching the visual/audio reference slot")
                    } else {
                      match library.prep_reference(chosen_path, "") {
                        ok(item) => {
                          if audio {
                            array.push(audio_references, item)
                            selected_audio = string.new()
                            show_items(session, "gen_audio_refs", audio_references)
                            reference_actions(session, true, "", array.len(audio_references))
                          } else {
                            array.push(visual_references, item)
                            selected_visual = string.new()
                            show_items(session, "gen_visual_refs", visual_references)
                            reference_actions(session, false, "", array.len(visual_references))
                          }
                        },
                        err(message) => { let _ = desk.set_text(session, "status", message) },
                      }
                    }
                  },
                }
                }
              }
              if id == "gen_swap_choose_source" {
                match media.inspect(str.view(selected),8589934592) {
                  err(problem) => { var held: media.Error = problem
                    let _ = desk.set_text(session,"gen_swap_status",media_error(held)) },
                  ok(info) => {
                    if info.kind != media.Kind.Video {
                      let _ = desk.set_text(session,"gen_swap_status",
                        "Character Swap source must be one video clip")
                    } else {
                      match library.prep_reference(str.view(selected),"") {
                        ok(item) => { var prepared = item
                          swap_source_video = string.copy(str.view(selected))
                          show_swap_source(session,prepared,str.view(selected))
                          swap_prompt_built = false
                          let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
                          let _ = desk.set_text(session,"gen_swap_status",
                            "Source Video selected · add identity pictures, then Build Prompt")
                        },
                        err(message) => { let _ = desk.set_text(session,"gen_swap_status",message) },
                      }
                    }
                  },
                }
              }
              if id == "gen_mask_choose" {
                match media.inspect(str.view(selected),8589934592) {
                  err(problem)=>{var held:media.Error=problem
                    let _=desk.set_text(session,"gen_swap_status",media_error(held))},
                  ok(info)=>{
                    if info.kind != media.Kind.Image and info.kind != media.Kind.Video {
                      let _=desk.set_text(session,"gen_swap_status",
                        "Target Mask must be an image or video")
                    } else {
                      swap_mask_path=string.copy(str.view(selected))
                      swap_manual_mask=false
                      swap_prompt_built=false
                      let _=desk.set_text(session,"gen_mask_name",path.basename(str.view(selected)))
                      let _=desk.set_bool(session,"gen_mask_clear","sensitive",true)
                      let _=desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
                      let _=desk.set_text(session,"gen_swap_status",
                        "Authored mask selected · Preview tracked crop or Build Prompt")
                    }
                  },
                }
              }
              if id == "edit_choose_source" {
                match media.inspect(str.view(selected),8589934592) {
                  err(problem)=>{var held:media.Error=problem
                    let _=desk.set_text(session,"edit_status",media_error(held))},
                  ok(info)=>{
                    if info.kind != media.Kind.Image and info.kind != media.Kind.Video {
                      let _=desk.set_text(session,"edit_status","Edit source must be an image or video")
                    } else {
                      edit_source=string.copy(str.view(selected))
                      edit_source_video=info.kind==media.Kind.Video
                      edit_source_width=0
                      edit_source_height=0
                      edit_source_frames=0
                      edit_motion_plan_ready=false
                      if edit_source_video {
                        match outpaint_runtime.inspect(str.view(selected),system.temp_directory()){
                          ok(facts)=>{
                            edit_source_width=facts.width
                            edit_source_height=facts.height
                            edit_source_frames=facts.frames
                            edit_motion_plan=repair_motion.create(facts.frames)
                            edit_motion_plan_ready=true
                            let _=desk.set_text(session,"edit_motion_heatmap",
                              "................................")
                            edit_repair_first=0
                            edit_repair_end=if facts.frames<24{facts.frames}else{24}
                            seconds=cast.float(facts.frames)/24.0
                            let _=desk.set_number(session,"gen_duration","value",seconds)
                            let _=desk.set_number(session,"edit_repair_start","value",0.0)
                            let _=desk.set_number(session,"edit_repair_end","value",
                              cast.float(edit_repair_end))
                          },
                          err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                        }
                      }
                      edit_position=0.0
                      edit_playing=edit_source_video
                      edit_showing_result=false
                      edit_brush_points=[]
                      edit_manual_mask=false
                      edit_mask_path=string.new()
                      edit_mask_video_source=false
                      let _=desk.pause(session,"edit_mask_video",false)
                      let _=desk.set_bool(session,"edit_mask_video","visible",false)
                      let _=desk.set_bool(session,"edit_mask_overlay","visible",false)
                      let _=desk.mask_paint(session,"edit_canvas",false,
                        edit_brush_radius,edit_erase_mask,true,true)
                      match library.prep_reference(str.view(selected),"") {
                        ok(item)=>{var prepared=item
                          let _=desk.picture(session,"edit_source_picture",
                            struct.borrow(prepared,field=thumbnail))
                          if edit_source_video {
                            let _=desk.set_string(session,"edit_media_stack",
                              "visible-child-name","video")
                            let _=desk.play(session,"edit_source_video",str.view(edit_source))
                          } else {
                            let _=desk.set_string(session,"edit_media_stack",
                              "visible-child-name","picture")
                            let _=desk.picture(session,"edit_source_picture",str.view(edit_source))
                          }
                          let _=desk.set_bool(session,"edit_canvas_empty","visible",false)
                          let _=desk.set_text(session,"edit_source_name",path.basename(str.view(selected)))
                          let _=desk.set_text(session,"edit_mask_name",
                            if character_swap.edit_character_replace(edit_mode){
                              "Character Replace · no mask required"}
                            else{"No mask · localized edit is blocked"})
                          let _=desk.set_text(session,"edit_status",
                            if character_swap.edit_character_replace(edit_mode){
                              "Source loaded · add a character reference image and build the prompt"}
                            else{"Source loaded · provide an authored mask"})},
                        err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                      }
                    }
                  },
                }
              }
              if id=="qwen_edit_choose_source"{
                var chosen=desk.dialog_paths(event)
                var chosen_index:u64=0
                var rejected:bool=false
                loop{
                  if chosen_index>=array.len(chosen) or
                     array.len(qwen_edit_references)>=10{break}
                  let candidate=array.borrow(chosen,chosen_index)
                  match media.inspect(str.view(candidate),8589934592){
                    err(_)=>{rejected=true},
                    ok(info)=>{
                      if info.kind!=media.Kind.Image or not
                          parameters.qwen_condition_image(str.view(candidate)){
                        rejected=true
                      }else{array.push(qwen_edit_references,string.copy(str.view(candidate)))}
                    },
                  }
                  chosen_index=chosen_index+1
                }
                if array.len(qwen_edit_references)!=0{
                  qwen_edit_source=string.copy(str.view(array.borrow(qwen_edit_references,0)))
                }
                update_qwen_edit_sources(session,qwen_edit_references)
                let count_i64:i64=cast.sat(array.len(qwen_edit_references))
                var source_status=string.copy(
                  "Only valid PNG, JPEG, or WebP images were added · maximum 10")
                if not rejected{source_status=text.concat(
                  str.view(string.from_int(count_i64))," ordered source image(s) ready")}
                let _=desk.set_text(session,"qwen_edit_status",str.view(source_status))
              }
              if id == "edit_choose_mask" {
                match media.inspect(str.view(selected),8589934592) {
                  err(problem)=>{var held:media.Error=problem
                    let _=desk.set_text(session,"edit_status",media_error(held))},
                  ok(info)=>{
                    if info.kind != media.Kind.Image and info.kind != media.Kind.Video {
                      let _=desk.set_text(session,"edit_status","Edit mask must be an image or video")
                    } else {
                      edit_mask_path=string.copy(str.view(selected))
                      edit_mask_video_source=info.kind==media.Kind.Video
                      edit_manual_mask=false
                      edit_brush_points=[]
                      let _=desk.mask_paint(session,"edit_canvas",false,
                        edit_brush_radius,edit_erase_mask,true,true)
                      match library.prep_reference(str.view(selected),"") {
                        ok(item)=>{var prepared=item
                          if info.kind==media.Kind.Video {
                            let _=desk.set_bool(session,"edit_mask_overlay","visible",false)
                            let _=desk.set_bool(session,"edit_mask_video","visible",true)
                            let _=desk.play_muted(session,"edit_mask_video",str.view(edit_mask_path))
                            let _=desk.seek(session,"edit_mask_video",edit_position)
                          } else {
                            let _=desk.pause(session,"edit_mask_video",false)
                            let _=desk.set_bool(session,"edit_mask_video","visible",false)
                            let _=desk.picture(session,"edit_mask_overlay",
                              struct.borrow(prepared,field=thumbnail))
                            let _=desk.set_bool(session,"edit_mask_overlay","visible",true)
                          }
                          let _=desk.set_text(session,"edit_mask_name",path.basename(str.view(selected)))
                          let _=desk.set_text(session,"edit_status","Imported mask ready for cleanup and crop planning")},
                        err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                      }
                    }
                  },
                }
              }
              if id == "edit_add_reference" {
                var chosen=desk.dialog_paths(event)
                var choice:u64=0
                loop {
                  if choice>=array.len(chosen) or array.len(edit_references)>=7{break}
                  let filename=array.borrow(chosen,choice)
                  choice=choice+1
                  match media.inspect(str.view(filename),8589934592) {
                    ok(info)=>{if info.kind==media.Kind.Image {
                      match library.prep_reference(str.view(filename),"") {
                        ok(item)=>{array.push(edit_references,item)},
                        err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                      }
                    } else {let _=desk.set_text(session,"edit_status",
                      "Edit references currently accept identity images")}},
                    err(problem)=>{var held:media.Error=problem
                      let _=desk.set_text(session,"edit_status",media_error(held))},
                  }
                }
                show_items(session,"edit_references",edit_references)
              }
              if id == "edit_save_as" and str.len(str.view(edit_result))!=0 {
                match files.copy_new(str.view(edit_result),str.view(selected)) {
                  ok(_)=>{let _=desk.set_text(session,"edit_status",text.concat(
                    "Saved localized edit: ",str.view(selected)))},
                  err(problem)=>{let _=desk.set_text(session,"edit_status",
                    text.concat("Save As failed: ",problem.message))},
                }
              }
              if id == "gen_swap_add_character" {
                var chosen = desk.dialog_paths(event)
                var choice: u64 = 0
                loop {
                  if choice >= array.len(chosen) { break }
                  if array.len(swap_character_references) >=
                     character_swap.maximum_character_pictures() {
                    let _ = desk.set_text(session,"gen_swap_status",
                      "Character Swap accepts at most seven identity pictures")
                    break
                  }
                  let filename = array.borrow(chosen,choice)
                  choice = choice + 1
                  match media.inspect(str.view(filename),8589934592) {
                    err(problem) => { var held: media.Error = problem
                      let _ = desk.set_text(session,"gen_swap_status",media_error(held)) },
                    ok(info) => {
                      if info.kind != media.Kind.Image {
                        let _ = desk.set_text(session,"gen_swap_status",
                          "Reference Character accepts images; use Source Video for the motion clip")
                      } else {
                        match library.prep_reference(str.view(filename),"") {
                          ok(item) => { array.push(swap_character_references,item)
                            swap_prompt_built = false },
                          err(message) => { let _ = desk.set_text(session,"gen_swap_status",message) },
                        }
                      }
                    },
                  }
                }
                selected_swap_character = string.new()
                show_items(session,"gen_swap_character_refs",swap_character_references)
                let _ = desk.set_bool(session,"gen_swap_remove_character","sensitive",false)
                let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              }
              if id == "prompt_attach" {
                var chosen = desk.dialog_paths(event)
                var choice: u64 = 0
                loop {
                  if choice >= array.len(chosen) { break }
                  if array.len(struct.borrow(prompt_state,field=attachments)) >= 8 {
                    let _ = desk.set_text(session,"status","Prompt Lab accepts at most eight ordered references")
                    break
                  }
                  let filename = array.borrow(chosen,choice)
                  choice = choice + 1
                  match media.inspect(str.view(filename),8589934592) {
                    err(problem) => { var held: media.Error = problem
                      let _ = desk.set_text(session,"status",media_error(held)) },
                    ok(info) => {
                      if info.kind == media.Kind.Image {
                        prompt_session.attach(prompt_state,str.view(filename),
                          prompt_types.AttachmentKind.Image)
                        prompt_task_index = 2
                      } else if info.kind == media.Kind.Video {
                        prompt_session.attach(prompt_state,str.view(filename),
                          prompt_types.AttachmentKind.Video)
                        prompt_task_index = 3
                      } else {
                        let _ = desk.set_text(session,"status","Prompt Lab accepts image and video references")
                      }
                    },
                  }
                }
                let _ = ref.swap(struct.borrow(prompt_state,field=task),
                  prompt_lab.task(prompt_task_index))
                let _ = desk.set_number(session,"prompt_task","selected",
                  cast.float(prompt_task_index))
                show_prompt_session(session,prompt_state)
              }
              if id == "choose_reference" {
                if accept_media(session, id, str.view(selected)) {
                  reference_media = text.copy(str.view(selected))
                }
              }
              if id == "choose_last_reference" {
                if accept_media(session, id, str.view(selected)) {
                  last_reference_media = text.copy(str.view(selected))
                }
              }
              if id == "choose_control" {
                if accept_media(session, id, str.view(selected)) {
                  control_media = text.copy(str.view(selected))
                }
              }
            }
            continue
          }
          if kind == "close" or id == "quit" { break }
          if id == "result_fullscreen_close" or
             (kind == "activate" and id == "result_fullscreen_picture") {
            close_image_view(session)
            continue
          }
          if kind == "activate" and (id == "result_picture" or
             id == "qwen_edit_source_picture" or id == "qwen_edit_result_picture" or
             id == "edit_source_picture" or id == "edit_crop_preview") {
            open_image_view(session,desk.field(event,"value"))
            continue
          }
          if kind == "select" or kind == "activate" {
            if id=="qwen_edit_references"{
              qwen_edit_selected=match text.parse_u64(desk.field(event,"value")){
                some(value)=>value,none=>0}
              if qwen_edit_selected<array.len(qwen_edit_references){
                let _=desk.picture(session,"qwen_edit_source_picture",str.view(
                  array.borrow(qwen_edit_references,qwen_edit_selected)))
                let _=desk.set_bool(session,"qwen_edit_remove_source","sensitive",true)
                if kind == "activate" { open_image_view(session,str.view(
                  array.borrow(qwen_edit_references,qwen_edit_selected))) }
              }
              continue
            }
            if id=="movie_project_list"{
              let value=match text.parse_u64(desk.field(event,"value")){
                some(found)=>found,none=>array.len(movie_library_paths)}
              if value<array.len(movie_library_paths){
                let selected=string.copy(array.borrow(movie_library_paths,value))
                match movie.load(str.view(selected)){
                  ok(project)=>{movie_state=project
                    movie_project_path=string.copy(str.view(selected))
                    save_movie_selection(str.view(movie_library_root),
                      str.view(movie_project_path))
                    show_movie(session,movie_state)
                    show_project_library(session,movie_library_paths,
                      str.view(movie_project_path))
                    let _=desk.set_text(session,"status",text.concat(
                      "Opened movie project: ",str.view(selected)))},
                  err(message)=>{let _=desk.set_text(session,"status",message)},
                }}
              continue
            }
            if id=="movie_cast_list"{
              let value=match text.parse_u64(desk.field(event,"value")){
                some(found)=>found,none=>0}
              if value<array.len(struct.borrow(movie_state,field=characters)){
                struct.set(movie_state,value,field=selected_character)
                show_movie(session,movie_state)}
              continue
            }
            if id=="movie_shot_list"{
              let value=match text.parse_u64(desk.field(event,"value")){
                some(found)=>found,none=>0}
              if value<array.len(struct.borrow(movie_state,field=shots)) and
                 value!=movie_state.selected_shot{
                struct.set(movie_state,value,field=selected_shot)
                show_movie(session,movie_state)
              }
              continue
            }
            if id=="movie_take_list"{
              let value=match text.parse_i64(desk.field(event,"value")){
                some(found)=>found,none=>-1}
              if movie.select_take(movie_state,movie_state.selected_shot,value){
                match save_movie(movie_state,str.view(movie_project_path)){
                  ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                show_movie(session,movie_state)
              }
              continue
            }
            if id == "gen_loras" {
              selected_lora = match text.parse_u64(desk.field(event,"value")) {
                some(value) => value, none => 18446744073709551615,
              }
              lora_editor(session,generate_loras,selected_lora)
              continue
            }
            let key = desk.field(event, "value")
            if id == "gen_visual_refs" { selected_visual = string.copy(key)
              reference_actions(session, false, key, array.len(visual_references)) }
            if id == "gen_audio_refs" { selected_audio = string.copy(key)
              reference_actions(session, true, key, array.len(audio_references)) }
            if id == "gen_swap_character_refs" {
              selected_swap_character = string.copy(key)
              let _ = desk.set_bool(session,"gen_swap_remove_character","sensitive",
                str.len(key) != 0)
              let filename = selected_path(swap_character_references,key)
              if filename != "" { show_source(session,filename)
                if kind == "activate" { open_image_view(session,filename) } }
            }
            if key != "" and (id == "gen_visual_refs" or id == "gen_audio_refs") {
              let filename = if id == "gen_visual_refs" { selected_path(visual_references, key) }
                             else { selected_path(audio_references, key) }
              if filename != "" { show_source(session, filename)
                if kind == "activate" { open_image_view(session,filename) } }
            }
            if id == "gen_history" or id == "gen_current" {
              let found = if id == "gen_current" { selected_parameters(current, key) }
                          else { selected_parameters(history, key) }
              match found {
                some(value) => {
                  saved_parameters = value
                  let filename = if id == "gen_current" { selected_path(current, key) }
                                 else { selected_path(history, key) }
                  selected_result = string.copy(filename)
                  show_result(session, filename)
                  if kind == "activate" { open_image_view(session,filename) }
                  let post=if id=="gen_current"{selected_postprocess(current,key)}
                    else{selected_postprocess(history,key)}
                },
                none => {},
              }
            }
          }
          if kind == "error" {
            let message = desk.field(event, "message")
            io.ewrite(text.concat(message, "\n"))
            let _ = desk.set_text(session, "status", message)
            continue
          }
          if id == "show_generate" { select_mode(session, "generate")
            continue }
          if id == "show_edit" { select_mode(session, "edit")
            continue }
          if id=="show_image_edit"{select_mode(session,"image_edit")
            continue}
          if id == "show_movie" { select_mode(session, "movie")
            continue }
          if id == "show_control" { select_mode(session, "control")
            continue }
          if id == "show_prompt" { select_mode(session, "prompt")
            continue }
          if id == "show_settings" { select_mode(session, "settings")
            continue }
          if kind=="select" and id=="settings_themes"{
            match text.parse_u64(desk.field(event,"value")){
              some(index)=>{struct.set(local_settings,index,field=theme)
                let _=desk.set_text(session,"settings_status","Unsaved changes · Preview or Save and Apply")},none=>{},}
            continue}
          if kind == "change" and desk.boolean(event, "value") {
            if id == "nav_generate" { select_mode(session, "generate")
              continue }
            if id == "nav_edit" { select_mode(session, "edit")
              continue }
            if id=="nav_image_edit"{select_mode(session,"image_edit")
              continue}
            if id == "nav_movie" { select_mode(session, "movie")
              continue }
            if id == "nav_control" { select_mode(session, "control")
              continue }
            if id == "nav_prompt" { select_mode(session, "prompt")
              continue }
            if id == "nav_settings" { select_mode(session, "settings")
              continue }
          }
          if kind=="video" and id=="edit_source_video" {
            edit_position=desk.number(event,"position")
            edit_duration=desk.number(event,"duration")
            edit_playing=desk.boolean(event,"playing")
            let _=desk.set_number(session,"edit_timeline_adjustment","upper",
              if edit_duration>0.0{edit_duration}else{1.0})
            let _=desk.set_number(session,"edit_timeline","value",edit_position)
            let _=desk.set_text(session,"edit_timecode",
              str.view(edit_timecode(edit_position,edit_duration)))
            let _=desk.set_text(session,"edit_play",if edit_playing{"❚❚"}else{"▶"})
            continue
          }
          if kind=="mask" and id=="edit_canvas" {
            if not desk.boolean(event,"cancelled") {
              array.push(edit_brush_points,masked_edit.brush_point(
                desk.number(event,"x"),desk.number(event,"y"),
                desk.number(event,"radius"),desk.boolean(event,"erase"),
                desk.boolean(event,"begin")))
              edit_manual_mask=false
              edit_mask_path=string.new()
              if array.len(edit_brush_points)==1 {
                io.write("mm-air edit painted mask accepted\n")
              }
              let _=desk.set_text(session,"edit_mask_name",text.concat(
                "Painted mask · ",text.concat(str.view(string.from_int(
                array.len(edit_brush_points)))," sampled points · applies across the clip")))
              let _=desk.set_text(session,"edit_status",
                "Painted mask updated · Finish painting before preview or generation")
            }
            continue
          }
          if kind == "crop" and id == "edit_canvas" {
            edit_mask_x=desk.number(event,"x")
            edit_mask_y=desk.number(event,"y")
            edit_mask_width=desk.number(event,"width")
            edit_mask_height=desk.number(event,"height")
            edit_manual_mask=true
            edit_mask_path=string.new()
            let _=desk.crop(session,"edit_canvas",false)
            let _=desk.set_bool(session,"edit_mask_overlay","visible",false)
            let mask_percent:u64=cast.sat(edit_mask_width*100.0)
            let _=desk.set_text(session,"edit_mask_name",text.concat(
              "Manual subject rectangle · ",text.concat(str.view(string.from_int(
              mask_percent)),"% canvas width")))
            let _=desk.set_text(session,"edit_status",
              "Manual subject mask ready · feathering is applied during localized edit")
            continue
          }
          if kind == "change" and layout_memory.is_layout(str.view(id)) {
            match layout_memory.remember(event,str.view(id)){ok(_)=>{},
              err(message)=>{io.ewrite(text.concat("Layout preference: ",text.concat(message,"\n")))}}
            continue
          }
          if kind == "change" {
            if id=="settings_panel_width" or id=="settings_navigation_width" or id=="settings_navigation_height" {
              let size:u64=cast.sat(desk.number(event,"value"))
              if id=="settings_panel_width"{struct.set(local_settings,size,field=panel_width)}
              if id=="settings_navigation_width"{struct.set(local_settings,size,field=navigation_width)}
              if id=="settings_navigation_height"{struct.set(local_settings,size,field=navigation_height)}
              let _=desk.set_text(session,"settings_status","Unsaved layout · Preview or Save and Apply")
              continue
            }
            match settings.index(id,false){some(index)=>{
              array.set(struct.borrow(local_settings,field=paths),index,desk.field(event,"value"))
              let _=desk.set_text(session,"settings_status","Unsaved changes · choose Save and Apply")
              continue},none=>{},}
            if id=="settings_accent"{
              let _=ref.swap(struct.borrow(local_settings,field=accent),desk.field(event,"value"))
              let _=desk.set_text(session,"settings_status","Unsaved changes · Preview or Save and Apply")
              continue}
            if id=="gen_seedvr2_enabled"{
              seedvr2_enabled=desk.boolean(event,"value")
              let _=desk.set_bool(session,"gen_seedvr2_fields","sensitive",
                seedvr2_enabled)
              let _=desk.set_text(session,"gen_seedvr2_note",if seedvr2_enabled{
                "Generator unloads first. The pre-upscale MP4 is retained beside the final result."}
                else{"Optional native AIR video restoration is disabled."})
              continue
            }
            if id=="gen_seedvr2_after"{
              seedvr2_run_after=desk.boolean(event,"value")
              continue
            }
            if id=="gen_seedvr2_method"{
              seedvr2_variant=cast.sat(desk.number(event,"value"))
              let _=desk.set_text(session,"gen_seedvr2_note",if seedvr2_variant==1{
                "SeedVR2 7B streams its 36-layer DiT after the generator unloads. Low VRAM is recommended on 24 GB GPUs."
              }else{
                "SeedVR2 3B runs after the generator unloads. The pre-upscale MP4 is retained beside the final result."
              })
              continue
            }
            if id=="gen_seedvr2_size"{
              seedvr2_size=cast.sat(desk.number(event,"value"))
              let _=desk.set_bool(session,"gen_seedvr2_custom","sensitive",
                seedvr2_size==2)
              continue
            }
            if id=="gen_seedvr2_width"{
              seedvr2_width=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="gen_seedvr2_height"{
              seedvr2_height=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="gen_seedvr2_audio"{
              seedvr2_audio=desk.boolean(event,"value")
              continue
            }
            if id=="gen_seedvr2_seed"{
              match text.parse_u64(desk.field(event,"value")){
                some(value)=>{seedvr2_seed=value
                  seedvr2_seed_valid=true},
                none=>{seedvr2_seed_valid=false
                  let _=desk.set_text(session,"status",
                    "SeedVR2 seed must be a nonnegative integer")},
              }
              continue
            }
            if id=="gen_seedvr2_quality"{
              seedvr2_quality=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="gen_seedvr2_memory"{
              seedvr2_memory=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="director_input_buffer"{
              movie_director_input=desk.field(event,"value")
              continue
            }
            if id=="movie_drift_enabled"{
              movie_drift_enabled=desk.boolean(event,"value")
              continue
            }
            if id=="movie_drift_matched"{
              movie_drift_matched=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="movie_drift_taper"{
              movie_drift_taper=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="movie_drift_amount"{
              movie_drift_amount=cast.float(desk.number(event,"value"))
              continue
            }
            if id=="project_title" or id=="movie_format" or id=="movie_target" or
               id=="movie_takes" or id=="director_bible_buffer" or
               id=="continuity_bible_buffer" or id=="brand_bible_buffer" or
               id=="movie_endless_target" or id=="movie_endless_segment"{
              if id=="project_title"{let _=ref.swap(struct.borrow(movie_state,field=title),
                desk.field(event,"value"))}
              if id=="movie_format"{
                let value:u32=cast.sat(desk.number(event,"value"))
                struct.set(movie_state,if value==0{1}else if value==1{0}else{2},field=format)}
              if id=="movie_target"{struct.set(movie_state,desk.number(event,"value"),field=target_duration)}
              if id=="movie_takes"{struct.set(movie_state,cast.sat(desk.number(event,"value")),field=takes_per_shot)}
              if id=="director_bible_buffer"{let _=ref.swap(struct.borrow(movie_state,field=director_bible),desk.field(event,"value"))}
              if id=="continuity_bible_buffer"{let _=ref.swap(struct.borrow(movie_state,field=continuity_bible),desk.field(event,"value"))}
              if id=="brand_bible_buffer"{let _=ref.swap(struct.borrow(movie_state,field=brand_bible),desk.field(event,"value"))}
              if id=="movie_endless_target"{struct.set(movie_state,desk.number(event,"value"),field=endless_target)}
              if id=="movie_endless_segment"{struct.set(movie_state,desk.number(event,"value"),field=endless_segment)}
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              save_movie_selection(str.view(movie_library_root),
                str.view(movie_project_path))
              if id=="movie_target" or id=="movie_takes" or id=="movie_format"{
                show_movie(session,movie_state)}
              continue
            }
            if id=="movie_character_name" or id=="movie_character_role" or
               id=="movie_character_identity_buffer"{
              let field:u32=if id=="movie_character_name"{0}
                else if id=="movie_character_role"{1}else{2}
              movie.set_character_text(movie_state,movie_state.selected_character,
                field,desk.field(event,"value"))
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              continue
            }
            if id=="movie_shot_title" or id=="movie_duration" or
               id=="movie_resolution" or id=="movie_width" or id=="movie_height" or id=="movie_locked" or
               id=="movie_brief_buffer" or id=="movie_plan_buffer" or
               id=="movie_prompt_buffer" or id=="movie_soundscape_buffer" or
               id=="movie_music_buffer"{
              if id=="movie_shot_title"{movie.set_shot_text(movie_state,movie_state.selected_shot,0,desk.field(event,"value"))}
              if id=="movie_brief_buffer"{movie.set_shot_text(movie_state,movie_state.selected_shot,1,desk.field(event,"value"))}
              if id=="movie_plan_buffer"{movie.set_shot_text(movie_state,movie_state.selected_shot,2,desk.field(event,"value"))}
              if id=="movie_prompt_buffer"{movie.set_shot_text(movie_state,movie_state.selected_shot,3,desk.field(event,"value"))}
              if id=="movie_soundscape_buffer"{movie.set_shot_text(movie_state,movie_state.selected_shot,4,desk.field(event,"value"))}
              if id=="movie_music_buffer"{movie.set_shot_text(movie_state,movie_state.selected_shot,5,desk.field(event,"value"))}
              if id=="movie_duration"{movie.set_duration(movie_state,movie_state.selected_shot,desk.number(event,"value"))}
              if id=="movie_width" or id=="movie_height"{
                var current=movie.snapshot_shot(movie_state,movie_state.selected_shot)
                movie.set_dimensions(movie_state,movie_state.selected_shot,
                  if id=="movie_width"{cast.sat(desk.number(event,"value"))}else{current.width},
                  if id=="movie_height"{cast.sat(desk.number(event,"value"))}else{current.height})
              }
              if id=="movie_locked"{movie.set_locked(movie_state,movie_state.selected_shot,desk.boolean(event,"value"))}
              if id=="movie_resolution"{movie.set_resolution(movie_state,movie_state.selected_shot,cast.sat(desk.number(event,"value")))}
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              if id=="movie_shot_title" or id=="movie_duration" or
                 id=="movie_resolution" or id=="movie_width" or id=="movie_height" or id=="movie_locked"{
                show_movie(session,movie_state)
              }else if id!="movie_prompt_buffer"{
                var updated=movie.snapshot_shot(movie_state,movie_state.selected_shot)
                let compiled=movie.compile_prompt(updated)
                let _=desk.set_text(session,"movie_prompt_buffer",str.view(compiled))
              }
              continue
            }
            if id=="edit_auto_mask_prompt"{
              edit_auto_mask_prompt=desk.field(event,"value")
            }
            if id == "prompt_input" {
              prompt_instruction = desk.field(event,"value")
            }
            if id == "prompt_output" {
              let _ = ref.swap(struct.borrow(prompt_state,field=current_result),
                desk.field(event,"value"))
            }
            if id == "edit_prompt" {edit_prompt=desk.field(event,"value")}
            if id=="qwen_edit_prompt"{qwen_edit_prompt=desk.field(event,"value")}
            if id=="qwen_edit_resolution"{
              qwen_edit_resolution_index=cast.sat(desk.number(event,"value"))
              let size=qwen_image_contract.resolution(qwen_edit_resolution_index)
              if size.width!=0{
                qwen_edit_width=size.width
                qwen_edit_height=size.height
                let _=desk.set_number(session,"qwen_edit_width","value",cast.float(qwen_edit_width))
                let _=desk.set_number(session,"qwen_edit_height","value",cast.float(qwen_edit_height))
              }
              continue
            }
            if id=="qwen_edit_width" or id=="qwen_edit_height"{
              if id=="qwen_edit_width"{qwen_edit_width=cast.sat(desk.number(event,"value"))}
              else{qwen_edit_height=cast.sat(desk.number(event,"value"))}
              qwen_edit_resolution_index=match qwen_image_contract.resolution_index(
                qwen_edit_width,qwen_edit_height){some(index)=>index,none=>qwen_image_contract.resolution_custom()}
              let _=desk.set_number(session,"qwen_edit_resolution","selected",cast.float(qwen_edit_resolution_index))
              continue
            }
            if id=="qwen_edit_scheduler"{
              qwen_image_scheduler=cast.sat(desk.number(event,"value"))
              qwen_image_steps=qwen_turbo_steps(session,
                qwen_effective_scheduler(qwen_turbo,qwen_image_scheduler),qwen_image_steps)
              continue
            }
            if id=="qwen_edit_sampler"{
              qwen_image_sampler=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="qwen_edit_steps"{
              qwen_image_steps=cast.sat(desk.number(event,"value"))
              continue
            }
            if id=="qwen_edit_seed_lock"{
              qwen_edit_seed_locked=desk.boolean(event,"value")
              continue
            }
            if id=="qwen_edit_seed"{
              match text.parse_u64(desk.field(event,"value")){
                some(value)=>{qwen_edit_seed=value},
                none=>{let _=desk.set_text(session,"qwen_edit_status",
                  "Seed must be a nonnegative integer")},
              }
              continue
            }
            if id == "edit_mode" {
              edit_mode=cast.sat(desk.number(event,"value"))
              let outpaint_mode=edit_mode==5
              let repair_mode=edit_mode==6 or edit_mode==7
              let _=desk.set_bool(session,"edit_outpaint_fields","visible",outpaint_mode)
              let _=desk.set_bool(session,"edit_repair_fields","visible",repair_mode)
              let _=desk.set_bool(session,"edit_repair_motion_fields","visible",
                edit_mode==7)
              let _=desk.set_bool(session,"edit_motion_plan_fields","visible",
                edit_mode==7)
              let _=desk.set_bool(session,"edit_outpaint_preview_geometry","visible",outpaint_mode)
              let _=desk.set_bool(session,"edit_outpaint_preview_window","visible",outpaint_mode)
              let _=desk.set_bool(session,"edit_repair_preview","visible",repair_mode)
              let _=desk.set_string(session,"edit_run","label",if outpaint_mode{
                "Run Full Outpaint"}else if edit_mode==6{"Repair Selected Frames"}
                else if edit_mode==7{"Repair Fast Motion"}else{"Run Localized Edit"})
              if outpaint_mode{let _=desk.set_text(session,"edit_mask_name",
                "Geometry creates the H3 outer-region mask; no authored mask required")}
              else if repair_mode{
                let _=desk.set_text(session,"edit_mask_name",
                  if str.len(str.view(edit_mask_path))!=0{
                    "Spatial subject mask will preserve the background during repair"
                  }else{
                    "Optional: Auto Mask with SAM 3 to preserve the background"})
                let _=desk.set_text(session,"edit_status",
                  "Enter the bad frame range, preview the exact plan, then run")
              }
              else if character_swap.edit_character_replace(edit_mode){
                let _=desk.set_text(session,"edit_mask_name",
                  "Character Replace · no mask required")
                let _=desk.set_text(session,"edit_status",
                  "Add source media, a character reference image, and your replacement prompt")
              }else if str.len(str.view(edit_mask_path))==0 and not edit_manual_mask
                  and array.len(edit_brush_points)==0{
                let _=desk.set_text(session,"edit_mask_name",
                  "No mask · localized edit is blocked")
              }
            }
            if id=="edit_outpaint_width"{edit_outpaint_width=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_height"{edit_outpaint_height=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_direction"{edit_outpaint_direction=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_anchor"{edit_outpaint_anchor=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_composite"{edit_outpaint_composite=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_seam"{edit_outpaint_seam=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_start"{edit_repair_first=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_end"{edit_repair_end=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_handle_before"{edit_repair_handle_before=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_handle_after"{edit_repair_handle_after=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_dilation"{
              edit_repair_dilation=desk.number(event,"value")}
            if id=="edit_repair_cuts"{edit_repair_cuts=desk.field(event,"value")}
            if id=="edit_repair_memory"{edit_repair_memory=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_window"{edit_repair_window=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_repair_overlap"{edit_repair_overlap=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_timing_mode"{edit_timing_mode=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_timing_block_lo"{edit_timing_block_lo=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_timing_block_hi"{edit_timing_block_hi=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_timing_fade"{edit_timing_fade=cast.float(
              desk.number(event,"value"))}
            if id=="edit_timing_step_lo"{edit_timing_step_lo=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_timing_step_hi"{edit_timing_step_hi=cast.sat(
              desk.number(event,"value"))}
            if id=="edit_outpaint_window"{
              edit_outpaint_window_seconds=desk.number(event,"value")}
            if id=="edit_outpaint_overlap"{
              edit_outpaint_overlap_seconds=desk.number(event,"value")}
            if id=="edit_outpaint_preset"{
              let preset:u32=cast.sat(desk.number(event,"value"))
              if preset<4 and edit_source_width!=0 and edit_source_height!=0{
                if preset==0 or preset==3{
                  edit_outpaint_width=((edit_source_width+31)/32)*32
                  edit_outpaint_height=(((edit_source_width*16/9)+31)/32)*32
                  edit_outpaint_direction=outpaint.vertical()
                }else{
                  edit_outpaint_height=((edit_source_height+31)/32)*32
                  edit_outpaint_width=(((edit_source_height*16/9)+31)/32)*32
                  edit_outpaint_direction=outpaint.horizontal()
                }
                let _=desk.set_number(session,"edit_outpaint_width","value",
                  cast.float(edit_outpaint_width))
                let _=desk.set_number(session,"edit_outpaint_height","value",
                  cast.float(edit_outpaint_height))
                let _=desk.set_number(session,"edit_outpaint_direction","selected",
                  cast.float(edit_outpaint_direction))
              }
            }
            if id == "edit_preserve_outside" {edit_preserve=desk.boolean(event,"value")}
            if id == "edit_feather" {edit_feather=cast.sat(desk.number(event,"value"))}
            if id == "edit_cleanup" {edit_cleanup=cast.sat(desk.number(event,"value"))}
            if id == "edit_expand" {edit_expand=cast.sat(desk.number(event,"value"))}
            if id == "edit_crop_strategy" {edit_strategy=cast.sat(desk.number(event,"value"))}
            if id == "edit_padding" {edit_padding=cast.sat(desk.number(event,"value"))}
            if id == "edit_brush" {
              edit_brush_radius=desk.number(event,"value")/100.0
              if edit_painting {let _=desk.mask_paint(session,"edit_canvas",true,
                edit_brush_radius,edit_erase_mask,true,false)}
            }
            if id == "edit_erase_mask" {
              edit_erase_mask=desk.boolean(event,"value")
              if edit_painting {let _=desk.mask_paint(session,"edit_canvas",true,
                edit_brush_radius,edit_erase_mask,true,false)}
            }
            if id == "edit_timeline" and edit_source_video and not edit_painting {
              edit_position=desk.number(event,"value")
              let _=desk.seek(session,"edit_source_video",edit_position)
              if str.len(str.view(edit_mask_path))!=0 {
                let _=desk.seek(session,"edit_mask_video",edit_position)
              }
            }
            if id == "edit_mask_visible" {
              let _=desk.set_bool(session,"edit_mask_overlay","visible",
                desk.boolean(event,"value") and str.len(str.view(edit_mask_path))!=0 and
                not edit_mask_video_source)
              let _=desk.set_bool(session,"edit_mask_video","visible",
                desk.boolean(event,"value") and str.len(str.view(edit_mask_path))!=0 and
                edit_mask_video_source)
              let _=desk.mask_paint(session,"edit_canvas",edit_painting,
                edit_brush_radius,edit_erase_mask,desk.boolean(event,"value"),false)
            }
            if id == "gen_mask_preserve" {swap_mask_preserve=desk.boolean(event,"value")}
            if id == "gen_mask_feather" {swap_mask_feather=cast.sat(desk.number(event,"value"))}
            if id == "gen_mask_cleanup" {swap_mask_cleanup=cast.sat(desk.number(event,"value"))}
            if id == "gen_mask_expand" {swap_mask_expand=cast.sat(desk.number(event,"value"))}
            if id == "gen_mask_crop_strategy" {swap_mask_strategy=cast.sat(desk.number(event,"value"))}
            if id == "gen_mask_padding" {swap_mask_padding=cast.sat(desk.number(event,"value"))}
            if id == "prompt_model" {
              prompt_model_index = cast.sat(desk.number(event,"value"))
              let _ = ref.swap(struct.borrow(prompt_state,field=model),
                prompt_lab.model(prompt_model_index))
              let _ = desk.set_number(session,"gen_swap_qwen_model","selected",
                cast.float(prompt_model_index))
              show_prompt_model(session,prompt_model_index)
            }
            if id == "gen_swap_qwen_model" {
              prompt_model_index = cast.sat(desk.number(event,"value"))
              let _ = ref.swap(struct.borrow(prompt_state,field=model),
                prompt_lab.model(prompt_model_index))
              let _ = desk.set_number(session,"prompt_model","selected",
                cast.float(prompt_model_index))
              show_prompt_model(session,prompt_model_index)
            }
            if id == "prompt_task" {
              prompt_task_index = cast.sat(desk.number(event,"value"))
              let _ = ref.swap(struct.borrow(prompt_state,field=task),
                prompt_lab.task(prompt_task_index))
            }
            if id=="prompt_total_seconds"{prompt_total_seconds=desk.number(event,"value")}
            if id=="prompt_window_seconds"{prompt_window_seconds=desk.number(event,"value")}
            if id=="prompt_overlap_seconds"{prompt_overlap_seconds=desk.number(event,"value")}
            if id == "gen_lora_strength" and selected_lora < array.len(generate_loras) {
              struct.set(array.borrow(generate_loras,selected_lora),desk.number(event,"value"),field=strength)
            }
            if id == "gen_lora_enabled" and selected_lora < array.len(generate_loras) {
              let enabled = desk.boolean(event,"value")
              var accepted = true
              if enabled {
                var i: u64 = 0
                loop {
                  if i == array.len(generate_loras) { break }
                  let other = array.borrow(generate_loras,i)
                  if i != selected_lora and other.enabled { accepted = false }
                  i = i + 1
                }
              }
              if accepted {
                struct.set(array.borrow(generate_loras,selected_lora),enabled,field=enabled)
                let _ = desk.set_bool(session,"gen_lora_strength","sensitive",enabled)
              } else {
                let _ = desk.set_bool(session,"gen_lora_enabled","active",false)
                let _ = desk.set_text(session,"status","Disable the current LoRA before enabling another")
              }
            }
            if id == "gen_parameter_filter" {
              filter_parameters(session,desk.field(event,"value"),model_index,
                generation_mode)
            }
            if id == "gen_prompt" { prompt = desk.field(event, "value") }
            if id == "gen_swap_target_notes" {
              swap_target_notes = desk.field(event,"value")
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              var target_display = if swap_target_mode == character_swap.replace_main() {
                if str.len(str.view(swap_target_notes)) == 0 {
                  string.copy("Target: main onscreen subject")
                } else {string.copy(str.view(swap_target_notes))}
              } else if str.len(str.view(swap_target_notes)) == 0 {
                string.copy("Target: describe one selected source subject")
              } else {string.copy(str.view(swap_target_notes))}
              let _ = desk.set_text(session,"gen_swap_target_display",
                str.view(target_display))
            }
            if id == "gen_swap_notes" { swap_notes = desk.field(event,"value")
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false) }
            if id == "gen_swap_target" {
              swap_target_mode = cast.sat(desk.number(event,"value"))
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"gen_swap_target_display",
                if swap_target_mode == character_swap.replace_main() {
                  "Target: main onscreen subject (optional description below)"
                } else {"Target: selected subject (description required below)"})
            }
            if id == "gen_swap_preserve_environment" {
              swap_preserve_environment = desk.boolean(event,"value")
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
            }
            if id == "gen_swap_preserve_camera" {
              swap_preserve_camera = desk.boolean(event,"value")
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
            }
            if id == "gen_swap_strong_identity" {
              swap_strong_identity = desk.boolean(event,"value")
              swap_prompt_built = false
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
            }
            if id == "gen_mode" {
              generation_mode = cast.sat(desk.number(event,"value"))
              if character_swap.is_swap(generation_mode) {
                character_sheet_mode = character_sheet.off()
                model_index = h3.model_reference()
                task_index = h3.task_ref2va()
                let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
                let _ = desk.set_number(session,"gen_model","selected",cast.float(model_index))
                let _ = desk.set_number(session,"gen_task","selected",cast.float(task_index))
                let fast: bool = not character_swap.is_masked(generation_mode) and
                  option.is_some(generation.character_swap_turbo_lora())
                if fast {
                  profile_index = h3.profile_turbo_4()
                } else if profile_index == h3.profile_turbo_4() {
                  profile_index = h3.profile_quality_19()
                }
                let _ = desk.set_number(session,"gen_profile","selected",cast.float(profile_index))
                generation_status(session,if character_swap.is_masked(generation_mode) {
                  "Masked Character Swap ready · an authored mask is required; no full-frame fallback"
                } else if fast {"Character Swap ready · Turbo 4-step root selected; pick a 19-evaluation schedule for the full sampler"
                } else {"Character Swap ready · Build Prompt does not start H3"})
              } else if profile_index == h3.profile_turbo_4() {
                profile_index = h3.profile_quality_19()
                let _ = desk.set_number(session,"gen_profile","selected",cast.float(profile_index))
              }
              source_widgets(session,task_index)
              model_widgets(session,model_index,character_sheet_mode,generation_mode)
            }
            if id == "gen_model" {
              let previous_model = model_index
              model_index = cast.sat(desk.number(event, "value"))
              let _=desk.set_text(session,"gen_parameter_filter","")
              if character_swap.is_swap(generation_mode) and
                 model_index != h3.model_reference() {
                generation_mode = character_swap.standard()
                let _ = desk.set_number(session,"gen_mode","selected",0.0)
              }
              let current_image_model:bool=model_index==parameters.krea_model_index() or
                parameters.qwen_like(model_index)
              let previous_image_model:bool=previous_model==parameters.krea_model_index() or
                parameters.qwen_like(previous_model)
              if current_image_model {
                character_sheet_mode = character_sheet.off()
                let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
              }
              model_widgets(session,model_index,character_sheet_mode,generation_mode)
              if current_image_model {
                if not previous_image_model {
                  saved_h3_width = width
                  saved_h3_height = height
                  saved_h3_seconds = seconds
                  saved_h3_resolution = resolution_index
                  saved_h3_output = string.copy(output_media)
                } else if previous_model==parameters.krea_model_index(){
                  saved_krea_width=width
                  saved_krea_height=height
                  saved_krea_output=string.copy(output_media)
                } else {
                  saved_qwen_width=width
                  saved_qwen_height=height
                  saved_qwen_output=string.copy(output_media)}
                output_media=if model_index==parameters.krea_model_index(){
                  string.copy(saved_krea_output)}else{string.copy(saved_qwen_output)}
                if model_index==parameters.krea_model_index(){
                  width=saved_krea_width
                  height=saved_krea_height
                }else{
                  width=saved_qwen_width
                  height=saved_qwen_height
                  show_qwen_recipe(session,qwen_image_scheduler,qwen_image_sampler)
                }
                resolution_index = h3.resolution_custom()
                let _ = desk.set_number(session,"gen_width","value",cast.float(width))
                let _ = desk.set_number(session,"gen_height","value",cast.float(height))
                let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
                geometry_widgets(session,width,height,seconds,
                  model_index==parameters.krea_model_index(),
                  parameters.qwen_like(model_index))
                continue
              }
              if previous_image_model {
                if previous_model==parameters.krea_model_index(){
                  saved_krea_width=width
                  saved_krea_height=height
                  saved_krea_output=string.copy(output_media)
                }else{
                  saved_qwen_width=width
                  saved_qwen_height=height
                  saved_qwen_output=string.copy(output_media)}
                width = saved_h3_width
                height = saved_h3_height
                seconds = saved_h3_seconds
                resolution_index = saved_h3_resolution
                output_media = string.copy(saved_h3_output)
                let _ = desk.set_number(session,"gen_width","value",cast.float(width))
                let _ = desk.set_number(session,"gen_height","value",cast.float(height))
                let _ = desk.set_number(session,"gen_duration","value",seconds)
                let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
                geometry_summary(session,width,height,seconds)
              }
              if model_index == h3.model_reference() { task_index = h3.task_ref2va() }
              else if task_index == h3.task_ref2va() { task_index = h3.task_fl2va() }
              let _ = desk.set_number(session, "gen_task", "selected", cast.float(task_index))
              source_widgets(session, task_index)
            }
            if id == "gen_task" {
              if model_index==parameters.krea_model_index() or
                 parameters.qwen_like(model_index){continue}
              task_index = cast.sat(desk.number(event, "value"))
              model_index = if task_index == h3.task_ref2va() { h3.model_reference() } else { h3.model_base() }
              let _ = desk.set_number(session, "gen_model", "selected", cast.float(model_index))
              source_widgets(session, task_index)
            }
            if id == "gen_character_sheet_mode" {
              character_sheet_mode = cast.sat(desk.number(event,"value"))
              if character_sheet.valid(character_sheet_mode) {
                generation_mode = character_swap.standard()
                let _ = desk.set_number(session,"gen_mode","selected",0.0)
              }
              model_widgets(session,model_index,character_sheet_mode,generation_mode)
            }
            if id == "gen_character_sheet_style" {
              character_sheet_style = cast.sat(desk.number(event,"value"))
            }
            if id == "gen_profile" { profile_index = cast.sat(desk.number(event, "value")) }
            if id == "gen_conditioner_projection" {
              conditioner_projection_index = cast.sat(desk.number(event, "value"))
            }
            if id == "gen_transformer_projection" {
              transformer_projection_index = cast.sat(desk.number(event, "value"))
            }
            if id == "gen_attention" { attention_index = cast.sat(desk.number(event, "value")) }
            if id=="gen_profile" or id=="gen_conditioner_projection" or
                id=="gen_transformer_projection" or id=="gen_attention"{
              show_movie_runtime_policy(session,profile_index,conditioner_projection_index,
                transformer_projection_index,attention_index)
            }

            if id == "gen_resolution" {
              if model_index==parameters.krea_model_index() or parameters.qwen_like(model_index){continue}
              let selected_index: u32 = cast.sat(desk.number(event, "value"))
              if selected_index == resolution_index { continue }
              resolution_index = selected_index
              let size: h3.Size = h3.resolution(resolution_index)
              if size.width != 0 {
                width = size.width
                height = size.height
                let _ = desk.set_number(session, "gen_width", "value", cast.float(width))
                let _ = desk.set_number(session, "gen_height", "value", cast.float(height))
              }
              geometry_widgets(session,width,height,seconds,
                model_index==parameters.krea_model_index(),
                parameters.qwen_like(model_index))
            }
            if id=="krea_resolution" {
              if model_index!=parameters.krea_model_index(){continue}
              if desk.number(event,"value")!=0.0{continue}
              let size=krea_config.preset(0)
              width=size.width
              height=size.height
              saved_krea_width=width
              saved_krea_height=height
              let _=desk.set_number(session,"gen_width","value",cast.float(width))
              let _=desk.set_number(session,"gen_height","value",cast.float(height))
              geometry_widgets(session,width,height,seconds,true,false)
              continue
            }
            if id=="qwen_image_resolution" {
              qwen_image_resolution_index=cast.sat(desk.number(event,"value"))
              let qwen_size=qwen_image_contract.resolution(qwen_image_resolution_index)
              if qwen_size.width==0{continue}
              // The Qwen size drives the shared geometry only while Qwen-Image is the
              // selected model; otherwise an event from this hidden control would
              // silently resize H3 or Krea requests (it did: H3 ran at 2048x2048).
              if model_index==parameters.qwen_image_model_index(){
                width=qwen_size.width
                height=qwen_size.height
                saved_qwen_width=width
                saved_qwen_height=height
                let _=desk.set_number(session,"gen_width","value",cast.float(width))
                let _=desk.set_number(session,"gen_height","value",cast.float(height))
                geometry_widgets(session,width,height,seconds,false,true)
              }
            }
            if id=="qwen_edit_match_source"{
              qwen_edit_match_source=desk.boolean(event,"value")
              continue
            }
            if id=="qwen_image_turbo" or id=="qwen_edit_turbo"{
              let chosen=desk.boolean(event,"value")
              if chosen!=qwen_turbo{
                match layout_memory.remember_turbo(chosen){ok(_)=>{},
                  err(message)=>{io.ewrite(text.concat("Turbo preference: ",text.concat(message,"\n")))}}}
              qwen_turbo=chosen
              show_qwen_turbo(session,qwen_turbo)
              qwen_image_steps=qwen_turbo_steps(session,
                qwen_effective_scheduler(qwen_turbo,qwen_image_scheduler),qwen_image_steps)
              continue
            }
            if id=="qwen_edit_enhance"{
              qwen_edit_enhance=desk.boolean(event,"value")
              continue
            }
            if id=="gen_enhance_prompt"{
              enhance_prompt=desk.boolean(event,"value")
              continue
            }
            if id=="qwen_edit_model"{
              qwen_edit_flux=desk.number(event,"value")==1.0
              let _=desk.set_text(session,"qwen_edit_chip",
                if qwen_edit_flux{"FLUX 3 IMAGE KLEIN · NATIVE AIR"}else{"QWEN-IMAGE-2.1 · NATIVE AIR"})
              let _=desk.set_text(session,"qwen_edit_status",
                if qwen_edit_flux{"FLUX 3 Klein: 16 steps, any size up to 4096 (multiples of 16); write the prompt as a full caption of the edited image"}
                else{"Qwen-Image-2.1 edit selected"})
              continue
            }
            if id=="qwen_image_steps"{
              qwen_image_steps=cast.sat(desk.number(event,"value"))
            }
            if id=="qwen_image_scheduler"{
              qwen_image_scheduler=cast.sat(desk.number(event,"value"))
              qwen_image_steps=qwen_turbo_steps(session,
                qwen_effective_scheduler(qwen_turbo,qwen_image_scheduler),qwen_image_steps)
              show_qwen_recipe(session,qwen_image_scheduler,qwen_image_sampler)
            }
            if id=="qwen_image_sampler"{
              qwen_image_sampler=cast.sat(desk.number(event,"value"))
              show_qwen_recipe(session,qwen_image_scheduler,qwen_image_sampler)
            }
            if id == "gen_width" { width = cast.sat(desk.number(event, "value"))
              if model_index==parameters.krea_model_index(){
                saved_krea_width=width
                saved_krea_height=height
              }
              if parameters.qwen_like(model_index){
                saved_qwen_width=width
                saved_qwen_height=height
                qwen_image_resolution_index=match qwen_image_contract.resolution_index(width,height){
                  some(index)=>index,none=>qwen_image_contract.resolution_custom(),}
                let _=desk.set_number(session,"qwen_image_resolution","selected",cast.float(qwen_image_resolution_index))
              }
              resolution_index = geometry_preset(resolution_index, width, height)
              let _ = desk.set_number(session, "gen_resolution", "selected", cast.float(resolution_index))
              geometry_widgets(session,width,height,seconds,
                model_index==parameters.krea_model_index(),
                parameters.qwen_like(model_index)) }
            if id == "gen_height" { height = cast.sat(desk.number(event, "value"))
              if model_index==parameters.krea_model_index(){
                saved_krea_width=width
                saved_krea_height=height
              }
              if parameters.qwen_like(model_index){
                saved_qwen_width=width
                saved_qwen_height=height
                qwen_image_resolution_index=match qwen_image_contract.resolution_index(width,height){
                  some(index)=>index,none=>qwen_image_contract.resolution_custom(),}
                let _=desk.set_number(session,"qwen_image_resolution","selected",cast.float(qwen_image_resolution_index))
              }
              resolution_index = geometry_preset(resolution_index, width, height)
              let _ = desk.set_number(session, "gen_resolution", "selected", cast.float(resolution_index))
              geometry_widgets(session,width,height,seconds,
                model_index==parameters.krea_model_index(),
                parameters.qwen_like(model_index)) }
            if id == "gen_duration" { seconds = desk.number(event, "value")
              geometry_widgets(session,width,height,seconds,
                model_index==parameters.krea_model_index(),
                parameters.qwen_like(model_index)) }
            if id == "gen_seed" {
              // The field starts as "Random" (Generate draws a seed unless locked), and
              // programmatic updates send an empty value first; neither is a typing mistake.
              let entered: string = text.trim(desk.field(event, "value"))
              match text.parse_i64(str.view(entered)) {
                some(value) => { seed = value
                  seed_valid = true },
                none => { seed_valid = str.view(entered) == "Random"
                  if not seed_valid and str.len(str.view(entered)) != 0 {
                    let _ = desk.set_text(session, "status", "Seed must be an integer (-1 for random)")
                  } },
              }
            }
            if id=="gen_seed_lock"{seed_locked=desk.boolean(event,"value")}
            continue
          }
          if kind == "action" {
            match settings.index(id,true){some(index)=>{
              let _=desk.dialog(session,id,if settings.is_file(index){"open"}else{"folder"},
                if settings.is_file(index){"Choose MM-Air model file"}else{"Choose MM-Air folder"},"",
                array.borrow(struct.borrow(local_settings,field=paths),index))
              continue},none=>{},}
            if id=="settings_reload"{
              match settings.load(output_directory){ok(value)=>{
                local_settings=value
                settings.show(session,local_settings)
                let _=settings.apply(session,local_settings)
                let _=desk.set_text(session,"settings_status","Saved settings restored")},
                err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
              continue}
            if id=="settings_preview"{
              match settings.apply(session,local_settings){ok(_)=>{
                let _=desk.set_text(session,"settings_status","Theme preview · Save and Apply to keep it")},
                err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
              continue}
            if id=="settings_save"{
              match settings.save(local_settings){ok(filename)=>{
                let _=settings.apply(session,local_settings)
                match prompt_lab.manifest_directory(bindir){
                  ok(value)=>{prompt_manifest_directory=value},
                  err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
                if array.len(prompt_jobs)==0 {show_prompt_model(session,prompt_model_index)}
                match runtime_config.value("MM_AIR_OUTPUT_ROOT"){
                  ok(value)=>match value{some(folder)=>{
                    output_directory=path.normalize(folder)
                    movie_library_root=path.join(output_directory,"movies")},none=>{},},
                  err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
                let _=desk.set_text(session,"settings_status",text.concat(
                  "Saved and applied · ",filename))},
                err(problem)=>{let _=desk.set_text(session,"settings_status",problem)},}
              continue}
            if id=="gen_seed_randomize"{
              seed=random_seed()
              seed_valid=true
              let _=desk.set_text(session,"gen_seed",str.view(string.from_int(seed)))
              continue
            }
            if id=="qwen_edit_choose_source"{
              let folder=if array.len(qwen_edit_references)==0{string.new()}
                else{path.dirname(str.view(array.borrow(qwen_edit_references,0)))}
              let _=desk.dialog_multiple(session,id,
                "Add 1–10 ordered Qwen Image Edit images · PNG, JPEG, or WebP",
                str.view(folder))
              continue
            }
            if id=="qwen_edit_seed_randomize"{
              qwen_edit_seed=cast.wrap(random_seed())
              let shown_seed:i64=cast.sat(qwen_edit_seed)
              let _=desk.set_text(session,"qwen_edit_seed",str.view(string.from_int(shown_seed)))
              continue
            }
            if id=="qwen_edit_remove_source"{
              if qwen_edit_selected<array.len(qwen_edit_references){
                remove_path_at(qwen_edit_references,qwen_edit_selected)
              }
              qwen_edit_selected=0
              qwen_edit_source=if array.len(qwen_edit_references)==0{string.new()}
                else{string.copy(str.view(array.borrow(qwen_edit_references,0)))}
              update_qwen_edit_sources(session,qwen_edit_references)
              continue
            }
            if id=="qwen_edit_clear_sources"{
              qwen_edit_references=array.new()
              qwen_edit_source=string.new()
              qwen_edit_selected=0
              update_qwen_edit_sources(session,qwen_edit_references)
              let _=desk.set_text(session,"qwen_edit_status",
                "Add 1–10 PNG, JPEG, or WebP source images to begin")
              continue
            }
            if id=="qwen_edit_run"{
              if array.len(generations)!=0{
                let _=desk.set_text(session,"qwen_edit_status","Another generation is already running")
                continue
              }
              if array.len(qwen_edit_references)==0{
                let _=desk.set_text(session,"qwen_edit_status",
                  "Add at least one PNG, JPEG, or WebP source first")
                continue
              }
              if not qwen_edit_seed_locked{
                qwen_edit_seed=cast.wrap(random_seed())
                let shown_seed:i64=cast.sat(qwen_edit_seed)
                let _=desk.set_text(session,"qwen_edit_seed",str.view(string.from_int(shown_seed)))
              }
              var additional_sources: array<string> = array.new()
              var edit_source_index:u64=1
              loop{
                if edit_source_index>=array.len(qwen_edit_references){break}
                array.push(additional_sources,string.copy(str.view(array.borrow(
                  qwen_edit_references,edit_source_index))))
                edit_source_index=edit_source_index+1
              }
              if qwen_edit_flux{
                var flux_sources:array<string>=array.new()
                var flux_index:u64=0
                loop{
                  if flux_index>=array.len(qwen_edit_references){break}
                  array.push(flux_sources,string.copy(str.view(array.borrow(qwen_edit_references,flux_index))))
                  flux_index=flux_index+1
                }
                var flux_request=parameters.Flux3Request{
                  prompt:string.copy(str.view(qwen_edit_prompt)),output:string.new(),
                  references:flux_sources,
                  width:if qwen_edit_match_source{0}else{qwen_edit_width},
                  height:if qwen_edit_match_source{0}else{qwen_edit_height},
                  steps:16,seed:qwen_edit_seed,upsample:qwen_edit_enhance}
                let flux_folder=path.join(output_directory,"flux3-klein/edit")
                let flux_stem=text.concat("flux3-edit-",string.from_int(time.monotonic_ns()))
                let flux_output=match library.unused_output(str.view(flux_folder),str.view(flux_stem),".png"){
                  ok(value)=>value,
                  err(message)=>{let _=desk.set_text(session,"qwen_edit_status",message)
                    continue},
                }
                let _=ref.swap(struct.borrow(flux_request,field=output),flux_output)
                match parameters.validate_flux3(flux_request){
                  err(message)=>{let _=desk.set_text(session,"qwen_edit_status",message)
                    continue},ok(_)=>{},
                }
                running_parameters=parameters.encode_flux3(flux_request)
                var flux_receiver=match channel.open(128,1024){
                  ok(value)=>value,
                  err(problem)=>{var held=problem
                    let _=desk.set_text(session,"qwen_edit_status",channel.message(held))
                    continue},
                }
                generation_started=time.monotonic_ns()
                qwen_edit_active=true
                var flux_work=generation.Flux3Job{request:flux_request,progress:channel.ticket(flux_receiver)}
                array.push(progress_receivers,flux_receiver)
                array.push(generations,task.spawn(flux_work,fn=generation.run_flux3))
                let _=desk.set_bool(session,"qwen_edit_run","sensitive",false)
                let _=desk.set_text(session,"qwen_edit_status","Starting native FLUX 3 Image Klein edit")
                let _=desk.set_text(session,"gen_run_state","Generating")
                continue
              }
              var request=parameters.QwenImageRequest{
                prompt:string.copy(str.view(qwen_edit_prompt)),output:string.new(),
                source:string.copy(str.view(array.borrow(qwen_edit_references,0))),
                references:additional_sources,
                width:qwen_edit_width,height:qwen_edit_height,
                steps:if qwen_turbo{
                  qwen_image_contract.turbo_steps()}else{qwen_image_steps},seed:qwen_edit_seed,
                scheduler:qwen_effective_scheduler(qwen_turbo,qwen_image_scheduler),
                sampler:qwen_image_sampler,enhance:qwen_edit_enhance}
              let folder=path.join(output_directory,"qwen-image-2.1/edit")
              let stem=text.concat("qwen-edit-",string.from_int(time.monotonic_ns()))
              let allocated=match library.unused_output(str.view(folder),str.view(stem),".png"){
                ok(value)=>value,
                err(message)=>{let _=desk.set_text(session,"qwen_edit_status",message)
                  continue},
              }
              let _=ref.swap(struct.borrow(request,field=output),allocated)
              match parameters.validate_qwen_image(request){
                err(message)=>{let _=desk.set_text(session,"qwen_edit_status",message)
                  continue},ok(_)=>{},
              }
              running_parameters=match parameters.encode_qwen_image(request){
                ok(value)=>value,
                err(message)=>{let _=desk.set_text(session,"qwen_edit_status",message)
                  continue},
              }
              var receiver=match channel.open(128,1024){
                ok(value)=>value,
                err(problem)=>{var held=problem
                  let _=desk.set_text(session,"qwen_edit_status",channel.message(held))
                  continue},
              }
              generation_started=time.monotonic_ns()
              qwen_edit_active=true
              var work=generation.QwenImageJob{request:request,progress:channel.ticket(receiver)}
              array.push(progress_receivers,receiver)
              array.push(generations,task.spawn(work,fn=generation.run_qwen_image))
              let _=desk.set_bool(session,"qwen_edit_run","sensitive",false)
              let _=desk.set_text(session,"qwen_edit_status",
                "Starting native Qwen-Image-2.1 edit · loading checkpoint once")
              let _=desk.set_text(session,"gen_run_state","Generating")
              continue
            }
            if id == "prompt_cancel" {
              if array.len(prompt_jobs) == 0 or str.len(str.view(prompt_cancel_path)) == 0 {
                let _ = desk.set_text(session,"status","No Qwen request is running")
              } else if prompt_lab.cancel(str.view(prompt_cancel_path)) {
                let _ = desk.set_bool(session,"prompt_cancel","sensitive",false)
                let _ = desk.set_text(session,"prompt_metrics","Cancellation requested · unloading at the next safe phase boundary")
                let _ = desk.set_text(session,"status","Cancelling Qwen; H3 remains blocked until teardown completes")
              } else {
                let _ = desk.set_text(session,"status","Qwen cancellation was already requested")
              }
              continue
            }
            if id == "gen_mask_send_edit" {
              edit_source=string.copy(str.view(swap_source_video))
              edit_mask_path=string.copy(str.view(swap_mask_path))
              edit_manual_mask=false
              edit_references=[]
              var source_index:u64=0
              loop {
                if source_index>=array.len(swap_character_references){break}
                let source_item=array.borrow(swap_character_references,source_index)
                array.push(edit_references,library.item(
                  struct.borrow(source_item,field=path),struct.borrow(source_item,field=thumbnail),""))
                source_index=source_index+1
              }
              edit_prompt=string.copy(str.view(prompt))
              edit_preserve=swap_mask_preserve
              edit_feather=swap_mask_feather
              edit_cleanup=swap_mask_cleanup
              edit_expand=swap_mask_expand
              edit_strategy=swap_mask_strategy
              edit_padding=swap_mask_padding
              let _=desk.set_text(session,"edit_prompt_buffer",str.view(edit_prompt))
              let edit_source_name:string=if str.len(str.view(edit_source))==0 {
                string.copy("No source selected")} else {path.basename(str.view(edit_source))}
              let edit_mask_name:string=if str.len(str.view(edit_mask_path))==0 {
                string.copy("No mask · localized edit is blocked")} else {
                  path.basename(str.view(edit_mask_path))}
              let _=desk.set_text(session,"edit_source_name",str.view(edit_source_name))
              let _=desk.set_text(session,"edit_mask_name",str.view(edit_mask_name))
              let _=desk.set_bool(session,"edit_preserve_outside","active",edit_preserve)
              let _=desk.set_number(session,"edit_feather","value",cast.float(edit_feather))
              let _=desk.set_number(session,"edit_cleanup","value",cast.float(edit_cleanup))
              let _=desk.set_number(session,"edit_expand","value",cast.float(edit_expand))
              let _=desk.set_number(session,"edit_crop_strategy","selected",cast.float(edit_strategy))
              let _=desk.set_number(session,"edit_padding","value",cast.float(edit_padding))
              show_items(session,"edit_references",edit_references)
              if str.len(str.view(edit_source))!=0 {
                match library.prep_reference(str.view(edit_source),"") {
                  ok(item)=>{var prepared=item
                    let _=desk.picture(session,"edit_source_picture",
                      struct.borrow(prepared,field=thumbnail))
                    let _=desk.set_bool(session,"edit_canvas_empty","visible",false)},
                  err(_)=>{},
                }
              }
              if str.len(str.view(edit_mask_path))!=0 {
                match library.prep_reference(str.view(edit_mask_path),"") {
                  ok(item)=>{var prepared=item
                    let _=desk.picture(session,"edit_mask_overlay",
                      struct.borrow(prepared,field=thumbnail))
                    let _=desk.set_bool(session,"edit_mask_overlay","visible",true)},
                  err(_)=>{},
                }
              }
              select_mode(session,"edit")
              let _=desk.set_text(session,"edit_status",
                "Masked Character Swap state transferred to Edit")
              continue
            }
            if id=="edit_outpaint_preview_geometry" {
              if not edit_source_video {
                let _=desk.set_text(session,"edit_status",
                  "Choose a source video before previewing outpaint geometry")
                continue
              }
              match outpaint_runtime.preview(str.view(edit_source),
                  str.view(edit_frame_preview),system.temp_directory(),edit_outpaint_width,
                  edit_outpaint_height,edit_outpaint_direction,
                  edit_outpaint_anchor,edit_position){
                ok(geometry)=>{
                  let _=desk.picture(session,"edit_crop_preview",str.view(edit_frame_preview))
                  let _=desk.set_bool(session,"edit_crop_preview","visible",true)
                  let _=desk.set_text(session,"edit_outpaint_geometry_status",
                    text.concat("Preserved rect x=",text.concat(str.view(string.from_int(
                    geometry.placement_x)),text.concat(" y=",text.concat(str.view(
                    string.from_int(geometry.placement_y)),text.concat(" · expansion L/R/T/B ",
                    text.concat(str.view(string.from_int(geometry.expand_left)),text.concat("/",
                    text.concat(str.view(string.from_int(geometry.expand_right)),text.concat("/",
                    text.concat(str.view(string.from_int(geometry.expand_top)),text.concat("/",
                    str.view(string.from_int(geometry.expand_bottom))))))))))))))
                  let _=desk.set_text(session,"edit_status",
                    "Outpaint geometry preview ready · orange rectangle is exact source")
                },
                err(message)=>{let _=desk.set_text(session,"edit_status",message)},
              }
              continue
            }
            if id == "gen_mask_preview_crop" or id == "edit_preview_crop" {
              let from_edit:bool=id=="edit_preview_crop"
              if from_edit and character_swap.edit_character_replace(edit_mode){
                let _=desk.set_text(session,"edit_status",
                  "Character Replace is semantic full-frame Ref2VA; no mask crop is needed")
                continue
              }
              let source_path:string=if from_edit {string.copy(str.view(edit_source))}
                else {string.copy(str.view(swap_source_video))}
              let mask_path:string=if from_edit {string.copy(str.view(edit_mask_path))}
                else {string.copy(str.view(swap_mask_path))}
              let manual:bool=from_edit and edit_manual_mask
              let painted:bool=from_edit and array.len(edit_brush_points)!=0
              if str.len(str.view(source_path))==0 or
                 (str.len(str.view(mask_path))==0 and not manual and not painted) {
                let message="Choose a source and authored mask before previewing the crop"
                let _=desk.set_text(session,if from_edit {"edit_status"} else {"gen_swap_status"},message)
                continue
              }
              let frame_count:u64=if from_edit {
                if edit_source_video{edit_source_frames}else{22}
              }else{cast.sat(math.round(seconds*24.0))}
              var mask_settings=if painted {
                var brush_copy:array<masked_edit.BrushPoint> = []
                var brush_index:u64=0
                loop {if brush_index>=array.len(edit_brush_points){break}
                  array.push(brush_copy,array.get(edit_brush_points,brush_index))
                  brush_index=brush_index+1}
                masked_runtime.paint_settings(brush_copy,edit_cleanup,edit_feather,
                  edit_expand,edit_strategy,edit_padding,edit_preserve)
              } else {masked_runtime.settings(str.view(mask_path),manual,
                edit_mask_x,edit_mask_y,edit_mask_width,edit_mask_height,
                if from_edit {edit_cleanup}else{swap_mask_cleanup},
                if from_edit {edit_feather}else{swap_mask_feather},
                if from_edit {edit_expand}else{swap_mask_expand},
                if from_edit {edit_strategy}else{swap_mask_strategy},
                if from_edit {edit_padding}else{swap_mask_padding},
                if from_edit {edit_preserve}else{swap_mask_preserve})}
              let preview_output=path.join(system.temp_directory(),text.concat(
                "mm-air-mask-preview-",text.concat(string.from_int(time.monotonic_ns()),".mp4")))
              match masked_runtime.prepare(str.view(source_path),str.view(preview_output),
                  system.temp_directory(),frame_count,mask_settings) {
                ok(prepared)=>{var held=prepared
                  let summary=masked_runtime.description(held)
                  if from_edit {
                    let _=desk.set_text(session,"edit_crop_status",str.view(summary))
                    match library.prep_reference(struct.borrow(held,field=cropped_source),"") {
                      ok(item)=>{var preview=item
                        let _=desk.picture(session,"edit_crop_preview",struct.borrow(preview,field=thumbnail))
                        let _=desk.set_bool(session,"edit_crop_preview","visible",true)},
                      err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                    }
                    let _=desk.set_text(session,"edit_status","Tracked crop prepared from the cleaned authored mask")
                  } else {
                    let _=desk.set_text(session,"gen_mask_geometry",str.view(summary))
                    let _=desk.set_text(session,"gen_swap_status","Tracked crop prepared from the cleaned authored mask")
                  }
                  masked_runtime.discard(held)
                },
                err(message)=>{let _=desk.set_text(session,
                  if from_edit {"edit_status"} else {"gen_swap_status"},message)},
              }
              continue
            }
            if id == "gen_swap_choose_source" {
              let folder = if str.len(str.view(swap_source_video)) == 0 {
                string.new()
              } else { path.dirname(str.view(swap_source_video)) }
              let _ = desk.dialog(session,id,"open","Choose Character Swap source video","",str.view(folder))
              continue
            }
            if id == "gen_mask_choose" {
              let folder=if str.len(str.view(swap_mask_path))==0 {string.new()}
                else {path.dirname(str.view(swap_mask_path))}
              let _=desk.dialog(session,id,"open","Choose authored mask image or video","",str.view(folder))
              continue
            }
            if id == "gen_mask_clear" {
              swap_mask_path=string.new()
              swap_manual_mask=false
              swap_manual_mask=false
              swap_prompt_built=false
              let _=desk.set_text(session,"gen_mask_name","No authored mask · masked generation is blocked")
              let _=desk.set_bool(session,"gen_mask_clear","sensitive",false)
              let _=desk.set_text(session,"gen_mask_geometry","Working crop geometry appears after mask validation; no full-frame fallback.")
              continue
            }
            if id == "edit_choose_source" {
              let _=desk.dialog(session,id,"open","Choose Edit source image or video","","")
              continue
            }
            if id == "edit_choose_mask" {
              let _=desk.dialog(session,id,"open","Choose authored mask image or video","","")
              continue
            }
            if id == "edit_add_reference" {
              let _=desk.dialog_multiple(session,id,"Add Edit reference images","")
              continue
            }
            if id == "edit_draw_mask" {
              if str.len(str.view(edit_source))==0 {
                let _=desk.set_text(session,"edit_status","Load a source before painting a mask")
              } else if edit_painting {
                edit_painting=false
                let _=desk.mask_paint(session,"edit_canvas",false,edit_brush_radius,
                  edit_erase_mask,true,false)
                let _=desk.set_text(session,"edit_draw_mask","Paint mask on current frame")
                if edit_source_video {
                  let _=desk.set_string(session,"edit_media_stack","visible-child-name","video")
                  let _=desk.seek(session,"edit_source_video",edit_position)
                }
                let _=desk.set_text(session,"edit_status",
                  "Painting finished · preview the cleaned tracked crop or run the edit")
              } else {
                if edit_source_video {
                  let _=desk.pause(session,"edit_source_video",false)
                  match masked_runtime.preview_frame(str.view(edit_source),
                      str.view(edit_frame_preview),edit_position) {
                    ok(_)=>{let _=desk.picture(session,"edit_source_picture",
                      str.view(edit_frame_preview))},
                    err(message)=>{let _=desk.set_text(session,"edit_status",message)
                      continue},
                  }
                } else {let _=desk.picture(session,"edit_source_picture",str.view(edit_source))}
                let _=desk.set_string(session,"edit_media_stack","visible-child-name","picture")
                edit_painting=true
                let _=desk.mask_paint(session,"edit_canvas",true,edit_brush_radius,
                  edit_erase_mask,true,false)
                let _=desk.set_text(session,"edit_draw_mask","Finish painting")
                let _=desk.set_text(session,"edit_status",
                  "Paint the subject in red · Erase removes strokes · the mask applies across the clip")
              }
              continue
            }
            if id=="edit_clear_paint" {
              edit_brush_points=[]
              edit_painting=false
              let _=desk.mask_paint(session,"edit_canvas",false,edit_brush_radius,
                edit_erase_mask,true,true)
              let _=desk.set_text(session,"edit_draw_mask","Paint mask on current frame")
              let _=desk.set_text(session,"edit_mask_name",
                if str.len(str.view(edit_mask_path))!=0 {path.basename(str.view(edit_mask_path))}
                else if character_swap.edit_character_replace(edit_mode){
                  "Character Replace · no mask required"}
                else {"No mask · localized edit is blocked"})
              let _=desk.set_text(session,"edit_status","Painted mask cleared")
              continue
            }
            if id=="edit_play" and edit_source_video and not edit_painting {
              edit_playing=not edit_playing
              let _=desk.pause(session,"edit_source_video",edit_playing)
              if edit_mask_video_source {let _=desk.pause(session,"edit_mask_video",edit_playing)}
              continue
            }
            if (id=="edit_frame_back" or id=="edit_frame_forward") and
               edit_source_video and not edit_painting {
              let delta:f64=if id=="edit_frame_back"{-1.0/24.0}else{1.0/24.0}
              edit_position=edit_position+delta
              if edit_position<0.0{edit_position=0.0}
              if edit_duration>0.0 and edit_position>edit_duration{edit_position=edit_duration}
              let _=desk.pause(session,"edit_source_video",false)
              let _=desk.seek(session,"edit_source_video",edit_position)
              if edit_mask_video_source {let _=desk.pause(session,"edit_mask_video",false)
                let _=desk.seek(session,"edit_mask_video",edit_position)}
              continue
            }
            if id=="edit_show_original" {
              edit_showing_result=false
              if edit_source_video {let _=desk.set_string(session,"edit_media_stack",
                  "visible-child-name","video")
                let _=desk.play(session,"edit_source_video",str.view(edit_source))}
              else {let _=desk.set_string(session,"edit_media_stack","visible-child-name","picture")
                let _=desk.picture(session,"edit_source_picture",str.view(edit_source))}
              continue
            }
            if id=="edit_show_result" and str.len(str.view(edit_result))!=0 {
              edit_showing_result=true
              if edit_source_video {let _=desk.set_string(session,"edit_media_stack",
                  "visible-child-name","video")
                let _=desk.play(session,"edit_source_video",str.view(edit_result))}
              else {let _=desk.set_string(session,"edit_media_stack","visible-child-name","picture")
                let _=desk.picture(session,"edit_source_picture",str.view(edit_result))}
              continue
            }
            if id == "edit_save_as" {
              if str.len(str.view(edit_result))==0 {
                let _=desk.set_text(session,"edit_status","Run a localized edit before Save As")
              } else {
                let _=desk.dialog(session,id,"save","Save localized edit as",
                  if edit_source_video {"masked-edit.mp4"}else{"masked-edit.png"},
                  str.view(path.dirname(str.view(edit_result))))
              }
              continue
            }
            if id=="edit_auto_mask"{
              if array.len(auto_mask_jobs)!=0{
                let _=desk.set_text(session,"edit_status","SAM 3 is already tracking a mask")
                continue
              }
              if str.len(str.view(edit_source))==0 or
                 str.len(text.trim(str.view(edit_auto_mask_prompt)))==0{
                let _=desk.set_text(session,"edit_status",
                  "Choose source media and describe the subject to mask")
                continue
              }
              let token=str.view(string.from_int(time.monotonic_ns()))
              let raw=path.join(system.temp_directory(),text.concat("mm-air-sam3-",
                text.concat(token,".gray")))
              let preview=path.join(system.temp_directory(),text.concat("mm-air-sam3-",
                text.concat(token,".mp4")))
              let mask_frames:u64=if edit_source_video{edit_source_frames}else{22}
              var work=auto_mask.Job{plugin:string.copy(str.view(sam3_plugin)),
                model:string.copy(str.view(sam3_model)),source:string.copy(str.view(edit_source)),
                prompt:string.copy(text.trim(str.view(edit_auto_mask_prompt))),
                raw_output:raw,preview_output:preview,frames:mask_frames}
              edit_auto_mask_started=time.monotonic_ns()
              array.push(auto_mask_jobs,task.spawn(work,fn=auto_mask.run))
              let _=desk.set_bool(session,"edit_auto_mask","sensitive",false)
              let _=desk.set_text(session,"edit_status","Loading local SAM 3 and finding the prompted subject")
              continue
            }
            if id == "edit_clear" {
              edit_source=string.new()
              edit_mask_path=string.new()
              edit_manual_mask=false
              edit_brush_points=[]
              edit_mask_video_source=false
              edit_source_video=false
              edit_duration=0.0
              edit_position=0.0
              edit_playing=false
              edit_painting=false
              edit_references=[]
              edit_result=string.new()
              let _=desk.picture(session,"edit_source_picture","")
              let _=desk.picture(session,"edit_mask_overlay","")
              let _=desk.pause(session,"edit_source_video",false)
              let _=desk.pause(session,"edit_mask_video",false)
              let _=desk.set_bool(session,"edit_mask_video","visible",false)
              let _=desk.mask_paint(session,"edit_canvas",false,edit_brush_radius,
                edit_erase_mask,true,true)
              let _=desk.set_bool(session,"edit_mask_overlay","visible",false)
              let _=desk.set_bool(session,"edit_canvas_empty","visible",true)
              let _=desk.set_text(session,"edit_source_name","No source selected")
              let _=desk.set_text(session,"edit_mask_name",
                if character_swap.edit_character_replace(edit_mode){
                  "Character Replace · no mask required"}
                else{"No mask · localized edit is blocked"})
              let _=desk.set_text(session,"edit_crop_status","Tracked crop not prepared")
              let _=desk.set_text(session,"edit_status",
                if character_swap.edit_character_replace(edit_mode){
                  "Ready · load source and character reference"}
                else{"Ready · no source or mask"})
              let _=desk.set_bool(session,"edit_save_as","sensitive",false)
              show_items(session,"edit_references",edit_references)
              continue
            }
            if id == "gen_swap_add_character" {
              if array.len(swap_character_references) >=
                 character_swap.maximum_character_pictures() {
                let _ = desk.set_text(session,"gen_swap_status",
                  "Character Swap accepts at most seven identity pictures")
                continue
              }
              let _ = desk.dialog_multiple(session,id,
                "Add Character Swap identity pictures","")
              continue
            }
            if id == "gen_swap_clear_source" {
              swap_source_video = string.new()
              swap_prompt_built = false
              clear_swap_source_ui(session)
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"gen_swap_status",
                "Source Video cleared; the original file was kept")
              continue
            }
            if id == "gen_swap_remove_character" {
              remove_item(swap_character_references,selected_swap_character)
              selected_swap_character = string.new()
              swap_prompt_built = false
              show_items(session,"gen_swap_character_refs",swap_character_references)
              let _ = desk.set_bool(session,"gen_swap_remove_character","sensitive",false)
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"gen_swap_status",
                "Character picture removed; the original file was kept")
              continue
            }
            if id == "gen_swap_clear" {
              swap_source_video = string.new()
              swap_character_references = []
              selected_swap_character = string.new()
              swap_target_mode = character_swap.replace_main()
              swap_target_notes = string.new()
              swap_notes = string.new()
              swap_preserve_environment = true
              swap_preserve_camera = true
              swap_strong_identity = true
              swap_prompt_built = false
              swap_built_prompt = string.new()
              swap_mask_path = string.new()
              swap_mask_preserve = true
              swap_mask_feather = 8
              swap_mask_cleanup = 2
              swap_mask_expand = 4
              swap_mask_strategy = 0
              swap_mask_padding = 96
              prompt = string.new()
              clear_swap_source_ui(session)
              show_items(session,"gen_swap_character_refs",swap_character_references)
              let _ = desk.set_number(session,"gen_swap_target","selected",0.0)
              let _ = desk.set_text(session,"gen_swap_target_notes","")
              let _ = desk.set_text(session,"gen_swap_notes_buffer","")
              let _ = desk.set_bool(session,"gen_swap_preserve_environment","active",true)
              let _ = desk.set_bool(session,"gen_swap_preserve_camera","active",true)
              let _ = desk.set_bool(session,"gen_swap_strong_identity","active",true)
              let _ = desk.set_text(session,"gen_mask_name","No authored mask · masked generation is blocked")
              let _ = desk.set_bool(session,"gen_mask_clear","sensitive",false)
              let _ = desk.set_bool(session,"gen_mask_preserve","active",true)
              let _ = desk.set_number(session,"gen_mask_feather","value",8.0)
              let _ = desk.set_number(session,"gen_mask_cleanup","value",2.0)
              let _ = desk.set_number(session,"gen_mask_expand","value",4.0)
              let _ = desk.set_number(session,"gen_mask_crop_strategy","selected",0.0)
              let _ = desk.set_number(session,"gen_mask_padding","value",96.0)
              let _ = desk.set_text(session,"gen_prompt_buffer","")
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"gen_swap_status",
                "Character Swap cleared; source files were kept")
              continue
            }
            if id == "gen_swap_build_prompt" {
              if not character_swap.is_swap(generation_mode) {
                generation_status(session,"Select H3 Character Swap mode first")
                continue
              }
              if not character_swap.is_masked(generation_mode) {
                if str.len(str.view(swap_source_video)) == 0 {
                  let _ = desk.set_text(session,"gen_swap_status",
                    "Choose a source video before building the character-swap prompt")
                  continue
                }
                var direct_options = character_swap.settings(swap_target_mode,
                  str.view(swap_target_notes),str.view(swap_notes),
                  swap_preserve_environment,swap_preserve_camera,swap_strong_identity)
                match character_swap.direct_prompt(direct_options,
                    array.len(swap_character_references)) {
                  err(message) => {
                    let _ = desk.set_text(session,"gen_swap_status",message)
                  },
                  ok(built) => {
                    swap_built_prompt = string.copy(str.view(built))
                    prompt = built
                    swap_prompt_built = true
                    let _ = desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
                    let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",true)
                    let _ = desk.set_text(session,"gen_swap_status",
                      if option.is_some(generation.character_swap_lora()) {
                        "Swap prompt ready and editable · Character Swap LoRA active"
                      } else {
                        "Swap prompt ready and editable · choose the Character Swap LoRA file in Settings"
                      })
                    let _ = desk.set_text(session,"status",
                      "Character Swap prompt built; edit the target wording before Generate if needed")
                  },
                }
                continue
              }
              if array.len(prompt_jobs) != 0 {
                let _ = desk.set_text(session,"gen_swap_status","A Qwen request is already running")
                continue
              }
              if array.len(generations) != 0 {
                let _ = desk.set_text(session,"gen_swap_status",
                  "Wait for H3/Krea generation before loading Qwen")
                continue
              }
              if character_swap.is_masked(generation_mode) and
                 str.len(str.view(swap_mask_path))==0 and not swap_manual_mask {
                let _=desk.set_text(session,"gen_swap_status",
                  "Masked Character Swap requires an authored mask before Build Prompt")
                continue
              }
              let selected_model = prompt_lab.model(prompt_model_index)
              var availability = prompt_lab.discover(selected_model)
              if not availability.available {
                let _ = desk.set_text(session,"gen_swap_status",
                  struct.borrow(availability,field=reason))
                continue
              }
              var options = character_swap.settings(swap_target_mode,
                str.view(swap_target_notes),str.view(swap_notes),
                swap_preserve_environment,swap_preserve_camera,swap_strong_identity)
              var pictures = item_paths(swap_character_references)
              var request = match if character_swap.is_masked(generation_mode) {
                  character_swap.masked_request(selected_model,
                    str.view(swap_source_video),pictures,options)
                } else {character_swap.request(selected_model,
                    str.view(swap_source_video),pictures,options)} {
                ok(value) => value,
                err(message) => { let _ = desk.set_text(session,"gen_swap_status",message)
                  continue },
              }
              prompt_cancel_path=prompt_lab.cancellation_path()
              let old_cancel:string=ref.swap(struct.borrow(request,field=cancel_path),
                string.copy(str.view(prompt_cancel_path)))
              swap_prompt_state = prompt_session.create(selected_model)
              let _ = ref.swap(struct.borrow(swap_prompt_state,field=task),
                prompt_types.Task.CharacterSwap)
              prompt_session.attach(swap_prompt_state,str.view(swap_source_video),
                prompt_types.AttachmentKind.Video)
              var picture_index: u64 = 0
              loop {
                if picture_index >= array.len(pictures) { break }
                prompt_session.attach(swap_prompt_state,array.borrow(pictures,picture_index),
                  prompt_types.AttachmentKind.Image)
                picture_index = picture_index + 1
              }
              prompt_session.add_turn(swap_prompt_state,prompt_types.Role.User,
                struct.borrow(request,field=instruction))
              prompt_started = time.monotonic_ns()
              prompt_target = 1
              swap_prompt_built = false
              var work = prompt_lab.Job {request:request,
                manifest_directory:string.copy(str.view(prompt_manifest_directory))}
              array.push(prompt_jobs,task.spawn(work,fn=prompt_lab.run))
              let _ = desk.set_bool(session,"gen_swap_build_prompt","sensitive",false)
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"prompt_residency","Loading Qwen · H3 waits")
              let _ = desk.set_text(session,"gen_swap_status",text.concat(
                "Qwen analyzing bounded frames with ",
                str.view(prompt_types.model_name(selected_model))))
              let _ = desk.set_text(session,"status",
                "Building Character Swap prompt; Generate remains separate")
              continue
            }
            if id == "edit_qwen_analyze" or id == "edit_build_prompt" {
              if array.len(prompt_jobs)!=0 or array.len(generations)!=0 {
                let _=desk.set_text(session,"edit_status",
                  "Wait for the active Qwen/H3 request to finish")
                continue
              }
              let identity_mode:bool=character_swap.edit_requires_identity(edit_mode)
              let outpaint_mode:bool=edit_mode==5
              if str.len(str.view(edit_source))==0 or
                 (identity_mode and array.len(edit_references)==0) {
                let _=desk.set_text(session,"edit_status",
                  if identity_mode {"Choose a source and at least one reference character image"}
                  else {"Choose a source image or video"})
                continue
              }
              if character_swap.edit_requires_mask(edit_mode) and
                 str.len(str.view(edit_mask_path))==0 and not edit_manual_mask and
                 array.len(edit_brush_points)==0 {
                let _=desk.set_text(session,"edit_status",
                  "Choose or draw an authored mask; Qwen analysis does not create one silently")
                continue
              }
              let selected_model=prompt_lab.model(prompt_model_index)
              var availability=prompt_lab.discover(selected_model)
              if not availability.available {
                let _=desk.set_text(session,"edit_status",struct.borrow(availability,field=reason))
                continue
              }
              var options=character_swap.settings(character_swap.replace_main(),"",
                str.view(edit_prompt),true,true,true)
              var pictures=item_paths(edit_references)
              var request_result:result<prompt_types.Request,string> = if outpaint_mode {
                if not edit_source_video or edit_source_frames<4{
                  result.err("Video Outpaint requires a probed source video")
                }else{
                  outpaint.prompt_request(selected_model,str.view(edit_source),
                    edit_source_width,edit_source_height,edit_outpaint_width,
                    edit_outpaint_height,edit_outpaint_direction,
                    edit_outpaint_anchor,edit_source_frames,
                    cast.sat(math.round(edit_outpaint_window_seconds*24.0)),
                    cast.sat(math.round(edit_outpaint_overlap_seconds*24.0)),
                    str.view(edit_prompt))
                }
              }else if edit_source_video {
                if character_swap.edit_character_replace(edit_mode){
                  character_swap.request(selected_model,str.view(edit_source),
                    pictures,options)
                }else{
                  character_swap.masked_request(selected_model,
                    str.view(edit_source),pictures,options)
                }
              } else if character_swap.edit_character_replace(edit_mode) {
                character_swap.image_replace_request(selected_model,
                  str.view(edit_source),pictures,str.view(edit_prompt))
              } else {
                character_swap.local_image_request(selected_model,
                  str.view(edit_source),pictures,str.view(edit_prompt))
              }
              var request=match request_result {
                ok(value)=>value,
                err(message)=>{let _=desk.set_text(session,"edit_status",message)
                  continue},
              }
              prompt_cancel_path=prompt_lab.cancellation_path()
              let old_cancel:string=ref.swap(struct.borrow(request,field=cancel_path),
                string.copy(str.view(prompt_cancel_path)))
              prompt_started=time.monotonic_ns()
              prompt_target=2
              var work=prompt_lab.Job {request:request,
                manifest_directory:string.copy(str.view(prompt_manifest_directory))}
              array.push(prompt_jobs,task.spawn(work,fn=prompt_lab.run))
              let _=desk.set_text(session,"prompt_residency","Loading Qwen · H3 waits")
              let _=desk.set_text(session,"edit_status",text.concat(
                "Qwen analyzing bounded source frames with ",
                str.view(prompt_types.model_name(selected_model))))
              continue
            }
            if id == "gen_swap_open_prompt" {
              if not swap_prompt_built or str.len(str.view(swap_built_prompt)) == 0 {
                let _ = desk.set_text(session,"gen_swap_status",
                  "Build the Character Swap prompt before sending it")
                continue
              }
              prompt_state = prompt_session.create(prompt_lab.model(prompt_model_index))
              let _ = ref.swap(struct.borrow(prompt_state,field=task),
                prompt_types.Task.CharacterSwap)
              prompt_session.attach(prompt_state,str.view(swap_source_video),
                prompt_types.AttachmentKind.Video)
              var paths = item_paths(swap_character_references)
              var index: u64 = 0
              loop {
                if index >= array.len(paths) { break }
                prompt_session.attach(prompt_state,array.borrow(paths,index),
                  prompt_types.AttachmentKind.Image)
                index = index + 1
              }
              let _ = ref.swap(struct.borrow(prompt_state,field=current_result),
                string.copy(str.view(swap_built_prompt)))
              prompt_session.add_turn(prompt_state,prompt_types.Role.Assistant,
                str.view(swap_built_prompt))
              let _ = desk.set_text(session,"prompt_output_buffer",str.view(swap_built_prompt))
              show_prompt_session(session,prompt_state)
              select_mode(session,"prompt")
              let _ = desk.set_text(session,"status",
                "Character Swap prompt and media opened in Prompt Lab; Director routing is available")
              continue
            }
            if id == "prompt_attach" {
              let _ = desk.dialog_multiple(session,id,"Add ordered image or video references","")
              continue
            }
            if id == "prompt_clear_attachments" {
              prompt_session.clear_attachments(prompt_state)
              show_prompt_session(session,prompt_state)
              let _ = desk.set_text(session,"status","Prompt Lab references cleared; source files kept")
              continue
            }
            if id == "prompt_new_session" {
              prompt_state = prompt_session.create(prompt_lab.model(prompt_model_index))
              let _ = ref.swap(struct.borrow(prompt_state,field=task),
                prompt_lab.task(prompt_task_index))
              prompt_instruction = string.new()
              let _ = desk.set_text(session,"prompt_input_buffer","")
              let _ = desk.set_text(session,"prompt_output_buffer","Your current production-ready result will appear here.")
              show_prompt_session(session,prompt_state)
              let _ = desk.set_text(session,"status","New Prompt Lab session")
              continue
            }
            if id == "prompt_preserve" {
              prompt_session.preserve(prompt_state)
              let _ = desk.set_text(session,"status",text.concat("Variant preserved · ",
                str.view(string.from_int(array.len(struct.borrow(prompt_state,field=saved_results))))))
              continue
            }
            if id=="prompt_build_plan"{
              if show_prompt_window_plan(session,prompt_total_seconds,
                  prompt_window_seconds,prompt_overlap_seconds){
                let _=desk.set_text(session,"status",
                  "Authoritative H3 window plan rebuilt; Scene Plan will use these exact spans")
              }else{
                let _=desk.set_text(session,"status",
                  "H3 window plan is invalid; adjust total, window, or overlap")
              }
              continue
            }
            if id == "prompt_save" {
              prompt_session.preserve(prompt_state)
              match save_prompt_state(prompt_state,str.view(output_directory),true) {
                ok(filename) => { let _ = desk.set_text(session,"status",text.concat("Prompt session saved: ",str.view(filename))) },
                err(message) => { let _ = desk.set_text(session,"status",message) },
              }
              continue
            }
            if id == "prompt_send_generate" or id == "prompt_replace" or
               id == "prompt_append" {
              let result = struct.borrow(prompt_state,field=current_result)
              if str.len(result) == 0 {
                let _ = desk.set_text(session,"status","Prompt Lab has no current result to send")
                continue
              }
              prompt = prompt_lab.route_generate(str.view(prompt),result,
                id == "prompt_append")
              let _ = desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
              let _ = desk.set_text(session,"status",if id == "prompt_append" {
                "Prompt Lab result appended to Generate"} else {"Prompt Lab result replaced the Generate prompt"})
              if id == "prompt_send_generate" { select_mode(session,"generate") }
              continue
            }
            if id == "prompt_send_edit" {
              let result=struct.borrow(prompt_state,field=current_result)
              if str.len(result)==0 {
                let _=desk.set_text(session,"status","Prompt Lab has no current result to send")
              } else {
                edit_prompt=string.copy(result)
                let _=desk.set_text(session,"edit_prompt_buffer",str.view(edit_prompt))
                select_mode(session,"edit")
                let _=desk.set_text(session,"edit_status","Prompt Lab result sent to Edit")
              }
              continue
            }
            if id == "prompt_send_movie" {
              let result = struct.borrow(prompt_state,field=current_result)
              if str.len(result) == 0 {
                let _ = desk.set_text(session,"status","Prompt Lab has no current result to send")
              } else {
                var movie_prompt = prompt_lab.route_movie(result)
                movie_director_input=string.copy(str.view(movie_prompt))
                let _ = desk.set_text(session,"director_input_buffer",str.view(movie_prompt))
                select_mode(session,"movie")
                let _ = desk.set_text(session,"status","Prompt Lab result sent to Movie Maker Director")
              }
              continue
            }
            if id=="new_project"{
              movie_state=movie.create()
              movie_project_path=movie.new_library_path(str.view(movie_library_root))
              movie_render_all=false
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              save_movie_selection(str.view(movie_library_root),
                str.view(movie_project_path))
              movie_library_paths=match movie.library_paths(str.view(movie_library_root)){
                ok(paths)=>paths,err(_)=>copy_paths(movie_library_paths)}
              show_movie(session,movie_state)
              show_project_library(session,movie_library_paths,str.view(movie_project_path))
              let _=desk.set_text(session,"status","New H3 movie project created and autosaved")
              continue
            }
            if id=="delete_project"{
              if array.len(movie_library_paths)<=1{
                let _=desk.set_text(session,"status","The movie library must keep at least one project")
                continue}
              match desktop_files.trash_file(str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)
                  continue}}
              movie_library_paths=match movie.library_paths(str.view(movie_library_root)){
                ok(paths)=>paths,err(_)=>copy_paths(movie_library_paths)}
              movie_project_path=string.copy(array.borrow(movie_library_paths,0))
              movie_state=match movie.load(str.view(movie_project_path)){
                ok(value)=>value,err(_)=>movie.create()}
              save_movie_selection(str.view(movie_library_root),
                str.view(movie_project_path))
              show_movie(session,movie_state)
              show_project_library(session,movie_library_paths,str.view(movie_project_path))
              let _=desk.set_text(session,"status","Movie project moved to Trash")
              continue
            }
            if id=="import_project"{
              let _=desk.dialog(session,id,"open","Import Serenity H3 movie project","","")
              continue
            }
            if id=="add_shot" or id=="duplicate_shot" or id=="delete_shot"{
              if id=="add_shot"{movie.add_shot(movie_state)}
              if id=="duplicate_shot"{movie.duplicate_shot(movie_state)}
              if id=="delete_shot" and not movie.delete_shot(movie_state){
                let _=desk.set_text(session,"status","A movie project must keep at least one shot")
                continue
              }
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              show_movie(session,movie_state)
              let _=desk.set_text(session,"status",if id=="add_shot"{"Shot added"}
                else if id=="duplicate_shot"{"Shot duplicated as a clean unrendered take"}
                else{"Shot deleted"})
              continue
            }
            if id=="choose_opening" or id=="choose_ending"{
              let _=desk.dialog(session,id,"open",if id=="choose_opening"{
                "Choose opening frame"}else{"Choose ending frame"},"","")
              continue
            }
            if id=="movie_add_reference"{
              let _=desk.dialog_multiple(session,id,"Add ordered H3 image references","")
              continue
            }
            if id=="movie_add_character"{
              let _=desk.dialog(session,id,"open","Add shared cast character image","","")
              continue
            }
            if id=="movie_remove_character"{
              if movie.remove_character(movie_state,movie_state.selected_character){
                struct.set(movie_state,0,field=selected_character)
                match save_movie(movie_state,str.view(movie_project_path)){
                  ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
                show_movie(session,movie_state)}
              continue
            }
            if id=="movie_remove_reference"{
              movie.remove_last_reference(movie_state,movie_state.selected_shot)
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              show_movie(session,movie_state)
              continue
            }
            if id=="export_project" or id=="export_edit"{
              let suggested=if id=="export_project"{"movie.serenitymovie.json"}
                else{"movie.serenityedit.json"}
              let _=desk.dialog(session,id,"save",if id=="export_project"{
                "Export H3 movie project"}else{"Export selected-take edit manifest"},suggested,"")
              continue
            }
            if id=="assemble_movie"{
              let folder=path.join(output_directory,"movies")
              let output=match library.unused_output(str.view(folder),"movie",".mp4"){
                ok(value)=>value,err(message)=>{let _=desk.set_text(session,"status",message)
                  continue}}
              let _=desk.set_text(session,"movie_runtime","STITCHING SELECTED TAKES…")
              match movie.stitch(movie_state,str.view(output),system.temp_directory()){
                ok(_)=>{
                  let _=desk.set_text(session,"movie_runtime","H3 ready")
                  let _=desk.set_text(session,"status",text.concat("Movie stitched: ",str.view(output)))
                  generation_notification("MM-Air movie ready",str.view(output))
                  let _=desk.set_bool(session,"movie_monitor_empty","visible",false)
                  let _=desk.set_bool(session,"movie_monitor_video","visible",true)
                  let _=desk.play(session,"movie_monitor_video",str.view(output))
                },err(message)=>{
                  let _=desk.set_text(session,"movie_runtime","Stitch failed")
                  let _=desk.set_text(session,"status",message)
                }}
              continue
            }
            if id=="copy_request"{
              prompt_model_index=1
              prompt_task_index=7
              prompt_instruction=string.copy(str.view(movie_director_input))
              prompt_state=prompt_session.create(prompt_types.ModelChoice.Qwen3VL8B)
              let _=ref.swap(struct.borrow(prompt_state,field=task),prompt_types.Task.DirectorNotes)
              let _=desk.set_number(session,"prompt_model","selected",1.0)
              let _=desk.set_number(session,"prompt_task","selected",7.0)
              let _=desk.set_text(session,"prompt_input_buffer",str.view(prompt_instruction))
              show_prompt_session(session,prompt_state)
              show_prompt_model(session,prompt_model_index)
              select_mode(session,"prompt")
              let _=desk.set_text(session,"status","Movie Director request opened in Prompt Lab with Qwen3-VL 8B")
              continue
            }
            if id == "prepare_director" {
              if array.len(prompt_jobs)!=0 or array.len(generations)!=0{
                let _=desk.set_text(session,"status","Wait for the active GPU job before running Movie Director")
                continue
              }
              prompt_model_index=1
              prompt_task_index=7
              prompt_state=prompt_session.create(prompt_types.ModelChoice.Qwen3VL8B)
              let _=ref.swap(struct.borrow(prompt_state,field=task),prompt_types.Task.DirectorNotes)
              var instruction=string.copy("Act as the MiniMax H3 movie director. Turn this input into a precise shot plan at the selected shot's requested duration. Preserve continuity and return production-ready camera, action, dialogue, sound, and music direction.\n\nPROJECT DIRECTOR BIBLE:\n")
              string.append(instruction,struct.borrow(movie_state,field=director_bible))
              string.append(instruction,"\n\nCONTINUITY BIBLE:\n")
              string.append(instruction,struct.borrow(movie_state,field=continuity_bible))
              string.append(instruction,"\n\nDIRECTOR INPUT:\n")
              string.append(instruction,str.view(movie_director_input))
              var selected=movie.snapshot_shot(movie_state,movie_state.selected_shot)
              string.append(instruction,"\n\nREQUESTED SHOT SECONDS: ")
              string.append(instruction,str.view(string.from_float(selected.duration)))
              string.append(instruction,"\n\nCURRENT SHOT:\n")
              string.append(instruction,struct.borrow(selected,field=brief))
              let _=ref.swap(struct.borrow(prompt_state,field=current_result),string.new())
              var request=prompt_session.build_request(prompt_state,prompt_types.Transform.None,str.view(instruction))
              prompt_cancel_path=prompt_lab.cancellation_path()
              let old_cancel:string=ref.swap(struct.borrow(request,field=cancel_path),
                string.copy(str.view(prompt_cancel_path)))
              prompt_started=time.monotonic_ns()
              prompt_target=3
              var work=prompt_lab.Job{request:request,
                manifest_directory:string.copy(str.view(prompt_manifest_directory))}
              array.push(prompt_jobs,task.spawn(work,fn=prompt_lab.run))
              let _=desk.set_text(session,"movie_runtime","Qwen3-VL 8B director · H3 waits")
              let _=desk.set_text(session,"status","Movie Director pass running; Qwen will fully unload before H3 is enabled")
              continue
            }
            if id == "prompt_expand" or id == "prompt_shorten" or
               id == "prompt_cinematic" or id == "prompt_shot_list" {
              prompt_transform = if id == "prompt_expand" {prompt_types.Transform.ExpandH3}
                else if id == "prompt_shorten" {prompt_types.Transform.Shorten}
                else if id == "prompt_cinematic" {prompt_types.Transform.Cinematic}
                else {prompt_types.Transform.None}
              if id == "prompt_shot_list" {
                prompt_task_index = 4
                let _ = ref.swap(struct.borrow(prompt_state,field=task),prompt_types.Task.ShotList)
                let _ = desk.set_number(session,"prompt_task","selected",4.0)
              }
            }
            if id == "prompt_run" or id == "prompt_expand" or
               id == "prompt_shorten" or id == "prompt_cinematic" or
               id == "prompt_shot_list" {
              if array.len(prompt_jobs) != 0 {
                let _ = desk.set_text(session,"status","A Qwen request is already running")
                continue
              }
              if array.len(generations) != 0 {
                let _ = desk.set_text(session,"status","Wait for H3/Krea generation before loading Qwen")
                continue
              }
              if str.len(str.view(prompt_instruction)) == 0 {
                let _ = desk.set_text(session,"status","Write a Prompt Lab instruction first")
                continue
              }
              let selected_model = prompt_lab.model(prompt_model_index)
              var availability = prompt_lab.discover(selected_model)
              if not availability.available {
                let _ = desk.set_text(session,"status",struct.borrow(availability,field=reason))
                continue
              }
              let _ = ref.swap(struct.borrow(prompt_state,field=model),selected_model)
              let _ = ref.swap(struct.borrow(prompt_state,field=task),
                prompt_lab.task(prompt_task_index))
              var effective_instruction=string.copy(str.view(prompt_instruction))
              if prompt_task_index==6{
                match prompt_lab.scene_instruction(prompt_total_seconds,
                    prompt_window_seconds,prompt_overlap_seconds,
                    str.view(prompt_instruction)){
                  ok(value)=>{effective_instruction=value},
                  err(message)=>{
                    let _=desk.set_text(session,"status",message)
                    continue
                  },
                }
              }
              var request = prompt_session.build_request(prompt_state,prompt_transform,
                str.view(effective_instruction))
              prompt_cancel_path=prompt_lab.cancellation_path()
              let old_cancel:string=ref.swap(struct.borrow(request,field=cancel_path),
                string.copy(str.view(prompt_cancel_path)))
              prompt_session.add_turn(prompt_state,prompt_types.Role.User,
                str.view(prompt_instruction))
              show_prompt_session(session,prompt_state)
              prompt_started = time.monotonic_ns()
              prompt_target = 0
              var work = prompt_lab.Job {request:request,
                manifest_directory:string.copy(str.view(prompt_manifest_directory))}
              array.push(prompt_jobs,task.spawn(work,fn=prompt_lab.run))
              prompt_transform = prompt_types.Transform.None
              let _ = desk.set_bool(session,"prompt_run","sensitive",false)
              let _ = desk.set_bool(session,"prompt_cancel","sensitive",true)
              let _ = desk.set_text(session,"prompt_residency","Loading Qwen · H3 waits")
              let _ = desk.set_text(session,"prompt_metrics","Checking VRAM and loading one AIR model")
              let _ = desk.set_text(session,"status",text.concat("Starting ",
                str.view(prompt_types.model_name(selected_model))))
              continue
            }
            if id == "gen_add_lora" {
              let folder = match env.get("HOME") {
                some(value) => path.join(value,".serenity/models/loras"), none => string.new(),
              }
              let title = if model_index == parameters.krea_model_index() {
                "Add Krea LoRA"} else {"Add H3 LoRA"}
              let _ = desk.dialog_multiple(session,id,title,folder)
              continue
            }
            if id == "gen_remove_lora" or id == "gen_clear_loras" {
              var kept: array<parameters.LoraEntry> = []
              var i: u64 = 0
              loop {
                if i == array.len(generate_loras) { break }
                let entry = array.borrow(generate_loras,i)
                if id != "gen_clear_loras" and i != selected_lora {
                  array.push(kept,parameters.LoraEntry {path:string.copy(struct.borrow(entry,field=path)),
                    strength:entry.strength,enabled:entry.enabled})
                }
                i = i + 1
              }
              generate_loras = kept
              selected_lora = 18446744073709551615
              show_loras(session,generate_loras,selected_lora)
              continue
            }
            if id == "gen_clear_references" {
              visual_references = []
              audio_references = []
              selected_visual = string.new()
              selected_audio = string.new()
              reference_media = string.new()
              last_reference_media = string.new()
              clear_reference(session,false)
              clear_reference(session,true)
              show_items(session,"gen_visual_refs",visual_references)
              show_items(session,"gen_audio_refs",audio_references)
              reference_actions(session,false,"",0)
              reference_actions(session,true,"",0)
              let _ = desk.set_text(session,"status","All references removed from this request; source files kept")
              continue
            }
            if id == "reset_generate" {
              qwen_image_resolution_index=0
              qwen_image_steps=qwen_image_contract.turbo_steps()
              qwen_image_scheduler=qwen_image_contract.scheduler_creator_dynamic()
              if not qwen_turbo{let _=layout_memory.remember_turbo(true)}
              qwen_turbo=true
              show_qwen_turbo(session,qwen_turbo)
              qwen_image_sampler=qwen_image_contract.sampler_euler()
              let _=desk.set_number(session,"qwen_image_resolution","selected",0.0)
              let _=desk.set_number(session,"qwen_image_steps","value",
                cast.float(qwen_image_steps))
              let _=desk.set_number(session,"qwen_image_scheduler","selected",0.0)
              let _=desk.set_number(session,"qwen_image_sampler","selected",0.0)
              show_qwen_recipe(session,qwen_image_scheduler,qwen_image_sampler)
              seedvr2_enabled=false
              seedvr2_run_after=true
              seedvr2_variant=0
              seedvr2_size=0
              seedvr2_width=1664
              seedvr2_height=960
              seedvr2_audio=true
              seedvr2_seed=42
              seedvr2_seed_valid=true
              seedvr2_quality=0
              seedvr2_memory=0
              let _=desk.set_bool(session,"gen_seedvr2_enabled","active",false)
              let _=desk.set_bool(session,"gen_seedvr2_fields","sensitive",false)
              let _=desk.set_bool(session,"gen_seedvr2_after","active",true)
              let _=desk.set_number(session,"gen_seedvr2_method","selected",0.0)
              let _=desk.set_number(session,"gen_seedvr2_size","selected",0.0)
              let _=desk.set_bool(session,"gen_seedvr2_custom","sensitive",false)
              let _=desk.set_number(session,"gen_seedvr2_width","value",1664.0)
              let _=desk.set_number(session,"gen_seedvr2_height","value",960.0)
              let _=desk.set_bool(session,"gen_seedvr2_audio","active",true)
              let _=desk.set_text(session,"gen_seedvr2_seed","42")
              let _=desk.set_number(session,"gen_seedvr2_quality","selected",0.0)
              let _=desk.set_number(session,"gen_seedvr2_memory","selected",0.0)
              generation_mode = character_swap.standard()
              character_sheet_mode = character_sheet.off()
              character_sheet_style = character_sheet.keep_picture_style()
              swap_source_video = string.new()
              swap_character_references = []
              selected_swap_character = string.new()
              swap_target_mode = character_swap.replace_main()
              swap_target_notes = string.new()
              swap_notes = string.new()
              swap_preserve_environment = true
              swap_preserve_camera = true
              swap_strong_identity = true
              swap_prompt_built = false
              swap_built_prompt = string.new()
              let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
              let _ = desk.set_number(session,"gen_mode","selected",0.0)
              let _ = desk.set_number(session,"gen_character_sheet_style","selected",0.0)
              clear_swap_source_ui(session)
              show_items(session,"gen_swap_character_refs",swap_character_references)
              let _ = desk.set_number(session,"gen_swap_target","selected",0.0)
              let _ = desk.set_text(session,"gen_swap_target_notes","")
              let _ = desk.set_text(session,"gen_swap_notes_buffer","")
              let _ = desk.set_bool(session,"gen_swap_preserve_environment","active",true)
              let _ = desk.set_bool(session,"gen_swap_preserve_camera","active",true)
              let _ = desk.set_bool(session,"gen_swap_strong_identity","active",true)
              let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
              let _ = desk.set_text(session,"gen_swap_status",
                "Add a source video and character picture(s), then Build Prompt.")
              model_widgets(session,model_index,character_sheet_mode,generation_mode)
              seed=random_seed()
              seed_locked=false
              let _=desk.set_text(session,"gen_seed",str.view(string.from_int(seed)))
              let _=desk.set_bool(session,"gen_seed_lock","active",false)
              var defaults=h3.request("A cinematic wide shot with natural motion, detailed atmosphere, and synchronized environmental audio.",
                h3.model_base(),h3.task_t2va(),h3.profile_quality_19(),
                h3.projection_exact_bf16(),h3.projection_convrot_int8(),
                h3.attention_ck_int8(),seed,6,[],"")
              pending_parameters = match parameters.encode(defaults) {
                ok(value) => value,
                err(message) => { let _ = desk.set_text(session, "status", message)
                  string.new() },
              }
              continue
            }
            if id == "gen_load_parameters" {
              let _ = desk.dialog(session, id, "open", "Load Generate parameters", "", "")
              continue
            }
            if id == "gen_reuse_parameters" {
              pending_parameters = string.copy(saved_parameters)
              continue
            }
            if id=="gen_delete_result"{
              if str.len(str.view(selected_result))==0{
                let _=desk.set_text(session,"status","Select a generated result first")
                continue
              }
              let deleting=string.copy(str.view(selected_result))
              match desktop_files.trash_file(str.view(deleting)){
                err(message)=>{
                  let _=desk.set_text(session,"status",message)
                  continue
                },
                ok(_)=>{},
              }
              var sidecars:array<string> = [text.concat(str.view(deleting),".json"),
                text.concat(str.view(deleting),".seedvr2.json")]
              var sidecar_index:u64=0
              loop {
                if sidecar_index >= array.len(sidecars){break}
                let sidecar=array.borrow(sidecars,sidecar_index)
                if match files.exists(str.view(sidecar)){ok(value)=>value,err(_)=>false}{
                  let _=desktop_files.trash_file(str.view(sidecar))
                }
                sidecar_index=sidecar_index+1
              }
              remove_output(current,str.view(deleting))
              remove_output(history,str.view(deleting))
              match library.save_history(history){ok(_)=>{},err(message)=>{
                let _=desk.set_text(session,"status",message)}}
              selected_result=string.new()
              saved_parameters=string.new()
              show_gallery_items(session,"gen_current",current)
              show_gallery_items(session,"gen_history",history)
              let _=desk.set_bool(session,"gen_current_empty","visible",array.len(current)==0)
              let _=desk.set_bool(session,"gen_history_empty","visible",array.len(history)==0)
              let _=desk.picture(session,"result_picture","")
              let _=desk.clear_video(session,"result_video")
              let _=desk.set_bool(session,"result_picture","visible",false)
              let _=desk.set_bool(session,"result_video","visible",false)
              let _=desk.set_bool(session,"result_placeholder","visible",true)
              let _=desk.set_bool(session,"result_empty_title","visible",true)
              let _=desk.set_bool(session,"gen_copy_downloads","sensitive",false)
              let _=desk.set_bool(session,"gen_reuse_parameters","sensitive",false)
              let _=desk.set_bool(session,"gen_use_image_reference","sensitive",false)
              let _=desk.set_bool(session,"gen_use_swap_character","sensitive",false)
              let _=desk.set_bool(session,"gen_side_by_side","visible",false)
              let _=desk.set_bool(session,"gen_delete_result","sensitive",false)
              let _=desk.set_text(session,"status","Selected result moved to Trash")
              continue
            }
            if id == "gen_side_by_side" {
              if str.len(selected_result) == 0 { continue }
              if array.len(side_jobs) != 0 {
                let _ = desk.set_text(session, "status", "The side-by-side movie is still being made")
                continue
              }
              let _ = desk.set_text(session, "status", "Making the side-by-side movie (source left, result right)")
              let _ = desk.set_bool(session, "gen_side_by_side", "sensitive", false)
              array.push(side_jobs, task.spawn(string.copy(selected_result), fn=make_side_by_side))
              continue
            }
            if id == "gen_copy_downloads" {
              if str.len(selected_result) == 0 { continue }
              if array.len(copies) != 0 {
                let _ = desk.set_text(session, "status", "Copy to Downloads is still running")
                continue
              }
              let _ = desk.set_text(session, "status", "Copying to Downloads…")
              array.push(copies, task.spawn(string.copy(selected_result), fn=copy_result))
              continue
            }
            if id == "gen_use_swap_character" {
              // A generated Krea portrait or H3 character sheet becomes
              // <Picture 1>, ahead of any photos, because the swap prompt
              // takes identity, outfit and style from <Picture 1>.
              let is_image: bool = match media.inspect(selected_result, 68719476736) {
                ok(info) => info.kind == media.Kind.Image,
                err(_) => false,
              }
              if not is_image {
                let _ = desk.set_text(session,"status","Select a generated image or character sheet first")
                continue
              }
              if array.len(swap_character_references) >=
                 character_swap.maximum_character_pictures() {
                let _ = desk.set_text(session,"status",
                  "Character Swap accepts at most seven identity pictures; remove one first")
                continue
              }
              match library.prep_reference(selected_result,"") {
                err(message) => { let _ = desk.set_text(session,"status",message) },
                ok(item) => {
                  var reordered: array<library.Item> = [item]
                  var moved: u64 = 0
                  loop {
                    if moved >= array.len(swap_character_references) { break }
                    let kept = array.borrow(swap_character_references,moved)
                    array.push(reordered,library.Item {
                      path:string.copy(struct.borrow(kept,field=path)),
                      thumbnail:string.copy(struct.borrow(kept,field=thumbnail)),
                      parameters:string.copy(struct.borrow(kept,field=parameters)),
                      postprocess:string.copy(struct.borrow(kept,field=postprocess))})
                    moved = moved + 1
                  }
                  swap_character_references = reordered
                  selected_swap_character = string.new()
                  swap_prompt_built = false
                  if model_index == parameters.krea_model_index() or
                     parameters.qwen_like(model_index) {
                    if model_index == parameters.krea_model_index() {
                      saved_krea_output = string.copy(output_media)
                    } else {
                      saved_qwen_output = string.copy(output_media)
                    }
                    width = saved_h3_width
                    height = saved_h3_height
                    seconds = saved_h3_seconds
                    resolution_index = saved_h3_resolution
                    output_media = string.copy(saved_h3_output)
                    let _ = desk.set_number(session,"gen_width","value",cast.float(width))
                    let _ = desk.set_number(session,"gen_height","value",cast.float(height))
                    let _ = desk.set_number(session,"gen_duration","value",seconds)
                    let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
                  }
                  if not character_swap.is_swap(generation_mode) {
                    generation_mode = character_swap.enabled()
                  }
                  character_sheet_mode = character_sheet.off()
                  model_index = h3.model_reference()
                  task_index = h3.task_ref2va()
                  let _ = desk.set_number(session,"gen_character_sheet_mode","selected",0.0)
                  let _ = desk.set_number(session,"gen_mode","selected",cast.float(generation_mode))
                  let _ = desk.set_number(session,"gen_model","selected",cast.float(model_index))
                  let _ = desk.set_number(session,"gen_task","selected",cast.float(task_index))
                  source_widgets(session,task_index)
                  model_widgets(session,model_index,character_sheet_mode,generation_mode)
                  geometry_widgets(session,width,height,seconds,false,false)
                  show_items(session,"gen_swap_character_refs",swap_character_references)
                  let _ = desk.set_bool(session,"gen_swap_remove_character","sensitive",false)
                  let _ = desk.set_bool(session,"gen_swap_open_prompt","sensitive",false)
                  let _ = desk.set_text(session,"gen_swap_status",
                    "Generated character is Picture 1 · choose the source video, then Build Prompt")
                  let _ = desk.set_text(session,"status",
                    "Selected image is now the Character Swap identity (Picture 1)")
                },
              }
              continue
            }
            if id == "gen_use_image_reference" {
              if array.len(visual_references) >= 9 {
                let _ = desk.set_text(session, "status", "Remove a visual reference before adding another (maximum 9)")
                continue
              }
              let is_image: bool = match media.inspect(selected_result, 68719476736) {
                ok(info) => info.kind == media.Kind.Image,
                err(_) => false,
              }
              if not is_image {
                let _ = desk.set_text(session, "status", "Select a generated image first")
                continue
              }
              match library.prep_reference(selected_result, saved_parameters) {
                ok(item) => {
                  array.push(visual_references, item)
                  selected_visual = string.from_int(array.len(visual_references) - 1)
                  if model_index == parameters.krea_model_index() or
                     parameters.qwen_like(model_index) {
                    if model_index == parameters.krea_model_index() {
                      saved_krea_output = string.copy(output_media)
                    } else {
                      saved_qwen_output = string.copy(output_media)
                    }
                    width = saved_h3_width
                    height = saved_h3_height
                    seconds = saved_h3_seconds
                    resolution_index = saved_h3_resolution
                    output_media = string.copy(saved_h3_output)
                    let _ = desk.set_number(session,"gen_width","value",cast.float(width))
                    let _ = desk.set_number(session,"gen_height","value",cast.float(height))
                    let _ = desk.set_number(session,"gen_duration","value",seconds)
                    let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
                    geometry_summary(session,width,height,seconds)
                  }
                  model_index = h3.model_reference()
                  task_index = h3.task_ref2va()
                  model_widgets(session,model_index,character_sheet_mode,generation_mode)
                  let _ = desk.set_number(session, "gen_model", "selected", cast.float(model_index))
                  let _ = desk.set_number(session, "gen_task", "selected", cast.float(task_index))
                  source_widgets(session, task_index)
                  // Model-selection notifications are asynchronous. Refresh
                  // the output readout after H3 owns the screen so a Qwen
                  // source geometry cannot remain visible as H3 output.
                  geometry_widgets(session,width,height,seconds,false,false)
                  show_items(session, "gen_visual_refs", visual_references)
                  let _ = desk.select(session, "gen_visual_refs", selected_visual)
                  reference_actions(session, false, selected_visual, array.len(visual_references))
                  let _ = desk.set_text(session, "status", "Selected image added to H3 references; prompt and execution settings were kept")
                },
                err(message) => { let _ = desk.set_text(session, "status", message) },
              }
              continue
            }
            if id == "gen_visual_earlier" or id == "gen_visual_later" {
              move_reference(session, visual_references, selected_visual,
                false, id == "gen_visual_earlier")
              continue
            }
            if id == "gen_audio_earlier" or id == "gen_audio_later" {
              move_reference(session, audio_references, selected_audio,
                true, id == "gen_audio_earlier")
              continue
            }
            if id == "gen_remove_visual" or id == "gen_remove_audio" {
              if id == "gen_remove_visual" {
                remove_item(visual_references, selected_visual)
                selected_visual = string.new()
                show_items(session, "gen_visual_refs", visual_references)
                reference_actions(session, false, "", array.len(visual_references))
              } else {
                remove_item(audio_references, selected_audio)
                selected_audio = string.new()
                show_items(session, "gen_audio_refs", audio_references)
                reference_actions(session, true, "", array.len(audio_references))
              }
              continue
            }
            if id == "clear_history" {
              match library.clear_history() {
                ok(_) => {
                  history = []
                  show_gallery_items(session,"gen_history",history)
                  let _ = desk.set_bool(session, "gen_history_empty", "visible", true)
                  let _ = desk.set_text(session, "status", "History cleared; generated media files were kept")
                },
                err(message) => { let _ = desk.set_text(session, "status", message) },
              }
              continue
            }
            if id == "clear_reference" {
              reference_media = string.new()
              clear_reference(session, false)
              continue
            }
            if id == "clear_last_reference" {
              last_reference_media = string.new()
              clear_reference(session, true)
              continue
            }
            if id == "gen_add_visual" or id == "gen_add_audio" {
              let audio: bool = id == "gen_add_audio"
              if (audio and array.len(audio_references) >= 3) or
                 (not audio and array.len(visual_references) >= 9) {
                let _ = desk.set_text(session, "status", "Reference limit reached: nine visuals and three audio clips")
                continue
              }
              let _ = desk.dialog_multiple(session, id,
                if audio { "Add audio references" } else {
                  "Add image or video references · PNG, JPEG, WebP, or video" }, "")
              continue
            }
            if id == "choose_reference" {
              let folder: string = if reference_media == "" { string.new() } else { path.dirname(str.view(reference_media)) }
              let _ = desk.dialog(session, id, "open",
                "Add H3 reference · PNG, JPEG, WebP, or video", "", str.view(folder))
              continue
            }
            if id == "choose_last_reference" {
              let folder: string = if last_reference_media == "" { string.new() } else { path.dirname(str.view(last_reference_media)) }
              let _ = desk.dialog(session, id, "open", "Choose H3 last frame", "", str.view(folder))
              continue
            }
            if id == "choose_control" {
              let folder: string = if control_media == "" { string.new() } else { path.dirname(str.view(control_media)) }
              let _ = desk.dialog(session, id, "open", "Add H3 control media", "", str.view(folder))
              continue
            }
            if id == "gen_character_sheet_apply" {
              if not character_sheet.valid(character_sheet_mode) {
                generation_status(session,"Select the four- or six-panel H3 character-sheet preset")
                continue
              }
              model_index = h3.model_reference()
              task_index = h3.task_ref2va()
              resolution_index = h3.resolution_custom()
              width = character_sheet.width(character_sheet_mode)
              height = character_sheet.height(character_sheet_mode)
              seconds = character_sheet.seconds(character_sheet_mode)
              prompt = character_sheet.general_input()
              let _ = desk.set_number(session,"gen_model","selected",cast.float(model_index))
              let _ = desk.set_number(session,"gen_task","selected",cast.float(task_index))
              let _ = desk.set_number(session,"gen_resolution","selected",cast.float(resolution_index))
              let _ = desk.set_number(session,"gen_width","value",cast.float(width))
              let _ = desk.set_number(session,"gen_height","value",cast.float(height))
              let _ = desk.set_number(session,"gen_duration","value",seconds)
              let _ = desk.set_text(session,"gen_prompt_buffer",str.view(prompt))
              geometry_widgets(session,width,height,seconds,false,false)
              source_widgets(session,task_index)
              model_widgets(session,model_index,character_sheet_mode,generation_mode)
              generation_status(session,"Character-sheet preset applied · add Picture 1 and select explicit H3 runtime policies")
              continue
            }
            if id=="render_all"{
              if array.len(generations)!=0{
                let _=desk.set_text(session,"status","A generation is already running")
                continue}
              movie_render_all=true
              var next:u64=0
              var found:bool=false
              loop{if next>=array.len(struct.borrow(movie_state,field=shots)){break}
                var candidate=movie.snapshot_shot(movie_state,next)
                if candidate.selected_take<0{
                  found=true
                  break
                }
                next=next+1}
              if not found{
                movie_render_all=false
                let _=desk.set_text(session,"status","Every shot already has a selected finished take")
                continue}
              struct.set(movie_state,next,field=selected_shot)
              show_movie(session,movie_state)
              let _=desk.set_text(session,"status","Render all started · shots run sequentially on the native H3 session")
              let _=desk.activate(session,"queue_take")
              continue
            }
            if id=="movie_endless_stop"{
              struct.set(movie_state,false,field=endless_active)
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              show_movie(session,movie_state)
              let _=desk.set_text(session,"status","Endless chain will stop after the current segment")
              continue
            }
            if id=="movie_endless_start"{
              if array.len(generations)!=0{
                let _=desk.set_text(session,"status","A generation is already running")
                continue}
              match movie.validate_endless(movie_state){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)
                  continue},
              }
              struct.set(movie_state,true,field=endless_active)
              let completed_seconds=movie.completed_seconds(movie_state)
              if completed_seconds>=movie_state.endless_target{
                struct.set(movie_state,false,field=endless_active)
                let _=desk.set_text(session,"status",
                  "Endless target is already complete")
                show_movie(session,movie_state)
                continue}
              let next_duration=movie.endless_segment_duration(completed_seconds,
                movie_state.endless_target,movie_state.endless_segment)
              let last=array.len(struct.borrow(movie_state,field=shots))-1
              struct.set(movie_state,last,field=selected_shot)
              var tail=movie.snapshot_shot(movie_state,last)
              if tail.selected_take>=0 {
                match movie.create_continuation(movie_state,last){
                  ok(_)=>{movie.set_duration(movie_state,movie_state.selected_shot,
                    next_duration)},
                  err(message)=>{struct.set(movie_state,false,field=endless_active)
                    let _=desk.set_text(session,"status",message)
                    continue}}
              } else {movie.set_duration(movie_state,last,next_duration)}
              match save_movie(movie_state,str.view(movie_project_path)){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              show_movie(session,movie_state)
              let _=desk.set_text(session,"status","Endless native continuation started; segments run sequentially")
              let _=desk.activate(session,"queue_take")
              continue
            }
            if id=="continue_take"{
              match movie.create_continuation(movie_state,movie_state.selected_shot){
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)
                  continue}}
              match save_movie(movie_state,str.view(movie_project_path)){ok(_)=>{},err(message)=>{let _=desk.set_text(session,"status",message)}}
              show_movie(session,movie_state)
              let _=desk.set_text(session,"status","Continuation shot created from the selected take; queue it when ready")
              continue
            }
            if id=="queue_take"{
              if array.len(prompt_jobs)!=0{
                let _=desk.set_text(session,"status","Wait for Qwen Director teardown before starting H3")
                continue}
              var shot=movie.snapshot_shot(movie_state,movie_state.selected_shot)
              match movie.validate(shot){ok(_)=>{},err(message)=>{
                let _=desk.set_text(session,"status",message)
                if movie_render_all{movie_render_all=false}
                continue}}
              if shot.locked{
                let _=desk.set_text(session,"status","Unlock the approved shot before queueing another take")
                movie_render_all=false
                continue}
              prompt=movie.compile_project_prompt(movie_state,movie_state.selected_shot)
              movie_motion_context=string.copy(struct.borrow(shot,field=continue_from))
              movie_motion_context_frames=shot.motion_context_frames
              movie_motion_output_frames=movie.output_frames(shot)
              width=shot.width
              height=shot.height
              seconds=shot.duration
              seed=shot.seed
              seed_locked=true
              seed_valid=true
              resolution_index=h3.resolution_custom()
              show_movie_runtime_policy(session,profile_index,conditioner_projection_index,
                transformer_projection_index,attention_index)
              generation_mode=character_swap.standard()
              character_sheet_mode=character_sheet.off()
              reference_media=string.copy(struct.borrow(shot,field=first_frame))
              last_reference_media=string.copy(struct.borrow(shot,field=last_frame))
              visual_references=[]
              var effective_movie_refs=movie.effective_references(movie_state,
                movie_state.selected_shot)
              var ref_index:u64=0
              loop{if ref_index>=array.len(effective_movie_refs){break}
                let filename=array.borrow(effective_movie_refs,ref_index)
                array.push(visual_references,library.item(filename,filename,""))
                ref_index=ref_index+1}
              if str.len(struct.borrow(shot,field=continue_from))!=0{
                visual_references=[]
                model_index=h3.model_base()
                task_index=h3.task_t2va()
              }else if array.len(visual_references)!=0{
                model_index=h3.model_reference()
                task_index=h3.task_ref2va()
              }else{
                model_index=h3.model_base()
                task_index=if str.len(struct.borrow(shot,field=first_frame))!=0 and
                  str.len(struct.borrow(shot,field=last_frame))!=0{h3.task_fl2va()}
                  else if str.len(struct.borrow(shot,field=first_frame))!=0{h3.task_i2va()}
                  else if str.len(struct.borrow(shot,field=last_frame))!=0{h3.task_l2va()}
                  else{h3.task_t2va()}
              }
              movie_generation_active=true
              movie_generation_shot=movie_state.selected_shot
              let _=desk.set_text(session,"movie_runtime","H3 TAKE STARTING…")
            }
            if id=="edit_repair_preview"{
              if not edit_source_video or edit_source_frames<4{
                let _=desk.set_text(session,"edit_repair_report",
                  "Repair planning requires a probed source video")
                continue
              }
              var cuts=match repair_cuts(str.view(edit_repair_cuts)){
                ok(value)=>value,err(message)=>{
                  let _=desk.set_text(session,"edit_repair_report",message)
                  continue
                },
              }
              let memory=if edit_repair_memory==1{repair_plan.MemoryMode.Full}
                else if edit_repair_memory==2{repair_plan.MemoryMode.Rolling}
                else{repair_plan.MemoryMode.Auto}
              match repair_plan.build(edit_source_frames,edit_repair_first,
                  edit_repair_end,edit_repair_handle_before,
                  edit_repair_handle_after,array.view(cuts),edit_source_width,
                  edit_source_height,memory,edit_repair_window,
                  edit_repair_overlap,0.0){
                ok(value)=>{var made=value
                  let _=desk.set_text(session,"edit_repair_report",
                    str.view(repair_plan.report(made)))},
                err(message)=>{let _=desk.set_text(session,
                  "edit_repair_report",message)},
              }
              continue
            }
            if id=="edit_motion_analyze"{
              if not edit_source_video or edit_source_frames<4{
                let _=desk.set_text(session,"edit_status",
                  "Load a source video before automatic motion analysis")
              }else{
                let _=desk.set_text(session,"edit_status",
                  "Analyzing decoded source motion in native AIR…")
                match repair_runtime.analyze_motion(str.view(edit_source),system.temp_directory(),
                    1.0,cast.float(edit_repair_dilation)){
                  ok(value)=>{var found=value
                    let summary=repair_analysis.describe(found)
                    edit_motion_plan=ref.swap(struct.borrow(found,field=plan),
                      repair_motion.create(edit_source_frames))
                    edit_motion_plan_ready=true
                    let heat=repair_motion.heatmap(edit_motion_plan,32)
                    let _=desk.set_text(session,"edit_motion_heatmap",str.view(heat))
                    let _=desk.set_text(session,"edit_status",str.view(summary))},
                  err(message)=>{let _=desk.set_text(session,"edit_status",message)},
                }
              }
              continue
            }
            if id=="edit_motion_add_span"{
              if not edit_motion_plan_ready{
                let _=desk.set_text(session,"edit_status",
                  "Load a source video before painting a hold span")
              }else{
                  match repair_motion.add_span(edit_motion_plan,
                    edit_repair_first,edit_repair_end,
                    cast.float(edit_repair_dilation)){
                  ok(_)=>{let heat=repair_motion.heatmap(edit_motion_plan,32)
                    let _=desk.set_text(session,"edit_motion_heatmap",
                      str.view(heat))
                    let _=desk.set_text(session,"edit_status",
                      "Hold span painted into reusable MotionPlan")},
                  err(message)=>{let _=desk.set_text(session,"edit_status",message)}}
              }
              continue
            }
            if id=="edit_motion_clear"{
              if edit_source_frames!=0{
                edit_motion_plan=repair_motion.create(edit_source_frames)
                edit_motion_plan_ready=true}
              let _=desk.set_text(session,"edit_motion_heatmap",
                "................................")
              let _=desk.set_text(session,"edit_status","MotionPlan cleared")
              continue
            }
            if id=="edit_motion_import"{
              let _=desk.dialog(session,id,"open","Import MotionPlan JSON","","")
              continue
            }
            if id=="edit_motion_export"{
              let _=desk.dialog(session,id,"save","Export MotionPlan JSON",
                "motion.airh3motion.json","")
              continue
            }
            if id == "edit_run" or id=="edit_outpaint_preview_window" {
              edit_outpaint_preview=id=="edit_outpaint_preview_window"
              edit_generation_active=true
              let repair_active=edit_mode==6 or edit_mode==7
              if repair_active{
                if not edit_source_video or edit_source_frames<4{
                  let _=desk.set_text(session,"edit_status",
                    "H3 Repair requires a probed source video")
                  continue
                }
                var repair_cut_check=match repair_cuts(str.view(edit_repair_cuts)){
                  ok(value)=>value,err(message)=>{
                    let _=desk.set_text(session,"edit_status",message)
                    continue
                  },
                }
                let repair_memory_check=if edit_repair_memory==1{
                  repair_plan.MemoryMode.Full}else if edit_repair_memory==2{
                  repair_plan.MemoryMode.Rolling}else{repair_plan.MemoryMode.Auto}
                match repair_plan.build(edit_source_frames,edit_repair_first,
                    edit_repair_end,edit_repair_handle_before,
                    edit_repair_handle_after,array.view(repair_cut_check),
                    edit_source_width,edit_source_height,repair_memory_check,
                    edit_repair_window,edit_repair_overlap,0.0){
                  ok(_)=>{},err(message)=>{
                    let _=desk.set_text(session,"edit_status",message)
                    continue
                  },
                }
                prompt=string.copy(str.view(edit_prompt))
                generation_mode=character_swap.standard()
                model_index=h3.model_reference()
                task_index=h3.task_ref2va()
                resolution_index=h3.resolution_custom()
                width=edit_source_width
                height=edit_source_height
                seconds=cast.float(edit_source_frames)/24.0
              }else if edit_mode==5 {
                if not edit_source_video or edit_source_frames<4 {
                  let _=desk.set_text(session,"edit_status",
                    "Video Outpaint requires a probed source video")
                  continue
                }
                match outpaint.validate_prompt(str.view(edit_prompt)){
                  ok(_)=>{},err(message)=>{let _=desk.set_text(session,"edit_status",
                    text.concat("Build the Video Outpaint prompt first: ",message))
                    continue}}
                match outpaint.geometry(edit_source_width,edit_source_height,
                    edit_outpaint_width,edit_outpaint_height,
                    edit_outpaint_direction,edit_outpaint_anchor){
                  ok(_)=>{},err(message)=>{let _=desk.set_text(session,"edit_status",message)
                    continue}}
                prompt=string.copy(str.view(edit_prompt))
                generation_mode=character_swap.standard()
                model_index=h3.model_reference()
                task_index=h3.task_ref2va()
                resolution_index=h3.resolution_custom()
                width=edit_outpaint_width
                height=edit_outpaint_height
                seconds=cast.float(edit_source_frames)/24.0
              } else {
              if str.len(str.view(edit_source))==0 or
                 (character_swap.edit_requires_mask(edit_mode) and
                   str.len(str.view(edit_mask_path))==0 and not edit_manual_mask and
                   array.len(edit_brush_points)==0) or
                 (character_swap.edit_requires_identity(edit_mode) and
                   array.len(edit_references)==0) {
                let _=desk.set_text(session,"edit_status",
                  "Run Edit requires a source; masked modes require a mask and character modes require a reference image")
                continue
              }
              match if edit_source_video {
                character_swap.validate_prompt(str.view(edit_prompt))
              } else if character_swap.edit_character_replace(edit_mode) {
                character_swap.validate_image_replace_prompt(str.view(edit_prompt))
              } else {character_swap.validate_local_image_prompt(str.view(edit_prompt))} {
                ok(_)=>{},err(message)=>{let _=desk.set_text(session,"edit_status",
                  text.concat("Build an H3 edit prompt first: ",message))
                  continue},
              }
              swap_source_video=string.copy(str.view(edit_source))
              swap_mask_path=string.copy(str.view(edit_mask_path))
              let implicit_full_image:bool=character_swap.edit_character_replace(
                edit_mode) and not edit_source_video
              swap_manual_mask=if implicit_full_image{true}else{edit_manual_mask}
              swap_painted_mask=if implicit_full_image{false}else{
                array.len(edit_brush_points)!=0}
              swap_brush_points=[]
              var brush_index:u64=0
              loop {if brush_index>=array.len(edit_brush_points){break}
                array.push(swap_brush_points,array.get(edit_brush_points,brush_index))
                brush_index=brush_index+1}
              swap_mask_x=if implicit_full_image{0.0}else{edit_mask_x}
              swap_mask_y=if implicit_full_image{0.0}else{edit_mask_y}
              swap_mask_width=if implicit_full_image{1.0}else{edit_mask_width}
              swap_mask_height=if implicit_full_image{1.0}else{edit_mask_height}
              swap_character_references=[]
              var edit_ref:u64=0
              loop {
                if edit_ref>=array.len(edit_references){break}
                let item=array.borrow(edit_references,edit_ref)
                array.push(swap_character_references,library.item(
                  struct.borrow(item,field=path),struct.borrow(item,field=thumbnail),""))
                edit_ref=edit_ref+1
              }
              prompt=string.copy(str.view(edit_prompt))
              swap_prompt_built=true
              generation_mode=if character_swap.edit_character_replace(edit_mode)
                  and edit_source_video{character_swap.enabled()}
                else{character_swap.masked()}
              model_index=h3.model_reference()
              task_index=h3.task_ref2va()
              swap_mask_preserve=edit_preserve
              swap_mask_feather=edit_feather
              swap_mask_cleanup=edit_cleanup
              swap_mask_expand=edit_expand
              swap_mask_strategy=edit_strategy
              swap_mask_padding=edit_padding
              }
            }
            if id == "generate_action" or id == "queue_take" or id == "edit_run" or
               id=="edit_outpaint_preview_window" or
               id == "gen_save_parameters" {
              if id!="gen_save_parameters" and not seed_locked {
                seed=random_seed()
                seed_valid=true
                let _=desk.set_text(session,"gen_seed",str.view(string.from_int(seed)))
              }
              if (id == "generate_action" or id == "queue_take" or id == "edit_run" or
                  id=="edit_outpaint_preview_window") and
                 array.len(prompt_jobs) != 0 {
                generation_status(session,"Wait for Prompt Lab Qwen teardown before starting generation")
                continue
              }
              if not seed_valid {
                generation_status(session,"Seed must be an integer (-1 for random)")
                continue
              }
              if seedvr2_enabled and seedvr2_run_after and not seedvr2_seed_valid{
                generation_status(session,"SeedVR2 seed must be a nonnegative integer")
                continue
              }
              if array.len(generations) != 0 and
                 (id == "generate_action" or id == "queue_take" or id == "edit_run" or
                  id=="edit_outpaint_preview_window") {
                generation_status(session,"Generation is already running")
                continue
              }
              let swap: bool = character_swap.is_swap(generation_mode)
              let masked: bool = character_swap.is_masked(generation_mode)
              let sheet: bool = character_sheet.valid(character_sheet_mode)
              if seedvr2_enabled and seedvr2_run_after and
                  (model_index==parameters.krea_model_index() or
                   parameters.qwen_like(model_index)){
                generation_status(session,
                  "SeedVR2 post-processing requires a generated video; the selected model outputs PNG")
                continue
              }
              if seedvr2_enabled and seedvr2_run_after and sheet{
                generation_status(session,
                  "Disable the character-sheet PNG preset before using SeedVR2 video post-processing")
                continue
              }
              let outpaint_active:bool=(id=="edit_run" or
                id=="edit_outpaint_preview_window") and edit_mode==5
              let repair_active:bool=id=="edit_run" and
                (edit_mode==6 or edit_mode==7)
              if swap and (model_index != h3.model_reference() or
                  task_index != h3.task_ref2va()) {
                generation_status(session,
                  "Character Swap requires MiniMax H3 Reference + Ref2VA")
                continue
              }
              if swap and str.len(str.view(swap_source_video)) == 0 {
                generation_status(session,"Choose the Character Swap Source Video")
                continue
              }
              if swap and array.len(swap_character_references) == 0 and
                 not (id=="edit_run" and not edit_source_video) {
                generation_status(session,"Add at least one Reference Character image")
                continue
              }
              if masked and str.len(str.view(swap_mask_path)) == 0 and
                 not swap_manual_mask and not swap_painted_mask {
                generation_status(session,
                  "Masked Character Swap requires an authored mask; ordinary full-frame generation was not used")
                continue
              }
              if masked and not swap_mask_preserve {
                generation_status(session,
                  "Enable Preserve Outside Mask or choose ordinary Character Swap")
                continue
              }
              if swap and not swap_prompt_built {
                generation_status(session,
                  if masked {"Build Prompt with Qwen after selecting the current source and character media"}
                  else {"Character Swap needs a source video, a character picture, and a description when replacing a selected subject"})
                continue
              }
              if swap {
                match if id=="edit_run" and not edit_source_video and
                    character_swap.edit_character_replace(edit_mode) {
                  character_swap.validate_image_replace_prompt(str.view(prompt))
                } else if id=="edit_run" and not edit_source_video {
                  character_swap.validate_local_image_prompt(str.view(prompt))
                } else if masked {character_swap.validate_prompt(str.view(prompt))
                } else {character_swap.validate_swap_prompt(str.view(prompt))} {
                  ok(_) => {},
                  err(message) => { generation_status(session,message)
                    continue },
                }
              }
              if sheet and (model_index != h3.model_reference() or
                  task_index != h3.task_ref2va() or
                  width != character_sheet.width(character_sheet_mode) or
                  height != character_sheet.height(character_sheet_mode) or
                  seconds != character_sheet.seconds(character_sheet_mode)) {
                generation_status(session,"Apply the selected character-sheet preset before generating")
                continue
              }
              if sheet and array.len(visual_references) == 0 {
                generation_status(session,"Add Picture 1 before generating an H3 character sheet")
                continue
              }
              var sheet_output: string = string.new()
              if id == "generate_action" or id == "queue_take" or id == "edit_run" or
                  id=="edit_outpaint_preview_window" {
                generation_started = time.monotonic_ns()
                let krea: bool = model_index == parameters.krea_model_index()
                let qwen_image:bool=model_index==parameters.qwen_image_model_index()
                let flux:bool=model_index==parameters.flux3_model_index()
                let folder: str = if id=="queue_take"{"movies/takes"}
                  else if flux{"flux3-klein/generate"}
                  else if qwen_image{"qwen-image-2.1/generate"}
                  else if krea {"krea"} else if sheet {"character-sheets"}
                  else if outpaint_active {"outpaint"}
                  else if masked {"masked-edits"} else {"h3"}
                let stem: string = text.concat(if id=="queue_take"{"take"}
                  else if qwen_image or flux{"generate"}
                  else if sheet {"character-sheet"} else {folder},
                  text.concat("-",string.from_int(time.monotonic_ns())))
                let extension: str = if qwen_image or krea or flux or sheet or
                  (id=="edit_run" and not edit_source_video) {".png"} else {".mp4"}
                let output_folder: string = path.join(output_directory,folder)
                var allocated = match library.unused_output(str.view(output_folder),
                    str.view(stem),extension) {
                  ok(value) => value,
                  err(problem) => { generation_status(session,problem)
                    continue },
                }
                if sheet {
                  sheet_output = allocated
                  let movie_name: string = text.concat(str.view(stem),".mp4")
                  output_media = path.join(str.view(output_folder),str.view(movie_name))
                } else { output_media = allocated }
                if sheet {
                } else {
                }
                io.write(text.concat(if qwen_image{"mm-air automatic Qwen-Image-2.1 output="} else if krea {"mm-air automatic Krea output="} else if sheet {"mm-air automatic H3 character-sheet source="} else if swap {"mm-air automatic H3 character-swap output="} else {"mm-air automatic H3 output="},
                  text.concat(output_media,"\n")))
              }
              if model_index==parameters.flux3_model_index(){
                var request=parameters.Flux3Request{prompt:string.copy(prompt),
                  output:string.copy(output_media),references:array.new(),
                  width:width,height:height,steps:16,
                  seed:if seed<0{time.monotonic_ns()}else{cast.wrap(seed)},upsample:enhance_prompt}
                if id=="gen_save_parameters"{
                  save_parameter_snapshot(session,output_directory,parameters.encode_flux3(request))
                  continue
                }
                match parameters.validate_flux3(request){
                  err(message)=>{generation_status(session,message)
                    continue},ok(_)=>{},
                }
                running_parameters=parameters.encode_flux3(request)
                var receiver=match channel.open(128,1024){
                  ok(value)=>value,
                  err(problem)=>{var held=problem
                    generation_status(session,channel.message(held))
                    continue},
                }
                var work=generation.Flux3Job{request:request,progress:channel.ticket(receiver)}
                array.push(progress_receivers,receiver)
                array.push(generations,task.spawn(work,fn=generation.run_flux3))
                let _=desk.set_bool(session,"generate_action","sensitive",false)
                let _=desk.set_text(session,"gen_run_state","Generating")
                let _=desk.set_text(session,"gen_batch_status","Running")
                generation_status(session,"Starting native AIR FLUX 3 Image Klein")
                io.write("mm-air started native AIR FLUX 3 Image Klein generation\n")
                continue
              }
              if model_index==parameters.qwen_image_model_index(){
                var request=parameters.QwenImageRequest{prompt:string.copy(prompt),
                  output:string.copy(output_media),source:string.new(),references:array.new(),
                  width:width,height:height,
                  steps:if qwen_turbo{
                    qwen_image_contract.turbo_steps()}else{qwen_image_steps},
                  seed:if seed<0{time.monotonic_ns()}else{cast.wrap(seed)},
                  scheduler:qwen_effective_scheduler(qwen_turbo,qwen_image_scheduler),
                  sampler:qwen_image_sampler,enhance:enhance_prompt}
                if id=="gen_save_parameters"{
                  match parameters.encode_qwen_image(request){
                    ok(value)=>{save_parameter_snapshot(session,output_directory,value)},
                    err(message)=>{let _=desk.set_text(session,"status",message)},
                  }
                  continue
                }
                match parameters.validate_qwen_image(request){
                  err(message)=>{generation_status(session,message)
                    continue},ok(_)=>{},
                }
                running_parameters=match parameters.encode_qwen_image(request){
                  ok(value)=>value,
                  err(message)=>{generation_status(session,message)
                    continue},
                }
                var receiver=match channel.open(128,1024){
                  ok(value)=>value,
                  err(problem)=>{var held=problem
                    generation_status(session,channel.message(held))
                    continue},
                }
                var work=generation.QwenImageJob{request:request,
                  progress:channel.ticket(receiver)}
                array.push(progress_receivers,receiver)
                array.push(generations,task.spawn(work,fn=generation.run_qwen_image))
                let _=desk.set_bool(session,"generate_action","sensitive",false)
                let _=desk.set_text(session,"gen_run_state","Generating")
                let _=desk.set_text(session,"gen_batch_status","Running")
                generation_status(session,
                  "Starting native AIR Qwen-Image-2.1 · checkpoint loads once")
                io.write("mm-air started native AIR Qwen-Image-2.1 generation\n")
                continue
              }
              if model_index == parameters.krea_model_index() {
                var request = parameters.KreaRequest {prompt:string.copy(prompt),seed:seed,
                  width:width,height:height,output:string.copy(output_media),loras:parameters.clone_loras(generate_loras)}
                if id == "gen_save_parameters" {
                  match parameters.encode_krea(request) {
                    ok(value) => { save_parameter_snapshot(session,output_directory,value) },
                    err(message) => { let _ = desk.set_text(session,"status",message) },
                  }
                  continue
                }
                match parameters.validate_krea(request) {
                  err(message) => { generation_status(session,message)
                    continue },ok(_) => {},
                }
                var sources = match generation.krea_sources() {
                  ok(value) => value,err(message) => { generation_status(session,message)
                    continue },
                }
                if request.seed < 0 { struct.set(request,cast.sat(time.monotonic_ns()),field=seed) }
                running_parameters = match parameters.encode_krea(request) {
                  ok(value) => value,err(message) => { let _ = desk.set_text(session,"status",message)
                    continue },
                }
                var receiver = match channel.open(128,1024) {
                  ok(value) => value,err(problem) => { var held = problem
                    generation_status(session,channel.message(held))
                    continue },
                }
                var work = generation.KreaJob {sources:sources,request:request,progress:channel.ticket(receiver)}
                array.push(progress_receivers,receiver)
                array.push(generations,task.spawn(work,fn=generation.run_krea))
                let _ = desk.set_bool(session,"generate_action","sensitive",false)
                let _ = desk.set_text(session,"gen_run_state","Generating")
                let _ = desk.set_text(session,"gen_batch_status","Running")
                generation_status(session,"Starting linked AIR Krea 2 Turbo generation")
                io.write("mm-air started linked AIR Krea 2 Turbo generation\n")
                continue
              }
              var request_references: array<string> = selected_references(
                str.view(reference_media), str.view(last_reference_media))
              if outpaint_active {
                request_references=[string.copy(str.view(edit_source))]
              } else if repair_active {
                request_references=[string.copy(str.view(edit_source))]
                var repair_ref:u64=0
                loop{if repair_ref>=array.len(edit_references){break}
                  array.push(request_references,string.copy(struct.borrow(
                    array.borrow(edit_references,repair_ref),field=path)))
                  repair_ref=repair_ref+1}
              } else if task_index == h3.task_t2va() { request_references = [] }
              if task_index == h3.task_i2va() {
                request_references = selected_references(str.view(reference_media), "")
              }
              var request_prompt: string = string.copy(prompt)
              if sheet {
                request_prompt = match character_sheet.prompt(str.view(prompt),
                    character_sheet_mode,character_sheet_style) {
                  ok(value) => value,
                  err(problem) => { generation_status(session,problem)
                    continue },
                }
              }
              var request: h3.Request = h3.request(str.view(request_prompt), model_index, task_index,
                profile_index, conditioner_projection_index,
                transformer_projection_index, attention_index, seed,
                resolution_index, request_references, str.view(output_media))
              if swap {
                var swap_pictures = item_paths(swap_character_references)
                let _ = ref.swap(struct.borrow(request,field=references),
                  character_swap.h3_references(str.view(swap_source_video),swap_pictures))
                let _ = ref.swap(struct.borrow(request,field=audio_references),array.new())
              } else if task_index == h3.task_ref2va() and not outpaint_active
                  and not repair_active {
                let _ = ref.swap(struct.borrow(request, field=references), item_paths(visual_references))
                let _ = ref.swap(struct.borrow(request, field=audio_references), item_paths(audio_references))
              }
              let request_seconds:f64=if id=="edit_run" and not edit_source_video {
                22.0/24.0}else{seconds}
              match h3.set_geometry(request, width, height, request_seconds) {
                ok(_) => {},
                err(error) => { var held: h3.Problem = error
                  generation_status(session,h3.describe(held))
                  continue },
              }
              if id == "gen_save_parameters" {
                match parameters.encode_h3(request,generate_loras) {
                  ok(value) => {
                    save_parameter_snapshot(session,output_directory,value)
                  },
                  err(message) => { let _ = desk.set_text(session, "status", message) },
                }
                continue
              }
              match h3.validate(request) {
                err(found) => {
                  var problem: h3.Problem = found
                  generation_status(session,h3.describe(problem))
                },
                ok(_) => {
                  let task = if request.task == h3.task_t2va() { h3_session.Task.T2VA }
                    else if request.task == h3.task_i2va() { h3_session.Task.I2VA }
                    else if request.task == h3.task_fl2va() { h3_session.Task.FL2VA }
                    else if request.task == h3.task_l2va() { h3_session.Task.L2VA }
                    else { h3_session.Task.Ref2VA }
                  let model = if request.model == h3.model_base() { h3_session.Model.Base }
                    else { h3_session.Model.Reference }
                  let conditioner_projection: h3_session.Projection = session_projection(request.conditioner_projection)
                  // Character Swap runs the plain Ref2VA root with its LoRA files
                  // applied at run time, after any LoRAs in the Generate list. The
                  // 4-step schedule also needs the turbo (distillation) LoRA.
                  let turbo: bool = request.profile == h3.profile_turbo_4()
                  if turbo and (not swap or masked or
                      not option.is_some(generation.character_swap_turbo_lora())) {
                    generation_status(session,
                      "Turbo · 4 evaluations needs Character Swap and a turbo LoRA file in Settings; choose a 19-evaluation schedule otherwise")
                    continue
                  }
                  var job_lora_list: array<parameters.LoraEntry> = parameters.clone_loras(generate_loras)
                  if swap and not masked {
                    match generation.character_swap_lora() {
                      some(file) => { array.push(job_lora_list,
                        parameters.LoraEntry {path:file,strength:1.0,enabled:true}) },
                      none => {},
                    }
                    if turbo {
                      match generation.character_swap_turbo_lora() {
                        some(file) => { array.push(job_lora_list,
                          parameters.LoraEntry {path:file,strength:1.0,enabled:true}) },
                        none => {},
                      }
                    }
                  }
                  // Swap adapters run on the fused ConvRot path, whose cache rows
                  // match the adapters' stored layout.
                  if swap and not masked and array.len(job_lora_list) > 0 and
                      request.transformer_projection != h3.projection_convrot_int8() {
                    struct.set(request,h3.projection_convrot_int8(),
                      field=transformer_projection)
                  }
                  let transformer_projection: h3_session.Projection = session_projection(request.transformer_projection)
                  let attention: h3_session.Attention = session_attention(request.attention)
                  var configuration: generation.Configuration = match generation.configuration() {
                    ok(value) => value,
                    err(problem) => {
                      generation_status(session,str.view(problem))
                      continue
                    },
                  }
                  var receiver: channel.Receiver = match channel.open(128, 1024) {
                    ok(value) => value,
                    err(problem) => {
                      var owned_problem: channel.Error = problem
                      let _ = desk.set_text(session, "status",
                        str.view(channel.message(owned_problem)))
                      continue
                    },
                  }
                  let actual_seed: u64 = if request.seed < 0 {
                    time.monotonic_ns()
                  } else { cast.sat(request.seed) }
                  struct.set(request, cast.sat(actual_seed), field=seed)
                  running_parameters = match parameters.encode_h3(request,generate_loras) {
                    ok(value) => value,
                    err(message) => { let _ = desk.set_text(session, "status", message)
                      continue },
                  }
                  var job_references = copy_paths(struct.borrow(request, field=references))
                  var job_audio = copy_paths(struct.borrow(request, field=audio_references))
                  var job: generation.Job = generation.job_loras(configuration,
                    str.view(struct.borrow(request, field=prompt)),
                    model, task, request.geometry,
                    job_references, job_audio,
                    str.view(struct.borrow(request, field=output)),
                    job_lora_list,
                    if id == "generate_action" or id == "queue_take" or id == "edit_run" or
                        id=="edit_outpaint_preview_window" {
                      character_sheet_mode} else {character_sheet.off()},
                    str.view(sheet_output), actual_seed,
                    h3.evaluations(request.profile), conditioner_projection,
                    transformer_projection, attention, channel.ticket(receiver),
                    if request.profile == h3.profile_dc_euler_19() {h3_session.Schedule.Exponential} else {h3_session.Schedule.Simple})
                  // A swap source clip only supplies motion and scene, so encode
                  // it at the output resolution rather than the 768p canvas.
                  if swap and not masked {
                    generation.enable_reference_video_match(job)
                  }
                  if id=="queue_take" and str.len(str.view(movie_motion_context))!=0 {
                    match generation.enable_motion_context(job,
                        str.view(movie_motion_context),movie_motion_context_frames,
                        movie_motion_output_frames) {
                      ok(_)=>{},err(message)=>{generation_status(session,str.view(message))
                        movie_generation_active=false
                        movie_render_all=false
                        continue},
                    }
                    match generation.enable_drift_control(job,
                        movie_drift_enabled,movie_drift_matched,
                        movie_drift_taper,movie_drift_amount){
                      ok(_)=>{},err(message)=>{generation_status(session,
                        str.view(message))
                        movie_generation_active=false
                        movie_render_all=false
                        continue},
                    }
                  }
                  let requested_window_frames:u64=cast.sat(math.round(
                    prompt_window_seconds*24.0))
                  let requested_overlap_frames:u64=cast.sat(math.round(
                    prompt_overlap_seconds*24.0))
                  if model==h3_session.Model.Base and
                      request.geometry.frames>requested_window_frames {
                    match generation.enable_windowed(job,requested_window_frames,
                        requested_overlap_frames) {
                      ok(_)=>{},
                      err(message)=>{generation_status(session,str.view(message))
                        continue},
                    }
                  }
                  if masked {
                    var mask_settings=if swap_painted_mask {
                      var brush_copy:array<masked_edit.BrushPoint> = []
                      var brush_index:u64=0
                      loop {if brush_index>=array.len(swap_brush_points){break}
                        array.push(brush_copy,array.get(swap_brush_points,brush_index))
                        brush_index=brush_index+1}
                      masked_runtime.paint_settings(brush_copy,swap_mask_cleanup,
                        swap_mask_feather,swap_mask_expand,swap_mask_strategy,
                        swap_mask_padding,swap_mask_preserve)
                    } else {masked_runtime.settings(str.view(swap_mask_path),
                      swap_manual_mask,swap_mask_x,swap_mask_y,swap_mask_width,
                      swap_mask_height,swap_mask_cleanup,swap_mask_feather,
                      swap_mask_expand,swap_mask_strategy,swap_mask_padding,
                      swap_mask_preserve)}
                    generation.enable_masked_composite(job,mask_settings)
                    match generation.enable_two_matte(job,str.view(sam3_plugin),
                        str.view(sam3_model)) {
                      ok(_)=>{},err(message)=>{generation_status(session,
                        str.view(message))
                        continue},
                    }
                  }
                  if outpaint_active {
                    let outpaint_window_frames:u64=cast.sat(math.round(
                      edit_outpaint_window_seconds*24.0))
                    let outpaint_overlap_frames:u64=cast.sat(math.round(
                      edit_outpaint_overlap_seconds*24.0))
                    var outpaint_settings=outpaint_runtime.settings(
                      edit_outpaint_width,edit_outpaint_height,
                      edit_outpaint_direction,edit_outpaint_anchor,
                      edit_outpaint_composite,if edit_outpaint_composite==
                        outpaint.exact(){0}else{edit_outpaint_seam},
                      outpaint_window_frames,outpaint_overlap_frames,
                      edit_outpaint_preview)
                    outpaint_runtime.set_qwen_model(outpaint_settings,
                      prompt_model_index)
                    generation.enable_outpaint(job,outpaint_settings)
                    var history_geometry=match outpaint.geometry(
                        edit_source_width,edit_source_height,
                        edit_outpaint_width,edit_outpaint_height,
                        edit_outpaint_direction,edit_outpaint_anchor) {
                      ok(value)=>value,
                      err(message)=>{generation_status(session,str.view(message))
                        continue},
                    }
                    running_parameters=match outpaint.sidecar(history_geometry,
                        str.view(edit_source),struct.borrow(request,field=prompt),
                        actual_seed,request.geometry.frames,
                        outpaint_window_frames,outpaint_overlap_frames,
                        edit_outpaint_composite,if edit_outpaint_composite==
                          outpaint.exact(){0}else{edit_outpaint_seam},true,
                        if request.geometry.frames>outpaint_window_frames{
                          "decoded-tail-reference"}else{"single-window"},
                        cast.wrap(prompt_model_index),job.evaluations,
                        cast.wrap(request.conditioner_projection),
                        cast.wrap(request.transformer_projection),
                        cast.wrap(request.attention),if request.profile==
                          h3.profile_dc_euler_19(){1}else{0}) {
                      ok(value)=>value,
                      err(message)=>{generation_status(session,str.view(message))
                        continue},
                    }
                  }
                  if repair_active{
                    var repair_settings=repair_runtime.settings(
                      edit_repair_first,edit_repair_end,
                      edit_repair_handle_before,edit_repair_handle_after,
                      if edit_mode==7{edit_repair_dilation}else{1.0},
                      if edit_repair_memory==1{repair_plan.MemoryMode.Full}
                        else if edit_repair_memory==2{
                          repair_plan.MemoryMode.Rolling}else{
                          repair_plan.MemoryMode.Auto},
                      edit_repair_window,edit_repair_overlap)
                    var parsed_cuts=match repair_cuts(str.view(edit_repair_cuts)){
                      ok(value)=>value,err(message)=>{
                        generation_status(session,str.view(message))
                        continue
                      },
                    }
                    let _=ref.swap(struct.borrow(repair_settings,
                      field=shot_cuts),parsed_cuts)
                    if str.len(str.view(edit_mask_path))!=0{
                      match repair_runtime.set_spatial_mask(repair_settings,
                          str.view(edit_mask_path),edit_cleanup,edit_feather,
                          edit_expand){
                        ok(_)=>{},err(message)=>{generation_status(session,
                          str.view(message))
                          continue},
                      }
                      match generation.enable_two_matte(job,str.view(sam3_plugin),
                          str.view(sam3_model)){
                        ok(_)=>{},err(message)=>{generation_status(session,
                          str.view(message))
                          continue},
                      }
                    }
                    if edit_mode==7 and edit_motion_plan_ready{
                      let encoded_motion=repair_motion.encode(edit_motion_plan)
                      match repair_runtime.set_motion_plan(repair_settings,
                          str.view(encoded_motion)){
                        ok(_)=>{},err(message)=>{generation_status(session,
                          str.view(message))
                          continue},
                      }
                    }
                    match generation.enable_repair(job,repair_settings){
                      ok(_)=>{},err(message)=>{
                        generation_status(session,str.view(message))
                        continue
                      },
                    }
                    let timing_mode=if edit_timing_mode==1{
                      h3_timing.Mode.PhysicalAll}else if edit_timing_mode==2{
                      h3_timing.Mode.CompactAll}else if edit_timing_mode==3{
                      h3_timing.Mode.PhysicalBlocks}else if edit_timing_mode==4{
                      h3_timing.Mode.CompactBlocks}else if edit_timing_mode==5{
                      h3_timing.Mode.FadePhysicalToCompact}else if edit_timing_mode==6{
                      h3_timing.Mode.PhysicalSteps}else{
                      h3_timing.Mode.Stock}
                    var timing_settings=match h3_timing.config(timing_mode,
                        edit_timing_block_lo,edit_timing_block_hi,
                        edit_timing_fade,edit_timing_step_lo,
                        edit_timing_step_hi){
                      ok(value)=>value,err(message)=>{
                        generation_status(session,str.view(message))
                        continue
                      },
                    }
                    generation.enable_timing(job,timing_settings)
                  }
                  if seedvr2_enabled and seedvr2_run_after {
                    var post_settings=seedvr2_post.settings(seedvr2_variant,seedvr2_size,
                      seedvr2_width,seedvr2_height,seedvr2_audio,seedvr2_seed,
                      seedvr2_quality,seedvr2_memory)
                    match generation.enable_seedvr2(job,post_settings){
                      ok(_)=>{},err(message)=>{generation_status(session,str.view(message))
                        continue},
                    }
                  }
                  let windowed_job:bool=job.window_frames<job.geometry.frames
                  // Release the prior GTK/GStreamer decoder before the H3 GPU
                  // context opens. A displayed result otherwise keeps hundreds
                  // of MiB resident and can push a subsequent 24 GB run over
                  // the device boundary even when the same cold run fits.
                  let _ = desk.clear_video(session,"result_video")
                  let _ = desk.set_bool(session,"result_video","visible",false)
                  array.push(progress_receivers, receiver)
                  array.push(generations, task.spawn(job, fn=generation.run))
                  let _ = desk.set_bool(session, "generate_action", "sensitive", false)
                  let _ = desk.set_text(session, "gen_run_state", "Generating")
                  generation_status(session,if outpaint_active {
                    if edit_outpaint_preview{"Starting native H3 Video Outpaint first-window preview"}
                    else{"Starting sequential native H3 Video Outpaint"}
                  } else if repair_active{
                    if edit_mode==7{"Starting bounded native H3 Motion Repair"}
                    else{"Starting bounded native H3 frame repair"}
                  } else if masked {
                    "Preparing native masked H3 crop; no full-frame fallback"
                  } else if swap {
                    "Starting linked AIR MiniMax-H3 Character Swap with Video 1 + Picture 1…N"
                  } else if windowed_job {
                    "Starting linked AIR MiniMax-H3 latent-window generation"
                  } else {"Starting linked AIR MiniMax-H3 generation"})
                  let _ = desk.set_text(session, "gen_batch_status", "Running")
                  io.write("mm-air started linked AIR H3 generation\n")
                },
              }
              continue
            }
            action_status(session, id)
          }
        }
      },
    }
    desk.close(session)
    let _ = proc.settle(hosts, session.root, 2000, 300)
  }
  desk.cleanup(session)
  result_code
}
