                    loop{
                      if lora_index>=array.len(struct.borrow(request,field=loras)){break}
                      let entry=array.borrow(struct.borrow(request,field=loras),lora_index)
                      var preset_index:u64=0
                      loop{
                        if preset_index>=face_swap.count(){break}
                        match face_swap.preset(preset_index){
                          some(found)=>{if text.contains(str.view(path.basename(str.view(struct.borrow(entry,field=path)))),str.view(found.stem)){
                            qwen_swap=preset_index+1
                            qwen_swap_strength=entry.strength}},
                          none=>{},
                        }
                        preset_index=preset_index+1
                      }
                      lora_index=lora_index+1
                    }
                    let _=desk.set_number(session,"qwen_edit_swap","selected",cast.float(qwen_swap))
                    let _=desk.set_number(session,"qwen_edit_swap_strength","value",qwen_swap_strength)
                    if qwen_swap>0{
                      swap_target=string.copy(str.view(array.borrow(qwen_edit_references,0)))
                      swap_face=if array.len(qwen_edit_references)>1{string.copy(str.view(array.borrow(qwen_edit_references,1)))}else{string.new()}
                      show_swap_slots(session,safe,true,str.view(swap_target),str.view(swap_face))
                    }else{show_swap_slots(session,safe,false,"","")}
