  var saved_h3image_width:u64=parameters.h3image_size(parameters.h3image_default_size_index()).width
  var saved_h3image_height:u64=parameters.h3image_size(parameters.h3image_default_size_index()).height
  // P-H3-Image keeps its own size too (its list starts at 8 MP).
  var saved_ph3image_width:u64=parameters.ph3image_size(parameters.ph3image_default_size_index()).width
  var saved_ph3image_height:u64=parameters.ph3image_size(parameters.ph3image_default_size_index()).height
  var saved_image_output:string=string.new()
