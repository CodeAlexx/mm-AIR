              <child><object class="GtkBox"><property name="height-request">86</property><property name="spacing">18</property><property name="margin-start">23</property><property name="margin-end">23</property><style><class name="control-header"/></style>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><property name="valign">center</property>
                  <child><object class="GtkLabel"><property name="label">NATIVE AIR WORKFLOW</property><property name="xalign">0</property><style><class name="control-eyebrow"/></style></object></child>
                  <child><object class="GtkLabel"><property name="label">MiniMax H3 Control</property><property name="xalign">0</property><style><class name="control-title"/></style></object></child>
                  <child><object class="GtkLabel"><property name="label">Union ControlNet for prepared motion maps or native Canny video.</property><property name="xalign">0</property><style><class name="muted"/></style></object></child>
                </object></child>
                <child><object class="GtkLabel"><property name="label">24 FPS</property><style><class name="contract-chip"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">CK-INT8 target</property><style><class name="contract-chip"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">Guidance 1.0</property><style><class name="contract-chip"/></style></object></child>
