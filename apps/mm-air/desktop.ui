                <child><object class="GtkLabel"><property name="label">Audio on</property><style><class name="contract-chip"/></style></object></child>
              </object></child>

              <child><object class="GtkGrid"><property name="vexpand">true</property>
                <child><object class="GtkScrolledWindow"><property name="width-request">595</property><property name="hscrollbar-policy">never</property><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-start">20</property><property name="margin-end">18</property><property name="margin-top">17</property><property name="margin-bottom">24</property>
                  <child><object class="GtkFrame"><style><class name="control-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">9</property><property name="margin-start">15</property><property name="margin-end">15</property><property name="margin-top">14</property><property name="margin-bottom">15</property>
                    <child><object class="GtkBox"><property name="spacing">10</property><child><object class="GtkLabel"><property name="label">01</property><style><class name="control-step"/></style></object></child><child><object class="GtkBox"><property name="orientation">vertical</property><child><object class="GtkLabel"><property name="label">Model &amp; control</property><property name="xalign">0</property><style><class name="card-title"/></style></object></child><child><object class="GtkLabel"><property name="label">Official dense Union checkpoint for the current full-embed H3 base.</property><property name="xalign">0</property><style><class name="muted"/></style></object></child></object></child></object></child>
                    <child><object class="GtkLabel"><property name="label">H3 base checkpoint</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child>
                    <child><object class="GtkDropDown" id="control_model"><property name="model">control_model_list</property></object></child>
                    <child><object class="GtkLabel"><property name="label">H3 Union ControlNet</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child>
                    <child><object class="GtkDropDown" id="controlnet_model"><property name="model">controlnet_list</property></object></child>
                    <child><object class="GtkLabel"><property name="label">Target: official dense ControlNet · AIR row-scale INT8 · execution not linked</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="capability-note"/></style></object></child>
                    <child><object class="GtkButton" id="choose_control"><style><class name="control-drop"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="margin-top">12</property><property name="margin-bottom">12</property><child><object class="GtkPicture" id="control_preview"><property name="visible">false</property><property name="height-request">96</property><property name="can-shrink">true</property><property name="content-fit">cover</property></object></child><child><object class="GtkLabel" id="control_name"><property name="label">⌗  Add control video or prepared map</property><property name="ellipsize">end</property><style><class name="drop-title"/></style></object></child><child><object class="GtkLabel" id="control_detail"><property name="label">Required · selection order is control order</property><property name="ellipsize">middle</property><property name="max-width-chars">34</property><style><class name="muted"/></style></object></child></object></child></object></child>
                    <child><object class="GtkGrid"><property name="column-spacing">9</property><property name="row-spacing">5</property>
                      <child><object class="GtkLabel"><property name="label">Input handling</property><property name="xalign">0</property><style><class name="field-label"/></style><layout><property name="column">0</property><property name="row">0</property></layout></object></child>
                      <child><object class="GtkLabel"><property name="label">Canvas fit</property><property name="xalign">0</property><style><class name="field-label"/></style><layout><property name="column">1</property><property name="row">0</property></layout></object></child>
                      <child><object class="GtkDropDown"><property name="model">preprocessor_list</property><layout><property name="column">0</property><property name="row">1</property></layout></object></child>
                      <child><object class="GtkDropDown"><property name="model">fit_list</property><layout><property name="column">1</property><property name="row">1</property></layout></object></child>
                    </object></child>
                    <child><object class="GtkGrid"><property name="column-spacing">9</property><property name="row-spacing">5</property>
                      <child><object class="GtkLabel"><property name="label">Strength</property><property name="xalign">0</property><style><class name="field-label"/></style><layout><property name="column">0</property><property name="row">0</property></layout></object></child>
                      <child><object class="GtkLabel"><property name="label">Start</property><property name="xalign">0</property><style><class name="field-label"/></style><layout><property name="column">1</property><property name="row">0</property></layout></object></child>
                      <child><object class="GtkLabel"><property name="label">End</property><property name="xalign">0</property><style><class name="field-label"/></style><layout><property name="column">2</property><property name="row">0</property></layout></object></child>
                      <child><object class="GtkSpinButton"><property name="adjustment">control_strength_adjustment</property><property name="digits">2</property><layout><property name="column">0</property><property name="row">1</property></layout></object></child>
                      <child><object class="GtkSpinButton"><property name="adjustment">control_start_adjustment</property><property name="digits">2</property><layout><property name="column">1</property><property name="row">1</property></layout></object></child>
                      <child><object class="GtkSpinButton"><property name="adjustment">control_end_adjustment</property><property name="digits">2</property><layout><property name="column">2</property><property name="row">1</property></layout></object></child>
                    </object></child>
                    <child><object class="GtkButton" id="add_control"><property name="label">＋  Add control track</property><style><class name="dashed-button"/></style></object></child>
                    <child><object class="GtkFrame"><style><class name="control-subpanel"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">7</property><property name="margin-start">10</property><property name="margin-end">10</property><property name="margin-top">9</property><property name="margin-bottom">9</property><child><object class="GtkBox"><child><object class="GtkLabel"><property name="label">H3 LoRAs</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">0</property><style><class name="control-count"/></style></object></child></object></child><child><object class="GtkLabel"><property name="label">Ordered overlays with independent strengths</property><property name="xalign">0</property><style><class name="muted"/></style></object></child></object></child></object></child>
                  </object></child></object></child>

                  <child><object class="GtkFrame"><style><class name="control-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">9</property><property name="margin-start">15</property><property name="margin-end">15</property><property name="margin-top">14</property><property name="margin-bottom">15</property>
                    <child><object class="GtkBox"><property name="spacing">10</property><child><object class="GtkLabel"><property name="label">02</property><style><class name="control-step"/></style></object></child><child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><child><object class="GtkLabel"><property name="label">Optional inpaint</property><property name="xalign">0</property><style><class name="card-title"/></style></object></child><child><object class="GtkLabel"><property name="label">White mask repaints; black mask preserves the source.</property><property name="xalign">0</property><style><class name="muted"/></style></object></child></object></child><child><object class="GtkSwitch"/></child></object></child>
                  </object></child></object></child>

                  <child><object class="GtkFrame"><style><class name="control-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">9</property><property name="margin-start">15</property><property name="margin-end">15</property><property name="margin-top">14</property><property name="margin-bottom">15</property>
                    <child><object class="GtkBox"><property name="spacing">10</property><child><object class="GtkLabel"><property name="label">03</property><style><class name="control-step"/></style></object></child><child><object class="GtkBox"><property name="orientation">vertical</property><child><object class="GtkLabel"><property name="label">Prompt</property><property name="xalign">0</property><style><class name="card-title"/></style></object></child><child><object class="GtkLabel"><property name="label">Describe final scene, subject, camera, motion, and audio.</property><property name="xalign">0</property><style><class name="muted"/></style></object></child></object></child></object></child>
                    <child><object class="GtkScrolledWindow"><property name="min-content-height">115</property><child><object class="GtkTextView" id="control_prompt"><property name="buffer">control_prompt_buffer</property><property name="wrap-mode">word-char</property><property name="top-margin">9</property><property name="bottom-margin">9</property><property name="left-margin">9</property><property name="right-margin">9</property></object></child></object></child>
                  </object></child></object></child>

                  <child><object class="GtkFrame"><style><class name="control-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">9</property><property name="margin-start">15</property><property name="margin-end">15</property><property name="margin-top">14</property><property name="margin-bottom">15</property>
                    <child><object class="GtkBox"><property name="spacing">10</property><child><object class="GtkLabel"><property name="label">04</property><style><class name="control-step"/></style></object></child><child><object class="GtkBox"><property name="orientation">vertical</property><child><object class="GtkLabel"><property name="label">Output</property><property name="xalign">0</property><style><class name="card-title"/></style></object></child><child><object class="GtkLabel"><property name="label">Whole seconds; frames and H3 padding are automatic.</property><property name="xalign">0</property><style><class name="muted"/></style></object></child></object></child></object></child>
                    <child><object class="GtkDropDown"><property name="model">h3_resolution_list</property></object></child>
                    <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Output 120 frames</property><property name="hexpand">true</property><style><class name="readonly-field"/></style></object></child><child><object class="GtkLabel"><property name="label">H3 internal 124 frames</property><property name="hexpand">true</property><style><class name="readonly-field"/></style></object></child></object></child>
                    <child><object class="GtkLabel"><property name="label">Fast · 7 points · MP4 · H.264 8-bit 4:2:0</property><property name="xalign">0</property><style><class name="capability-note"/></style></object></child>
                  </object></child></object></child>
                </object></child><layout><property name="column">0</property><property name="row">0</property></layout></object></child>

                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><property name="vexpand">true</property><property name="spacing">10</property><property name="margin-start">18</property><property name="margin-end">20</property><property name="margin-top">17</property><property name="margin-bottom">18</property><style><class name="control-stage"/></style>
                  <child><object class="GtkBox"><child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><child><object class="GtkLabel"><property name="label">Control deck</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child><child><object class="GtkLabel"><property name="label">No control video</property><property name="xalign">0</property><style><class name="card-title"/></style></object></child></object></child><child><object class="GtkLabel"><property name="label">○</property><style><class name="control-empty-dot"/></style></object></child></object></child>
                  <child><object class="GtkBox"><property name="spacing">7</property><child><object class="GtkLabel"><property name="label">Control #1</property><style><class name="control-tab-active"/></style></object></child><child><object class="GtkBox"><property name="hexpand">true</property></object></child><child><object class="GtkLabel"><property name="label">Single</property><style><class name="control-tab-active"/></style></object></child><child><object class="GtkLabel"><property name="label">Split</property><style><class name="muted"/></style></object></child></object></child>
                  <child><object class="GtkFrame"><property name="vexpand">true</property><style><class name="control-monitor"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="valign">center</property><property name="halign">center</property><property name="spacing">7</property>
                    <child><object class="GtkLabel"><property name="label">⌗</property><style><class name="monitor-glyph"/></style></object></child><child><object class="GtkLabel"><property name="label">Drop a control video</property><style><class name="monitor-title"/></style></object></child><child><object class="GtkLabel"><property name="label">The exact uploaded media appears here.</property><style><class name="muted"/></style></object></child></object></child></object></child>
                  <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkButton" id="frame_back"><property name="label">−1f</property><style><class name="quiet-button"/></style></object></child><child><object class="GtkButton" id="deck_play"><property name="label">▶</property><style><class name="quiet-button"/></style></object></child><child><object class="GtkButton" id="frame_forward"><property name="label">+1f</property><style><class name="quiet-button"/></style></object></child><child><object class="GtkScale"><property name="hexpand">true</property><property name="draw-value">false</property></object></child><child><object class="GtkLabel"><property name="label">00:00 / 00:00</property><style><class name="timecode"/></style></object></child></object></child>
                  <child><object class="GtkBox"><property name="spacing">8</property><property name="halign">center</property><child><object class="GtkLabel"><property name="label">Control map</property><style><class name="route-chip"/></style></object></child><child><object class="GtkLabel"><property name="label">→</property><style><class name="muted"/></style></object></child><child><object class="GtkLabel"><property name="label">VAE align</property><style><class name="route-chip"/></style></object></child><child><object class="GtkLabel"><property name="label">→</property><style><class name="muted"/></style></object></child><child><object class="GtkLabel"><property name="label">Layers 0 · 10 · 20 · 30 · 40</property><style><class name="route-chip"/></style></object></child></object></child>
                  <child><object class="GtkFrame"><style><class name="run-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">9</property><property name="margin-start">13</property><property name="margin-end">13</property><property name="margin-top">12</property><property name="margin-bottom">12</property>
                    <child><object class="GtkBox"><property name="homogeneous">true</property><child><object class="GtkLabel"><property name="label">Prepare</property><style><class name="phase-active"/></style></object></child><child><object class="GtkLabel"><property name="label">Control</property><style><class name="phase"/></style></object></child><child><object class="GtkLabel"><property name="label">Sample</property><style><class name="phase"/></style></object></child><child><object class="GtkLabel"><property name="label">Decode</property><style><class name="phase"/></style></object></child><child><object class="GtkLabel"><property name="label">Save</property><style><class name="phase"/></style></object></child></object></child>
                    <child><object class="GtkBox"><child><object class="GtkLabel"><property name="label">Ready</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">0%</property><style><class name="timecode"/></style></object></child></object></child>
                    <child><object class="GtkProgressBar"><property name="fraction">0</property></object></child>
                    <child><object class="GtkBox"><child><object class="GtkLabel"><property name="label">No sampling step</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="muted"/></style></object></child><child><object class="GtkLabel"><property name="label">Elapsed 00:00      ETA —</property><style><class name="muted"/></style></object></child></object></child>
                    <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkButton" id="control_action"><property name="label">Stage H3 CT Request</property><style><class name="control-primary"/></style></object></child><child><object class="GtkButton" id="cancel_control"><property name="label">Cancel</property><property name="sensitive">false</property><style><class name="quiet-button"/></style></object></child></object></child>
                  </object></child></object></child>
                <layout><property name="column">1</property><property name="row">0</property></layout></object></child>
              </object></child>
            </object>
          </property></object></child>
        </object></child>
      </object></child>

      <child><object class="GtkBox"><property name="height-request">28</property><property name="spacing">10</property><property name="margin-start">12</property><property name="margin-end">12</property><style><class name="status-bar"/></style>
