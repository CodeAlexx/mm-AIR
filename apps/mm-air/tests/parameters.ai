// Generate parameter persistence contract. Requires the refreshed H3 package.
module app.mm_air.tests.parameters
import "../parameters.ai" as parameters
import "../.air/deps/h3/request.ai" as h3
import std.text as text

fn expect_error(source: str) -> bool effects {alloc} {
  match parameters.decode(source) { ok(_) => false, err(_) => true }
}

fn lora_round_trip() -> bool effects {alloc} {
  var entries: array<parameters.LoraEntry> = [
    parameters.LoraEntry {path:"/tmp/robot.safetensors",strength:0.75,enabled:true},
    parameters.LoraEntry {path:"/tmp/style.SAFETENSORS",strength:-0.25,enabled:false},
    parameters.LoraEntry {path:"/tmp/detail.safetensors",strength:1.5,enabled:false}]
  var request = parameters.KreaRequest {prompt:"robot",seed:42,width:1024,height:1024,
    output:"/tmp/robot.png",loras:parameters.clone_loras(entries)}
  var encoded = match parameters.encode_krea(request) { ok(v) => v,err(_) => { return false }, }
  var restored = match parameters.decode_krea(encoded) { ok(v) => v,err(_) => { return false }, }
  let copies = struct.borrow(restored,field=loras)
  if array.len(copies) != 3 { return false }
  var index: u64 = 0
  loop {
    if index >= 3 { break }
    let expected = array.borrow(entries,index)
    let actual = array.borrow(copies,index)
    if str.view(struct.borrow(actual,field=path)) != str.view(struct.borrow(expected,field=path)) or actual.strength != expected.strength or
       actual.enabled != expected.enabled { return false }
    index = index + 1
  }
  // Clone owns independent rows, including disabled entries for saved UI state.
  struct.set(array.borrow(entries,0),9.0,field=strength)
  if array.borrow(copies,0).strength != 0.75 { return false }
  struct.set(array.borrow(entries,1),true,field=enabled)
  match parameters.validate_loras(entries) { ok(_) => { return false },err(_) => {}, }
  struct.set(array.borrow(entries,1),false,field=enabled)
  let legacy: str = "{\"schema\":\"mm-air.krea2.parameters\",\"version\":1,\"model\":\"krea2-turbo\",\"prompt\":\"robot\",\"seed\":42,\"width\":1024,\"height\":1024,\"steps\":8,\"precision\":\"bf16\",\"output\":\"/tmp/robot.png\"}"
  var old = match parameters.decode_krea(legacy) { ok(v) => v,err(_) => { return false }, }
  if array.len(struct.borrow(old,field=loras)) != 0 { return false }
  let invalid_path = text.replace(encoded,"robot.safetensors","robot.ckpt")
  match parameters.decode_krea(invalid_path) { ok(_) => { return false },err(_) => {}, }
  let invalid_scale = text.replace(encoded,"0.75","1e100")
  match parameters.decode_krea(invalid_scale) { ok(_) => { return false },err(_) => {}, }
  let outside_ui = text.replace(encoded,"0.75","25")
  match parameters.decode_krea(outside_ui) { ok(_) => { return false },err(_) => {}, }
  let below_ui = text.replace(encoded,"0.75","-10.01")
  match parameters.decode_krea(below_ui) { ok(_) => { return false },err(_) => {}, }
  let minimum_ui = text.replace(encoded,"0.75","-10")
  match parameters.decode_krea(minimum_ui) { ok(_) => {},err(_) => { return false }, }
  let maximum_ui = text.replace(encoded,"0.75","10")
  match parameters.decode_krea(maximum_ui) { ok(_) => {},err(_) => { return false }, }
  let invalid_toggle = text.replace(encoded,"\"enabled\":true","\"enabled\":1")
  match parameters.decode_krea(invalid_toggle) { ok(_) => { return false },err(_) => {}, }
  let malformed = text.replace(legacy,"\"output\":","\"loras\":{},\"output\":")
  match parameters.decode_krea(malformed) { ok(_) => { return false },err(_) => {}, }
  let null_loras = text.replace(legacy,"\"output\":","\"loras\":null,\"output\":")
  match parameters.decode_krea(null_loras) { ok(_) => { return false },err(_) => {}, }
  let missing_strength = text.replace(encoded,"\"strength\":0.75,","")
  match parameters.decode_krea(missing_strength) { ok(_) => { return false },err(_) => {}, }
  let infinity_bits: u64 = 9218868437227405312
  let infinity: f64 = cast.bits(infinity_bits)
  struct.set(array.borrow(entries,0),infinity,field=strength)
  match parameters.validate_loras(entries) { ok(_) => { return false },err(_) => {}, }
  true
}

fn geometry_round_trip(width: u64, height: u64, seconds: f64,
                       frames: u64) -> bool effects {alloc} {
  var refs: array<string> = []
  var request = h3.request("fractional duration", 0, 0, 2, 2, 2, 2,
    42, 6, refs, "/tmp/mm-air-fractional-parameters.mp4")
  match h3.set_geometry(request, width, height, seconds) {
    ok(_) => {}, err(_) => { return false },
  }
  let encoded = match parameters.encode(request) {
    ok(value) => value, err(_) => { return false },
  }
  var decoded: h3.Request = match parameters.decode(encoded) {
    ok(value) => value, err(_) => { return false },
  }
  decoded.geometry.width == width and decoded.geometry.height == height and
    decoded.geometry.frames == frames and decoded.seconds == seconds
}

pub fn main(args: view<str>) -> i32 effects {alloc} {
  if not lora_round_trip() { return 1 }
  var krea = parameters.KreaRequest {prompt:"mechanical robot reference",seed:9007199254740993,
    width:1024,height:1024,output:"/tmp/mm-air-krea.png",loras:[]}
  let krea_json = match parameters.encode_krea(krea) { ok(value) => value,err(_) => { return 1 }, }
  if not parameters.is_krea(krea_json) or parameters.is_krea("{}") { return 1 }
  var krea_restored = match parameters.decode_krea(krea_json) { ok(value) => value,err(_) => { return 1 }, }
  if krea_restored.seed != 9007199254740993 or krea_restored.width != 1024 or
     krea_restored.height != 1024 or krea_restored.prompt != "mechanical robot reference" or
     krea_restored.output != "/tmp/mm-air-krea.png" { return 1 }
  match parameters.validate_krea(krea_restored) { ok(_) => {},err(_) => { return 1 }, }
  struct.set(krea_restored,832,field=width)
  match parameters.validate_krea(krea_restored) { ok(_) => { return 1 },err(_) => {}, }
  let unsupported = match parameters.encode_krea(krea_restored) { ok(value) => value,err(_) => { return 1 }, }
  match parameters.decode_krea(unsupported) { ok(_) => { return 1 },err(_) => {}, }
  if not expect_error(krea_json) { return 1 }
  var dc_request = h3.request("explicit DC recipe", 1, 3,
    h3.profile_dc_euler_19(), h3.projection_exact_bf16(),
    h3.projection_row_scaled_int8(), h3.attention_dense_int8(),
    7311, 3, ["robot.png"], "/tmp/mm-air-dc.mp4")
  let dc_json = match parameters.encode(dc_request) { ok(value) => value,err(_) => { return 1 }, }
  var dc_restored = match parameters.decode(dc_json) { ok(value) => value,err(_) => { return 1 }, }
  if dc_restored.profile != 3 or dc_restored.conditioner_projection != 1 or
     dc_restored.transformer_projection != 3 or dc_restored.attention != 3 or
     h3.evaluations(dc_restored.profile) != 19 { return 1 }
  match h3.validate(dc_restored) { ok(_) => {},err(_) => { return 1 }, }
  var refs: array<string> = []
  var i: u64 = 0
  loop {
    if i == 9 { break }
    array.push(refs, text.concat("visual-", string.from_int(i)))
    i = i + 1
  }
  var request = h3.request("robot speaking to an injured ally", 1, 3, 1, 2, 2, 1,
    9007199254740993, 6, refs, "/tmp/mm-air-parameters.mp4")
  match h3.set_geometry(request, 960, 544, 10.0) { ok(_) => {}, err(_) => { return 1 } }
  var audio: array<string> = ["audio-0.wav", "audio-1.wav", "audio-2.wav"]
  let _ = ref.swap(struct.borrow(request, field=audio_references), audio)
  let encoded = match parameters.encode(request) { ok(v) => v, err(_) => { return 1 } }
  var decoded: h3.Request = match parameters.decode(encoded) { ok(v) => v, err(_) => { return 1 } }
  if decoded.geometry.width != 960 or decoded.geometry.height != 544 or
      decoded.seconds != 10.0 or array.len(struct.borrow(decoded, field=references)) != 9 or
      array.len(struct.borrow(decoded, field=audio_references)) != 3 or
      decoded.seed != 9007199254740993 or decoded.model != 1 or decoded.task != 3 or
      decoded.profile != 1 or decoded.conditioner_projection != 2 or
      decoded.transformer_projection != 2 or decoded.attention != 1 or decoded.resolution != 6 or
      str.view(struct.borrow(decoded, field=prompt)) != "robot speaking to an injured ally" or
      str.view(struct.borrow(decoded, field=output)) != "/tmp/mm-air-parameters.mp4" { return 1 }
  i = 0
  loop {
    if i == 9 { break }
    if str.view(array.borrow(struct.borrow(decoded, field=references), i)) !=
       str.view(array.borrow(struct.borrow(request, field=references), i)) { return 1 }
    i = i + 1
  }
  i = 0
  loop {
    if i == 3 { break }
    if str.view(array.borrow(struct.borrow(decoded, field=audio_references), i)) !=
       str.view(array.borrow(struct.borrow(request, field=audio_references), i)) { return 1 }
    i = i + 1
  }
  array.push(struct.borrow(request, field=audio_references), "fourth.wav")
  let excessive_audio = match parameters.encode(request) { ok(v) => v, err(_) => { return 1 } }
  if not expect_error(excessive_audio) { return 1 }
  array.push(struct.borrow(decoded, field=references), "tenth.png")
  let excessive_visual = match parameters.encode(decoded) { ok(v) => v, err(_) => { return 1 } }
  if not expect_error(excessive_visual) { return 1 }
  if not expect_error("{}") { return 1 }
  if not expect_error("{\"schema\":\"mm-air.generate.parameters\",\"version\":99}") { return 1 }
  // Persist the requested fractional seconds, recomputing delivery frames on
  // the native 24 FPS clock when parameters are loaded or reused.
  if not geometry_round_trip(832, 480, 10.25, 246) or
     not geometry_round_trip(960, 544, 7.5, 180) or
     not geometry_round_trip(1344, 768, 5.125, 123) or
     not geometry_round_trip(512, 896, 12.75, 306) or
     not geometry_round_trip(832, 480, 2.3125, 56) {
    return 1
  }
  0
}
