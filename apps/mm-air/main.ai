// MM-AIR is an AIR-owned native shell for the three MiniMax H3 editing surfaces.
module app.mm_air.main
import "../../toolkits/desktop/ui.ai" as desk
import std.files as files
import std.desktop as desktop
import std.path as path
import std.text as text
import std.json as json
import std.process as proc
import std.channel as channel
import std.math as math
import std.codec as codec
import std.media_input as media
import ".air/deps/h3/request.ai" as h3
import ".air/deps/h3/session.ai" as h3_session
