// Generate parameter files are reusable user data, not a second runtime configuration.
module app.mm_air.parameters
import std.codec as codec
import std.json as json
import std.text as text
import std.math as math
import std.path as path
import std.inference.h3.request as h3
import "./.air/deps/qwenimage21/contract.ai" as qwen_contract
import std.inference.krea2.config as krea_config
import std.draw as draw
import "./.air/deps/flux1/latent.ai" as flux1_latent
import "./.air/deps/fibo2/defaults.ai" as fibo_defaults
import std.inference.clownshark_request as csr

pub fn krea_model_index() -> u32 effects {} { 2 }
pub fn qwen_image_model_index() -> u32 effects {} { 3 }
// Generate's model dropdown (gen_model_list) order. Only H3's 0/1 is ever written to a file;
// image models save their own schema with a model name, so these positions can move.
pub fn moss_base_model_index() -> u32 effects {} { 4 }
pub fn moss_sft_model_index() -> u32 effects {} { 5 }
pub fn is_moss_model(model:u32) -> bool effects {} { model==4 or model==5 }
// Every Generate model that outputs a PNG (not H3).
pub fn fibo_dev_model_index() -> u32 effects {} { 6 }
pub fn h3image_model_index() -> u32 effects {} { 7 }
pub fn ph3image_model_index() -> u32 effects {} { 8 }
pub fn image_model(model:u32) -> bool effects {} { model>=2 and model<=8 }
// Image models that share Generate's Sampling panel and remembered size (not Krea or Qwen).
pub fn uses_image_geometry(model:u32) -> bool effects {} {
  is_moss_model(model) or model==fibo_dev_model_index() or model==h3image_model_index()
}
// The Windows presenter's FLUX.1 id. Nothing reads it and it is never saved; it has its own number, after the
// desktop dropdown positions.
pub fn flux1_model_index() -> u32 effects {} { 9 }
pub type Flux1Request=struct {prompt:string,output:string,width:u64,height:u64,steps:u64,seed:u64,guidance:f64} derive codec(strict)
type Flux1File=struct {schema:string,request:Flux1Request} derive codec(strict)
pub fn flux1_defaults() -> Flux1Request effects {alloc} {
  Flux1Request {prompt:"",output:"",width:1024,height:1024,steps:30,seed:42,guidance:3.5}
}
pub fn validate_flux1(request:ref<Flux1Request>) -> result<unit,string> effects {alloc} {
  if request.prompt=="" {return result.err("FLUX.1 DEV needs a prompt")}
  // Geometry is the model's own: the session rounds sides to its packing grid (session.public_request) and bounds the
  // area by the output surface; device memory is admitted by Prime for the exact size.
  let step:u64=flux1_latent.pixel_alignment()
  if request.width<step/2 or request.height<step/2 or request.height>draw.max_pixels()/request.width or
      request.steps==0 or request.steps>1000 or not math.is_finite(cast.float(request.guidance)) or request.guidance<0.0 or request.guidance>100.0 {
    return result.err("FLUX.1 DEV requires dimensions within the output surface bound (rounded to the 16 px packing grid),1..1000steps and finite guidance0..100")
  }
  if not path.is_absolute(request.output) or path.extension(request.output)!=".png" {
    return result.err("Choose an absolute PNG output path for FLUX.1 DEV")
  }
  result.ok(())
}
pub fn copy_flux1(request:ref<Flux1Request>) -> Flux1Request effects {alloc} {
  Flux1Request {prompt:string.copy(request.prompt),output:string.copy(request.output),width:request.width,height:request.height,
    steps:request.steps,seed:request.seed,guidance:request.guidance}
}
pub fn encode_flux1(request:ref<Flux1Request>) -> result<string,string> effects {alloc} {
  let _=try validate_flux1(request)
  var file:Flux1File=Flux1File {schema:"mm-air.flux1-dev.parameters.v1",request:copy_flux1(request)}
  match Flux1File_encode(file) {
    ok(value)=>result.ok(value),err(_)=>result.err("FLUX.1 DEV parameter encoding failed"),}
}
pub fn is_flux1(source:str) -> bool effects {alloc} {
  var doc:json.Document=match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema") {ok(value)=>value=="mm-air.flux1-dev.parameters.v1",err(_)=>false,}
}
pub fn decode_flux1(source:str) -> result<Flux1Request,string> effects {alloc} {
  var file:Flux1File=match Flux1File_decode(source) {ok(value)=>value,err(_)=>{return result.err("FLUX.1 DEV parameters do not match the strict schema")},}
  if file.schema!="mm-air.flux1-dev.parameters.v1" {return result.err("Unsupported FLUX.1 DEV parameter schema")}
  let _=try validate_flux1(struct.borrow(file,field=request))
  result.ok(struct.replace(file,flux1_defaults(),field=request))
}
// Qwen-Image-2.1 owns the Qwen PNG geometry and saved sizes.
pub fn qwen_like(model:u32) -> bool effects {} { model==qwen_image_model_index() }

// FLUX 3 Image Klein was removed from MM-Air (2026-11-05). Its saved parameter files and
// history entries keep their own schema; they are recognized here so that loading or
// reusing one is refused by name instead of being read as another model's request.
pub fn is_retired_flux3(source:str)->bool effects {alloc}{
  var doc:json.Document=match json.parse(source){ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema"){ok(value)=>value=="mm-air.flux3-klein.parameters",err(_)=>false,}
}
pub fn retired_flux3_message()->str effects {} {
  "FLUX 3 Klein settings restored into the selected model: prompt, seed, size and source pictures"
}
// A number field of a retired FLUX 3 Klein entry (width, height, steps); 0 when absent.
pub fn retired_flux3_number(source:str,name:str)->u64 effects {alloc} {
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return 0},}
  match json.get(document,json.root(),name){some(index)=>match json.as_u64(document,index){some(value)=>value,none=>0,},none=>0,}
}
// The source pictures of a retired FLUX 3 Klein edit, in order (empty for text to image).
pub fn retired_flux3_references(source:str)->array<string> effects {alloc} {
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return []},}
  match json.get(document,json.root(),"references"){
    some(_)=>match strings(document,"references",64){ok(values)=>values,err(_)=>[],},
    none=>[],
  }
}
// The prompt and seed of a retired FLUX 3 Klein entry, which carry over to any model.
pub fn retired_flux3_prompt(source:str)->string effects {alloc} {
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return string.new()},}
  text_at(document,json.root(),"prompt")
}
pub fn retired_flux3_seed(source:str)->option<i64> effects {alloc} {
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return option.none()},}
  match json.get(document,json.root(),"seed"){some(index)=>json.as_i64(document,index),none=>option.none(),}
}

pub type LoraEntry = struct {path:string,strength:f64,enabled:bool} derive codec(strict)

// Sampler controls (AIR std.inference.clownshark_request), the same on every wired model:
// Sampler, Schedule, Noise (eta), Bong math. "default" is the model's own path. The Generate
// Sampling list for MOSS and Fibo Dev, in display order (MOSS's Euler is its own Euler):
pub fn image_sampler_names()->array<string> effects{alloc}{
  ["default","res_2m","res_3m","res_2s","res_3s","res_5s","deis_2m","deis_3m","dpmpp_2m","dpmpp_2s","ddim","euler"]
}
pub fn sampler_schedule_names()->array<string> effects{alloc}{["default","beta57","bong_tangent"]}
fn index_in(names:array<string> own,name:str)->u64 effects{alloc}{
  var held=names
  var index:u64=0
  loop{
    if index>=array.len(held){break}
    if str.view(array.borrow(held,index))==name{return index}
    index=index+1
  }
  0
}
fn name_at(names:array<string> own,index:u64)->string effects{alloc}{
  var held=names
  if index>=array.len(held){return string.copy("default")}
  string.copy(str.view(array.borrow(held,index)))
}
pub fn image_sampler_index(name:str)->u64 effects{alloc}{index_in(image_sampler_names(),name)}
pub fn image_sampler_name(index:u64)->string effects{alloc}{name_at(image_sampler_names(),index)}
pub fn sampler_schedule_index(name:str)->u64 effects{alloc}{index_in(sampler_schedule_names(),name)}
pub fn sampler_schedule_name(index:u64)->string effects{alloc}{name_at(sampler_schedule_names(),index)}
// Schedule, Noise and Bong math take effect only with a shared sampler (MOSS: not ER-SDE or its Euler).
pub fn moss_uses_stepper(name:str)->bool effects{}{
  not (csr.is_default(name) or name=="er_sde" or name=="euler")
}
pub fn fibo_uses_stepper(name:str)->bool effects{}{ not csr.is_default(name) }
fn check_sampling(sampler:str,schedule:str,eta:f64)->result<unit,string> effects{alloc}{
  if not (csr.is_default(sampler) or sampler=="er_sde" or index_in(image_sampler_names(),sampler)!=0) {
    return result.err("Choose a listed sampler")
  }
  let checked=if sampler=="er_sde"{csr.check("default",schedule,eta)}else{csr.check(sampler,schedule,eta)}
  match checked{ok(_)=>result.ok(()),err(message)=>result.err(message),}
}
// Qwen-Image-2.1's Sampler list: its own Euler (the default) and DPM++ 2M in the places of the
// shared methods of those names, the shared methods as contract codes 3..11.
fn qwen_sampler_codes()->array<u64> effects{alloc}{[0,3,4,5,6,7,8,9,1,10,11]}
pub fn qwen_sampler_index(code:u32)->u64 effects{alloc}{
  var codes=qwen_sampler_codes()
  var index:u64=0
  loop{
    if index>=array.len(codes){break}
    if array.get(codes,index)==cast.wrap(code){return index}
    index=index+1
  }
  0
}
pub fn qwen_sampler_code(index:u64)->u32 effects{alloc}{
  var codes=qwen_sampler_codes()
  if index>=array.len(codes){return qwen_contract.sampler_euler()}
  cast.sat(array.get(codes,index))
}

// MOSS-Image Base or SFT text-to-image. Creator defaults (models/moss_image/scheduler.ai,
// OpenMOSS README): 50 steps, CFG 3, shift 5, empty negative prompt, block-22 negative skip.
// `fast` runs the INT8 projections (about twice as fast; fine detail differs).
// Image prompt: up to 4 pictures the text encoder reads beside the prompt, each with its own strength
// (0 leaves the picture out; stored in hundredths, 5 = 0.05), a text strength and the vision size
// (models/moss_image/image_prompt.ai).
pub type MossRequest = struct {
  model:string,prompt:string,negative:string,output:string,
  width:u64,height:u64,steps:u64,cfg:f64,shift:f64,seed:u64,fast:bool,
  loras:array<LoraEntry>,
  prompt_images:array<string>,prompt_strength_percent:array<u64>,text_strength:f64,vision_size:u64,
  // Sampler controls (absent in older files: the model's own ER-SDE path)
  sampler:string="default",schedule:string="default",eta:f64=0.5,bongmath:bool=true
} derive codec(strict)
type MossFile=struct {schema:string,request:MossRequest} derive codec(strict)
// Parameter files saved before the image prompt existed (same schema name, no picture fields).
type MossRequestV1 = struct {
  model:string,prompt:string,negative:string,output:string,
  width:u64,height:u64,steps:u64,cfg:f64,shift:f64,seed:u64,fast:bool,
  loras:array<LoraEntry>
} derive codec(strict)
type MossFileV1=struct {schema:string,request:MossRequestV1} derive codec(strict)
// Fibo 2.0: Dev text-to-image on Generate, Edit Turbo on Image Edit. Creator defaults
// (models/fibo2/defaults.ai): Dev 50 steps, guidance 5; Edit Turbo 4 steps, guidance 1.
// `images` (Edit Turbo only): the picture to change first, then up to four references.
// width/height 0 (edits only) keep the first picture's size.
pub type FiboRequest = struct {
  model:string,prompt:string,negative:string,output:string,images:array<string>,
  width:u64,height:u64,steps:u64,guidance:f64,seed:u64,loras:array<LoraEntry>,
  // Sampler controls, Dev only (absent in older files: the model's own sampler); Edit Turbo keeps "default"
  sampler:string="default",schedule:string="default",eta:f64=0.5,bongmath:bool=true
} derive codec(strict)
type FiboFile=struct {schema:string,request:FiboRequest} derive codec(strict)
pub fn fibo_schema() -> str effects {} { "mm-air.fibo2.parameters.v1" }
pub fn fibo_dev_name() -> str effects {} { "fibo-2.0-dev" }
pub fn fibo_edit_name() -> str effects {} { "fibo-2.0-edit-turbo" }
pub fn fibo_max_images() -> u64 effects {} { fibo_defaults.max_images() }
pub fn fibo_is_edit(request:ref<FiboRequest>) -> bool effects {} {
  struct.borrow(request,field=model)==fibo_edit_name()
}
pub fn fibo_defaults_for(edit:bool) -> FiboRequest effects {alloc} {
  FiboRequest {model:string.copy(if edit{fibo_edit_name()}else{fibo_dev_name()}),prompt:"",negative:"",output:"",
    images:[],width:if edit{0}else{fibo_defaults.default_side()},height:if edit{0}else{fibo_defaults.default_side()},
    steps:if edit{fibo_defaults.turbo_steps()}else{fibo_defaults.dev_steps()},
    guidance:if edit{fibo_defaults.turbo_guidance()}else{fibo_defaults.dev_guidance()},seed:42,loras:[]}
}
pub fn validate_fibo(request:ref<FiboRequest>) -> result<unit,string> effects {alloc} {
  let model=struct.borrow(request,field=model)
  if model!=fibo_dev_name() and model!=fibo_edit_name() {return result.err("Unknown Fibo 2.0 model")}
  let edit=fibo_is_edit(request)
  if text.trim(struct.borrow(request,field=prompt))=="" {
    return result.err(if edit{"Write the edit instruction first"}else{"Write a prompt first"})
  }
  let count=array.len(struct.borrow(request,field=images))
  if edit and (count<1 or count>fibo_max_images()) {
    return result.err("Fibo 2.0 Edit Turbo takes the picture to change plus up to four references (1 to 5 images)")
  }
  if not edit and count!=0 {return result.err("Fibo 2.0 Dev makes images from text only")}
  var index:u64=0
  loop{
    if index>=count{break}
    let lower=text.lower_ascii(str.view(array.borrow(struct.borrow(request,field=images),index)))
    if not (text.ends_with(str.view(lower),".png") or text.ends_with(str.view(lower),".jpg") or
        text.ends_with(str.view(lower),".jpeg")){
      return result.err("Fibo 2.0 Edit Turbo reads PNG or JPEG sources")
    }
    index=index+1
  }
  let keep_size:bool=request.width==0 and request.height==0
  if not (edit and keep_size) and (request.width<256 or request.height<256 or request.width>2048 or
      request.height>2048 or request.width%fibo_defaults.side_step()!=0 or request.height%fibo_defaults.side_step()!=0) {
    return result.err("Fibo 2.0 size must be 256 to 2048 px, both sides multiples of 16")
  }
  if request.steps<1 or request.steps>200 {return result.err("Fibo 2.0 steps must be 1 to 200")}
  if not math.is_finite(request.guidance) or request.guidance<1.0 or request.guidance>20.0 {
    return result.err("Fibo 2.0 guidance must be 1 to 20")
  }
  try check_sampling(str.view(struct.borrow(request,field=sampler)),str.view(struct.borrow(request,field=schedule)),request.eta)
  if edit and not csr.is_default(str.view(struct.borrow(request,field=sampler))) {
    return result.err("Fibo 2.0 Edit Turbo keeps its own sampler")
  }
  if not path.is_absolute(struct.borrow(request,field=output)) or
      text.lower_ascii(path.extension(struct.borrow(request,field=output)))!=".png" {
    return result.err("Fibo 2.0 output must be an absolute PNG path")
  }
  validate_loras(struct.borrow(request,field=loras))
}
pub fn copy_fibo(request:ref<FiboRequest>) -> FiboRequest effects {alloc} {
  var images:array<string> = []
  var index:u64=0
  loop{
    if index>=array.len(struct.borrow(request,field=images)){break}
    array.push(images,string.copy(str.view(array.borrow(struct.borrow(request,field=images),index))))
    index=index+1
  }
  FiboRequest {model:string.copy(struct.borrow(request,field=model)),prompt:string.copy(struct.borrow(request,field=prompt)),
    negative:string.copy(struct.borrow(request,field=negative)),output:string.copy(struct.borrow(request,field=output)),
    images:images,width:request.width,height:request.height,steps:request.steps,guidance:request.guidance,
    seed:request.seed,loras:clone_loras(struct.borrow(request,field=loras)),
    sampler:string.copy(struct.borrow(request,field=sampler)),schedule:string.copy(struct.borrow(request,field=schedule)),
    eta:request.eta,bongmath:request.bongmath}
}
pub fn encode_fibo(request:ref<FiboRequest>) -> result<string,string> effects {alloc} {
  let _=try validate_fibo(request)
  var file:FiboFile=FiboFile {schema:string.copy(fibo_schema()),request:copy_fibo(request)}
  match FiboFile_encode(file) {ok(value)=>result.ok(value),err(_)=>result.err("Fibo 2.0 parameter encoding failed"),}
}
pub fn is_fibo(source:str) -> bool effects {alloc} {
  var doc:json.Document=match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema") {ok(value)=>value==fibo_schema(),err(_)=>false,}
}
pub fn decode_fibo(source:str) -> result<FiboRequest,string> effects {alloc} {
  var file:FiboFile=match FiboFile_decode(source) {ok(value)=>value,
    err(_)=>{return result.err("Fibo 2.0 parameters do not match the saved format")},}
  if file.schema!=fibo_schema() {return result.err("Unsupported Fibo 2.0 parameter file")}
  let _=try validate_fibo(struct.borrow(file,field=request))
  result.ok(struct.replace(file,fibo_defaults_for(false),field=request))
}

// MiniMax H3-Image: text to image on Generate, reference-image edit on Image Edit (one request type;
// `images` empty is text to image). Steps, guidance and negative prompt are the model's own and are not
// stored. width/height 0 (edits only) keep the first picture's size. `expander` is "off", "low" or "xhigh"
// (the model's own prompt expander) or "qwen" (edits only: the local Qwen3-VL 8B).
pub type H3ImageRequest = struct {
  prompt:string,output:string,images:array<string>,width:u64,height:u64,seed:u64,
  loras:array<LoraEntry>,expander:string
} derive codec(strict)
type H3ImageFile=struct {schema:string,request:H3ImageRequest} derive codec(strict)
pub fn h3image_schema() -> str effects {} { "mm-air.h3image.parameters.v1" }
pub fn h3image_max_images() -> u64 effects {} { 16 }
// Largest picture: the model works 4 to 20 megapixels (agent assumption: 20 MP as the app limit; 4096x4096 was measured).
pub fn h3image_max_pixels() -> u64 effects {} { 20000000 }
// The sizes the H3-Image size list offers, in list order: the same presets as SerenityAir's
// H3 Image (2048x2048 first and default). A size under about 4 MP is made by AIR's session on a
// larger canvas of the same shape and resized back. The entry after the last one is "Custom".
// desktop.ui's h3image_size_list has the same order.
pub type H3ImageSize = struct {width:u64,height:u64}
pub fn h3image_size_count() -> u64 effects {} { 7 }
pub fn h3image_default_size_index() -> u64 effects {} { 0 }
pub fn h3image_size(index:u64) -> H3ImageSize effects {} {
  if index==0 {return H3ImageSize {width:2048,height:2048}}
  if index==1 {return H3ImageSize {width:2720,height:1536}}
  if index==2 {return H3ImageSize {width:1536,height:2720}}
  if index==3 {return H3ImageSize {width:1024,height:1024}}
  if index==4 {return H3ImageSize {width:4096,height:4096}}
  if index==5 {return H3ImageSize {width:5952,height:3360}}
  H3ImageSize {width:3552,height:1184}
}
// The list entry for a size; h3image_size_count() (Custom) when it is not one of them.
pub fn h3image_size_index(width:u64,height:u64) -> u64 effects {} {
  var index:u64=0
  loop{if index>=h3image_size_count(){break}
    let size=h3image_size(index)
    if size.width==width and size.height==height {return index}
    index=index+1}
  h3image_size_count()
}
pub fn h3image_expander_valid(name:str,edit:bool) -> bool effects {} {
  name=="off" or name=="low" or name=="xhigh" or (edit and name=="qwen")
}
pub fn h3image_defaults() -> H3ImageRequest effects {alloc} {
  H3ImageRequest {prompt:"",output:"",images:[],width:2048,height:2048,seed:42,loras:[],expander:"off"}
}
pub fn h3image_is_edit(request:ref<H3ImageRequest>) -> bool effects {} {
  array.len(struct.borrow(request,field=images))>0
}
pub fn validate_h3image(request:ref<H3ImageRequest>) -> result<unit,string> effects {alloc} {
  let edit=h3image_is_edit(request)
  if text.trim(struct.borrow(request,field=prompt))=="" {
    return result.err(if edit{"Write the edit instruction first"}else{"Write a prompt first"})
  }
  let count=array.len(struct.borrow(request,field=images))
  if count>h3image_max_images() {return result.err("MiniMax H3-Image takes 1 to 16 images")}
  var index:u64=0
  loop{
    if index>=count{break}
    let lower=text.lower_ascii(str.view(array.borrow(struct.borrow(request,field=images),index)))
    if not (text.ends_with(str.view(lower),".png") or text.ends_with(str.view(lower),".jpg") or
        text.ends_with(str.view(lower),".jpeg") or text.ends_with(str.view(lower),".webp")){
      return result.err("MiniMax H3-Image reads PNG, JPEG or WebP pictures")
    }
    index=index+1
  }
  let keep_size:bool=request.width==0 and request.height==0
  if not (edit and keep_size) and (request.width<64 or request.height<64 or request.width>8192 or request.height>8192) {
    return result.err("MiniMax H3-Image size must be 64 to 8192 px on each side")
  }
  if not (edit and keep_size) and request.width*request.height>h3image_max_pixels() {
    return result.err("MiniMax H3-Image makes pictures up to 20 megapixels")
  }
  if not h3image_expander_valid(struct.borrow(request,field=expander),edit) {
    return result.err("Choose a prompt expander from the list")
  }
  if not path.is_absolute(struct.borrow(request,field=output)) or
      text.lower_ascii(path.extension(struct.borrow(request,field=output)))!=".png" {
    return result.err("MiniMax H3-Image output must be an absolute PNG path")
  }
  validate_loras(struct.borrow(request,field=loras))
}
pub fn copy_h3image(request:ref<H3ImageRequest>) -> H3ImageRequest effects {alloc} {
  var images:array<string> = []
  var index:u64=0
  loop{
    if index>=array.len(struct.borrow(request,field=images)){break}
    array.push(images,string.copy(str.view(array.borrow(struct.borrow(request,field=images),index))))
    index=index+1
  }
  H3ImageRequest {prompt:string.copy(struct.borrow(request,field=prompt)),
    output:string.copy(struct.borrow(request,field=output)),images:images,width:request.width,height:request.height,
    seed:request.seed,loras:clone_loras(struct.borrow(request,field=loras)),
    expander:string.copy(struct.borrow(request,field=expander))}
}
pub fn encode_h3image(request:ref<H3ImageRequest>) -> result<string,string> effects {alloc} {
  let _=try validate_h3image(request)
  var file:H3ImageFile=H3ImageFile {schema:string.copy(h3image_schema()),request:copy_h3image(request)}
  match H3ImageFile_encode(file) {ok(value)=>result.ok(value),err(_)=>result.err("MiniMax H3-Image parameter encoding failed"),}
}
pub fn is_h3image(source:str) -> bool effects {alloc} {
  var doc:json.Document=match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema") {ok(value)=>value==h3image_schema(),err(_)=>false,}
}
pub fn decode_h3image(source:str) -> result<H3ImageRequest,string> effects {alloc} {
  var file:H3ImageFile=match H3ImageFile_decode(source) {ok(value)=>value,
    err(_)=>{return result.err("MiniMax H3-Image parameters do not match the saved format")},}
  if file.schema!=h3image_schema() {return result.err("Unsupported MiniMax H3-Image parameter file")}
  let _=try validate_h3image(struct.borrow(file,field=request))
  result.ok(struct.replace(file,h3image_defaults(),field=request))
}

// P-H3-Image: text to image on Generate, edit of 1 to 8 pictures on Image Edit (one request type;
// `images` empty is text to image, Picture 1 is the one edited). Steps, guidance and negative prompt are
// the model's own and are not stored. width/height 0 (edits only) keep Picture 1's size. `upsample`: the
// model's prompt upsampler rewrites the prompt first.
pub type PH3ImageRequest = struct {
  prompt:string,output:string,images:array<string>,width:u64,height:u64,seed:u64,upsample:bool
} derive codec(strict)
type PH3ImageFile=struct {schema:string,request:PH3ImageRequest} derive codec(strict)
pub fn ph3image_schema() -> str effects {} { "mm-air.ph3image.parameters.v1" }
pub fn ph3image_max_images() -> u64 effects {} { 8 }
// Largest picture: the area of the largest listed size, 2912x2912 (agent assumption: nothing larger was run).
pub fn ph3image_max_pixels() -> u64 effects {} { 8479744 }
// The sizes the creator's pipeline lists, in list order; the entry after the last one is "Custom"
// (text to image). desktop.ui's ph3image_size_list has the same order.
pub fn ph3image_size_count() -> u64 effects {} { 7 }
pub fn ph3image_default_size_index() -> u64 effects {} { 0 }
pub fn ph3image_size(index:u64) -> H3ImageSize effects {} {
  if index==0 {return H3ImageSize {width:2912,height:2912}}
  if index==1 {return H3ImageSize {width:3360,height:2496}}
  if index==2 {return H3ImageSize {width:2496,height:3360}}
  if index==3 {return H3ImageSize {width:3552,height:2368}}
  if index==4 {return H3ImageSize {width:2368,height:3552}}
  if index==5 {return H3ImageSize {width:3872,height:2176}}
  H3ImageSize {width:2176,height:3872}
}
pub fn ph3image_size_index(width:u64,height:u64) -> u64 effects {} {
  var index:u64=0
  loop{if index>=ph3image_size_count(){break}
    let size=ph3image_size(index)
    if size.width==width and size.height==height {return index}
    index=index+1}
  ph3image_size_count()
}
// Edit output sizes. desktop.ui's ph3image_edit_size_list lists "Picture 1 size" first, then these.
pub fn ph3image_edit_size_count() -> u64 effects {} { 7 }
pub fn ph3image_edit_size(index:u64) -> H3ImageSize effects {} {
  if index==0 {return H3ImageSize {width:2048,height:2048}}
  if index==1 {return H3ImageSize {width:2368,height:1760}}
  if index==2 {return H3ImageSize {width:1760,height:2368}}
  if index==3 {return H3ImageSize {width:2496,height:1664}}
  if index==4 {return H3ImageSize {width:1664,height:2496}}
  if index==5 {return H3ImageSize {width:2720,height:1536}}
  H3ImageSize {width:1536,height:2720}
}
pub fn ph3image_edit_size_index(width:u64,height:u64) -> u64 effects {} {
  var index:u64=0
  loop{if index>=ph3image_edit_size_count(){break}
    let size=ph3image_edit_size(index)
    if size.width==width and size.height==height {return index}
    index=index+1}
  ph3image_edit_size_count()
}
pub fn ph3image_defaults() -> PH3ImageRequest effects {alloc} {
  PH3ImageRequest {prompt:"",output:"",images:[],width:2912,height:2912,seed:42,upsample:true}
}
pub fn ph3image_is_edit(request:ref<PH3ImageRequest>) -> bool effects {} {
  array.len(struct.borrow(request,field=images))>0
}
pub fn validate_ph3image(request:ref<PH3ImageRequest>) -> result<unit,string> effects {alloc} {
  let edit=ph3image_is_edit(request)
  if text.trim(struct.borrow(request,field=prompt))=="" {
    return result.err(if edit{"Write the edit instruction first"}else{"Write a prompt first"})
  }
  let count=array.len(struct.borrow(request,field=images))
  if count>ph3image_max_images() {return result.err("P-H3-Image takes 1 to 8 pictures")}
  var index:u64=0
  loop{
    if index>=count{break}
    let lower=text.lower_ascii(str.view(array.borrow(struct.borrow(request,field=images),index)))
    if not (text.ends_with(str.view(lower),".png") or text.ends_with(str.view(lower),".jpg") or
        text.ends_with(str.view(lower),".jpeg") or text.ends_with(str.view(lower),".webp")){
      return result.err("P-H3-Image reads PNG, JPEG or WebP pictures")
    }
    index=index+1
  }
  if edit {
    let keep_size:bool=request.width==0 and request.height==0
    if not keep_size and ph3image_edit_size_index(request.width,request.height)==ph3image_edit_size_count() {
      return result.err("Choose an edit size from the list")
    }
  } else {
    // Sides: 256 px as the smallest is an agent assumption; 32-pixel steps are the model's rule.
    if request.width<256 or request.height<256 or request.width%32!=0 or request.height%32!=0 {
      return result.err("P-H3-Image width and height must be multiples of 32, 256 px or more")
    }
    if request.width*request.height>ph3image_max_pixels() {
      return result.err("P-H3-Image makes pictures up to 8 megapixels")
    }
  }
  if not path.is_absolute(struct.borrow(request,field=output)) or
      text.lower_ascii(path.extension(struct.borrow(request,field=output)))!=".png" {
    return result.err("P-H3-Image output must be an absolute PNG path")
  }
  result.ok(())
}
pub fn copy_ph3image(request:ref<PH3ImageRequest>) -> PH3ImageRequest effects {alloc} {
  var images:array<string> = []
  var index:u64=0
  loop{
    if index>=array.len(struct.borrow(request,field=images)){break}
    array.push(images,string.copy(str.view(array.borrow(struct.borrow(request,field=images),index))))
    index=index+1
  }
  PH3ImageRequest {prompt:string.copy(struct.borrow(request,field=prompt)),
    output:string.copy(struct.borrow(request,field=output)),images:images,width:request.width,height:request.height,
    seed:request.seed,upsample:request.upsample}
}
pub fn encode_ph3image(request:ref<PH3ImageRequest>) -> result<string,string> effects {alloc} {
  let _=try validate_ph3image(request)
  var file:PH3ImageFile=PH3ImageFile {schema:string.copy(ph3image_schema()),request:copy_ph3image(request)}
  match PH3ImageFile_encode(file) {ok(value)=>result.ok(value),err(_)=>result.err("P-H3-Image parameter encoding failed"),}
}
pub fn is_ph3image(source:str) -> bool effects {alloc} {
  var doc:json.Document=match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema") {ok(value)=>value==ph3image_schema(),err(_)=>false,}
}
pub fn decode_ph3image(source:str) -> result<PH3ImageRequest,string> effects {alloc} {
  var file:PH3ImageFile=match PH3ImageFile_decode(source) {ok(value)=>value,
    err(_)=>{return result.err("P-H3-Image parameters do not match the saved format")},}
  if file.schema!=ph3image_schema() {return result.err("Unsupported P-H3-Image parameter file")}
  let _=try validate_ph3image(struct.borrow(file,field=request))
  result.ok(struct.replace(file,ph3image_defaults(),field=request))
}

pub fn moss_schema() -> str effects {} { "mm-air.moss-image.parameters.v1" }
pub fn moss_model_name(model:u32) -> str effects {} {
  if model==moss_sft_model_index() {"moss-image-sft"} else {"moss-image-base"}
}
pub fn moss_model_index_of(name:str) -> option<u32> effects {} {
  if name=="moss-image-base" {return option.some(moss_base_model_index())}
  if name=="moss-image-sft" {return option.some(moss_sft_model_index())}
  option.none()
}
pub fn moss_label(model:u32) -> str effects {} {
  if model==moss_sft_model_index() {"MOSS-Image SFT"} else {"MOSS-Image Base"}
}
pub fn moss_defaults(model:u32) -> MossRequest effects {alloc} {
  MossRequest {model:string.copy(moss_model_name(model)),prompt:"",negative:"",output:"",
    width:1024,height:1024,steps:50,cfg:3.0,shift:5.0,seed:42,fast:false,loras:[],
    prompt_images:[],prompt_strength_percent:[],text_strength:1.0,vision_size:384}
}
pub fn moss_max_pictures() -> u64 effects {} { 4 }
pub fn moss_default_picture_percent() -> u64 effects {} { 5 }
// Add one picture (PNG or JPEG, absolute path) at the default strength.
pub fn moss_add_picture(request:ref<MossRequest>,file:str) -> result<unit,string> effects {alloc} {
  if array.len(struct.borrow(request,field=prompt_images))>=moss_max_pictures() {
    return result.err("An image prompt takes at most 4 pictures")}
  let extension=text.lower_ascii(path.extension(file))
  if extension!=".png" and extension!=".jpg" and extension!=".jpeg" {
    return result.err("Choose PNG or JPEG pictures")}
  if not path.is_absolute(file) {return result.err("Picture paths must be absolute")}
  array.push(struct.borrow(request,field=prompt_images),string.copy(file))
  array.push(struct.borrow(request,field=prompt_strength_percent),moss_default_picture_percent())
  result.ok(())
}
pub fn moss_remove_picture(request:ref<MossRequest>,index:u64) -> unit effects {alloc} {
  let count=array.len(struct.borrow(request,field=prompt_images))
  if index>=count {return}
  var images:array<string>=[]
  var strengths:array<u64>=[]
  var i:u64=0
  loop{
    if i>=count{break}
    if i!=index {
      array.push(images,string.copy(array.borrow(struct.borrow(request,field=prompt_images),i)))
      array.push(strengths,array.get(struct.borrow(request,field=prompt_strength_percent),i))
    }
    i=i+1
  }
  let _=ref.swap(struct.borrow(request,field=prompt_images),images)
  let _=ref.swap(struct.borrow(request,field=prompt_strength_percent),strengths)
}
pub fn validate_moss(request:ref<MossRequest>) -> result<unit,string> effects {alloc} {
  match moss_model_index_of(str.view(struct.borrow(request,field=model))) {
    some(_)=>{},none=>{return result.err("Unknown MOSS-Image model")},}
  if text.trim(struct.borrow(request,field=prompt))=="" {return result.err("Write a prompt first")}
  if request.width<256 or request.height<256 or request.width>2048 or request.height>2048 or
      request.width%16!=0 or request.height%16!=0 {
    return result.err("MOSS-Image size must be 256 to 2048 px, both sides multiples of 16")
  }
  if request.steps<1 or request.steps>200 {return result.err("MOSS-Image steps must be 1 to 200")}
  if not math.is_finite(request.cfg) or request.cfg<1.0 or request.cfg>20.0 {
    return result.err("MOSS-Image CFG must be 1 to 20")
  }
  if not math.is_finite(request.shift) or request.shift<0.1 or request.shift>20.0 {
    return result.err("MOSS-Image shift must be 0.1 to 20")
  }
  if not path.is_absolute(struct.borrow(request,field=output)) or
      text.lower_ascii(path.extension(struct.borrow(request,field=output)))!=".png" {
    return result.err("MOSS-Image output must be an absolute PNG path")
  }
  let pictures=array.len(struct.borrow(request,field=prompt_images))
  if pictures>moss_max_pictures() {return result.err("An image prompt takes at most 4 pictures")}
  if array.len(struct.borrow(request,field=prompt_strength_percent))!=pictures {
    return result.err("Every picture needs a strength")}
  var picture:u64=0
  loop{
    if picture>=pictures {break}
    if array.get(struct.borrow(request,field=prompt_strength_percent),picture)>100 {
      return result.err("Picture strength must be 0 to 1")}
    if not path.is_absolute(array.borrow(struct.borrow(request,field=prompt_images),picture)) {
      return result.err("Picture paths must be absolute")}
    picture=picture+1
  }
  if not math.is_finite(request.text_strength) or request.text_strength<0.0 or request.text_strength>10.0 {
    return result.err("Text strength must be 0 to 10")}
  if request.vision_size<256 or request.vision_size>1024 {return result.err("Vision size must be 256 to 1024")}
  try check_sampling(str.view(struct.borrow(request,field=sampler)),str.view(struct.borrow(request,field=schedule)),request.eta)
  validate_loras(struct.borrow(request,field=loras))
}
pub fn copy_moss(request:ref<MossRequest>) -> MossRequest effects {alloc} {
  MossRequest {model:string.copy(struct.borrow(request,field=model)),prompt:string.copy(struct.borrow(request,field=prompt)),
    negative:string.copy(struct.borrow(request,field=negative)),output:string.copy(struct.borrow(request,field=output)),
    width:request.width,height:request.height,steps:request.steps,cfg:request.cfg,shift:request.shift,
    seed:request.seed,fast:request.fast,loras:clone_loras(struct.borrow(request,field=loras)),
    prompt_images:copy_strings(struct.borrow(request,field=prompt_images)),
    prompt_strength_percent:copy_numbers(struct.borrow(request,field=prompt_strength_percent)),
    text_strength:request.text_strength,vision_size:request.vision_size,
    sampler:string.copy(struct.borrow(request,field=sampler)),schedule:string.copy(struct.borrow(request,field=schedule)),
    eta:request.eta,bongmath:request.bongmath}
}
fn copy_strings(values:ref<array<string>>) -> array<string> effects {alloc} {
  var out:array<string>=[]
  var index:u64=0
  loop{
    if index>=array.len(values){break}
    array.push(out,string.copy(array.borrow(values,index)))
    index=index+1
  }
  out
}
fn copy_numbers(values:ref<array<u64>>) -> array<u64> effects {alloc} {
  var out:array<u64>=[]
  var index:u64=0
  loop{
    if index>=array.len(values){break}
    array.push(out,array.get(values,index))
    index=index+1
  }
  out
}
pub fn encode_moss(request:ref<MossRequest>) -> result<string,string> effects {alloc} {
  let _=try validate_moss(request)
  var file:MossFile=MossFile {schema:string.copy(moss_schema()),request:copy_moss(request)}
  match MossFile_encode(file) {ok(value)=>result.ok(value),err(_)=>result.err("MOSS-Image parameter encoding failed"),}
}
pub fn is_moss(source:str) -> bool effects {alloc} {
  var doc:json.Document=match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(doc,"schema") {ok(value)=>value==moss_schema(),err(_)=>false,}
}
pub fn decode_moss(source:str) -> result<MossRequest,string> effects {alloc} {
  var file:MossFile=match MossFile_decode(source) {ok(value)=>value,
    err(_)=>{
      // saved before the image prompt: the same fields, no pictures
      match MossFileV1_decode(source) {
        ok(old)=>{
          if old.schema!=moss_schema() {return result.err("Unsupported MOSS-Image parameter file")}
          let before=struct.borrow(old,field=request)
          let upgraded=MossRequest {model:string.copy(struct.borrow(before,field=model)),
            prompt:string.copy(struct.borrow(before,field=prompt)),
            negative:string.copy(struct.borrow(before,field=negative)),
            output:string.copy(struct.borrow(before,field=output)),
            width:before.width,height:before.height,steps:before.steps,cfg:before.cfg,shift:before.shift,
            seed:before.seed,fast:before.fast,loras:clone_loras(struct.borrow(before,field=loras)),
            prompt_images:[],prompt_strength_percent:[],text_strength:1.0,vision_size:384}
          let _=try validate_moss(upgraded)
          return result.ok(upgraded)
        },
        err(_)=>{return result.err("MOSS-Image parameters do not match the saved format")},
      }
    },}
  if file.schema!=moss_schema() {return result.err("Unsupported MOSS-Image parameter file")}
  let _=try validate_moss(struct.borrow(file,field=request))
  result.ok(struct.replace(file,moss_defaults(moss_base_model_index()),field=request))
}
// `pose`: path of a pose-control condition (a COCO-17 skeleton raster .png, used as is, or a keypoint
// .json rendered at its own canvas); empty = ordinary Krea 2 Turbo. With a pose the run takes the
// Krea-2 Pose Control-LoRA release (MM_AIR_KREA_POSE_RELEASE) at the pose's native size; `pose_scale`
// is its control scale (1.0 frozen default, 1.25 to 1.5 stronger).
pub type KreaRequest = struct {
  prompt:string,seed:i64,width:u64,height:u64,output:string,loras:array<LoraEntry>,
  pose:string = "",pose_scale:f64 = 1.0
}
pub type QwenImageRequest = struct {
  prompt:string,output:string,source:string,references:array<string>,
  width:u64,height:u64,steps:u64,seed:u64,
  scheduler:u32,sampler:u32,
  // Sampler controls with a shared sampler (codes 3..11): schedule 0 Default / 1 Beta 57 /
  // 2 Bong tangent, Noise (eta) and Bong math. Absent in older files: their defaults.
  schedule:u32=0,eta:f64=0.5,bongmath:bool=true,
  // Text-to-image: rewrite the prompt first with Qwen-Image-2.1-PE-T2I, which
  // also picks the aspect ratio (width/height follow it, as in its model card).
  enhance:bool,
  // Run-time adapters (face / head / body swap files), applied unmerged beside the resident
  // transformer; empty is the base model.
  loras:array<LoraEntry>
}

pub fn qwen_condition_count(request:ref<QwenImageRequest>)->u64 effects {} {
  (if struct.borrow(request,field=source)==""{0}else{1})+
    array.len(struct.borrow(request,field=references))
}

pub fn is_qwen_image(source:str)->bool effects {alloc}{
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return false}}
  match string_field(document,"schema"){
    ok(value)=>value=="mm-air.qwen-image-2.1.parameters",err(_)=>false,
  }
}

pub fn qwen_condition_image(path:str)->bool effects {alloc}{
  let lower=text.lower_ascii(path)
  text.ends_with(str.view(lower),".png") or
    text.ends_with(str.view(lower),".jpg") or
    text.ends_with(str.view(lower),".jpeg") or
    text.ends_with(str.view(lower),".webp")
}

pub fn validate_qwen_image(request:ref<QwenImageRequest>)->result<unit,string>
    effects {alloc}{
  if request.prompt==""{return result.err("Qwen-Image-2.1 prompt must not be empty")}
  match qwen_contract.geometry(request.width,request.height){
    ok(_)=>{},err(message)=>{return result.err(message)},
  }
  if request.steps<2 or request.steps>100{
    return result.err("Qwen-Image-2.1 steps must be between 2 and 100")
  }
  if request.scheduler==qwen_contract.scheduler_turbo() and request.steps!=qwen_contract.turbo_steps(){
    return result.err("Qwen-Image-2.1-Turbo uses its fixed 8-step schedule")
  }
  if not qwen_contract.supported_scheduler(request.scheduler){
    return result.err("Choose a supported Qwen-Image-2.1 scheduler")
  }
  if not qwen_contract.supported_sampler(request.sampler){
    return result.err("Choose a supported Qwen-Image-2.1 sampler")
  }
  if request.schedule>qwen_contract.schedule_bong_tangent(){
    return result.err("Choose a supported Qwen-Image-2.1 schedule")
  }
  if not math.is_finite(request.eta) or request.eta<0.0 or request.eta>1.0{
    return result.err("Noise must be 0 to 1")
  }
  if qwen_contract.is_clownshark_sampler(request.sampler) and
      request.scheduler==qwen_contract.scheduler_turbo(){
    return result.err("Qwen-Image-2.1-Turbo keeps its own sampler")
  }
  if not text.ends_with(text.lower_ascii(struct.borrow(request,field=output)),".png"){
    return result.err("Choose a .png output for Qwen-Image-2.1")
  }
  if struct.borrow(request,field=source)!="" and
     not qwen_condition_image(struct.borrow(request,field=source)){
    return result.err("Qwen-Image-2.1 edit requires PNG, JPEG, or WebP sources")
  }
  if qwen_condition_count(request)>10{
    return result.err("Qwen-Image-2.1 edit accepts at most 10 ordered image sources")
  }
  var reference_index:u64=0
  loop{
    if reference_index>=array.len(struct.borrow(request,field=references)){break}
    if not qwen_condition_image(str.view(array.borrow(
        struct.borrow(request,field=references),reference_index))){
      return result.err("Qwen-Image-2.1 edit requires PNG, JPEG, or WebP sources")
    }
    reference_index=reference_index+1
  }
  try validate_loras(struct.borrow(request,field=loras))
  result.ok(())
}

pub fn encode_qwen_image(request:ref<QwenImageRequest>)->result<string,string>
    effects {alloc}{
  try validate_qwen_image(request)
  var out=codec.writer()
  codec.begin_object(out)
  codec.field_text(out,"schema","mm-air.qwen-image-2.1.parameters")
  codec.field_u64(out,"version",2)
  codec.field_text(out,"model","qwen-image-2.1")
  codec.field_text(out,"mode",if qwen_condition_count(request)==0{"t2i"}else{"edit"})
  codec.field_text(out,"prompt",struct.borrow(request,field=prompt))
  codec.field_text(out,"source",struct.borrow(request,field=source))
  codec.key(out,"references")
  codec.begin_array(out)
  var reference_index:u64=0
  loop{
    if reference_index>=array.len(struct.borrow(request,field=references)){break}
    codec.text_value(out,str.view(array.borrow(
      struct.borrow(request,field=references),reference_index)))
    reference_index=reference_index+1
  }
  codec.end_array(out)
  codec.field_text(out,"output",struct.borrow(request,field=output))
  codec.field_u64(out,"width",request.width)
  codec.field_u64(out,"height",request.height)
  codec.field_u64(out,"steps",request.steps)
  codec.field_u64(out,"scheduler",cast.wrap(request.scheduler))
  codec.field_u64(out,"sampler",cast.wrap(request.sampler))
  var schedule_name=qwen_contract.scheduler_name(request.scheduler)
  var solver_name=qwen_contract.sampler_name(request.sampler)
  codec.field_text(out,"noise_schedule",str.view(schedule_name))
  codec.field_text(out,"solver",str.view(solver_name))
  codec.field_u64(out,"schedule",cast.wrap(request.schedule))
  codec.field_text(out,"schedule_name",qwen_contract.schedule_label(request.schedule))
  codec.field_f64(out,"eta",request.eta)
  codec.field_bool(out,"bongmath",request.bongmath)
  codec.field_u64(out,"seed",request.seed)
  codec.field_bool(out,"enhance",request.enhance)
  codec.key(out,"loras")
  codec.begin_array(out)
  let lora_entries=struct.borrow(request,field=loras)
  var lora_index:u64=0
  loop{
    if lora_index>=array.len(lora_entries){break}
    let entry=array.borrow(lora_entries,lora_index)
    codec.begin_object(out)
    codec.field_text(out,"path",struct.borrow(entry,field=path))
    codec.field_f64(out,"strength",entry.strength)
    codec.field_bool(out,"enabled",entry.enabled)
    codec.end_object(out)
    lora_index=lora_index+1
  }
  codec.end_array(out)
  codec.end_object(out)
  match codec.finish(out){ok(value)=>result.ok(value),err(error)=>result.err(codec.describe(error))}
}

fn decode_text_array(document:ref<json.Document>,name:str)->result<array<string>,string>
    effects{alloc}{
  var output: array<string> = array.new()
  let node:u64=match json.get(document,json.root(),name){
    some(value)=>value,none=>{return result.ok(output)},
  }
  match json.kind(document,node){
    some(kind)=>{if kind!=json.Kind.Array{return result.err("Expected text array")}},
    none=>{return result.err("Expected text array")},
  }
  let size:u64=match json.len(document,node){
    some(value)=>value,none=>{return result.err("Expected text array")},
  }
  var index:u64=0
  loop{
    if index>=size{break}
    let item:u64=match json.at(document,node,index){
      some(value)=>value,none=>{return result.err("Expected text array item")},
    }
    match json.as_string(document,item){
      some(value)=>array.push(output,value),none=>{return result.err("Expected text array item")},
    }
    index=index+1
  }
  result.ok(output)
}

pub fn decode_qwen_image(source:str)->result<QwenImageRequest,string>
    effects {alloc}{
  var document=match json.parse(source){
    ok(value)=>value,err(error)=>{return result.err(json.error_message(error))},
  }
  let schema=try string_field(document,"schema")
  let version=try count(document,"version")
  let model=try string_field(document,"model")
  let width=try count(document,"width")
  let height=try count(document,"height")
  let steps=try count(document,"steps")
  let scheduler=try count(document,"scheduler")
  let sampler=try count(document,"sampler")
  let seed=try count(document,"seed")
  if schema!="mm-air.qwen-image-2.1.parameters" or (version!=1 and version!=2) or
     model!="qwen-image-2.1"{
    return result.err("Unsupported Qwen-Image-2.1 parameter recipe")
  }
  var request=QwenImageRequest{prompt:try string_field(document,"prompt"),
    source:try string_field(document,"source"),
    references:if version==1{array.new()}else{try decode_text_array(document,"references")},
    output:try string_field(document,"output"),
    width:width,height:height,steps:steps,seed:seed,
    scheduler:cast.sat(scheduler),sampler:cast.sat(sampler),
    schedule:match json.get(document,json.root(),"schedule"){
      some(_)=>cast.sat(try count(document,"schedule")),none=>qwen_contract.schedule_default()},
    eta:match json.get(document,json.root(),"eta"){
      some(node)=>match json.as_f64(document,node){some(value)=>value,none=>{return result.err("eta must be a number")}},
      none=>csr.default_eta()},
    bongmath:match json.get(document,json.root(),"bongmath"){
      some(node)=>match json.as_bool(document,node){some(value)=>value,none=>{return result.err("bongmath must be true or false")}},
      none=>csr.default_bongmath()},
    enhance:match json.get(document,json.root(),"enhance"){
      some(node)=>match json.as_bool(document,node){some(value)=>value,none=>false},none=>false},
    loras:try decode_loras(document)}
  try validate_qwen_image(request)
  result.ok(request)
}

pub fn clone_loras(entries: ref<array<LoraEntry>>) -> array<LoraEntry> effects {alloc} {
  var output: array<LoraEntry> = []
  var index: u64 = 0
  loop {
    if index >= array.len(entries) { break }
    let entry = array.borrow(entries,index)
    array.push(output,LoraEntry {path:string.copy(struct.borrow(entry,field=path)),
      strength:entry.strength,enabled:entry.enabled})
    index = index + 1
  }
  output
}

pub fn validate_loras(entries: ref<array<LoraEntry>>) -> result<unit,string> effects {alloc} {
  var index: u64 = 0
  // Several enabled LoRAs are allowed: H3 applies each at its own strength, and
  // Krea 2 reports its own one-adapter limit.
  loop {
    if index >= array.len(entries) { break }
    let entry = array.borrow(entries,index)
    let runtime_strength: f32 = cast.float(entry.strength)
    if not math.is_finite(entry.strength) or
       not math.is_finite(cast.float(runtime_strength)) {
      return result.err("LoRA strength must be finite")
    }
    if entry.strength < -10.0 or entry.strength > 10.0 {
      return result.err("LoRA strength must be between -10 and 10, matching the Serenity UI controls")
    }
    if not text.ends_with(text.lower_ascii(struct.borrow(entry,field=path)),".safetensors") {
      return result.err("Choose a .safetensors LoRA file")
    }
    index = index + 1
  }
  result.ok(())
}
pub fn is_krea(source: str) -> bool effects {alloc} {
  var document = match json.parse(source) { ok(value) => value,err(_) => { return false }, }
  match string_field(document,"schema") {
    ok(value) => value == "mm-air.krea2.parameters",err(_) => false,
  }
}
pub fn is_h3(source: str) -> bool effects {alloc} {
  var document = match json.parse(source) {ok(value)=>value,err(_)=>{return false},}
  match string_field(document,"schema") {ok(value)=>value=="mm-air.generate.parameters",err(_)=>false,}
}
pub fn validate_krea(request: ref<KreaRequest>) -> result<unit,string> effects {alloc} {
  if request.prompt == "" { return result.err("Krea prompt must not be empty") }
  match krea_config.geometry(krea_config.Config {width:request.width,height:request.height}) {
    ok(_) => {},err(message) => { return result.err(message) },
  }
  if request.seed < -1 { return result.err("Seed must be nonnegative or -1 for random") }
  if not text.ends_with(text.lower_ascii(struct.borrow(request,field=output)),".png") {
    return result.err("Choose a .png output for Krea 2 Turbo")
  }
  try validate_loras(struct.borrow(request,field=loras))
  if request.pose != "" {
    let lowered = text.lower_ascii(struct.borrow(request,field=pose))
    if not text.ends_with(lowered,".png") and not text.ends_with(lowered,".json") {
      return result.err("Pose control takes a .png skeleton raster or a .json keypoint file")
    }
    if not math.is_finite(request.pose_scale) or request.pose_scale <= 0.0 or request.pose_scale > 3.0 {
      return result.err("Pose control scale must be above 0 and at most 3 (1.0 is the default)")
    }
    var enabled: u64 = 0
    var index: u64 = 0
    loop {
      if index >= array.len(struct.borrow(request,field=loras)) { break }
      if array.borrow(struct.borrow(request,field=loras),index).enabled { enabled = enabled + 1 }
      index = index + 1
    }
    if enabled != 0 { return result.err("Pose control applies its own LoRA; disable the other LoRAs") }
  }
  result.ok(())
}
pub fn encode_krea(request: ref<KreaRequest>) -> result<string,string> effects {alloc} {
  var out = codec.writer()
  codec.begin_object(out)
  codec.field_text(out,"schema","mm-air.krea2.parameters")
  codec.field_u64(out,"version",1)
  codec.field_text(out,"model","krea2-turbo")
  codec.field_text(out,"prompt",struct.borrow(request,field=prompt))
  codec.field_i64(out,"seed",request.seed)
  codec.field_u64(out,"width",request.width)
  codec.field_u64(out,"height",request.height)
  codec.field_u64(out,"steps",8)
  codec.field_text(out,"precision","bf16")
  codec.field_text(out,"output",struct.borrow(request,field=output))
  if request.pose != "" {
    codec.field_text(out,"pose",struct.borrow(request,field=pose))
    codec.field_f64(out,"pose_scale",request.pose_scale)
  }
  codec.key(out,"loras")
  codec.begin_array(out)
  let entries = struct.borrow(request,field=loras)
  var index: u64 = 0
  loop {
    if index >= array.len(entries) { break }
    let entry = array.borrow(entries,index)
    codec.begin_object(out)
    codec.field_text(out,"path",struct.borrow(entry,field=path))
    codec.field_f64(out,"strength",entry.strength)
    codec.field_bool(out,"enabled",entry.enabled)
    codec.end_object(out)
    index = index + 1
  }
  codec.end_array(out)
  codec.end_object(out)
  match codec.finish(out) { ok(value) => result.ok(value),err(error) => result.err(codec.describe(error)), }
}
pub fn decode_krea(source: str) -> result<KreaRequest,string> effects {alloc} {
  var document = match json.parse(source) {
    ok(value) => value,err(error) => { return result.err(json.error_message(error)) },
  }
  let schema = try string_field(document,"schema")
  let version = try count(document,"version")
  let model = try string_field(document,"model")
  let steps = try count(document,"steps")
  let precision = try string_field(document,"precision")
  if schema != "mm-air.krea2.parameters" or version != 1 or
     model != "krea2-turbo" or steps != 8 or precision != "bf16" {
    return result.err("Unsupported Krea parameter model, steps, precision, or version")
  }
  let seed = match json.as_i64(document,try field(document,"seed")) {
    some(value) => value,none => { return result.err("Expected signed integer seed") },
  }
  var request = KreaRequest {prompt:try string_field(document,"prompt"),seed:seed,
    width:try count(document,"width"),height:try count(document,"height"),
    output:try string_field(document,"output"),loras:try decode_loras(document)}
  match json.get(document,json.root(),"pose") {
    some(_) => {
      request.pose = try string_field(document,"pose")
      request.pose_scale = match json.get(document,json.root(),"pose_scale") {
        some(node) => match json.as_f64(document,node) { some(value) => value, none => { return result.err("Expected numeric pose_scale") } },
        none => 1.0,
      }
    },
    none => {},
  }
  try validate_krea(request)
  result.ok(request)
}

fn decode_loras(document: ref<json.Document>) -> result<array<LoraEntry>,string> effects {alloc} {
  var output: array<LoraEntry> = []
  let node: u64 = match json.get(document,json.root(),"loras") {
    some(value) => value,none => { return result.ok(output) },
  }
  match json.kind(document,node) {
    some(kind) => { if kind != json.Kind.Array { return result.err("Expected LoRA array") } },
    none => { return result.err("Expected LoRA array") },
  }
  let size: u64 = match json.len(document,node) {
    some(value) => value,none => { return result.err("Expected LoRA array") },
  }
  var index: u64 = 0
  loop {
    if index >= size { break }
    let item: u64 = match json.at(document,node,index) {
      some(value) => value,none => { return result.err("Expected LoRA record") },
    }
    let path_node: u64 = match json.get(document,item,"path") {
      some(value) => value,none => { return result.err("Missing LoRA path") },
    }
    let path: string = match json.as_string(document,path_node) {
      some(value) => value,none => { return result.err("Expected LoRA path string") },
    }
    let strength_node: u64 = match json.get(document,item,"strength") {
      some(value) => value,none => { return result.err("Missing LoRA strength") },
    }
    let strength: f64 = match json.as_f64(document,strength_node) {
      some(value) => value,none => { return result.err("Expected finite LoRA strength") },
    }
    let enabled_node: u64 = match json.get(document,item,"enabled") {
      some(value) => value,none => { return result.err("Missing LoRA enabled toggle") },
    }
    let enabled: bool = match json.as_bool(document,enabled_node) {
      some(value) => value,none => { return result.err("Expected LoRA enabled boolean") },
    }
    array.push(output,LoraEntry {path:path,strength:strength,enabled:enabled})
    index = index + 1
  }
  try validate_loras(output)
  result.ok(output)
}

pub fn encode_h3(request: ref<h3.Request>, loras: ref<array<LoraEntry>>)
    -> result<string,string> effects {alloc} {
  try validate_loras(loras)
  var out: codec.Writer = codec.writer()
  codec.begin_object(out)
  codec.field_text(out, "schema", "mm-air.generate.parameters")
  codec.field_u64(out, "version", 1)
  codec.field_text(out, "prompt", struct.borrow(request, field=prompt))
  codec.field_u64(out, "model", cast.wrap(request.model))
  codec.field_u64(out, "task", cast.wrap(request.task))
  codec.field_u64(out, "profile", cast.wrap(request.profile))
  codec.field_u64(out, "conditioner_projection", cast.wrap(request.conditioner_projection))
  codec.field_u64(out, "transformer_projection", cast.wrap(request.transformer_projection))
  codec.field_u64(out, "attention", cast.wrap(request.attention))
  codec.field_i64(out, "seed", request.seed)
  codec.field_u64(out, "resolution", cast.wrap(request.resolution))
  let geometry = request.geometry
  codec.field_u64(out, "width", geometry.width)
  codec.field_u64(out, "height", geometry.height)
  codec.field_f64(out, "seconds", request.seconds)
  codec.field_text_array(out, "references", struct.borrow(request, field=references))
  codec.field_text_array(out, "audio_references", struct.borrow(request, field=audio_references))
  codec.field_text(out, "output", struct.borrow(request, field=output))
  codec.key(out,"loras")
  codec.begin_array(out)
  var lora_index: u64 = 0
  loop {
    if lora_index >= array.len(loras) { break }
    let entry = array.borrow(loras,lora_index)
    codec.begin_object(out)
    codec.field_text(out,"path",struct.borrow(entry,field=path))
    codec.field_f64(out,"strength",entry.strength)
    codec.field_bool(out,"enabled",entry.enabled)
    codec.end_object(out)
    lora_index = lora_index + 1
  }
  codec.end_array(out)
  codec.end_object(out)
  match codec.finish(out) {
    ok(value) => result.ok(value),
    err(error) => result.err(codec.describe(error)),
  }
}

pub fn encode(request: ref<h3.Request>) -> result<string,string> effects {alloc} {
  var loras: array<LoraEntry> = []
  encode_h3(request,loras)
}

fn field(document: ref<json.Document>, name: str) -> result<u64,string> effects {alloc} {
  match json.get(document, json.root(), name) {
    some(value) => result.ok(value),
    none => result.err(text.concat("Missing Generate parameter: ", name)),
  }
}

fn string_field(document: ref<json.Document>, name: str) -> result<string,string> effects {alloc} {
  let index = try field(document, name)
  match json.as_string(document, index) {
    some(value) => result.ok(value),
    none => result.err(text.concat("Expected string: ", name)),
  }
}

fn count(document: ref<json.Document>, name: str) -> result<u64,string> effects {alloc} {
  let index = try field(document, name)
  match json.as_u64(document, index) {
    some(value) => result.ok(value),
    none => result.err(text.concat("Expected unsigned integer: ", name)),
  }
}

fn selection(document: ref<json.Document>, name: str) -> result<u32,string> effects {alloc} {
  let value = try count(document, name)
  if value > 4294967295 { return result.err(text.concat("Selection out of range: ", name)) }
  result.ok(cast.sat(value))
}

fn strings(document: ref<json.Document>, name: str, limit: u64)
    -> result<array<string>,string> effects {alloc} {
  let index = try field(document, name)
  match json.kind(document, index) {
    some(kind) => { if kind != json.Kind.Array {
      return result.err(text.concat("Expected reference array: ", name))
    } },
    none => { return result.err(text.concat("Expected reference array: ", name)) },
  }
  let size = match json.len(document, index) {
    some(value) => value,
    none => { return result.err(text.concat("Expected reference array: ", name)) },
  }
  if size > limit { return result.err(text.concat("Too many references: ", name)) }
  var out: array<string> = []
  var i: u64 = 0
  loop {
    if i == size { break }
    let element = match json.at(document, index, i) {
      some(value) => value,
      none => { return result.err(text.concat("Expected reference array: ", name)) },
    }
    let value = match json.as_string(document, element) {
      some(value) => value,
      none => { return result.err(text.concat("Expected reference path: ", name)) },
    }
    array.push(out, value)
    i = i + 1
  }
  result.ok(out)
}

pub fn decode(source: str) -> result<h3.Request,string> effects {alloc} {
  var document: json.Document = match json.parse(source) {
    ok(value) => value,
    err(error) => { return result.err(json.error_message(error)) },
  }
  let schema = try string_field(document, "schema")
  let version = try count(document, "version")
  if schema != "mm-air.generate.parameters" or version != 1 {
    return result.err("Not a supported MM-Air Generate parameter file")
  }
  let prompt = try string_field(document, "prompt")
  let model = try selection(document, "model")
  let task = try selection(document, "task")
  let profile = try selection(document, "profile")
  let conditioner = try selection(document, "conditioner_projection")
  let transformer = try selection(document, "transformer_projection")
  // Files saved with the retired approximate route (code 4) load as the
  // owned dense INT8 route.
  let stored_attention = try selection(document, "attention")
  let attention: u32 = if stored_attention == 4 { h3.attention_dense_int8() } else { stored_attention }
  let resolution = try selection(document, "resolution")
  let seed = match json.as_i64(document, try field(document, "seed")) {
    some(value) => value,
    none => { return result.err("Expected signed integer seed") },
  }
  let width = try count(document, "width")
  let height = try count(document, "height")
  let seconds = match json.as_f64(document, try field(document, "seconds")) {
    some(value) => value,
    none => { return result.err("Expected duration in seconds") },
  }
  let references = try strings(document, "references", 9)
  var audio = try strings(document, "audio_references", 3)
  let output = try string_field(document, "output")
  var request = h3.request(prompt, model, task, profile, conditioner, transformer,
    attention, seed, resolution, references, output)
  match h3.set_geometry(request, width, height, seconds) {
    ok(_) => {},
    err(error) => { var held: h3.Problem = error
      return result.err(h3.describe(held)) },
  }
  let _ = ref.swap(struct.borrow(request, field=audio_references), audio)
  result.ok(request)
}

pub type H3Parameters = struct {
  request: h3.Request,
  loras: array<LoraEntry>
}

pub fn decode_h3(source: str) -> result<H3Parameters,string> effects {alloc} {
  var request: h3.Request = try decode(source)
  var document: json.Document = match json.parse(source) {
    ok(value) => value,
    err(error) => { return result.err(json.error_message(error)) },
  }
  var loras: array<LoraEntry> = try decode_loras(document)
  result.ok(H3Parameters {request: request,loras: loras})
}

// What made a result, for the line under the Generate preview: the model and settings on
// the first line and the prompt on the second. Works for every saved schema, including
// retired ones, and returns nothing for text that is not a parameter file.
fn text_at(document:ref<json.Document>,object:u64,name:str)->string effects{alloc}{
  match json.get(document,object,name){some(i)=>match json.as_string(document,i){some(v)=>v,none=>string.new(),},none=>string.new(),}
}
fn number_at(document:ref<json.Document>,object:u64,name:str)->string effects{alloc}{
  match json.get(document,object,name){some(i)=>match json.number_text(document,i){some(v)=>v,none=>string.new(),},none=>string.new(),}
}
fn result_model(schema:str,model:str,index:str)->string effects{alloc}{
  if schema=="mm-air.generate.parameters"{return string.copy(if index=="1"{"MiniMax H3 Reference"}else{"MiniMax H3 Base"})}
  if schema=="mm-air.krea2.parameters"{return string.copy("Krea 2 Turbo")}
  if schema=="mm-air.flux3-klein.parameters"{return string.copy("FLUX 3 Image Klein (no longer in MM-Air)")}
  if schema=="mm-air.qwen-image-2.1.parameters"{return string.copy("Qwen-Image-2.1")}
  if schema==fibo_schema(){return string.copy(if model==fibo_edit_name(){"Fibo 2.0 Edit Turbo"}else{"Fibo 2.0"})}
  if schema==h3image_schema(){return string.copy("MiniMax H3-Image")}
  if schema==ph3image_schema(){return string.copy("P-H3-Image")}
  if schema==moss_schema(){return text.concat("MOSS-Image · ",model)}
  if schema=="mm-air.flux1-dev.parameters.v1"{return string.copy("FLUX.1 Dev")}
  string.copy(schema)
}
fn h3_task_name(index:str)->str effects{}{
  if index=="0"{"Text to video + audio"}else if index=="1"{"First frame to video"}else if index=="2"{"First + last frame"}
  else if index=="3"{"Reference to video"}else if index=="4"{"Last frame to video"}else{""}
}
fn part(before:str,value:str,after:str)->string effects{alloc}{
  if value==""{return string.new()}
  text.concat(str.view(text.concat(before,value)),after)
}
pub fn result_summary(source:str)->array<string> effects{alloc}{
  var document=match json.parse(source){ok(value)=>value,err(_)=>{return []},}
  let schema=text_at(document,json.root(),"schema")
  if schema==""{return []}
  var object:u64=json.root()
  match json.get(document,json.root(),"request"){some(index)=>{object=index},none=>{},}
  var line=result_model(str.view(schema),str.view(text_at(document,object,"model")),str.view(number_at(document,object,"model")))
  if text_at(document,object,"mode")=="edit"{string.append(line," edit")}
  if schema=="mm-air.generate.parameters"{string.append(line,str.view(part(" · ",h3_task_name(str.view(number_at(document,object,"task"))),"")))}
  let width=number_at(document,object,"width")
  let height=number_at(document,object,"height")
  if width!="0" and height!=""{string.append(line,str.view(part(" · ",str.view(width),text.concat("×",str.view(height)))))}
  string.append(line,str.view(part(" · ",str.view(number_at(document,object,"seconds"))," s")))
  string.append(line,str.view(part(" · ",str.view(number_at(document,object,"steps"))," steps")))
  string.append(line,str.view(part(" · seed ",str.view(number_at(document,object,"seed")),"")))
  let prompt=text.replace(str.view(text.replace(str.view(text_at(document,object,"prompt")),"\x{0D}"," ")),"\x{0A}"," ")
  [line,prompt]
}
