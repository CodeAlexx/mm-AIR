                <child><object class="GtkScrolledWindow" id="qwen_edit_panel"><property name="width-request">330</property><property name="hexpand">false</property><property name="vexpand">true</property><property name="hscrollbar-policy">automatic</property><child><object class="GtkBox" id="qwen_edit_panel_contents"><property name="orientation">vertical</property><property name="spacing">10</property><property name="hexpand">false</property>
                  <child><object class="GtkLabel"><property name="label">EDIT MODEL</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child>
                  <child><object class="GtkDropDown" id="qwen_edit_model"><property name="factory"><object class="GtkBuilderListItemFactory"><property name="bytes"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><interface><template class="GtkListItem"><property name="child"><object class="GtkLabel"><property name="xalign">0</property><property name="ellipsize">end</property><binding name="label"><lookup name="string" type="GtkStringObject"><lookup name="item">GtkListItem</lookup></lookup></binding></object></property></template></interface>]]></property></object></property><property name="list-factory"><object class="GtkBuilderListItemFactory"><property name="bytes"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><interface><template class="GtkListItem"><property name="child"><object class="GtkLabel"><property name="xalign">0</property><binding name="label"><lookup name="string" type="GtkStringObject"><lookup name="item">GtkListItem</lookup></lookup></binding></object></property></template></interface>]]></property></object></property><property name="model">qwen_edit_model_list</property><property name="selected">0</property></object></child>
                  <child><object class="GtkCheckButton" id="qwen_edit_turbo"><property name="label">Turbo (8 steps · Qwen-Image-2.1-Turbo weights)</property><property name="active">true</property><property name="tooltip-text">Runs the distilled Turbo checkpoint at its fixed 8 steps, several times faster. Untick to use base Qwen-Image-2.1 with the schedule and steps below.</property></object></child>
                  <child><object class="GtkCheckButton" id="qwen_edit_enhance"><property name="label">Enhance prompt (the model's own 9B prompt enhancer)</property><property name="active">true</property><property name="tooltip-text">Looks at the sources and rewrites the edit request first. FLUX 3: BFL's prompt upsampler (about 15 s). Qwen-Image: Qwen-Image-2.1-PE-I2I, which thinks first (about 2 min) and also picks the output aspect ratio. Untick to send the request as typed.</property></object></child>
                  <child><object class="GtkCheckButton" id="qwen_edit_match_source"><property name="label">FLUX 3: match first source size (untick to use Width/Height, up to 4096)</property><property name="active">true</property></object></child>
                  <child><object class="GtkLabel"><property name="label">ORDERED SOURCE IMAGES</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child>
                  <child><object class="GtkButton" id="qwen_edit_choose_source"><property name="label">＋ Add PNG / JPEG / WebP · up to 10</property><style><class name="drop-target"/></style></object></child>
                  <child><object class="GtkGridView" id="qwen_edit_references"><property name="max-columns">3</property><property name="single-click-activate">false</property><property name="height-request">128</property></object></child>
                  <child><object class="GtkBox"><property name="spacing">6</property><child><object class="GtkLabel" id="qwen_edit_source_count"><property name="label">0 / 10</property><property name="hexpand">true</property><property name="xalign">0</property></object></child><child><object class="GtkButton" id="qwen_edit_remove_source"><property name="label">Remove selected</property><property name="sensitive">false</property></object></child><child><object class="GtkButton" id="qwen_edit_clear_sources"><property name="label">Clear</property><property name="sensitive">false</property></object></child></object></child>
                  <child><object class="GtkLabel"><property name="label">Edit instruction</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child>
                  <child><object class="GtkScrolledWindow"><property name="min-content-height">190</property><child><object class="GtkTextView" id="qwen_edit_prompt"><property name="buffer">qwen_edit_prompt_buffer</property><property name="wrap-mode">word-char</property><property name="top-margin">9</property><property name="bottom-margin">9</property><property name="left-margin">9</property><property name="right-margin">9</property></object></child></object></child>
                  <child><object class="GtkFrame"><style><class name="run-card"/></style><child><object class="GtkGrid"><property name="column-spacing">8</property><property name="row-spacing">7</property><property name="margin-start">10</property><property name="margin-end">10</property><property name="margin-top">9</property><property name="margin-bottom">10</property>
                    <child><object class="GtkLabel"><property name="label">Resolution</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">0</property></layout></object></child><child><object class="GtkDropDown" id="qwen_edit_resolution"><property name="model">qwen_image_resolution_list</property><property name="selected">0</property><layout><property name="column">1</property><property name="row">0</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Scheduler</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">1</property></layout></object></child><child><object class="GtkDropDown" id="qwen_edit_scheduler"><property name="model">qwen_image_scheduler_list</property><property name="selected">0</property><layout><property name="column">1</property><property name="row">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Sampler</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">2</property></layout></object></child><child><object class="GtkDropDown" id="qwen_edit_sampler"><property name="model">qwen_image_sampler_list</property><property name="selected">0</property><layout><property name="column">1</property><property name="row">2</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Steps</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">3</property></layout></object></child><child><object class="GtkSpinButton" id="qwen_edit_steps"><property name="adjustment">qwen_edit_steps_adjustment</property><property name="numeric">true</property><layout><property name="column">1</property><property name="row">3</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Seed</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">4</property></layout></object></child><child><object class="GtkBox"><property name="spacing">5</property><child><object class="GtkEntry" id="qwen_edit_seed"><property name="hexpand">true</property><property name="text">Random</property><property name="input-purpose">number</property></object></child><child><object class="GtkButton" id="qwen_edit_seed_randomize"><property name="icon-name">media-playlist-shuffle-symbolic</property></object></child><child><object class="GtkCheckButton" id="qwen_edit_seed_lock"><property name="label">Lock</property></object></child><layout><property name="column">1</property><property name="row">4</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Width</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">5</property></layout></object></child><child><object class="GtkSpinButton" id="qwen_edit_width"><property name="adjustment">qwen_edit_width_adjustment</property><property name="numeric">true</property><layout><property name="column">1</property><property name="row">5</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Height</property><property name="xalign">0</property><layout><property name="column">0</property><property name="row">6</property></layout></object></child><child><object class="GtkSpinButton" id="qwen_edit_height"><property name="adjustment">qwen_edit_height_adjustment</property><property name="numeric">true</property><layout><property name="column">1</property><property name="row">6</property></layout></object></child>
                  </object></child></object></child>
