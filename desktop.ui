          <!-- Qwen Image Edit: 1..10 ordered sources, one instruction, one native model -->
          <child><object class="GtkStackPage"><property name="name">image_edit</property><property name="child">
            <object class="GtkBox"><property name="orientation">vertical</property><property name="vexpand">true</property><style><class name="generate-page"/></style>
              <child><object class="GtkBox"><property name="spacing">12</property><property name="margin-start">18</property><property name="margin-end">18</property><property name="margin-top">15</property><property name="margin-bottom">12</property><style><class name="prompt-header"/></style>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><child><object class="GtkLabel"><property name="label">QWEN IMAGE EDIT</property><property name="xalign">0</property><style><class name="prompt-eyebrow"/></style></object></child><child><object class="GtkLabel"><property name="label">Load 1–10 ordered images, describe the change, generate the edit</property><property name="xalign">0</property><style><class name="prompt-title"/></style></object></child></object></child>
