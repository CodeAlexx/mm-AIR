          <child><object class="GtkStackPage"><property name="name">edit</property><property name="child">
            <object class="GtkBox"><property name="orientation">vertical</property><property name="vexpand">true</property><style><class name="generate-page"/></style>
              <child><object class="GtkBox"><property name="spacing">12</property><property name="margin-start">18</property><property name="margin-end">18</property><property name="margin-top">15</property><property name="margin-bottom">12</property><style><class name="prompt-header"/></style>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property><child><object class="GtkLabel"><property name="label">Edit</property><property name="xalign">0</property><style><class name="prompt-eyebrow"/></style></object></child><child><object class="GtkLabel"><property name="label">Localized image and video edits with source-preserving reconstruction</property><property name="xalign">0</property><style><class name="prompt-title"/></style></object></child></object></child>
