          </property></object></child>

          <!-- Prompt Lab: AIR-native Qwen conversation and production workprint -->
          <child><object class="GtkStackPage"><property name="name">prompt</property><property name="child">
            <object class="GtkBox"><property name="orientation">vertical</property><property name="vexpand">true</property><style><class name="prompt-page"/></style>
              <child><object class="GtkBox"><property name="spacing">12</property><property name="margin-start">18</property><property name="margin-end">18</property><property name="margin-top">15</property><property name="margin-bottom">12</property><style><class name="prompt-header"/></style>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="hexpand">true</property>
                  <child><object class="GtkLabel"><property name="label">Prompt lab</property><property name="xalign">0</property><style><class name="prompt-eyebrow"/></style></object></child>
                  <child><object class="GtkLabel"><property name="label">Turn an idea or reference into an H3-ready workprint</property><property name="xalign">0</property><style><class name="prompt-title"/></style></object></child>
                </object></child>
                <child><object class="GtkLabel" id="prompt_model_badge"><property name="label">Qwen3-VL 4B</property><style><class name="prompt-model-chip"/></style></object></child>
                <child><object class="GtkLabel" id="prompt_residency"><property name="label">Unloaded</property><style><class name="ready-chip"/></style></object></child>
              </object></child>
              <child><object class="GtkPaned"><property name="orientation">horizontal</property><property name="vexpand">true</property><property name="position">650</property><property name="wide-handle">true</property>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><property name="margin-start">16</property><property name="margin-end">12</property><property name="margin-bottom">14</property><style><class name="prompt-conversation"/></style>
                  <child><object class="GtkBox"><child><object class="GtkLabel"><property name="label">Conversation</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child><child><object class="GtkButton" id="prompt_new_session"><property name="label">New session</property><style><class name="quiet-button"/></style></object></child></object></child>
                  <child><object class="GtkScrolledWindow"><property name="vexpand">true</property><style><class name="prompt-transcript"/></style><child><object class="GtkTextView" id="prompt_chat"><property name="buffer">prompt_chat_buffer</property><property name="editable">false</property><property name="cursor-visible">false</property><property name="wrap-mode">word-char</property><property name="top-margin">14</property><property name="bottom-margin">14</property><property name="left-margin">14</property><property name="right-margin">14</property></object></child></object></child>
                  <child><object class="GtkFrame"><style><class name="prompt-compose"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin-start">10</property><property name="margin-end">10</property><property name="margin-top">10</property><property name="margin-bottom">10</property>
                    <child><object class="GtkScrolledWindow"><property name="min-content-height">88</property><child><object class="GtkTextView" id="prompt_input"><property name="buffer">prompt_input_buffer</property><property name="wrap-mode">word-char</property><property name="top-margin">8</property><property name="bottom-margin">8</property><property name="left-margin">8</property><property name="right-margin">8</property></object></child></object></child>
                    <child><object class="GtkBox"><property name="spacing">7</property>
                      <child><object class="GtkButton" id="prompt_attach"><property name="label">＋ Image / video</property><style><class name="dashed-button"/></style></object></child>
                      <child><object class="GtkLabel" id="prompt_attachment_summary"><property name="label">No references</property><property name="hexpand">true</property><property name="xalign">0</property><property name="ellipsize">middle</property><style><class name="muted"/></style></object></child>
                      <child><object class="GtkButton" id="prompt_clear_attachments"><property name="label">Clear</property><property name="sensitive">false</property><style><class name="quiet-button"/></style></object></child>
                      <child><object class="GtkButton" id="prompt_cancel"><property name="label">Cancel</property><property name="sensitive">false</property><style><class name="quiet-button"/></style></object></child>
                      <child><object class="GtkButton" id="prompt_run"><property name="label">Run Qwen</property><style><class name="primary-action"/></style></object></child>
                    </object></child>
                  </object></child></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><property name="margin-start">12</property><property name="margin-end">16</property><property name="margin-bottom">14</property><style><class name="prompt-workprint"/></style>
                  <child><object class="GtkBox"><child><object class="GtkLabel"><property name="label">Current workprint</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child><child><object class="GtkButton" id="prompt_preserve"><property name="label">Preserve variant</property><style><class name="quiet-button"/></style></object></child></object></child>
                  <child><object class="GtkScrolledWindow"><property name="vexpand">true</property><style><class name="prompt-output"/></style><child><object class="GtkTextView" id="prompt_output"><property name="buffer">prompt_output_buffer</property><property name="wrap-mode">word-char</property><property name="top-margin">16</property><property name="bottom-margin">16</property><property name="left-margin">16</property><property name="right-margin">16</property></object></child></object></child>
                  <child><object class="GtkExpander"><property name="label">H3 window plan (same geometry as AIR)</property><property name="expanded">true</property><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">7</property><property name="margin-top">7</property>
                    <child><object class="GtkBox"><property name="spacing">7</property>
                      <child><object class="GtkSpinButton" id="prompt_total_seconds"><property name="adjustment">prompt_total_adjustment</property><property name="digits">3</property><property name="numeric">true</property><property name="tooltip-text">Finished-film seconds</property></object></child>
                      <child><object class="GtkLabel"><property name="label">total s</property><style><class name="muted"/></style></object></child>
                      <child><object class="GtkSpinButton" id="prompt_window_seconds"><property name="adjustment">prompt_window_adjustment</property><property name="digits">3</property><property name="numeric">true</property><property name="tooltip-text">Approximate H3 window seconds; AIR snaps to model geometry</property></object></child>
                      <child><object class="GtkLabel"><property name="label">window s</property><style><class name="muted"/></style></object></child>
                      <child><object class="GtkSpinButton" id="prompt_overlap_seconds"><property name="adjustment">prompt_overlap_adjustment</property><property name="digits">3</property><property name="numeric">true</property><property name="tooltip-text">Approximate overlap seconds; audio is mapped separately</property></object></child>
                      <child><object class="GtkLabel"><property name="label">overlap s</property><style><class name="muted"/></style></object></child>
                      <child><object class="GtkButton" id="prompt_build_plan"><property name="label">Build authoritative plan</property><style><class name="prompt-transform"/></style></object></child>
                    </object></child>
                    <child><object class="GtkLabel" id="prompt_window_report"><property name="label">Plan not built</property><property name="wrap">true</property><property name="selectable">true</property><property name="xalign">0</property><property name="max-width-chars">90</property><style><class name="capability-note"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">Scene Plan sends these exact ordered frame, video-latent, and audio-latent spans to Qwen. Current Generate remains one native H3 latent; multi-window execution is not mislabeled as active.</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="muted"/></style></object></child>
                  </object></child></object></child>
                  <child><object class="GtkBox"><property name="spacing">7</property><property name="homogeneous">true</property>
                    <child><object class="GtkButton" id="prompt_send_generate"><property name="label">Send to Generate</property><style><class name="primary-action"/></style></object></child>
                    <child><object class="GtkButton" id="prompt_send_edit"><property name="label">Send to Edit</property><style><class name="primary-action"/></style></object></child>
                    <child><object class="GtkButton" id="prompt_send_movie"><property name="label">Send to Movie Maker</property><style><class name="movie-primary"/></style></object></child>
                    <child><object class="GtkButton" id="prompt_save"><property name="label">Save to History</property><style><class name="quiet-button"/></style></object></child>
                  </object></child>
                  <child><object class="GtkBox"><property name="spacing">7</property>
                    <child><object class="GtkButton" id="prompt_replace"><property name="label">Replace current prompt</property><style><class name="quiet-button"/></style></object></child>
                    <child><object class="GtkButton" id="prompt_append"><property name="label">Append to current prompt</property><style><class name="quiet-button"/></style></object></child>
                  </object></child>
                </object></child>
              </object></child>
              <child><object class="GtkBox"><property name="spacing">10</property><property name="margin-start">16</property><property name="margin-end">16</property><property name="margin-bottom">14</property><style><class name="prompt-controls"/></style>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="width-request">245</property><child><object class="GtkLabel"><property name="label">Model</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child><child><object class="GtkDropDown" id="prompt_model"><property name="model">prompt_model_list</property><property name="selected">0</property></object></child></object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><property name="width-request">250</property><child><object class="GtkLabel"><property name="label">Output mode</property><property name="xalign">0</property><style><class name="field-label"/></style></object></child><child><object class="GtkDropDown" id="prompt_task"><property name="model">prompt_task_list</property><property name="selected">0</property></object></child></object></child>
                <child><object class="GtkBox"><property name="hexpand">true</property></object></child>
                <child><object class="GtkButton" id="prompt_expand"><property name="label">Expand H3</property><style><class name="prompt-transform"/></style></object></child>
                <child><object class="GtkButton" id="prompt_shorten"><property name="label">Shorten</property><style><class name="prompt-transform"/></style></object></child>
                <child><object class="GtkButton" id="prompt_cinematic"><property name="label">Cinematic</property><style><class name="prompt-transform"/></style></object></child>
                <child><object class="GtkButton" id="prompt_shot_list"><property name="label">Shot list</property><style><class name="prompt-transform"/></style></object></child>
              </object></child>
              <child><object class="GtkBox"><property name="spacing">9</property><property name="margin-start">16</property><property name="margin-end">16</property><property name="margin-bottom">10</property>
                <child><object class="GtkLabel" id="prompt_availability"><property name="label">4B local · resident BF16 · one request at a time</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="capability-note"/></style></object></child>
                <child><object class="GtkLabel" id="prompt_metrics"><property name="label">No request measured</property><style><class name="timecode-cyan"/></style></object></child>
              </object></child>
            </object>
          </property></object></child>
        </object></child>
      </object></child>

      <child><object class="GtkBox"><property name="height-request">28</property><property name="spacing">10</property><property name="margin-start">12</property><property name="margin-end">12</property><style><class name="status-bar"/></style>
        <child><object class="GtkLabel" id="status"><property name="label">Generate ready · H3 generation not connected to MM-AIR</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="status-text"/></style></object></child>
        <child><object class="GtkLabel"><property name="label">Native generation</property><style><class name="status-contract"/></style></object></child>
      </object></child>
    </object></property></object></child>
      <child><object class="GtkStackPage"><property name="name">image</property><property name="child">
        <object class="GtkBox" id="result_fullscreen"><property name="orientation">vertical</property><property name="spacing">8</property><property name="hexpand">true</property><property name="vexpand">true</property><property name="margin-start">10</property><property name="margin-end">10</property><property name="margin-top">10</property><property name="margin-bottom">10</property><style><class name="fullscreen-preview"/></style>
          <child><object class="GtkBox"><property name="spacing">12</property>
            <child><object class="GtkButton" id="result_fullscreen_close"><property name="label">Back</property><property name="tooltip-text">Close expanded image · Escape</property><style><class name="quiet-button"/></style></object></child>
            <child><object class="GtkLabel" id="image_view_name"><property name="hexpand">true</property><property name="xalign">0</property><property name="ellipsize">middle</property><style><class name="muted"/></style></object></child>
            <child><object class="GtkLabel"><property name="label">Escape or double-click to return</property><style><class name="muted"/></style></object></child>
          </object></child>
          <child><object class="GtkPicture" id="result_fullscreen_picture"><property name="can-shrink">true</property><property name="content-fit">contain</property><property name="hexpand">true</property><property name="vexpand">true</property><style><class name="image-zoom"/></style></object></child>
        </object>
      </property></object></child>
    </object></child>
  </object>
</interface>
