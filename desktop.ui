                  <child><object class="GtkFrame"><style><class name="run-card"/></style><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">7</property><property name="margin-start">10</property><property name="margin-end">10</property><property name="margin-top">9</property><property name="margin-bottom">10</property>
