                    <child><object class="GtkLabel"><property name="label">Cleanup</property><layout><property name="column">1</property><property name="row">0</property></layout></object></child><child><object class="GtkSpinButton" id="edit_cleanup"><property name="adjustment">edit_cleanup_adjustment</property><property name="numeric">true</property><layout><property name="column">1</property><property name="row">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Expand / shrink</property><layout><property name="column">0</property><property name="row">2</property></layout></object></child><child><object class="GtkSpinButton" id="edit_expand"><property name="adjustment">edit_expand_adjustment</property><property name="numeric">true</property><layout><property name="column">0</property><property name="row">3</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Padding</property><layout><property name="column">1</property><property name="row">2</property></layout></object></child><child><object class="GtkSpinButton" id="edit_padding"><property name="adjustment">edit_padding_adjustment</property><property name="numeric">true</property><layout><property name="column">1</property><property name="row">3</property></layout></object></child>
                  </object></child>
