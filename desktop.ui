                </object></child><layout><property name="column">2</property><property name="row">0</property></layout></object></child>
              </object></child>
              <child><object class="GtkBox"><property name="spacing">8</property><property name="margin-start">16</property><property name="margin-end">16</property><property name="margin-bottom">14</property><property name="halign">end</property>
